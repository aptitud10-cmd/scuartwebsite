---
/**
 * Layout.astro — Layout base del sitio SCUART
 * v2 (i18n): recibe lang, canonicalURL, alternates para SEO bilingue.
 * Carga fuentes con preload, tokens CSS, grain.
 * CSS global importado via frontmatter (mas confiable que @import en <style>).
 */

import '../styles/global.css';
import type { Lang } from '../i18n/index';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  lang?: Lang;
  canonicalURL?: string;
  alternates?: {
    en: string;
    es: string;
    xDefault: string;
  };
}

const {
  title = 'SCUART — Bilingual Design & Tech Studio',
  description = 'A bilingual studio building premium websites, platforms and digital systems for ambitious businesses across the US and LATAM.',
  ogTitle,
  ogDescription,
  lang = 'en',
  canonicalURL,
  alternates,
} = Astro.props;

const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDesc = ogDescription ?? description;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- OG / Social -->
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDesc} />
    <meta property="og:type" content="website" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:locale" content={lang === 'es' ? 'es_419' : 'en_US'} />
    <meta property="og:site_name" content="SCUART" />
    <meta property="og:image" content="https://scuart.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SCUART — Design + Technology studio for ambitious businesses" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDesc} />
    <meta name="twitter:image" content="https://scuart.com/og.png" />

    <!-- Browser theme -->
    <meta name="theme-color" content="#0E0E0E" />

    <title>{title}</title>

    <!-- SEO: canonical -->
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- SEO: hreflang (bilingue EN/ES + x-default) -->
    {alternates && (
      <>
        <link rel="alternate" hreflang="en" href={alternates.en} />
        <link rel="alternate" hreflang="es" href={alternates.es} />
        <link rel="alternate" hreflang="x-default" href={alternates.xDefault} />
      </>
    )}

    <!-- Preload fuentes self-hosted (criticas para render) -->
    <link
      rel="preload"
      href="/fonts/archivo-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/dm-sans-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Favicon placeholder -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
