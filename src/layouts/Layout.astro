---
/**
 * Layout.astro — Layout base del sitio SCUART
 * v2 (i18n): recibe lang, canonicalURL, alternates para SEO bilingue.
 * Carga fuentes con preload, tokens CSS, grain.
 * CSS global importado via frontmatter (mas confiable que @import en <style>).
 */

import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import { SITE_URL, type Lang } from '../i18n/index';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  /** ruta absoluta o relativa a una imagen OG propia de la página (ej. hero de un
   *  caso). Si se omite, cae al og.png genérico del estudio. */
  ogImage?: string;
  lang?: Lang;
  canonicalURL?: string;
  alternates?: {
    en: string;
    es: string;
    xDefault: string;
  };
}

const {
  title = 'SCUART — Bilingual Design & Tech Studio',
  description = 'A bilingual studio building premium websites, platforms and digital systems for ambitious businesses across the US and LATAM.',
  ogTitle,
  ogDescription,
  ogImage,
  lang = 'en',
  canonicalURL,
  alternates,
} = Astro.props;

/* og:image por página: si la página pasa ogImage, se usa esa (absolutizada);
   si no, el og.png genérico del estudio. Mejora el preview al compartir un caso. */
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`)
  : `${SITE_URL}/og.png`;

/*
 * JSON-LD @graph: Organization (ProfessionalService con base en New York) + WebSite.
 * Base geo NY primario (William 2026-07-28): vive en Queens, mercado principal USA.
 * La dirección web es solo ciudad/estado (New York, NY, US) — NUNCA el domicilio
 * real; ese solo existe en el panel privado de Google Business Profile y oculto
 * al público (Service Area Business). Colombia queda como segundo mercado en
 * areaServed. Teléfono +1 347 (NY) ya coherente. Cubre las 15 páginas.
 */
const orgSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE_URL}/#organization`,
      name: 'SCUART',
      url: SITE_URL,
      description,
      image: `${SITE_URL}/og.png`,
      logo: `${SITE_URL}/favicon.svg`,
      email: 'info@scuart.com',
      telephone: '+13478489720',
      knowsLanguage: ['en', 'es'],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'New York',
        addressRegion: 'NY',
        addressCountry: 'US',
      },
      areaServed: [
        { '@type': 'Country', name: 'United States' },
        { '@type': 'Country', name: 'Colombia' },
        { '@type': 'Place', name: 'Latin America' },
      ],
      knowsAbout: [
        'Web design',
        'Web development',
        'SaaS development',
        'E-commerce',
        'Booking systems',
        'Brand identity',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: SITE_URL,
      name: 'SCUART',
      description,
      inLanguage: ['en', 'es'],
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
  ],
};

const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDesc = ogDescription ?? description;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />

    <!-- Google Search Console: verificación de propiedad del dominio (William 2026-07-28) -->
    <meta name="google-site-verification" content="G9kq5cGJRRHeX-SLLtRPGnZ-J37G1jj1-rmRXfOQAZU" />

    <!-- OG / Social -->
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDesc} />
    <meta property="og:type" content="website" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:locale" content={lang === 'es' ? 'es_419' : 'en_US'} />
    <meta property="og:site_name" content="SCUART" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedOgTitle} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDesc} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Browser theme — crema como color de tema (el hero arranca claro) -->
    <meta name="theme-color" content="#f4f2ec" />

    <title>{title}</title>

    <!-- SEO: canonical -->
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- SEO: hreflang (bilingue EN/ES + x-default) -->
    {alternates && (
      <>
        <link rel="alternate" hreflang="en" href={alternates.en} />
        <link rel="alternate" hreflang="es" href={alternates.es} />
        <link rel="alternate" hreflang="x-default" href={alternates.xDefault} />
      </>
    )}

    <!-- SEO: structured data (Organization) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(orgSchema)}
      is:inline
    />


    <!--
      Fuentes activas: Fraunces Variable (display) + Geist Sans (cuerpo/UI).
      Se sirven desde node_modules via @fontsource/@fontsource-variable — no requieren
      preload manual (Vite los procesa como assets locales con hash de contenido).
      Las fuentes legado (archivo/dm-sans/ibm-plex) se conservan en /public/fonts
      y en fonts.css para componentes no migrados, pero NO se precargan:
      no están en el critical path de render del hero B1.
    -->

    <!-- PP Editorial New pinta TODO el texto display (hero, nombres, statements).
         Sin preload, el swap tardío causa reflow/CLS y retrasa el LCP (QA 2026-07-21). -->
    <link
      rel="preload"
      href="/fonts/ppeditorialnew-light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Favicon — S serif PP Editorial, tinta sobre lima (marca SCUART) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- B5: skip-link styles — inlined para garantizar disponibilidad inmediata -->
    <style>
      /*
       * Skip-link: visible solo cuando recibe foco (usuarios de teclado/screen reader).
       * Oculto visualmente con translate negativo (no display:none — accesible al foco).
       * Fondo tinta (--ink), texto crema (--bg), borde/outline lima (--brand) —
       * mismo patrón que el resto de los CTAs invertidos del sitio.
       * Contraste verificado: bg-sobre-ink 16.6:1, brand-sobre-ink 14.3:1 (AAA).
       */
      .skip-link {
        position: absolute;
        top: 0;
        left: 0;
        transform: translateY(-100%);
        z-index: 9999;
        padding: 0.75rem 1.25rem;
        background-color: var(--ink);
        color: var(--bg);
        font-family: 'Hanken Grotesk', sans-serif;
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-decoration: none;
        border-bottom: 1px solid var(--brand);
        transition: transform 0.15s ease;
      }

      .skip-link:focus {
        transform: translateY(0);
        outline: 2px solid var(--brand);
        outline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <!--
      B5 FIX: skip-link para usuarios de teclado.
      Visible solo al recibir foco (posición absoluta fuera de pantalla por defecto,
      entra al viewport en :focus). Fondo --ink, texto --bg, mono — coherente
      con la identidad del sitio. z-index sobre todo el contenido incluyendo el nav.
    -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <main id="main-content">
      <slot />
    </main>

    <CookieBanner lang={lang} />

    <!--
      Lenis smooth scroll — FASE 1 del Art Layer.
      Se inicializa aquí (Layout global) para que esté activo en todas las páginas.
      Integración con GSAP ScrollTrigger: ticker compartido para que los ScrollTrigger
      de Portfolio y Method lean la posición de Lenis en sincronía con el RAF.

      Carga como módulo ES: Vite garantiza que gsap y ScrollTrigger sean el mismo
      singleton que usan los scripts de los componentes (deduplicación por path).

      prefers-reduced-motion: no se inicializa Lenis → scroll nativo puro.
    -->
    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      /* Registrar ScrollTrigger en el singleton compartido de GSAP.
         Los scripts de PortfolioSection y MethodSection también lo registran,
         pero registerPlugin es idempotente — no hay problema con llamarlo varias veces. */
      gsap.registerPlugin(ScrollTrigger);

      /* Respetar prefers-reduced-motion: sin Lenis, scroll nativo puro. */
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* Lenis SOLO en desktop (≥769px). En mobile: scroll nativo del body
         (body-scroll-container). Conflicto crítico: Lenis asume window como
         scroller, pero en mobile el scroller es document.body (directiva iOS).
         Research 4.2: Estrategia A recomendada. */
      /* 767px, NO 768px (unificado 2026-08-06 junto a global.css y tokens.css).
         Este valor DEBE coincidir exactamente con el media query que mueve el
         scroller al <body> en global.css. Si acá dijera 768 y allá 767, en un
         viewport de exactamente 768px el scroller sería `window` pero este
         código escucharía `document.body` — un listener sobre un elemento que
         no scrollea, y encima saltearía Lenis. Mobile = ≤767px en todo el sitio. */
      const isMobile = window.matchMedia('(max-width: 767px)').matches;

      /* ═══════════════════════════════════════════════════════════════
         MOBILE: avisarle a ScrollTrigger que el scroll ocurrió.

         MEDIDO EN IPHONE REAL (página /es/diag, 2026-08-05) — no supuesto:
           scroller real   BODY
           window.scrollY  0      ← window NUNCA se mueve
           body.scrollTop  1103
           ev. window      0      ← window NO recibe un solo evento
           ev. body        541
         global.css mueve el scroll del root al <body> en ≤768px (directiva
         iOS de CLAUDE.md). ScrollTrigger escucha `window`, que ahí está
         muerto: sus triggers nunca se actualizan y toda animación por scroll
         queda congelada. Chrome DevTools en modo mobile NO reproduce esto
         (sigue scrolleando window), por eso el bug solo se ve en el iPhone.

         EL FIX ES ESTE LISTENER, nada más. Con él, el mismo test dio
         ST progress 0.68 y la opacidad subió de 0.08 a 0.71.

         NO agregar acá scrollerProxy() ni ScrollTrigger.defaults({scroller}):
         se intentó el 2026-08-05 y rompió TODAS las animaciones en Safari iOS
         — `scroller` no es opción válida de defaults() (se ignora, dejando los
         triggers apuntando a window mientras el proxy declara otro scroller),
         y este script no tiene orden garantizado frente a los <script> de cada
         componente, que ya crearon sus triggers antes.
         ═══════════════════════════════════════════════════════════════ */
      if (isMobile) {
        document.body.addEventListener('scroll', () => ScrollTrigger.update(), { passive: true });
      }

      if (!reducedMotion && !isMobile) {
        const lenis = new Lenis({
          /* lerp 0.08: sensación "flotante" premium tipo Locomotive — la página
             tiene masa y sigue al usuario con un retardo suave. 0.07–0.1 es el
             rango; 0.08 flota sin marear. (research motion 2026) */
          lerp: 0.08,
          smoothWheel: true,
          /* syncTouch: false — el scroll touch en mobile ya es suave nativamente.
             Activarlo en iOS puede interferir con el momentum scroll nativo. */
          syncTouch: false,
        });

        /* Integración Lenis + GSAP ScrollTrigger — patrón oficial verificado.
           Lenis emite el evento 'scroll' en cada tick de RAF.
           ScrollTrigger.update() recalcula las posiciones usando la posición
           real del scroll (que Lenis ya aplicó al documento). */
        lenis.on('scroll', ScrollTrigger.update);

        /* Conectar Lenis al ticker de GSAP para que ambos corran en el mismo RAF.
           gsap.ticker.add recibe tiempo en segundos, lenis.raf espera milisegundos.
           Guardamos la referencia del callback para poder removerlo en el teardown. */
        const tickerCallback = (time: number) => {
          lenis.raf(time * 1000);
        };
        gsap.ticker.add(tickerCallback);

        /* Evitar que GSAP haga lag smoothing propio — Lenis ya maneja el suavizado. */
        gsap.ticker.lagSmoothing(0);

        /* Exponer lenis en window para que el Nav pueda escuchar su evento de scroll.
           Alternativa más simple a un eventBus o import cruzado entre scripts. */
        (window as unknown as Record<string, unknown>)['__lenis'] = lenis;

        /* Disparar evento personalizado para que Nav.astro sepa que Lenis está listo. */
        window.dispatchEvent(new CustomEvent('lenis:ready', { detail: { lenis } }));

        /*
         * TEARDOWN — evita acumular tickers/Lenis huérfanos entre páginas.
         * El sitio es multi-página y el selector EN/ES navega con <a> real.
         * Sin View Transitions, la navegación dura recarga todo (limpieza implícita),
         * pero registramos teardown explícito para:
         *   1. astro:before-swap → si se activan View Transitions, cada swap
         *      destruiría el Lenis viejo en lugar de apilar uno nuevo.
         *   2. pagehide → red de seguridad en navegación dura / bfcache.
         * lenis.raf deja de llamarse (ticker removido) y Lenis libera sus listeners.
         */
        let toreDown = false;
        const teardown = () => {
          if (toreDown) return; /* idempotente: solo el primer evento que dispare */
          toreDown = true;
          gsap.ticker.remove(tickerCallback);
          lenis.destroy();
          delete (window as unknown as Record<string, unknown>)['__lenis'];
        };
        document.addEventListener('astro:before-swap', teardown, { once: true });
        window.addEventListener('pagehide', teardown, { once: true });
      }
    </script>
  </body>
</html>
