---
/**
 * Layout.astro — Layout base del sitio SCUART
 * v2 (i18n): recibe lang, canonicalURL, alternates para SEO bilingue.
 * Carga fuentes con preload, tokens CSS, grain.
 * CSS global importado via frontmatter (mas confiable que @import en <style>).
 */

import '../styles/global.css';
import type { Lang } from '../i18n/index';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  lang?: Lang;
  canonicalURL?: string;
  alternates?: {
    en: string;
    es: string;
    xDefault: string;
  };
}

const {
  title = 'SCUART — Bilingual Design & Tech Studio',
  description = 'A bilingual studio building premium websites, platforms and digital systems for ambitious businesses across the US and LATAM.',
  ogTitle,
  ogDescription,
  lang = 'en',
  canonicalURL,
  alternates,
} = Astro.props;

const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDesc = ogDescription ?? description;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />

    <!-- OG / Social -->
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDesc} />
    <meta property="og:type" content="website" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:locale" content={lang === 'es' ? 'es_419' : 'en_US'} />
    <meta property="og:site_name" content="SCUART" />
    <meta property="og:image" content="https://scuart.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SCUART — Design + Technology studio for ambitious businesses" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDesc} />
    <meta name="twitter:image" content="https://scuart.com/og.png" />

    <!-- Browser theme — V3: hueso como color de tema (el hero arranca claro) -->
    <meta name="theme-color" content="#F0E9DC" />

    <title>{title}</title>

    <!-- SEO: canonical -->
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- SEO: hreflang (bilingue EN/ES + x-default) -->
    {alternates && (
      <>
        <link rel="alternate" hreflang="en" href={alternates.en} />
        <link rel="alternate" hreflang="es" href={alternates.es} />
        <link rel="alternate" hreflang="x-default" href={alternates.xDefault} />
      </>
    )}

    <!--
      Fuentes activas: Fraunces Variable (display) + Geist Sans (cuerpo/UI).
      Se sirven desde node_modules via @fontsource/@fontsource-variable — no requieren
      preload manual (Vite los procesa como assets locales con hash de contenido).
      Las fuentes legado (archivo/dm-sans/ibm-plex) se conservan en /public/fonts
      y en fonts.css para componentes no migrados, pero NO se precargan:
      no están en el critical path de render del hero B1.
    -->

    <!-- Favicon placeholder -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- B5: skip-link styles — inlined para garantizar disponibilidad inmediata -->
    <style>
      /*
       * Skip-link: visible solo cuando recibe foco (usuarios de teclado/screen reader).
       * Oculto visualmente con translate negativo (no display:none — accesible al foco).
       * V3: fondo barro-oscuro, texto hueso, mono uppercase, borde terracota.
       */
      .skip-link {
        position: absolute;
        top: 0;
        left: 0;
        transform: translateY(-100%);
        z-index: 9999;
        padding: 0.75rem 1.25rem;
        background-color: #241710; /* --barro-oscuro */
        color: #F0E9DC; /* --hueso */
        font-family: 'Hanken Grotesk', sans-serif;
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-decoration: none;
        border-bottom: 1px solid #A4471F; /* --terracota */
        transition: transform 0.15s ease;
      }

      .skip-link:focus {
        transform: translateY(0);
        outline: 2px solid #A4471F; /* --terracota */
        outline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <!--
      B5 FIX: skip-link para usuarios de teclado.
      Visible solo al recibir foco (posición absoluta fuera de pantalla por defecto,
      entra al viewport en :focus). Fondo --carbon, texto --crema, mono — coherente
      con la identidad del sitio. z-index sobre todo el contenido incluyendo el nav.
    -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <main id="main-content">
      <slot />
    </main>

    <!--
      Lenis smooth scroll — FASE 1 del Art Layer.
      Se inicializa aquí (Layout global) para que esté activo en todas las páginas.
      Integración con GSAP ScrollTrigger: ticker compartido para que los ScrollTrigger
      de Portfolio y Method lean la posición de Lenis en sincronía con el RAF.

      Carga como módulo ES: Vite garantiza que gsap y ScrollTrigger sean el mismo
      singleton que usan los scripts de los componentes (deduplicación por path).

      prefers-reduced-motion: no se inicializa Lenis → scroll nativo puro.
    -->
    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      /* Registrar ScrollTrigger en el singleton compartido de GSAP.
         Los scripts de PortfolioSection y MethodSection también lo registran,
         pero registerPlugin es idempotente — no hay problema con llamarlo varias veces. */
      gsap.registerPlugin(ScrollTrigger);

      /* Respetar prefers-reduced-motion: sin Lenis, scroll nativo puro. */
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reducedMotion) {
        const lenis = new Lenis({
          /* lerp 0.1: sutil y elegante. No flotante exagerado. */
          lerp: 0.1,
          smoothWheel: true,
          /* syncTouch: false — el scroll touch en mobile ya es suave nativamente.
             Activarlo en iOS puede interferir con el momentum scroll nativo. */
          syncTouch: false,
        });

        /* Integración Lenis + GSAP ScrollTrigger — patrón oficial verificado.
           Lenis emite el evento 'scroll' en cada tick de RAF.
           ScrollTrigger.update() recalcula las posiciones usando la posición
           real del scroll (que Lenis ya aplicó al documento). */
        lenis.on('scroll', ScrollTrigger.update);

        /* Conectar Lenis al ticker de GSAP para que ambos corran en el mismo RAF.
           gsap.ticker.add recibe tiempo en segundos, lenis.raf espera milisegundos.
           Guardamos la referencia del callback para poder removerlo en el teardown. */
        const tickerCallback = (time: number) => {
          lenis.raf(time * 1000);
        };
        gsap.ticker.add(tickerCallback);

        /* Evitar que GSAP haga lag smoothing propio — Lenis ya maneja el suavizado. */
        gsap.ticker.lagSmoothing(0);

        /* Exponer lenis en window para que el Nav pueda escuchar su evento de scroll.
           Alternativa más simple a un eventBus o import cruzado entre scripts. */
        (window as unknown as Record<string, unknown>)['__lenis'] = lenis;

        /* Disparar evento personalizado para que Nav.astro sepa que Lenis está listo. */
        window.dispatchEvent(new CustomEvent('lenis:ready', { detail: { lenis } }));

        /*
         * TEARDOWN — evita acumular tickers/Lenis huérfanos entre páginas.
         * El sitio es multi-página y el selector EN/ES navega con <a> real.
         * Sin View Transitions, la navegación dura recarga todo (limpieza implícita),
         * pero registramos teardown explícito para:
         *   1. astro:before-swap → si se activan View Transitions, cada swap
         *      destruiría el Lenis viejo en lugar de apilar uno nuevo.
         *   2. pagehide → red de seguridad en navegación dura / bfcache.
         * lenis.raf deja de llamarse (ticker removido) y Lenis libera sus listeners.
         */
        let toreDown = false;
        const teardown = () => {
          if (toreDown) return; /* idempotente: solo el primer evento que dispare */
          toreDown = true;
          gsap.ticker.remove(tickerCallback);
          lenis.destroy();
          delete (window as unknown as Record<string, unknown>)['__lenis'];
        };
        document.addEventListener('astro:before-swap', teardown, { once: true });
        window.addEventListener('pagehide', teardown, { once: true });
      }
    </script>
  </body>
</html>
