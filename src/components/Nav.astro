---
/**
 * Nav.astro — Navegacion minima para el hero
 * v2 (i18n): recibe lang + t (traducciones) para selector EN/ES y labels.
 * Nav completo (hamburger mobile, overlay) se implementa en hito siguiente.
 * DESIGN_RESPONSIVE §8: height 72px, transparente, Mono uppercase taupe.
 */

import type { Lang } from '../i18n/index';
import type { Translations } from '../i18n/en';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;
---

<nav class="nav" aria-label="Navegacion principal">
  <a href={`/${lang}`} class="nav__logo" aria-label="SCUART — Inicio">
    SCUART
  </a>

  <div class="nav__right">
    <!-- Placeholder links — se expanden en hito nav completo -->
    <ul class="nav__links" role="list">
      <li><a href={`/${lang}#portfolio`} class="nav__link">{t.nav.portfolio}</a></li>
      <li><a href={`/${lang}#method`} class="nav__link">{t.nav.method}</a></li>
      <li><a href={`/${lang}#contact`} class="nav__link">{t.nav.contact}</a></li>
    </ul>

    <!-- Selector de idioma EN/ES -->
    <div class="nav__lang" role="navigation" aria-label="Selector de idioma">
      <span class="nav__lang-active" aria-current="true">
        {lang.toUpperCase()}
      </span>
      <span class="nav__lang-sep" aria-hidden="true">/</span>
      <a
        href={t.nav.langHref}
        class="nav__lang-other"
        hreflang={t.nav.langLabel.toLowerCase()}
        aria-label={`Cambiar idioma a ${t.nav.langLabel}`}
      >
        {t.nav.langLabel}
      </a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--margin);
    /*
     * V3: transparente sobre hueso. El fondo del hero es claro (#F0E9DC)
     * así que el nav arranca con texto oscuro (tinta) para legibilidad.
     * Al scrollear hacia secciones oscuras (barro-oscuro), se aplica .scrolled
     * que invierte los colores — ver abajo.
     */
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 0.35s ease, border-color 0.35s ease, color 0.35s ease;
  }

  /*
   * Al scrollear: fondo barro-oscuro + borde hairline oscuro.
   * Aplica cuando el JS detecta scroll > 20px.
   * Nota futura: si se quiere inversión precisa por sección, usar
   * IntersectionObserver con las secciones — por ahora .scrolled es suficiente.
   */
  .nav.scrolled {
    background-color: var(--barro-oscuro);
    border-bottom-color: var(--borde-oscuro);
  }

  .nav__logo {
    font-family: var(--font-display);
    font-weight: var(--display-weight-light);
    font-size: 1.125rem;
    letter-spacing: var(--display-tracking);
    /* V3: tinta sobre hueso (nav transparente sobre hero claro) */
    color: var(--tinta);
    text-decoration: none;
    line-height: 1;
    transition: color 0.35s ease;
  }

  /* Logo en scrolled: hueso sobre barro-oscuro */
  .nav.scrolled .nav__logo {
    color: var(--hueso);
  }

  /* Contenedor derecho: links + selector idioma */
  .nav__right {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .nav__links {
    display: none; /* oculto en mobile — se muestra en tablet+ */
    list-style: none;
    gap: var(--space-m);
    align-items: center;
  }

  .nav__link {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    /* V3: tinta-suave sobre hueso — 5.2:1, pasa AA */
    color: var(--tinta-suave);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.4;
    position: relative;
    /* Subrayado terracota en hover — scaleX 0→1 */
    padding-bottom: 2px;
    transition: color 0.35s ease;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--terracota);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav__link:hover {
    color: var(--tinta);
  }

  .nav__link:hover::after {
    transform: scaleX(1);
  }

  /* En scrolled (sobre barro-oscuro): links en hueso/tinta-suave claro */
  .nav.scrolled .nav__link {
    color: rgba(240, 233, 220, 0.65); /* hueso al 65% = legible sobre barro */
  }

  .nav.scrolled .nav__link:hover {
    color: var(--hueso);
  }

  /* ── Selector de idioma ──────────────────────────────────── */
  /*
   * V3 sobre hueso: usar tinta/tinta-suave para legibilidad.
   * Contraste WCAG:
   *   - .nav__lang-active: var(--tinta) #1C140E sobre --hueso #F0E9DC = ~13.5:1 (AAA)
   *   - .nav__lang-other: var(--tinta-suave) #6B5D4F sobre --hueso #F0E9DC = ~5.2:1 (AA)
   * En .scrolled (sobre barro-oscuro):
   *   - active: var(--hueso) sobre --barro-oscuro = ~12:1 (AAA)
   *   - other: rgba(hueso, 0.65) sobre barro-oscuro = ~7:1 (AA)
   */
  .nav__lang {
    display: flex;
    align-items: center;
    gap: 0.3em;
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.4;
  }

  /* Idioma activo — tinta sobre hueso, no clickeable */
  .nav__lang-active {
    color: var(--tinta);
    cursor: default;
    transition: color 0.35s ease;
  }

  /* Separador / — decorativo, aria-hidden */
  .nav__lang-sep {
    color: var(--tinta-suave);
    opacity: 0.4;
  }

  /* Idioma alternativo — tinta-suave sobre hueso: 5.2:1 pasa AA */
  .nav__lang-other {
    color: var(--tinta-suave);
    text-decoration: none;
    transition: color 0.25s ease;
    position: relative;
    padding-bottom: 2px;
  }

  .nav__lang-other::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--terracota);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav__lang-other:hover {
    color: var(--tinta);
  }

  .nav__lang-other:hover::after {
    transform: scaleX(1);
  }

  /* En scrolled (sobre barro-oscuro): invertir a claro */
  .nav.scrolled .nav__lang-active {
    color: var(--hueso);
  }

  .nav.scrolled .nav__lang-sep {
    color: var(--hueso);
    opacity: 0.3;
  }

  .nav.scrolled .nav__lang-other {
    color: rgba(240, 233, 220, 0.65);
  }

  .nav.scrolled .nav__lang-other:hover {
    color: var(--hueso);
  }

  /* Tablet+: mostrar links inline */
  @media (min-width: 768px) {
    .nav__links {
      display: flex;
    }
  }
</style>

<script>
  /**
   * Nav scroll — clase .scrolled al scrollear.
   *
   * Con Lenis activo: escucha el evento 'scroll' de Lenis via el objeto
   * expuesto en window.__lenis. Lenis 1.3+ no usa translateY en el body
   * (mueve el scroll real del documento), por lo que window.scrollY sigue
   * siendo válido. El evento de Lenis es más preciso: se dispara en cada
   * tick del RAF sincronizado, no en el evento nativo del browser.
   *
   * Sin Lenis (reduced-motion o fallo de carga): fallback a window.scroll nativo.
   */
  const nav = document.querySelector('.nav');
  if (nav) {
    const applyScrolled = (y: number) => {
      if (y > 20) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    };

    /*
     * Flag único: garantiza que SOLO se ata una fuente de scroll (Lenis O nativo),
     * nunca las dos. Sin esto había una carrera: si Lenis llega tarde (>200ms en
     * un device lento), el timeout ataba el listener nativo Y después lenis:ready
     * ataba el de Lenis → doble cálculo de .scrolled.
     */
    let connected = false;

    /* Intentar conectar al evento de Lenis. Devuelve true si conectó. */
    const connectLenis = () => {
      if (connected) return true;
      const lenis = (window as unknown as Record<string, unknown>)['__lenis'];
      if (lenis && typeof (lenis as { on?: unknown }).on === 'function') {
        /* Lenis emite { scroll: number, ... } en el evento 'scroll' */
        (lenis as { on: (event: string, cb: (e: { scroll: number }) => void) => void })
          .on('scroll', ({ scroll }: { scroll: number }) => {
            applyScrolled(scroll);
          });
        connected = true;
        return true;
      }
      return false;
    };

    /* Fallback a scroll nativo. No-op si ya hay una fuente atada. */
    const connectNative = () => {
      if (connected) return;
      connected = true;
      window.addEventListener('scroll', () => applyScrolled(window.scrollY), { passive: true });
    };

    /* Si Lenis ya está inicializado (script de Layout corrió primero), listo. */
    if (!connectLenis()) {
      /* Esperar el evento lenis:ready (puede conectar Lenis o no-op si ya conectó). */
      window.addEventListener(
        'lenis:ready',
        () => {
          if (!connectLenis()) connectNative();
        },
        { once: true }
      );

      /* Red de seguridad: si lenis:ready nunca llega (reduced-motion: Lenis no
         se inicializa), atar el nativo a los 200ms. El flag 'connected' evita
         el doble-atado si Lenis termina conectando justo después. */
      setTimeout(connectNative, 200);
    }
  }
</script>
