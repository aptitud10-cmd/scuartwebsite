---
/**
 * Nav.astro — Barra de navegación global (sticky reducida)
 *
 * DECISIÓN CERRADA (William / HERO_DESKTOP_SPEC.md §3 "DECISIÓN CERRADA"):
 * La navegación principal vive DENTRO del hero (banda TOP), como parte de su
 * composición — gesto Locomotive. Esta Nav.astro es la versión REDUCIDA que
 * aparece sticky solo DESPUÉS de que el hero sale del viewport.
 *
 * Comportamiento por IntersectionObserver:
 *   - Mientras el hero está en viewport → nav oculta (opacity:0, translateY:-100%)
 *   - Cuando el hero sale del viewport → nav aparece (opacity:1, translateY:0, sticky)
 *
 * Así NUNCA hay dos navs visibles simultáneamente en el primer viewport.
 * Verificación: en 1280px y 1920px, cargar la home → debe haber exactamente
 * UN wordmark y UN juego de links hasta que el usuario scrollee fuera del hero.
 */

import type { Lang } from '../i18n/index';
import type { Translations } from '../i18n/en';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;
---

<!-- nav global — sticky, solo visible cuando el hero salió del viewport -->
<nav class="nav-global" aria-label="Navegación principal" data-nav-global>
  <a href={`/${lang}`} class="nav-global__logo" aria-label="SCUART — Inicio">
    SCUART<sup class="nav-global__reg" aria-hidden="true">®</sup>
  </a>

  <div class="nav-global__right">
    <ul class="nav-global__links" role="list">
      <li><a href={`/${lang}#portfolio`} class="nav-global__link">{t.nav.portfolio}</a></li>
      <li><a href={`/${lang}#method`} class="nav-global__link">{t.nav.method}</a></li>
      <li><a href={`/${lang}#contact`} class="nav-global__link">{t.nav.contact}</a></li>
    </ul>

    <div class="nav-global__lang" role="navigation" aria-label="Selector de idioma">
      <span class="nav-global__lang-active" aria-current="true">
        {lang.toUpperCase()}
      </span>
      <span class="nav-global__lang-sep" aria-hidden="true">|</span>
      <a
        href={t.nav.langHref}
        class="nav-global__lang-other"
        hreflang={t.nav.langLabel.toLowerCase()}
        aria-label={`Cambiar idioma a ${t.nav.langLabel}`}
      >
        {t.nav.langLabel}
      </a>
    </div>
  </div>
</nav>

<style>
  /*
   * Nav global reducida — aparece sticky SOLO tras salir del hero.
   * Estado inicial: oculta (translateY -100%, opacity 0, pointer-events none).
   * Al activarse (JS): transición suave a visible.
   * B1 "Arquitecto": fondo yeso --bg, tinta --ink, hairline inferior.
   */
  .nav-global {
    /*
     * position: fixed — NO ocupa espacio en el flujo del documento.
     * El hero empieza en y=0 (no desplazado por la nav).
     * La nav aparece sobre el hero solo cuando el hero sale del viewport.
     */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: clamp(64px, 9vh, 80px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--margin);
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
    /* Estado inicial: oculta arriba del viewport. */
    opacity: 0;
    transform: translateY(-100%);
    pointer-events: none;
    transition:
      opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  /*
   * Estado activo — cuando el JS detecta que el hero salió del viewport.
   * IntersectionObserver en el <script> agrega .is-visible al salir del hero.
   */
  .nav-global.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* ── Wordmark ──────────────────────────────────────────────────── */
  .nav-global__logo {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.0625rem; /* 17px — Fraunces 500, mismo que en el hero */
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    line-height: 1;
    display: inline-flex;
    align-items: baseline;
    gap: 0.1em;
  }

  .nav-global__reg {
    font-size: 0.55em;
    color: var(--accent-text); /* ® — sello de marca (tinta sobre blanco, lima sobre negro) */
    vertical-align: super;
    font-style: normal;
  }

  /* ── Contenedor derecho ────────────────────────────────────────── */
  .nav-global__right {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  /* ── Links de nav ──────────────────────────────────────────────── */
  .nav-global__links {
    display: none;
    list-style: none;
    gap: 2.5rem;
    align-items: center;
  }

  .nav-global__link {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1;
    position: relative;
    padding-bottom: 2px;
  }

  /* Subrayado accent verde — se dibuja en hover (scaleX 0→1) */
  .nav-global__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-global__link:hover::after {
    transform: scaleX(1);
  }

  .nav-global__link:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }

  /* ── Toggle idioma ─────────────────────────────────────────────── */
  .nav-global__lang {
    display: flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  /* Idioma activo — tinta, no clickeable */
  .nav-global__lang-active {
    color: var(--ink);
    cursor: default;
  }

  /* Separador | — en --mid al 40% */
  .nav-global__lang-sep {
    color: var(--mid);
    opacity: 0.4;
  }

  /* Idioma alternativo */
  .nav-global__lang-other {
    color: var(--mid);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-global__lang-other:hover {
    color: var(--ink);
  }

  .nav-global__lang-other:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }

  /* ── Tablet+: mostrar links ────────────────────────────────────── */
  @media (min-width: 768px) {
    .nav-global__links {
      display: flex;
    }
  }
</style>

<script>
  /**
   * Nav global — IntersectionObserver sobre el hero.
   *
   * Mientras el hero está en viewport → nav oculta.
   * Cuando el hero sale del viewport (threshold 0) → nav aparece.
   * Esto garantiza que NO haya dos navs visibles simultáneamente.
   *
   * IntersectionObserver es más confiable que scroll event para este uso:
   * - No requiere calcular alturas manualmente.
   * - Funciona con Lenis smooth scroll sin necesidad de sincronización.
   * - Eficiente: solo dispara en cambios de visibilidad, no en cada frame.
   */
  const navGlobal = document.querySelector<HTMLElement>('[data-nav-global]');

  if (navGlobal) {
    /* El hero tiene aria-label específico — lo buscamos por la sección */
    const heroSection = document.querySelector<HTMLElement>('.hero-v3');

    if (heroSection) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              /* Hero en viewport → nav oculta */
              navGlobal.classList.remove('is-visible');
            } else {
              /* Hero fuera del viewport → nav visible */
              navGlobal.classList.add('is-visible');
            }
          }
        },
        {
          /* threshold:0 → dispara en cuanto el primer pixel del hero sale/entra */
          threshold: 0,
          /* rootMargin negativo: la nav aparece solo cuando el hero salió del todo */
          rootMargin: '0px 0px 0px 0px',
        }
      );

      observer.observe(heroSection);
    } else {
      /*
       * Si no hay hero con .hero-v3 (página interior, etc.),
       * la nav aparece directamente sin animación de reveal.
       */
      navGlobal.classList.add('is-visible');
    }
  }
</script>
