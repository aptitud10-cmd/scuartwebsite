---
/**
 * Nav.astro — Navegacion minima para el hero
 * v2 (i18n): recibe lang + t (traducciones) para selector EN/ES y labels.
 * Nav completo (hamburger mobile, overlay) se implementa en hito siguiente.
 * DESIGN_RESPONSIVE §8: height 72px, transparente, Mono uppercase taupe.
 */

import type { Lang } from '../i18n/index';
import type { Translations } from '../i18n/en';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;
---

<nav class="nav" aria-label="Navegacion principal">
  <a href={`/${lang}`} class="nav__logo" aria-label="SCUART — Inicio">
    SCUART
  </a>

  <div class="nav__right">
    <!-- Placeholder links — se expanden en hito nav completo -->
    <ul class="nav__links" role="list">
      <li><a href={`/${lang}#portfolio`} class="nav__link">{t.nav.portfolio}</a></li>
      <li><a href={`/${lang}#method`} class="nav__link">{t.nav.method}</a></li>
      <li><a href={`/${lang}#contact`} class="nav__link">{t.nav.contact}</a></li>
    </ul>

    <!-- Selector de idioma EN/ES -->
    <div class="nav__lang" role="navigation" aria-label="Selector de idioma">
      <span class="nav__lang-active" aria-current="true">
        {lang.toUpperCase()}
      </span>
      <span class="nav__lang-sep" aria-hidden="true">/</span>
      <a
        href={t.nav.langHref}
        class="nav__lang-other"
        hreflang={t.nav.langLabel.toLowerCase()}
        aria-label={`Cambiar idioma a ${t.nav.langLabel}`}
      >
        {t.nav.langLabel}
      </a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--margin);
    /* Transparente sobre carbon: grain visible a traves */
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  /* Al scrollear, fondo carbon + borde sutil */
  .nav.scrolled {
    background-color: var(--carbon);
    border-bottom-color: var(--linea);
  }

  .nav__logo {
    font-family: var(--font-display);
    font-weight: var(--display-weight-heavy);
    font-variation-settings: 'wdth' var(--display-wdth);
    font-size: 1.125rem;
    letter-spacing: -0.025em;
    color: var(--crema);
    text-decoration: none;
    line-height: 1;
  }

  /* Contenedor derecho: links + selector idioma */
  .nav__right {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .nav__links {
    display: none; /* oculto en mobile — se muestra en tablet+ */
    list-style: none;
    gap: var(--space-m);
    align-items: center;
  }

  .nav__link {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    font-weight: 400;
    color: var(--taupe);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.4;
    position: relative;
    /* Subrayado barrido rojo hover — scaleX 0→1 */
    padding-bottom: 2px;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--rojo);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); /* power2.out */
  }

  .nav__link:hover {
    color: var(--crema);
  }

  .nav__link:hover::after {
    transform: scaleX(1);
  }

  /* ── Selector de idioma ──────────────────────────────────── */
  /*
   * iter.5 (B3 WCAG): opacidad del contenedor eliminada.
   * Antes: opacity:0.65 en mobile hundía #9C978D a ~#6a6761 = 3.42:1 (falla).
   * Ahora: jerarquía discreta se logra por color, no opacity en el padre.
   *   - .nav__lang-active: var(--crema) — el foco, resalta.
   *   - .nav__lang-sep: opacity:0.5 solo en él (aria-hidden, no texto WCAG).
   *   - .nav__lang-other: #9C978D puro = 4.56:1 sobre #0E0E0E → PASA.
   */
  .nav__lang {
    display: flex;
    align-items: center;
    gap: 0.3em;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  /* Idioma activo — crema, no clickeable */
  .nav__lang-active {
    color: var(--crema);
    cursor: default;
  }

  /* Separador / — taupe bajo */
  .nav__lang-sep {
    color: var(--taupe);
    opacity: 0.5;
  }

  /* Idioma alternativo — color elevado para pasar WCAG 4.5:1.
   * B3 FIX: var(--taupe) puro = 4.24:1 sobre #0E0E0E — NO pasa 4.5:1 para texto <14px.
   * Además el contenedor .nav__lang tenía opacity:0.65 (ya eliminada, ver arriba)
   * que lo hundía aún más a 2.86:1. Solución: color propio #9C978D sin opacity
   * heredada = 4.56:1 sobre #0E0E0E (verificado axe-core). PASA en todos los viewports. */
  .nav__lang-other {
    color: #9C978D;
    text-decoration: none;
    transition: color 0.25s ease;
    position: relative;
    padding-bottom: 2px;
  }

  .nav__lang-other::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--rojo);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav__lang-other:hover {
    color: var(--crema);
  }

  .nav__lang-other:hover::after {
    transform: scaleX(1);
  }

  /* Tablet+: mostrar links inline */
  @media (min-width: 768px) {
    .nav__links {
      display: flex;
    }
  }
</style>

<script>
  /**
   * Nav scroll — clase .scrolled al scrollear.
   *
   * Con Lenis activo: escucha el evento 'scroll' de Lenis via el objeto
   * expuesto en window.__lenis. Lenis 1.3+ no usa translateY en el body
   * (mueve el scroll real del documento), por lo que window.scrollY sigue
   * siendo válido. El evento de Lenis es más preciso: se dispara en cada
   * tick del RAF sincronizado, no en el evento nativo del browser.
   *
   * Sin Lenis (reduced-motion o fallo de carga): fallback a window.scroll nativo.
   */
  const nav = document.querySelector('.nav');
  if (nav) {
    const applyScrolled = (y: number) => {
      if (y > 20) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    };

    /*
     * Flag único: garantiza que SOLO se ata una fuente de scroll (Lenis O nativo),
     * nunca las dos. Sin esto había una carrera: si Lenis llega tarde (>200ms en
     * un device lento), el timeout ataba el listener nativo Y después lenis:ready
     * ataba el de Lenis → doble cálculo de .scrolled.
     */
    let connected = false;

    /* Intentar conectar al evento de Lenis. Devuelve true si conectó. */
    const connectLenis = () => {
      if (connected) return true;
      const lenis = (window as unknown as Record<string, unknown>)['__lenis'];
      if (lenis && typeof (lenis as { on?: unknown }).on === 'function') {
        /* Lenis emite { scroll: number, ... } en el evento 'scroll' */
        (lenis as { on: (event: string, cb: (e: { scroll: number }) => void) => void })
          .on('scroll', ({ scroll }: { scroll: number }) => {
            applyScrolled(scroll);
          });
        connected = true;
        return true;
      }
      return false;
    };

    /* Fallback a scroll nativo. No-op si ya hay una fuente atada. */
    const connectNative = () => {
      if (connected) return;
      connected = true;
      window.addEventListener('scroll', () => applyScrolled(window.scrollY), { passive: true });
    };

    /* Si Lenis ya está inicializado (script de Layout corrió primero), listo. */
    if (!connectLenis()) {
      /* Esperar el evento lenis:ready (puede conectar Lenis o no-op si ya conectó). */
      window.addEventListener(
        'lenis:ready',
        () => {
          if (!connectLenis()) connectNative();
        },
        { once: true }
      );

      /* Red de seguridad: si lenis:ready nunca llega (reduced-motion: Lenis no
         se inicializa), atar el nativo a los 200ms. El flag 'connected' evita
         el doble-atado si Lenis termina conectando justo después. */
      setTimeout(connectNative, 200);
    }
  }
</script>
