---
/**
 * StudioSection.astro — "Cómo trabajamos" (proceso, 4 pasos). REDISEÑO 2026-07-26.
 *
 * PROBLEMA: era una lista vertical de 4 pasos con numerales fantasma — mismo
 * molde que Servicios ("larguero"). William pidió movimiento/wow, y que NO se
 * viera igual a Servicios (que ahora usa pin+highlight vertical).
 *
 * SOLUCIÓN (DESIGN_RESEARCH_SERVICIOS_PROCESO_2026-07, mecánica #2):
 * HORIZONTAL SCROLL DENTRO DE VERTICAL. Al llegar a la sección, se pinea y el
 * scroll vertical del usuario se traduce en desplazamiento LATERAL de un track
 * con los 4 pasos (Escuchamos → Definimos → Construimos → Lanzamos). El cambio
 * de EJE respecto a Servicios (que baja) comunica "módulo distinto, secuencia".
 * Una línea de progreso lima marca el avance. Patrón activo en agencias 2026.
 *
 * ⚠️ DESKTOP-ONLY (≥1024px). Regla de William + advertencia del research:
 * el horizontal-scroll es de los patrones más delicados en mobile (falta de
 * affordance) y el pin puede chocar con el body-scroll-container de iOS. TODO
 * el motion horizontal se registra SOLO en ScrollTrigger.matchMedia('(min-width:1024px)').
 * Mobile/tablet (<1024px) = pasos APILADOS con reveal por paso, como ya estaba.
 *
 * COMPOSICIÓN: cada paso = numeral display gigante + verbo + body + "qué cambia".
 */

import type { Translations, MethodStep } from '../i18n/en';

const { t } = Astro.props as { t: Translations };

const howWeWorkLabel: string = t.studio.howWeWorkLabel;
const whatChangesLabel: string = t.method.whatChangesLabel;
const steps: MethodStep[] = t.method.steps;
---

<section class="stu" id="studio" aria-label={howWeWorkLabel} data-stu>
  <div class="stu-head">
    <h2 class="stu-part__label--how">{howWeWorkLabel}</h2>
  </div>

  <!-- Pista horizontal (desktop) / columna apilada (mobile) -->
  <div class="stu-track-wrap" data-stu-wrap>
    <div class="stu-track" data-stu-track>
      {steps.map((step, i) => (
        <article
          class="stu-step"
          data-stu-step
          data-index={i}
          aria-label={`${step.num} ${step.title}`}
        >
          <span class="stu-step__num" aria-hidden="true">{step.num}</span>
          <div class="stu-step__body">
            <h3 class="stu-step__verb" data-step-verb>{step.title}</h3>
            <p class="stu-step__desc">{step.body}</p>
            <p class="stu-step__change">
              <span class="stu-step__change-label">{whatChangesLabel}</span>
              {step.whatChanges}
            </p>
          </div>
        </article>
      ))}
    </div>

    <!-- Línea de progreso (solo desktop, la anima el JS) -->
    <div class="stu-progress" aria-hidden="true" data-stu-progress>
      <span class="stu-progress__fill" data-stu-progress-fill></span>
    </div>
  </div>
</section>

<style>
/* ═══════════════════════════════════════════════════════════
   STUDIO / CÓMO TRABAJAMOS — fondo crema.
   BASE (mobile/tablet <1024px): pasos apilados con reveal.
   DESKTOP (≥1024px): horizontal scroll (track lateral) + progreso.
   ═══════════════════════════════════════════════════════════ */
.stu {
  background-color: var(--bg);
  padding: var(--space-2xl) var(--margin);
  overflow-x: clip;
  scroll-margin-top: 72px;
}

.stu-part__label--how {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  color: var(--ink-62);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  line-height: 1.4;
  margin: 0 0 var(--space-xl) 0;
  padding-bottom: var(--space-s);
  border-bottom: 1px solid var(--hairline);
}

/* ─── TRACK: en mobile es columna; en desktop es fila horizontal ─── */
.stu-track {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.stu-step {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-2xs);
  border-top: 1px solid var(--hairline);
  padding-block: clamp(2rem, 5vh, 3.5rem);
}
.stu-step:last-child { border-bottom: 1px solid var(--hairline); }

.stu-step__num {
  font-family: var(--font-display);
  font-weight: var(--display-weight-light);
  font-size: var(--text-display-watermark);
  line-height: 0.9;
  letter-spacing: -0.03em;
  color: var(--ink-62);
  font-variant-numeric: tabular-nums;
}

.stu-step__verb {
  font-family: var(--font-display);
  font-weight: var(--display-weight-light);
  font-size: var(--text-names);
  line-height: 1.0;
  letter-spacing: -0.025em;
  color: var(--ink);
  margin: clamp(0.5rem, 1.5vh, 1rem) 0 clamp(0.6rem, 1.5vh, 1rem) 0;
}

.stu-step__desc {
  font-family: var(--font-body);
  font-size: var(--text-body);
  color: var(--ink-62);
  line-height: 1.55;
  max-width: 44ch;
  margin: 0 0 clamp(1rem, 2vh, 1.5rem) 0;
}

.stu-step__change {
  font-family: var(--font-body);
  font-size: var(--text-body);
  font-style: italic;
  color: var(--ink);
  line-height: 1.5;
  max-width: 40ch;
  margin: 0;
  padding-top: clamp(0.75rem, 1.5vh, 1.25rem);
  border-top: 1px solid var(--hairline);
}
.stu-step__change-label {
  display: block;
  font-style: normal;
  font-size: var(--text-mono);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--ink-62);
  margin-bottom: 0.4em;
}

.stu-progress { display: none; }

/* ─── reveal base (mobile) — lo aplica el JS ─── */
.stu-animate-base .stu-step { opacity: 0; transform: translateY(24px); }

/* ═══════════════════════════════════════════════════════════
   DESKTOP ≥1024px — HORIZONTAL SCROLL.
   El wrap se pinea; el track se desliza en X con el scroll vertical.
   Cada paso ocupa ~una pantalla; línea de progreso lima abajo.
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 1024px) {
  .stu { padding-bottom: 0; overflow: hidden; }

  .stu-head { padding-bottom: var(--space-l); }

  .stu-track-wrap {
    position: relative;
  }

  .stu-track {
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 0;
    /* el ancho real lo da la suma de los pasos; el JS calcula el desplazamiento */
    width: max-content;
    align-items: stretch;
  }

  .stu-step {
    /* cada paso ocupa una franja ancha de la pantalla */
    width: clamp(30rem, 46vw, 44rem);
    min-height: 82vh;
    border-top: none;
    border-left: 1px solid var(--hairline);
    padding: clamp(3rem, 6vh, 5rem) clamp(2.5rem, 5vw, 5rem);
    display: grid;
    grid-template-rows: auto 1fr;
    align-content: start;
    gap: clamp(1.5rem, 4vh, 3rem);
  }
  .stu-step:last-child { border-bottom: none; }
  .stu-step:first-child { border-left: none; padding-left: 0; }

  .stu-step__num {
    /* font-size lo da el token base */
    line-height: 0.72;
    color: rgba(20, 19, 15, 0.14);
    /* el numeral gigante como marca de agua del paso */
    align-self: start;
  }

  .stu-step__verb {
    /* font-size lo da el token base */
    margin-top: 0;
  }

  .stu-step__body { align-self: start; }

  /* Línea de progreso — fija abajo del viewport pineado */
  .stu-progress {
    display: block;
    position: absolute;
    left: 0;
    bottom: clamp(2rem, 5vh, 4rem);
    width: 100%;
    height: 2px;
    background: var(--hairline);
  }
  .stu-progress__fill {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--brand);
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* en desktop el reveal-base no aplica (manda el pin horizontal) */
  .stu-animate-base .stu-step { opacity: 1; transform: none; }
}

/* ─── reduced-motion: todo estático y visible ─── */
@media (prefers-reduced-motion: reduce) {
  .stu-animate-base .stu-step { opacity: 1 !important; transform: none !important; }
  .stu-progress__fill { transform: scaleX(1) !important; }
  @media (min-width: 1024px) {
    /* sin horizontal scroll: los pasos vuelven a columna legible */
    .stu-track { flex-direction: column; width: auto; }
    .stu-step { width: auto; min-height: 0; border-left: none; border-top: 1px solid var(--hairline); padding-inline: 0; }
    .stu-step:first-child { padding-left: 0; }
  }
}
</style>

<script>
  /**
   * Cómo trabajamos — dos vías por ancho (ScrollTrigger.matchMedia):
   *   ≥1024px: horizontal scroll — pin del wrap, track se desliza en X con el
   *     scroll vertical, línea de progreso lima se llena. Cambio de eje respecto
   *     a Servicios (vertical) → "módulo distinto".
   *   <1024px: reveal por paso (apilado). Igual que antes. NO toca el scroll de iOS.
   */

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.querySelector<HTMLElement>('[data-stu]');
  const wrap = document.querySelector<HTMLElement>('[data-stu-wrap]');
  const track = document.querySelector<HTMLElement>('[data-stu-track]');

  if (section && wrap && track && !prefersReduced) {
    (async () => {
      try {
        const { gsap } = await import('gsap');
        const { ScrollTrigger } = await import('gsap/ScrollTrigger');
        const { SplitText } = await import('gsap/SplitText');
        gsap.registerPlugin(ScrollTrigger, SplitText);

        const steps = gsap.utils.toArray<HTMLElement>('[data-stu-step]');
        const fill = section.querySelector<HTMLElement>('[data-stu-progress-fill]');

        ScrollTrigger.matchMedia({
          /* ─────────── DESKTOP ≥1024px: horizontal scroll ─────────── */
          '(min-width: 1024px)': () => {
            /* distancia a desplazar en X = ancho del track menos un viewport */
            const getDistance = () => track.scrollWidth - window.innerWidth;

            const tween = gsap.to(track, {
              x: () => -getDistance(),
              ease: 'none',
              scrollTrigger: {
                trigger: wrap,
                start: 'top top',
                end: () => '+=' + getDistance(),
                pin: true,
                scrub: 0.8,
                invalidateOnRefresh: true,
                onUpdate: (self) => {
                  if (fill) gsap.set(fill, { scaleX: self.progress });
                },
              },
            });

            /* Cada verbo hace line-mask reveal al entrar en X (batch por paso) */
            steps.forEach((step) => {
              const verb = step.querySelector<HTMLElement>('[data-step-verb]');
              if (!verb) return;
              const split = new SplitText(verb, { type: 'lines', mask: 'lines', autoSplit: true, aria: 'none' });
              gsap.set(split.lines, { yPercent: 0 });
              ScrollTrigger.create({
                trigger: step,
                containerAnimation: tween,
                start: 'left 70%',
                once: true,
                onEnter: () => {
                  gsap.from(split.lines, { yPercent: 115, duration: 0.9, ease: 'expo.out', stagger: 0.08 });
                },
              });
            });

            return () => { tween.scrollTrigger?.kill(); tween.kill(); gsap.set(track, { x: 0 }); };
          },

          /* ─────────── MOBILE/TABLET <1024px: reveal apilado ─────────── */
          '(max-width: 1023px)': () => {
            section.classList.add('stu-animate-base');
            const triggers = steps.map((step, i) =>
              ScrollTrigger.create({
                trigger: step,
                start: 'top 82%',
                once: true,
                onEnter: () => {
                  gsap.to(step, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', delay: i * 0.05 });
                },
              }),
            );
            return () => { triggers.forEach((t) => t.kill()); };
          },
        });
      } catch (err) {
        console.error('[StudioSection] motion init failed:', err);
        document.querySelectorAll<HTMLElement>('[data-stu-step]').forEach((s) => {
          s.style.opacity = '1';
          s.style.transform = 'none';
        });
      }
    })();
  }
</script>
