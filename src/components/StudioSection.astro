---
/**
 * StudioSection.astro — Sección "Estudio / Studio"
 * Fusión de CapabilitiesSection + MethodSection (William 2026-06-18).
 *
 * ESTRUCTURA:
 *   Parte 1 — QUÉ HACEMOS / WHAT WE DO
 *     Tres declaraciones PP Editorial New centradas, mask-reveal por scroll.
 *     Numeral anclado al margen izquierdo (absoluto en tablet+, estático en mobile).
 *     Barra lima scaleX 0→1 post-reveal.
 *
 *   MARQUEE DIVISOR — nombres de servicio corriendo infinito.
 *     Velocidad reactiva a Lenis velocity (frena/acelera con el scroll).
 *
 *   Parte 2 — CÓMO TRABAJAMOS / HOW WE WORK
 *     4 pasos del proceso (de method.steps).
 *     Numerales 001-004 + título + body + "qué cambia".
 *     whatChanges: PP Editorial New itálica + hairline corto derecha.
 *     Pin GSAP de columna de numerales en desktop ≥1280px (conservado).
 *
 * TOKENS V4 BLANCO ACTIVOS (NO modificar):
 *   --bg, --ink, --ink-62, --ink-18, --brand, --hairline,
 *   --font-display, --font-body, --text-mono, --text-body.
 *
 * RESPONSIVE:
 *   Mobile (375px): numeral estático arriba-izquierda, declaración centrada.
 *   Tablet (768px): numeral absoluto al margen, más aire.
 *   Desktop (1280px): declaración más grande + proceso con pin.
 *   prefers-reduced-motion: todo estático y visible.
 */

import type { Translations, CapabilityService, MethodStep } from '../i18n/en';

const { t } = Astro.props as { t: Translations };

const kicker: string = t.studio.kicker;
const howWeWorkLabel: string = t.studio.howWeWorkLabel;

const items: CapabilityService[] = t.capabilities.items;
const steps: MethodStep[] = t.method.steps;
---

<section
  class="stu"
  id="studio"
  aria-label={kicker}
>

  <!-- ═══════════════════════════════════════════════
       MARQUEE DIVISOR — nombres de servicio corriendo infinito.
       Velocidad reactiva a Lenis (frena/acelera con el scroll).
       aria-hidden: contenido decorativo, no semántico.
       ═══════════════════════════════════════════════ -->
  <div class="stu-marquee" aria-hidden="true" data-stu-marquee>
    <div class="stu-marquee__track" data-stu-marquee-track>
      {[0, 1].map(() => (
        <span class="stu-marquee__group">
          {items.map((item) => (
            <>
              <span class="stu-marquee__item">{item.name}</span>
              <span class="stu-marquee__dot">·</span>
            </>
          ))}
        </span>
      ))}
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════
       PARTE 2 — CÓMO TRABAJAMOS (4 verbos-acción)
       Rediseño 2026-07-17 (aprobado por William sobre demo):
       verbo serif gigante protagonista + número discreto + descripción.
       Motion: line-mask reveal del verbo (SplitText, expo.out) +
       entrada escalonada del paso (y + blur). Sin pin, sin numerales
       fantasma — restraint (research motion Locomotive).
       ═══════════════════════════════════════════════ -->
  <div class="stu-part" id="studio-how">
    <p class="stu-part__label stu-part__label--how">{howWeWorkLabel}</p>

    <div class="stu-proc" data-stu-proc>
      {steps.map((step, i) => (
        <div
          class="stu-proc__step"
          data-step-index={i}
          role="article"
          aria-label={`${step.num} ${step.title}`}
        >
          <span class="stu-proc__num" aria-hidden="true">{step.num}</span>
          <div class="stu-proc__body-wrap">
            <h3 class="stu-proc__verb" data-proc-verb>{step.title}</h3>
            <p class="stu-proc__desc">{step.body}</p>
          </div>
          <!-- Numeral fantasma al margen derecho — llena el ancho desktop
               con intención (fix visual-critic: asimetría decidida, no vacío) -->
          <span class="stu-proc__ghost" aria-hidden="true">{step.num}</span>
        </div>
      ))}
    </div>
  </div>

</section>

<style>
/* ═══════════════════════════════════════════════════════════
   STUDIO SECTION — Art direction V5.
   Parte 1: numeral al margen + declaración serif centrada + mask-reveal.
   Parte 2: proceso con pin de numerales en desktop.
   Mobile-first: 375px → 768px → 1280px.
   ═══════════════════════════════════════════════════════════ */

.stu {
  background-color: var(--bg);
  isolation: isolate;
  padding-top: var(--space-xl);
  padding-bottom: var(--space-2xl);
  padding-left: var(--margin);
  padding-right: var(--margin);
  position: relative;
  overflow-x: clip;
  scroll-margin-top: 72px;
}

/* ─── PARTES ─────────────────────────────────────────────── */

.stu-part {
  margin-bottom: calc(var(--space-2xl) * 1.5);
}

.stu-part:last-child {
  margin-bottom: 0;
}

.stu-part__label {
  display: none;
}

.stu-part__label--how {
  display: block;
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  color: var(--ink-62);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  line-height: 1.4;
  margin: 0 0 var(--space-xl) 0;
  padding-bottom: var(--space-s);
  border-bottom: 1px solid var(--hairline);
}


/* ═══════════════════════════════════════════════════════════
   MARQUEE DIVISOR — entre Parte 1 y Parte 2
   Velocidad reactiva a Lenis via JS (--marquee-speed custom prop).
   ═══════════════════════════════════════════════════════════ */

.stu-marquee {
  overflow: hidden;
  border-top: 1px solid var(--hairline);
  border-bottom: 1px solid var(--hairline);
  padding: var(--space-s) 0;
  margin-bottom: calc(var(--space-2xl) * 1.5);
  position: relative;
}

.stu-marquee__track {
  display: flex;
  width: max-content;
  will-change: transform;
}

.stu-marquee__group {
  display: flex;
  align-items: center;
  gap: var(--space-l);
  padding-right: var(--space-l);
  flex-shrink: 0;
}

.stu-marquee__item {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(1.5rem, 4vw, 3.5rem);
  letter-spacing: -0.02em;
  color: var(--ink);
  white-space: nowrap;
  line-height: 1;
}

.stu-marquee__dot {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  color: var(--ink-62); /* --ink-42 daba 2.7:1 — AA pide 4.5:1 (QA 2026-07-21) */
  font-weight: 500;
  flex-shrink: 0;
}

/* ═══════════════════════════════════════════════════════════
   PARTE 2 — PROCESO (verbos-acción, mobile first)
   Verbo serif protagonista + número discreto + descripción.
   Hairlines entre pasos. Sin numerales fantasma, sin pin.
   IMPORTANTE: sin opacity:0 en CSS base — el estado oculto lo
   aplica solo el JS (progressive enhancement).
   ═══════════════════════════════════════════════════════════ */

.stu-proc {
  display: flex;
  flex-direction: column;
}

.stu-proc__step {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-2xs);
  border-top: 1px solid var(--hairline);
  padding-block: clamp(2rem, 5vh, 3.5rem);
}

.stu-proc__step:last-child {
  border-bottom: 1px solid var(--hairline);
}

.stu-proc__num {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 400;
  letter-spacing: 0.1em;
  color: var(--ink-62); /* 42% daba 2.7:1 sobre crema — WCAG AA pide 4.5:1 (QA 2026-07-21) */
  font-variant-numeric: tabular-nums;
}

.stu-proc__verb {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(2.25rem, 5.5vw, 4.5rem);
  line-height: 1.0;
  letter-spacing: -0.025em;
  color: var(--ink);
  margin: 0 0 clamp(0.75rem, 1.5vh, 1.25rem) 0;
}

.stu-proc__desc {
  font-family: var(--font-body);
  font-size: var(--text-body);
  font-weight: 400;
  color: var(--ink-62);
  line-height: 1.55;
  max-width: 44ch;
  margin: 0;
}

/* Numeral fantasma — solo tablet/desktop. Llena el margen derecho
   con la marca de agua tipográfica del paso (--ink-18, gigante). */
.stu-proc__ghost {
  display: none;
}

/* ═══════════════════════════════════════════════════════════
   TABLET/DESKTOP (768px+): número en columna propia, alineado
   a la primera línea del verbo — asimetría editorial.
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 768px) {
  .stu {
    padding-top: var(--space-2xl);
    padding-bottom: calc(var(--space-2xl) * 1.5);
  }

  .stu-proc__step {
    grid-template-columns: 4rem 1fr auto;
    gap: clamp(1rem, 3vw, 3rem);
    align-items: baseline;
  }

  .stu-proc__num {
    padding-top: 0.4em;
  }

  .stu-proc__ghost {
    display: block;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(8rem, 16vw, 15rem);
    line-height: 0.75;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    /* 18% daba 1.46:1 — texto display necesita 3:1 (WCAG AA texto grande).
       42% ≈ 3.1:1: sigue siendo fantasma, pero pasa el gate. */
    color: var(--ink-42);
    align-self: center;
    justify-self: end;
    user-select: none;
    pointer-events: none;
  }
}

@media (min-width: 1280px) {
  .stu {
    padding-top: calc(var(--space-2xl) * 1.5);
    padding-bottom: calc(var(--space-2xl) * 1.5);
  }

  #studio-how {
    padding-bottom: 0;
    margin-bottom: 0;
  }
}

/* ─── reduced-motion: todo estático ─────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .stu-proc__step { opacity: 1 !important; transform: none !important; filter: none !important; }
}
</style>

<script>
  /**
   * StudioSection — scripts de interactividad.
   *
   * PARTE 1 — About (mecanismo real de trionn.com/about):
   *   Reveal por BLUR + OPACITY (el que usa Trionn: will-change:filter,opacity).
   *   La frase entra desenfocada y se enfoca; anotaciones fade-up.
   *   El video de fondo se reproduce solo (autoplay muted loop).
   *   Progressive enhancement: sin GSAP → todo visible nítido
   *   (el estado oculto lo aplica SOLO el JS, no el CSS).
   *
   * PARTE 2 — Pasos del proceso (INTACTO):
   *   DESKTOP (≥1280px): GSAP ScrollTrigger pin de columna de numerales.
   *   MOBILE/TABLET (<1280px): GSAP ScrollTrigger reveal por paso.
   *
   * prefers-reduced-motion: sin nada — todo visible estático.
   */

  const reducedMotionPart1 = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ─── MARQUEE DIVISOR: velocidad reactiva a Lenis ─────── */

  if (!reducedMotionPart1) {
    try {
      const track = document.querySelector<HTMLElement>('[data-stu-marquee-track]');
      if (!track) throw new Error('no track');

      const getGroupWidth = () => track.scrollWidth / 2;

      let x = 0;
      let speed = 0.5;
      let targetSpeed = speed;

      let lenisVelocity = 0;
      const lenisEl = (window as any).__lenis;
      if (lenisEl) {
        lenisEl.on('scroll', (e: any) => {
          lenisVelocity = e.velocity;
        });
      }

      const animate = () => {
        const velocityBoost = Math.abs(lenisVelocity) * 0.08;
        targetSpeed = 0.5 + velocityBoost;
        speed += (targetSpeed - speed) * 0.08;

        x -= speed;
        const groupW = getGroupWidth();
        if (Math.abs(x) >= groupW) x += groupW;

        track.style.transform = `translateX(${x}px)`;
        raf = requestAnimationFrame(animate);
      };

      let raf = requestAnimationFrame(animate);

      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      const { gsap } = await import('gsap');
      gsap.registerPlugin(ScrollTrigger);

      ScrollTrigger.create({
        trigger: '[data-stu-marquee]',
        start: 'top bottom',
        end: 'bottom top',
        onEnter: () => { if (!raf) raf = requestAnimationFrame(animate); },
        onLeave: () => { cancelAnimationFrame(raf); raf = 0; },
        onEnterBack: () => { if (!raf) raf = requestAnimationFrame(animate); },
        onLeaveBack: () => { cancelAnimationFrame(raf); raf = 0; },
      });

    } catch (err) {
      // Sin marquee si falla — no es crítico, pero logueamos para no tragar el error
      console.error('[StudioSection marquee] init failed:', err);
    }
  }

  /* ─── PARTE 2: proceso — motion premium (research 2026) ───
     Cada paso entra escalonado (y + blur, power3.out) y el verbo
     hace line-mask reveal (SplitText, yPercent 110, expo.out).
     once:true — los reveals de entrada no rebobinan. */

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion) {
    try {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      const { SplitText } = await import('gsap/SplitText');
      gsap.registerPlugin(ScrollTrigger, SplitText);

      const procSteps = document.querySelectorAll<HTMLElement>('.stu-proc__step');

      procSteps.forEach((step, i) => {
        /* Entrada del paso: y + blur sutil, escalonada por índice.
           gsap.from DENTRO de onEnter — sin estado oculto persistente:
           si el trigger no dispara, el paso queda visible (robustez). */
        ScrollTrigger.create({
          trigger: step,
          start: 'top 82%',
          once: true,
          onEnter: () => {
            gsap.from(step, {
              opacity: 0,
              y: 24,
              filter: 'blur(4px)',
              duration: 0.7,
              ease: 'power3.out',
              delay: i * 0.06,
              onComplete: () => { step.style.filter = ''; },
            });

            /* Verbo: line-mask reveal — la línea sube desde su máscara */
            const verb = step.querySelector<HTMLElement>('[data-proc-verb]');
            if (verb) {
              const split = new SplitText(verb, {
                type: 'lines',
                mask: 'lines',
                autoSplit: true,
                aria: 'none',
              });
              gsap.from(split.lines, {
                yPercent: 110,
                duration: 1.0,
                ease: 'expo.out',
                stagger: 0.1,
                force3D: true,
              });
            }
          },
        });
      });

    } catch (err) {
      /* Si GSAP falla → pasos visibles (el estado oculto lo puso este JS) */
      console.error('[StudioSection proceso] motion init failed:', err);
      document.querySelectorAll<HTMLElement>('.stu-proc__step').forEach((s) => {
        s.style.opacity = '1';
        s.style.transform = 'none';
        s.style.filter = 'none';
      });
    }
  }
</script>
