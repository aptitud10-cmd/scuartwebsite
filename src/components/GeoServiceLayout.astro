---
/**
 * GeoServiceLayout.astro — Página de servicio AI Visibility · GEO.
 *
 * Estructura answer-first (SERVICIO-GEO-SCUART.md + HANDOFF-GEO-LANDING.md):
 * cada sección responde una pregunta real de cliente, de modo que la propia
 * página sea citable por motores generativos (comerse la propia medicina).
 *
 * Precios: base en USD (mercado LATAM + USA + España). Un hint client-side
 * muestra el aproximado en la moneda local según el timezone del visitante
 * (sin APIs externas, sin geolocalización — privacidad y cero dependencias).
 *
 * Checker (lead magnet): el visitante pega su URL → se abre WhatsApp con el
 * pedido armado. v1 sin backend a propósito; se automatiza si hay volumen.
 *
 * Sigue el sistema visual del sitio (mismos tokens que CaseStudyLayout):
 * kicker mono · display serif hairline · hairlines · reveal on scroll.
 */

import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import FooterSection from './FooterSection.astro';
import type { Translations } from '../i18n/en';
import { SITE_URL } from '../i18n/index';

const EMAIL = 'info@scuart.com';

interface Stat {
  num: string;
  note: string;
}

interface Tier {
  num: string;
  name: string;
  /** Monto base en USD (número, para el hint de moneda local) */
  priceUSD: number;
  /** "Desde" / "From" — vacío si es precio cerrado */
  pricePrefix?: string;
  /** "pago único" / "one time" / "/ mes" */
  priceSuffix: string;
  body: string;
  includesLabel: string;
  includes: string[];
}

interface FaqItem {
  q: string;
  a: string;
}

export interface GeoServiceData {
  kicker: string;
  heading: string;
  tagline: string;
  cta: string;
  /** sourceNote: atribución visible de las cifras (P4 — sin números huérfanos) */
  shift: { label: string; body: string; stats: Stat[]; sourceNote: string };
  whatIs: { label: string; body: string };
  whyNot: { label: string; items: { title: string; body: string }[] };
  /* OPCIONAL desde 2026-08-10: este layout dejó de ser exclusivo de GEO y ahora
     sirve a todas las páginas de servicio. `engines` (los motores de IA que se
     auditan) solo aplica a GEO — el resto de los servicios omite el campo y la
     sección no se renderiza. */
  engines?: { label: string; body: string; primary: string[]; secondary: string };
  how: { label: string; tiers: Tier[] };
  /* OPCIONAL — "La prueba", solo en GEO.
     REEMPLAZA AL CHECKER AUTOMÁTICO (2026-08-14). El anterior analizaba el HTML
     del visitante y devolvía un score técnico. Se sacó por tres razones, todas
     con fuente:

     1. MEDÍA LO QUE NO FUNCIONA. Ahrefs trackeó 1.885 páginas que agregaron
        JSON-LD (ago 2025–mar 2026) contra ~4.000 de control: ningún uplift
        significativo, y en Google AI Overviews −4,6%. El checker le decía a la
        gente "te falta schema" — un consejo que la evidencia de 2026 no
        respalda. Lo que sí correlaciona son las menciones de terceros (0,664
        contra 0,218 de los backlinks, Ahrefs sobre 75.000 marcas), y eso NO
        vive en el HTML del propio sitio.

     2. ERA COMMODITY. Insites, AuditSky, Sophyx, GoVISIBLE y Semrush venden
        exactamente ese widget white-label a cualquier agencia. Cero
        diferenciación, y como no pedía contacto, tampoco capturaba el lead.

     3. SE PARECÍA A UNA ESTAFA CONOCIDA. El patrón documentado del "AI
        Visibility Audit Scam" (Ritner Digital, may 2026) es: score automático
        vago + hallazgos técnicos genéricos + informe de $100-200. Un dueño que
        leyó sobre eso no distinguía esta página de la de un estafador.

     Y sobre todo: el visitante llega preguntando "¿aparezco en ChatGPT?" y
     recibía una auditoría de robots.txt. Ninguna agencia seria hace esto —
     GeoAgencia no ofrece herramienta y cobra la auditoría; Ignite la regala
     pero la hace UNA PERSONA y tarda 2-3 días. Esa fricción es justamente lo
     que la separa del spam.

     Lo que hay ahora es esa prueba manual: el visitante deja su negocio y
     nosotros corremos los prompts a mano. Sin score, sin API, sin costo por
     uso — y es lo que Ritner define como auditoría legítima ("live query
     testing"). */
  proof?: {
    label: string;
    body: string;
    /** Los tres resultados posibles, en el lenguaje del dueño del negocio */
    outcomes: { title: string; body: string }[];
    /** Qué se pide: negocio, zona y rubro — NO una URL */
    fields: { name: string; label: string; placeholder: string }[];
    button: string;
    /** Qué pasa después de enviar: plazo y forma de entrega */
    note: string;
    /** Mensaje de WhatsApp; los datos del formulario se concatenan */
    waMessage: string;
  };
  forWhom: {
    label: string;
    yesLabel: string;
    yes: string[];
    noLabel: string;
    no: string[];
  };
  /* OPCIONAL — "la prueba". Un servicio sin caso publicado todavía omite el campo
     en vez de mostrar una sección que anuncia que no hay prueba. */
  evidence?: { label: string; body: string };
  faq: { label: string; items: FaqItem[] };
  closing: { statement: string; emailLabel: string; whatsappLabel: string };
}

interface Props {
  t: Translations;
  lang: 'es' | 'en';
  data: GeoServiceData;
  title: string;
  description: string;
  canonicalURL: string;
  alternates: { en: string; es: string; xDefault: string };
}

const { t, lang, data, title, description, canonicalURL, alternates } = Astro.props;

/* Nombre del servicio para el JSON-LD, derivado del kicker.
   BUG CORREGIDO 2026-08-14: `name` y `serviceType` estaban HARDCODEADOS como
   "AI Visibility (GEO)" en este layout compartido, así que las SIETE páginas de
   servicio se declaraban ante Google y los motores generativos como si todas
   fueran el servicio de GEO — cada una con los precios de otra. En un sitio que
   vende justamente visibilidad en IA, era el error más caro posible: el dato
   estructurado contradecía al producto.

   Se deriva del kicker ("SERVICIO N°01 — WEB PLATFORMS" → "WEB PLATFORMS") para
   no tener que tocar las 14 páginas; si el formato del kicker cambiara, el
   fallback es el kicker completo, nunca un nombre de otro servicio. */
const serviceName = (data.kicker.split('—').pop() ?? data.kicker).trim();

/* JSON-LD Service: declara la oferta ante buscadores y motores generativos. */
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: serviceName,
  /* serviceType solo cuando ES el servicio de GEO — es un término de industria
     concreto, no una etiqueta genérica que aplique a los siete. */
  ...(data.proof ? { serviceType: 'Generative Engine Optimization' } : {}),
  description,
  url: canonicalURL,
  inLanguage: lang,
  provider: { '@type': 'Organization', '@id': `${SITE_URL}/#organization`, name: 'SCUART' },
  areaServed: ['US', 'CO', 'MX', 'PE', 'CL', 'AR', 'ES'],
  offers: data.how.tiers.map((tier) => ({
    '@type': 'Offer',
    name: tier.name,
    price: tier.priceUSD,
    priceCurrency: 'USD',
  })),
};

/* FAQPage: las preguntas reales de la sección FAQ, citables por la SERP y por LLMs. */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const servicesLabel = lang === 'es' ? 'Servicios' : 'Services';
const homeUrl = `${SITE_URL}/${lang}`;
/* Destino del CTA del hero: el ancla #la-prueba SOLO existe cuando la página
   trae bloque `checker` (hoy solo AI Visibility). En las demás páginas de
   servicio ese ancla no existe y el botón no llevaba a ningún lado — apuntamos
   a la sección de contacto de la home, que siempre existe.

   RUTA RELATIVA, no homeUrl (corregido 2026-08-12): homeUrl se arma con
   SITE_URL = https://scuart.com, que es correcto para el JSON-LD del breadcrumb
   pero NO para un href de navegación — en local y en los previews de Vercel el
   botón expulsaba al visitante al sitio de producción. */
const heroCtaHref = data.proof ? '#la-prueba' : `/${lang}#contact`;
/* ── ÍNDICE DE SERVICIOS (2026-08-12) ────────────────────────────────
   Al terminar de leer un servicio no había ningún camino hacia los otros:
   el único cierre era email + WhatsApp, así que para ver otro servicio había
   que volver al nav (reporte de William).

   La lista NO se declara acá: se deriva de `capabilities.items`, que ya es la
   fuente de verdad de los 7 servicios en la home (num, name, href) y existe
   completa en ES y EN. Así, agregar un servicio al diccionario lo suma a la
   navegación de las 7 páginas sin tocar este layout.

   `current` se detecta comparando el href de cada item con la URL de la página.
   Se normaliza la barra final porque el sitio usa trailingSlash: 'never' pero
   Astro.url.pathname puede traerla según el contexto. */
const allServices = (t.capabilities?.items ?? []).filter((s: any) => s.href);
const stripSlash = (u: string) => u.replace(/\/+$/, '');
const currentPath = stripSlash(Astro.url.pathname);
const currentIdx = allServices.findIndex((s: any) => stripSlash(s.href) === currentPath);
const otherServices = allServices.filter((_: any, i: number) => i !== currentIdx);
/* El siguiente en orden circular — el destino primario, mismo gesto que el
   "SIGUIENTE" de las páginas de caso. */
const nextService = allServices.length > 1
  ? allServices[(currentIdx + 1) % allServices.length]
  : null;

const navCopy = lang === 'es'
  ? { next: 'SIGUIENTE SERVICIO', all: 'TODOS LOS SERVICIOS', other: 'OTROS SERVICIOS' }
  : { next: 'NEXT SERVICE', all: 'ALL SERVICES', other: 'OTHER SERVICES' };

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'SCUART', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: servicesLabel, item: `${homeUrl}#services` },
    /* Mismo bug que en serviceSchema: estaba fijo en "AI Visibility · GEO"
       para las 7 páginas. */
    { '@type': 'ListItem', position: 3, name: serviceName, item: canonicalURL },
  ],
};

const whatsappHref = t.contact.whatsappHref;

/* Numeración editorial de bloques, en orden de render */
let n = 0;
const num = () => String(++n).padStart(2, '0');

const usd = (v: number) => `$${v.toLocaleString('en-US')} USD`;
---

<Layout
  title={title}
  description={description}
  lang={lang}
  canonicalURL={canonicalURL}
  alternates={alternates}
>
  <Nav lang={lang} t={t} />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

  <article class="geo" data-wa-base={whatsappHref}>

    <!-- ── HERO tipográfico ─────────────────────────────────── -->
    <header class="geo-hero">
      <p class="geo-kicker">{data.kicker}</p>
      <h1 class="geo-hero__heading">{data.heading}</h1>
      <p class="geo-hero__tagline">{data.tagline}</p>
      <a class="geo-cta" href={heroCtaHref}>
        {data.cta} <span aria-hidden="true">{data.proof ? '↓' : '→'}</span>
      </a>
    </header>

    <!-- ── El cambio de comportamiento — datos, no opinión ──── -->
    <section class="geo-block" data-geo-reveal>
      <span class="geo-num">{num()}</span>
      <h2 class="geo-label">{data.shift.label}</h2>
      <div class="geo-col3">
        <p class="geo-body">{data.shift.body}</p>
        <div class="geo-stats">
          {data.shift.stats.map((s) => (
            <div class="geo-stat">
              <span class="geo-stat__num">{s.num}</span>
              <span class="geo-stat__note">{s.note}</span>
            </div>
          ))}
        </div>
        <p class="geo-note">{data.shift.sourceNote}</p>
      </div>
    </section>

    <!-- ── Qué es GEO ───────────────────────────────────────── -->
    <section class="geo-block" data-geo-reveal>
      <span class="geo-num">{num()}</span>
      <h2 class="geo-label">{data.whatIs.label}</h2>
      <p class="geo-body">{data.whatIs.body}</p>
    </section>

    <!-- ── Por qué no apareces ──────────────────────────────── -->
    <section class="geo-block" data-geo-reveal>
      <span class="geo-num">{num()}</span>
      <h2 class="geo-label">{data.whyNot.label}</h2>
      <div class="geo-causes">
        {data.whyNot.items.map((item) => (
          <div class="geo-cause">
            <h3 class="geo-cause__title">{item.title}</h3>
            <p class="geo-body">{item.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Los motores que auditamos (solo GEO) ─────────────── -->
    {data.engines && (
      <section class="geo-block" data-geo-reveal>
        <span class="geo-num">{num()}</span>
        <h2 class="geo-label">{data.engines.label}</h2>
        <div class="geo-col3">
          <p class="geo-body">{data.engines.body}</p>
          <ul class="geo-engines">
            {data.engines.primary.map((e) => (
              <li class="geo-engine">{e}</li>
            ))}
          </ul>
          <p class="geo-note">{data.engines.secondary}</p>
        </div>
      </section>
    )}

    <!-- ── Cómo funciona — escalones con precio USD + hint local ── -->
    <section class="geo-block" data-geo-reveal>
      <span class="geo-num">{num()}</span>
      <h2 class="geo-label">{data.how.label}</h2>
      <ol class="geo-tiers">
        {data.how.tiers.map((tier) => (
          <li class="geo-tier">
            <span class="geo-num">{tier.num}</span>
            <h3 class="geo-tier__name">{tier.name}</h3>
            <p class="geo-tier__price">
              {tier.pricePrefix ? `${tier.pricePrefix} ` : ''}{usd(tier.priceUSD)} · {tier.priceSuffix}
              <span class="geo-tier__local" data-usd={tier.priceUSD} data-prefix={tier.pricePrefix ?? ''}></span>
            </p>
            <p class="geo-body">{tier.body}</p>
            <p class="geo-includes__label">{tier.includesLabel}</p>
            <ul class="geo-includes">
              {tier.includes.map((inc) => (
                <li>{inc}</li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <!-- ── La prueba — chequeo manual de prompts reales (solo GEO) ─────
         Sin endpoint ni JS de análisis: el formulario arma un mensaje de
         WhatsApp con los datos. El trabajo lo hace una persona. Ver la nota
         larga en la interfaz `proof` para por qué reemplazó al checker. -->
    {data.proof && (
      <section class="geo-block geo-proof" id="la-prueba" data-geo-reveal>
        <span class="geo-num">{num()}</span>
        <h2 class="geo-label">{data.proof.label}</h2>
        <div class="geo-col3">
          <p class="geo-body">{data.proof.body}</p>

          <!-- Los tres resultados posibles. Es el corazón de la sección: le
               da al dueño un marco para entender su situación ANTES de pedir
               nada, en su idioma y sin una sola palabra técnica. -->
          <ol class="geo-proof__outcomes">
            {data.proof.outcomes.map((o) => (
              <li class="geo-proof__outcome">
                <p class="geo-proof__outcome-title">{o.title}</p>
                <p class="geo-proof__outcome-body">{o.body}</p>
              </li>
            ))}
          </ol>

          <form class="geo-proof__form" data-geo-proof data-wa-message={data.proof.waMessage}>
            {data.proof.fields.map((f) => (
              <label class="geo-proof__field">
                <span class="geo-proof__label">{f.label}</span>
                <input
                  class="geo-proof__input"
                  type="text"
                  name={f.name}
                  placeholder={f.placeholder}
                  required
                />
              </label>
            ))}
            <button class="geo-proof__btn" type="submit">
              {data.proof.button} <span aria-hidden="true">→</span>
            </button>
          </form>
          <p class="geo-note">{data.proof.note}</p>
        </div>
      </section>
    )}

    <!-- ── Para quién es (y para quién no) ──────────────────── -->
    <section class="geo-block" data-geo-reveal>
      <span class="geo-num">{num()}</span>
      <h2 class="geo-label">{data.forWhom.label}</h2>
      <div class="geo-forwhom">
        <div>
          <p class="geo-includes__label">{data.forWhom.yesLabel}</p>
          <ul class="geo-includes">
            {data.forWhom.yes.map((y) => (
              <li>{y}</li>
            ))}
          </ul>
        </div>
        <div>
          <p class="geo-includes__label">{data.forWhom.noLabel}</p>
          <ul class="geo-includes geo-includes--no">
            {data.forWhom.no.map((x) => (
              <li>{x}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ── Evidencia — opcional: se omite si el servicio aún no tiene prueba ── -->
    {data.evidence && (
      <section class="geo-block" data-geo-reveal>
        <span class="geo-num">{num()}</span>
        <h2 class="geo-label">{data.evidence.label}</h2>
        <p class="geo-body geo-evidence">{data.evidence.body}</p>
      </section>
    )}

    <!-- ── FAQ answer-first ─────────────────────────────────── -->
    <section class="geo-block" data-geo-reveal>
      <span class="geo-num">{num()}</span>
      <h2 class="geo-label">{data.faq.label}</h2>
      <dl class="geo-faq">
        {data.faq.items.map((f) => (
          <div class="geo-faq__item">
            <dt class="geo-faq__q">{f.q}</dt>
            <dd class="geo-faq__a">{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- ── Cierre + contacto directo (email + WhatsApp) ─────── -->
    <section class="geo-closing" data-geo-reveal>
      <p class="geo-closing__statement">{data.closing.statement}</p>
      <div class="geo-closing__channels">
        <a class="geo-cta" href={`mailto:${EMAIL}`}>{data.closing.emailLabel}</a>
        <a class="geo-cta" href={whatsappHref} target="_blank" rel="noopener noreferrer">
          {data.closing.whatsappLabel} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <!-- ── Siguiente servicio + índice del resto ──────────────
         Dos niveles a propósito: el SIGUIENTE es el destino grande (mismo
         gesto que "SIGUIENTE" en las páginas de caso) y debajo va el índice
         completo, para quien busca un servicio concreto y no quiere recorrer
         los 7 de a uno. -->
    {nextService && (
      <nav class="geo-more" aria-label={navCopy.other}>
        <a class="geo-next" href={nextService.href}>
          <span class="geo-next__label">{navCopy.next}</span>
          <span class="geo-next__name">{nextService.name}</span>
          <span class="geo-next__arrow" aria-hidden="true">→</span>
        </a>

        <div class="geo-index">
          <p class="geo-index__label">{navCopy.other}</p>
          <ul class="geo-index__list">
            {otherServices.map((s: any) => (
              <li class="geo-index__item">
                <a class="geo-index__link" href={s.href}>
                  <span class="geo-index__num">{s.num}</span>
                  <span class="geo-index__name">{s.name}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="geo-index__all" href={`/${lang}#services`}>
            {navCopy.all} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </nav>
    )}

  </article>

  <FooterSection t={t} lang={lang} />
</Layout>

<style>
  .geo {
    background-color: var(--bg);
    color: var(--ink);
  }

  /* ── tipos base (mismo lenguaje que CaseStudyLayout) ─────── */
  .geo-kicker,
  .geo-num {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-62);
    font-variant-numeric: tabular-nums;
  }
  .geo-label {
    font-family: var(--font-display);
    font-weight: var(--display-weight-light);
    font-size: var(--text-h3);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .geo-body {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--ink-mid, var(--ink-62));
    margin: 0;
    max-width: 60ch;
  }
  .geo-note {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--ink-62);
    margin: var(--space-s) 0 0;
    max-width: 55ch;
  }

  /* ── HERO ─────────────────────────────────────────────────── */
  .geo-hero {
    padding: clamp(7rem, 18vh, 12rem) var(--margin) clamp(3rem, 8vh, 6rem);
    max-width: 1600px;
    margin-inline: auto;
  }
  .geo-hero__heading {
    font-family: var(--font-display);
    font-weight: var(--display-weight-hairline);
    font-size: var(--text-h1);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: var(--space-l) 0 0;
    max-width: 18ch;
    text-wrap: balance;
  }
  .geo-hero__tagline {
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    /* --text-lead (30px), no --text-subhead (22px): es la bajada del H1, el
       peldaño entre titular y cuerpo. A 22px competía con el body de 16px en
       vez de mediar entre el h1 y él. */
    font-size: var(--text-lead);
    line-height: 1.25;
    color: var(--ink-mid, var(--ink-62));
    margin: var(--space-m) 0 0;
    max-width: 30ch;
  }

  /* ── CTA (patrón cs-hero__visit) ──────────────────────────── */
  .geo-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: var(--space-l);
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.3em;
    transition: gap 0.3s ease, opacity 0.3s ease;
  }
  .geo-cta:hover { gap: 0.9em; opacity: 0.7; }

  /* Área táctil (auditoría Fase 5, 2026-08-06; alcance corregido 2026-08-11):
     los CTAs medían 21px de alto. Mismo patrón que .cs-hero__visit —
     pseudo-elemento en vez de min-height, porque el border-bottom es el
     subrayado del diseño y estirar la caja lo despegaría del texto.

     SIN media query: estaba limitado a ≤767px, así que en iPad estos CTAs
     —los enlaces más importantes de una página de servicio— seguían con un
     blanco de 22px. */
  .geo-cta {
    position: relative;
  }
  .geo-cta::after {
    content: '';
    position: absolute;
    inset: -12px -8px;
  }

  /* ── BLOQUES ──────────────────────────────────────────────── */
  .geo-block {
    max-width: 1600px;
    margin-inline: auto;
    padding: clamp(3rem, 7vh, 5.5rem) var(--margin);
    border-top: 1px solid var(--hairline);
    display: grid;
    gap: var(--space-s);
  }
  /* contenedor genérico de la 3ª columna cuando hay varios hijos */
  .geo-col3 {
    display: grid;
    gap: var(--space-m);
  }

  /* ── Stats (el cambio) ────────────────────────────────────── */
  .geo-stats {
    display: grid;
    gap: var(--space-m);
  }
  .geo-stat { display: grid; gap: 0.25rem; }
  .geo-stat__num {
    font-family: var(--font-display);
    font-weight: var(--display-weight-hairline);
    font-size: var(--text-names);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .geo-stat__note {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    line-height: 1.5;
    color: var(--ink-62);
    max-width: 34ch;
  }

  /* ── Causas ───────────────────────────────────────────────── */
  .geo-causes {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-m);
  }
  .geo-cause__title {
    font-family: var(--font-display);
    font-weight: var(--display-weight-light);
    font-size: var(--text-h3);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 0.4em;
  }

  /* ── Motores ──────────────────────────────────────────────── */
  .geo-engines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .geo-engine {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.55em 1em;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    color: var(--ink);
  }

  /* ── Escalones ────────────────────────────────────────────── */
  .geo-tiers {
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
    display: grid;
  }
  .geo-tier {
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.5rem, 3vh, 2.5rem) 0;
    border-top: 1px solid var(--hairline);
  }
  .geo-tier__name {
    font-family: var(--font-display);
    font-weight: var(--display-weight-light);
    font-size: var(--text-h3);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .geo-tier__price {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
  }
  /* hint de moneda local — lo llena el script; vacío = no ocupa espacio */
  .geo-tier__local {
    display: block;
    margin-top: 0.35em;
    color: var(--ink-62);
    letter-spacing: 0.1em;
  }
  .geo-tier__local:empty { display: none; }

  .geo-includes__label {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-62);
    margin: var(--space-s) 0 0.5em;
  }
  .geo-includes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45em;
  }
  .geo-includes li {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--ink-mid, var(--ink-62));
    padding-left: 1.2em;
    position: relative;
    max-width: 58ch;
  }
  .geo-includes li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--ink-62);
  }
  .geo-includes--no li::before { content: '✕'; font-size: 0.75em; top: 0.25em; }

  /* ── "La prueba" ──────────────────────────────────────────────
     Reemplaza al bloque del checker (2026-08-14). Se fueron ~360 líneas de
     CSS: el formulario de URL, el informe con score, las barras de severidad
     y el contador animado. Acá no hay resultado que pintar — el resultado
     llega por WhatsApp, escrito por una persona. */

  /* Los tres resultados posibles. Numerados con el mismo índice angosto que
     usa el resto de la página, para que se lea como parte del documento y no
     como una caja de widget. */
  .geo-proof__outcomes {
    list-style: none;
    margin: var(--space-m) 0 var(--space-l);
    padding: 0;
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    max-width: 52rem;
    counter-reset: outcome;
  }
  .geo-proof__outcome {
    position: relative;
    padding-left: 2.4rem;
    counter-increment: outcome;
  }
  .geo-proof__outcome::before {
    content: counter(outcome, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.1em;
    font-family: var(--font-body);
    font-size: var(--text-mono);
    letter-spacing: 0.08em;
    color: var(--ink-42);
    font-variant-numeric: tabular-nums;
  }
  .geo-proof__outcome-title {
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
    margin: 0 0 0.3rem;
    max-width: 44ch;
  }
  .geo-proof__outcome-body {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    line-height: 1.6;
    color: var(--ink-62);
    margin: 0;
    max-width: 58ch;
  }

  /* Tres campos cortos en una fila desde tablet; apilados en mobile. Pedir
     negocio/zona/rubro y NO una URL es el cambio de fondo: se pregunta por el
     negocio, no por el HTML. */
  .geo-proof__form {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
    margin-top: var(--space-m);
  }
  @media (min-width: 700px) {
    .geo-proof__form {
      grid-template-columns: repeat(3, 1fr);
      align-items: end;
    }
    .geo-proof__btn { grid-column: 1 / -1; justify-self: start; }
  }
  .geo-proof__field {
    display: grid;
    gap: 0.4rem;
  }
  .geo-proof__label {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-62);
  }
  .geo-proof__input {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: 2px;
    /* 0.85rem vertical deja el campo en ~48px de alto: por encima del mínimo
       táctil de 44px que el sitio se fijó como norma. */
    padding: 0.85rem 1rem;
    width: 100%;
  }
  .geo-proof__input::placeholder { color: var(--ink-42); }
  .geo-proof__input:focus {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    border-color: transparent;
  }
  .geo-proof__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper, #f4f2ed);
    background: var(--ink);
    border: none;
    border-radius: 2px;
    padding: 0.95rem 1.6rem;
    cursor: pointer;
    transition: gap 0.3s ease, opacity 0.3s ease;
  }
  .geo-proof__btn:hover { gap: 0.9em; opacity: 0.85; }
  .geo-proof__btn:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  /* ── Para quién ───────────────────────────────────────────── */
  .geo-forwhom {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-m);
  }
  /* 768px, no 640px (unificado 2026-08-06): a 640px la grilla pasaba a 2
     columnas dentro de lo que el resto del sitio todavía trata como mobile. */
  @media (min-width: 768px) {
    .geo-forwhom { grid-template-columns: 1fr 1fr; }
  }

  /* ── Evidencia — nota honesta, sin capturas inventadas ────── */
  .geo-evidence { font-style: italic; }

  /* ── FAQ ──────────────────────────────────────────────────── */
  .geo-faq {
    margin: var(--space-m) 0 0;
    display: grid;
    gap: var(--space-l);
  }
  .geo-faq__item { margin: 0; }
  .geo-faq__q {
    font-family: var(--font-display);
    font-weight: var(--display-weight-light);
    font-size: var(--text-h3);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 0.4em;
  }
  .geo-faq__a {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--ink-mid, var(--ink-62));
    margin: 0;
    max-width: 60ch;
  }

  /* ── Cierre ───────────────────────────────────────────────── */
  /* ── SIGUIENTE SERVICIO + ÍNDICE ─────────────────────────────
     Cierra el callejón sin salida que tenían las páginas de servicio: se
     terminaba de leer y el único camino era volver al nav. */
  .geo-more {
    max-width: 1600px;
    margin-inline: auto;
    border-top: 1px solid var(--ink);
  }

  /* Destino primario — mismo gesto que .cs-next en las páginas de caso */
  .geo-next {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 3vw, 2.5rem);
    padding: clamp(2.5rem, 8vh, 5rem) var(--margin);
    text-decoration: none;
    color: var(--ink);
  }
  .geo-next__label {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-62);
    flex-shrink: 0;
  }
  .geo-next__name {
    font-family: var(--font-display);
    font-weight: var(--display-weight-light);
    font-size: var(--text-names);
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .geo-next__arrow {
    font-family: var(--font-body);
    font-size: var(--text-h3);
    margin-left: auto;
    transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .geo-next:hover .geo-next__arrow,
  .geo-next:focus-visible .geo-next__arrow {
    transform: translateX(0.35em);
  }
  .geo-next:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -4px;
  }

  /* Índice del resto — nivel secundario, tipografía de metadatos */
  .geo-index {
    padding: 0 var(--margin) clamp(2.5rem, 7vh, 4.5rem);
    border-top: 1px solid var(--hairline);
    padding-top: clamp(1.5rem, 4vh, 2.5rem);
  }
  .geo-index__label {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-62);
    margin: 0 0 var(--space-s);
  }
  .geo-index__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  .geo-index__item + .geo-index__item {
    border-top: 1px solid var(--hairline);
  }
  .geo-index__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    /* 44px de área táctil: es una lista de destinos, y tablet/mobile son
       táctiles por igual (ver Nav.astro / FooterSection.astro). */
    min-height: 44px;
    padding-block: 0.5rem;
    text-decoration: none;
    color: var(--ink);
    transition: color 0.28s ease;
  }
  .geo-index__link:hover,
  .geo-index__link:focus-visible {
    color: var(--ink-62);
  }
  .geo-index__link:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .geo-index__num {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    /* --ink-62, no --ink-42: sobre el crema el 42% da 2.7:1 y AA pide 4.5:1
       (medido). El 42% sirve para numerales fantasma decorativos, pero acá el
       numeral es parte del texto del enlace. Mismo fix que en el toggle de
       idioma del pie (QA 2026-07-21). */
    color: var(--ink-62);
    flex-shrink: 0;
  }
  .geo-index__name {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .geo-index__all {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
    margin-top: var(--space-s);
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }

  /* Desde tablet: el índice en dos columnas — son 6 items y en una sola
     columna estiraba el cierre de la página sin necesidad. */
  @media (min-width: 768px) {
    .geo-index__list {
      /* grid-auto-flow: column + 3 filas fijas → llena la PRIMERA columna
         entera antes de pasar a la segunda. Con el flujo por defecto (por
         filas) los numerales quedaban 02·03 / 04·05 / 06·07 leídos en zigzag;
         así se leen 02·04·06 hacia abajo y luego 03·05·07, que es como se lee
         un índice. */
      grid-auto-flow: column;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: repeat(3, auto);
      column-gap: var(--space-xl);
    }
    /* con 2 columnas, el primer item de la SEGUNDA columna (el 4º del orden)
       no lleva borde superior: ya lo aporta el encabezado de su columna */
    .geo-index__item:nth-child(4) {
      border-top: none;
    }
  }

  .geo-closing {
    max-width: 1600px;
    margin-inline: auto;
    padding: clamp(4rem, 12vh, 9rem) var(--margin);
    border-top: 1px solid var(--hairline);
  }
  .geo-closing__statement {
    font-family: var(--font-display);
    font-weight: var(--display-weight-hairline);
    font-size: var(--text-h2);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 20ch;
    text-wrap: balance;
  }
  .geo-closing__channels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-l);
  }

  /* ── DESKTOP: composición asimétrica num/label/contenido ──── */
  @media (min-width: 900px) {
    .geo-block {
      /* num angosto · label como índice lateral estrecho · contenido protagónico.
         Antes el label era 1fr elástico: con títulos cortos ("Por qué no rinde")
         dejaba una columna casi vacía y comprimía el contenido a la derecha, con
         mucho aire muerto. Ahora el label es una columna estrecha fija (patrón
         editorial de índice) y el contenido absorbe todo el ancho restante →
         texto ancho, legible, sin hueco. */
      grid-template-columns: minmax(0, 4rem) minmax(0, 15rem) minmax(0, 1fr);
      column-gap: clamp(2rem, 4vw, 4.5rem);
      align-items: start;
    }
    .geo-block > .geo-num { grid-column: 1; }
    .geo-block > .geo-label { grid-column: 2; }
    .geo-block > .geo-body,
    .geo-block > .geo-col3,
    .geo-block > .geo-causes,
    .geo-block > .geo-tiers,
    .geo-block > .geo-forwhom,
    .geo-block > .geo-faq { grid-column: 3; margin-top: 0; }

    .geo-stats { grid-template-columns: repeat(3, 1fr); gap: var(--space-m); }

    .geo-tier {
      grid-template-columns: minmax(0, 4rem) minmax(0, 1fr);
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }
    .geo-tier > .geo-num { grid-column: 1; padding-top: 0.4em; }
    .geo-tier > .geo-tier__name,
    .geo-tier > .geo-tier__price,
    .geo-tier > .geo-body,
    .geo-tier > .geo-includes__label,
    .geo-tier > .geo-includes { grid-column: 2; }
  }

  }

  /* ── Reveal (mismo patrón del sitio) ──────────────────────── */
  [data-geo-reveal] {
    opacity: 0;
    transform: translateY(24px);
  }
  [data-geo-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-geo-reveal] { opacity: 1; transform: none; }
  }
</style>

<script>
  /* ── Reveal on scroll ─────────────────────────────────────── */
  const els = document.querySelectorAll('[data-geo-reveal]');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) {
    els.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -12% 0px' }
    );
    els.forEach((el) => io.observe(el));
  }

  /* ── Hint de moneda local ─────────────────────────────────────
     Sin APIs ni geolocalización: timezone → moneda, tasas aproximadas.
     Tasas de referencia al 2026-08-04 (actualizar de vez en cuando):
     TRM COP 3.144 · MXN 17,7 · CLP 925 · PEN 3,6 · EUR 0,90.
     ARS omitido a propósito: bimonetario + volatilidad → cualquier tasa
     fija sería errada en días; ese público lee USD con naturalidad. */
  const TZ_CURRENCY: Record<string, [string, number, string]> = {
    'America/Bogota': ['COP', 3144, 'es-CO'],
    'America/Mexico_City': ['MXN', 17.7, 'es-MX'],
    'America/Monterrey': ['MXN', 17.7, 'es-MX'],
    'America/Cancun': ['MXN', 17.7, 'es-MX'],
    'America/Tijuana': ['MXN', 17.7, 'es-MX'],
    'America/Lima': ['PEN', 3.6, 'es-PE'],
    'America/Santiago': ['CLP', 925, 'es-CL'],
    'Europe/Madrid': ['EUR', 0.9, 'es-ES'],
    'Atlantic/Canary': ['EUR', 0.9, 'es-ES'],
  };
  try {
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const hit = TZ_CURRENCY[tz];
    if (hit) {
      const [currency, rate, locale] = hit;
      document.querySelectorAll<HTMLElement>('[data-usd]').forEach((el) => {
        const usdVal = Number(el.dataset.usd);
        if (!usdVal) return;
        const local = new Intl.NumberFormat(locale, {
          style: 'currency',
          currency,
          maximumFractionDigits: 0,
        }).format(usdVal * rate);
        const prefix = el.dataset.prefix ? `${el.dataset.prefix} ` : '';
        el.textContent = `≈ ${prefix}${local} ${currency} aprox.`;
      });
    }
  } catch { /* sin hint — la página funciona igual en USD */ }

  /* ── "La prueba": el formulario arma un WhatsApp, no llama a una API ───
     Antes acá vivía el checker: 180 renglones que pegaban a /api/geo-check,
     pintaban un informe con score y animaban un contador. Se fue entero junto
     con el endpoint (ver la nota en la interfaz `proof` para las tres razones
     con fuente).

     Lo que queda es deliberadamente tonto: junta los campos, arma un mensaje
     y abre WhatsApp. El análisis lo hace una persona corriendo los prompts a
     mano. Sin costo por uso, sin superficie de abuso, sin endpoint que
     mantener — y es lo que la industria define como auditoría legítima
     ("live query testing") en vez de un score automático. */
  const proofForm = document.querySelector<HTMLFormElement>('[data-geo-proof]');
  const proofWaBase = document.querySelector<HTMLElement>('[data-wa-base]')?.dataset.waBase;

  if (proofForm) {
    proofForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const datos = [...new FormData(proofForm).entries()]
        .map(([k, v]) => `${k}: ${String(v).trim()}`)
        .filter((s) => !s.endsWith(': '))
        .join(' · ');

      const msg = `${proofForm.dataset.waMessage ?? ''} ${datos}`.trim();
      /* Sin WhatsApp configurado se cae a mailto: el formulario nunca queda
         muerto, que es lo que pasaría si dependiera solo del número. */
      const url = proofWaBase
        ? `${proofWaBase}?text=${encodeURIComponent(msg)}`
        : `mailto:info@scuart.com?subject=${encodeURIComponent('Prueba de 3 preguntas')}&body=${encodeURIComponent(msg)}`;
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  }
</script>
