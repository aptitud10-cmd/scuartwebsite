---
/**
 * GeoServiceLayout.astro — Página de servicio AI Visibility · GEO.
 *
 * Estructura answer-first (SERVICIO-GEO-SCUART.md + HANDOFF-GEO-LANDING.md):
 * cada sección responde una pregunta real de cliente, de modo que la propia
 * página sea citable por motores generativos (comerse la propia medicina).
 *
 * Precios: base en USD (mercado LATAM + USA + España). Un hint client-side
 * muestra el aproximado en la moneda local según el timezone del visitante
 * (sin APIs externas, sin geolocalización — privacidad y cero dependencias).
 *
 * Checker (lead magnet): el visitante pega su URL → se abre WhatsApp con el
 * pedido armado. v1 sin backend a propósito; se automatiza si hay volumen.
 *
 * Sigue el sistema visual del sitio (mismos tokens que CaseStudyLayout):
 * kicker mono · display serif hairline · hairlines · reveal on scroll.
 */

import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import FooterSection from './FooterSection.astro';
import type { Translations } from '../i18n/en';
import { SITE_URL } from '../i18n/index';

const EMAIL = 'info@scuart.com';

interface Stat {
  num: string;
  note: string;
}

interface Tier {
  num: string;
  name: string;
  /** Monto base en USD (número, para el hint de moneda local) */
  priceUSD: number;
  /** "Desde" / "From" — vacío si es precio cerrado */
  pricePrefix?: string;
  /** "pago único" / "one time" / "/ mes" */
  priceSuffix: string;
  body: string;
  includesLabel: string;
  includes: string[];
}

interface FaqItem {
  q: string;
  a: string;
}

export interface GeoServiceData {
  kicker: string;
  heading: string;
  tagline: string;
  cta: string;
  /** sourceNote: atribución visible de las cifras (P4 — sin números huérfanos) */
  shift: { label: string; body: string; stats: Stat[]; sourceNote: string };
  whatIs: { label: string; body: string };
  whyNot: { label: string; items: { title: string; body: string }[] };
  /* OPCIONAL desde 2026-08-10: este layout dejó de ser exclusivo de GEO y ahora
     sirve a todas las páginas de servicio. `engines` (los motores de IA que se
     auditan) solo aplica a GEO — el resto de los servicios omite el campo y la
     sección no se renderiza. */
  engines?: { label: string; body: string; primary: string[]; secondary: string };
  how: { label: string; tiers: Tier[] };
  /* OPCIONAL — la herramienta que analiza una URL en vivo existe solo para GEO. */
  checker?: {
    label: string;
    body: string;
    placeholder: string;
    /** Label accesible del input — describe el propósito, no repite el placeholder */
    inputLabel: string;
    button: string;
    note: string;
    /** Texto del mensaje de WhatsApp; la URL del sitio se concatena al final */
    waMessage: string;
    /** Estado del botón mientras corre el análisis */
    loadingLabel: string;
    /** Encabezado de la lista de prioridades en el resultado */
    prioLabel: string;
    /** CTA a WhatsApp que aparece DEBAJO del resultado */
    waCta: string;
    /** Mensaje si el fetch falla */
    errorLabel: string;
  };
  forWhom: {
    label: string;
    yesLabel: string;
    yes: string[];
    noLabel: string;
    no: string[];
  };
  /* OPCIONAL — "la prueba". Un servicio sin caso publicado todavía omite el campo
     en vez de mostrar una sección que anuncia que no hay prueba. */
  evidence?: { label: string; body: string };
  faq: { label: string; items: FaqItem[] };
  closing: { statement: string; emailLabel: string; whatsappLabel: string };
}

interface Props {
  t: Translations;
  lang: 'es' | 'en';
  data: GeoServiceData;
  title: string;
  description: string;
  canonicalURL: string;
  alternates: { en: string; es: string; xDefault: string };
}

const { t, lang, data, title, description, canonicalURL, alternates } = Astro.props;

/* Nombre del servicio para el JSON-LD, derivado del kicker.
   BUG CORREGIDO 2026-08-14: `name` y `serviceType` estaban HARDCODEADOS como
   "AI Visibility (GEO)" en este layout compartido, así que las SIETE páginas de
   servicio se declaraban ante Google y los motores generativos como si todas
   fueran el servicio de GEO — cada una con los precios de otra. En un sitio que
   vende justamente visibilidad en IA, era el error más caro posible: el dato
   estructurado contradecía al producto.

   Se deriva del kicker ("SERVICIO N°01 — WEB PLATFORMS" → "WEB PLATFORMS") para
   no tener que tocar las 14 páginas; si el formato del kicker cambiara, el
   fallback es el kicker completo, nunca un nombre de otro servicio. */
const serviceName = (data.kicker.split('—').pop() ?? data.kicker).trim();

/* JSON-LD Service: declara la oferta ante buscadores y motores generativos. */
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: serviceName,
  /* serviceType solo cuando ES el servicio de GEO — es un término de industria
     concreto, no una etiqueta genérica que aplique a los siete. */
  ...(data.checker ? { serviceType: 'Generative Engine Optimization' } : {}),
  description,
  url: canonicalURL,
  inLanguage: lang,
  provider: { '@type': 'Organization', '@id': `${SITE_URL}/#organization`, name: 'SCUART' },
  areaServed: ['US', 'CO', 'MX', 'PE', 'CL', 'AR', 'ES'],
  offers: data.how.tiers.map((tier) => ({
    '@type': 'Offer',
    name: tier.name,
    price: tier.priceUSD,
    priceCurrency: 'USD',
  })),
};

/* FAQPage: las preguntas reales de la sección FAQ, citables por la SERP y por LLMs. */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const servicesLabel = lang === 'es' ? 'Servicios' : 'Services';
const homeUrl = `${SITE_URL}/${lang}`;
/* Destino del CTA del hero: el ancla #geo-checker SOLO existe cuando la página
   trae bloque `checker` (hoy solo AI Visibility). En las demás páginas de
   servicio ese ancla no existe y el botón no llevaba a ningún lado — apuntamos
   a la sección de contacto de la home, que siempre existe.

   RUTA RELATIVA, no homeUrl (corregido 2026-08-12): homeUrl se arma con
   SITE_URL = https://scuart.com, que es correcto para el JSON-LD del breadcrumb
   pero NO para un href de navegación — en local y en los previews de Vercel el
   botón expulsaba al visitante al sitio de producción. */
const heroCtaHref = data.checker ? '#geo-checker' : `/${lang}#contact`;
/* ── ÍNDICE DE SERVICIOS (2026-08-12) ────────────────────────────────
   Al terminar de leer un servicio no había ningún camino hacia los otros:
   el único cierre era email + WhatsApp, así que para ver otro servicio había
   que volver al nav (reporte de William).

   La lista NO se declara acá: se deriva de `capabilities.items`, que ya es la
   fuente de verdad de los 7 servicios en la home (num, name, href) y existe
   completa en ES y EN. Así, agregar un servicio al diccionario lo suma a la
   navegación de las 7 páginas sin tocar este layout.

   `current` se detecta comparando el href de cada item con la URL de la página.
   Se normaliza la barra final porque el sitio usa trailingSlash: 'never' pero
   Astro.url.pathname puede traerla según el contexto. */
const allServices = (t.capabilities?.items ?? []).filter((s: any) => s.href);
const stripSlash = (u: string) => u.replace(/\/+$/, '');
const currentPath = stripSlash(Astro.url.pathname);
const currentIdx = allServices.findIndex((s: any) => stripSlash(s.href) === currentPath);
const otherServices = allServices.filter((_: any, i: number) => i !== currentIdx);
/* El siguiente en orden circular — el destino primario, mismo gesto que el
   "SIGUIENTE" de las páginas de caso. */
const nextService = allServices.length > 1
  ? allServices[(currentIdx + 1) % allServices.length]
  : null;

const navCopy = lang === 'es'
  ? { next: 'SIGUIENTE SERVICIO', all: 'TODOS LOS SERVICIOS', other: 'OTROS SERVICIOS' }
  : { next: 'NEXT SERVICE', all: 'ALL SERVICES', other: 'OTHER SERVICES' };

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'SCUART', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: servicesLabel, item: `${homeUrl}#services` },
    /* Mismo bug que en serviceSchema: estaba fijo en "AI Visibility · GEO"
       para las 7 páginas. */
    { '@type': 'ListItem', position: 3, name: serviceName, item: canonicalURL },
  ],
};

const whatsappHref = t.contact.whatsappHref;

/* Numeración editorial de bloques, en orden de render */
let n = 0;
const num = () => String(++n).padStart(2, '0');

const usd = (v: number) => `$${v.toLocaleString('en-US')} USD`;
---

<Layout
  title={title}
  description={description}
  lang={lang}
  canonicalURL={canonicalURL}
  alternates={alternates}
>
  <Nav lang={lang} t={t} />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

  <article class="geo" data-wa-base={whatsappHref}>

    <!-- ── HERO tipográfico ─────────────────────────────────── -->
    <header class="geo-hero">
      <p class="geo-kicker">{data.kicker}</p>
      <h1 class="geo-hero__heading">{data.heading}</h1>
      <p class="geo-hero__tagline">{data.tagline}</p>
      <a class="geo-cta" href={heroCtaHref}>
        {data.cta} <span aria-hidden="true">{data.checker ? '↓' : '→'}</span>
      </a>
    </header>

    <!-- ── El cambio de comportamiento — datos, no opinión ──── -->
    <section class="geo-block" data-geo-reveal>
      <span class="geo-num">{num()}</span>
      <h2 class="geo-label">{data.shift.label}</h2>
      <div class="geo-col3">
        <p class="geo-body">{data.shift.body}</p>
        <div class="geo-stats">
          {data.shift.stats.map((s) => (
            <div class="geo-stat">
              <span class="geo-stat__num">{s.num}</span>
              <span class="geo-stat__note">{s.note}</span>
            </div>
          ))}
        </div>
        <p class="geo-note">{data.shift.sourceNote}</p>
      </div>
    </section>

    <!-- ── Qué es GEO ───────────────────────────────────────── -->
    <section class="geo-block" data-geo-reveal>
      <span class="geo-num">{num()}</span>
      <h2 class="geo-label">{data.whatIs.label}</h2>
      <p class="geo-body">{data.whatIs.body}</p>
    </section>

    <!-- ── Por qué no apareces ──────────────────────────────── -->
    <section class="geo-block" data-geo-reveal>
      <span class="geo-num">{num()}</span>
      <h2 class="geo-label">{data.whyNot.label}</h2>
      <div class="geo-causes">
        {data.whyNot.items.map((item) => (
          <div class="geo-cause">
            <h3 class="geo-cause__title">{item.title}</h3>
            <p class="geo-body">{item.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Los motores que auditamos (solo GEO) ─────────────── -->
    {data.engines && (
      <section class="geo-block" data-geo-reveal>
        <span class="geo-num">{num()}</span>
        <h2 class="geo-label">{data.engines.label}</h2>
        <div class="geo-col3">
          <p class="geo-body">{data.engines.body}</p>
          <ul class="geo-engines">
            {data.engines.primary.map((e) => (
              <li class="geo-engine">{e}</li>
            ))}
          </ul>
          <p class="geo-note">{data.engines.secondary}</p>
        </div>
      </section>
    )}

    <!-- ── Cómo funciona — escalones con precio USD + hint local ── -->
    <section class="geo-block" data-geo-reveal>
      <span class="geo-num">{num()}</span>
      <h2 class="geo-label">{data.how.label}</h2>
      <ol class="geo-tiers">
        {data.how.tiers.map((tier) => (
          <li class="geo-tier">
            <span class="geo-num">{tier.num}</span>
            <h3 class="geo-tier__name">{tier.name}</h3>
            <p class="geo-tier__price">
              {tier.pricePrefix ? `${tier.pricePrefix} ` : ''}{usd(tier.priceUSD)} · {tier.priceSuffix}
              <span class="geo-tier__local" data-usd={tier.priceUSD} data-prefix={tier.pricePrefix ?? ''}></span>
            </p>
            <p class="geo-body">{tier.body}</p>
            <p class="geo-includes__label">{tier.includesLabel}</p>
            <ul class="geo-includes">
              {tier.includes.map((inc) => (
                <li>{inc}</li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <!-- ── Checker — lead magnet: URL → WhatsApp prefilled (solo GEO) ──── -->
    {data.checker && (
      <section class="geo-block geo-checker" id="geo-checker" data-geo-reveal>
        <span class="geo-num">{num()}</span>
        <h2 class="geo-label">{data.checker.label}</h2>
        <div class="geo-col3">
          <p class="geo-body">{data.checker.body}</p>
          <form
            class="geo-checker__form"
            data-geo-checker
            data-wa-message={data.checker.waMessage}
            data-loading-label={data.checker.loadingLabel}
            data-prio-label={data.checker.prioLabel}
            data-wa-cta={data.checker.waCta}
            data-error-label={data.checker.errorLabel}
          >
            <input
              class="geo-checker__input"
              type="text"
              name="siteurl"
              inputmode="url"
              autocomplete="url"
              placeholder={data.checker.placeholder}
              aria-label={data.checker.inputLabel}
              required
            />
            <button class="geo-checker__btn" type="submit">
              {data.checker.button} <span aria-hidden="true">→</span>
            </button>
          </form>
          <!-- Resultado del análisis — lo llena el JS. aria-live: un lector de
               pantalla anuncia el score cuando llega. -->
          <div class="geo-result" data-geo-result aria-live="polite" hidden></div>
          <p class="geo-note">{data.checker.note}</p>
        </div>
      </section>
    )}

    <!-- ── Para quién es (y para quién no) ──────────────────── -->
    <section class="geo-block" data-geo-reveal>
      <span class="geo-num">{num()}</span>
      <h2 class="geo-label">{data.forWhom.label}</h2>
      <div class="geo-forwhom">
        <div>
          <p class="geo-includes__label">{data.forWhom.yesLabel}</p>
          <ul class="geo-includes">
            {data.forWhom.yes.map((y) => (
              <li>{y}</li>
            ))}
          </ul>
        </div>
        <div>
          <p class="geo-includes__label">{data.forWhom.noLabel}</p>
          <ul class="geo-includes geo-includes--no">
            {data.forWhom.no.map((x) => (
              <li>{x}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ── Evidencia — opcional: se omite si el servicio aún no tiene prueba ── -->
    {data.evidence && (
      <section class="geo-block" data-geo-reveal>
        <span class="geo-num">{num()}</span>
        <h2 class="geo-label">{data.evidence.label}</h2>
        <p class="geo-body geo-evidence">{data.evidence.body}</p>
      </section>
    )}

    <!-- ── FAQ answer-first ─────────────────────────────────── -->
    <section class="geo-block" data-geo-reveal>
      <span class="geo-num">{num()}</span>
      <h2 class="geo-label">{data.faq.label}</h2>
      <dl class="geo-faq">
        {data.faq.items.map((f) => (
          <div class="geo-faq__item">
            <dt class="geo-faq__q">{f.q}</dt>
            <dd class="geo-faq__a">{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- ── Cierre + contacto directo (email + WhatsApp) ─────── -->
    <section class="geo-closing" data-geo-reveal>
      <p class="geo-closing__statement">{data.closing.statement}</p>
      <div class="geo-closing__channels">
        <a class="geo-cta" href={`mailto:${EMAIL}`}>{data.closing.emailLabel}</a>
        <a class="geo-cta" href={whatsappHref} target="_blank" rel="noopener noreferrer">
          {data.closing.whatsappLabel} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <!-- ── Siguiente servicio + índice del resto ──────────────
         Dos niveles a propósito: el SIGUIENTE es el destino grande (mismo
         gesto que "SIGUIENTE" en las páginas de caso) y debajo va el índice
         completo, para quien busca un servicio concreto y no quiere recorrer
         los 7 de a uno. -->
    {nextService && (
      <nav class="geo-more" aria-label={navCopy.other}>
        <a class="geo-next" href={nextService.href}>
          <span class="geo-next__label">{navCopy.next}</span>
          <span class="geo-next__name">{nextService.name}</span>
          <span class="geo-next__arrow" aria-hidden="true">→</span>
        </a>

        <div class="geo-index">
          <p class="geo-index__label">{navCopy.other}</p>
          <ul class="geo-index__list">
            {otherServices.map((s: any) => (
              <li class="geo-index__item">
                <a class="geo-index__link" href={s.href}>
                  <span class="geo-index__num">{s.num}</span>
                  <span class="geo-index__name">{s.name}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="geo-index__all" href={`/${lang}#services`}>
            {navCopy.all} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </nav>
    )}

  </article>

  <FooterSection t={t} lang={lang} />
</Layout>

<style>
  .geo {
    background-color: var(--bg);
    color: var(--ink);
  }

  /* ── tipos base (mismo lenguaje que CaseStudyLayout) ─────── */
  .geo-kicker,
  .geo-num {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-62);
    font-variant-numeric: tabular-nums;
  }
  .geo-label {
    font-family: var(--font-display);
    font-weight: var(--display-weight-light);
    font-size: var(--text-h3);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .geo-body {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--ink-mid, var(--ink-62));
    margin: 0;
    max-width: 60ch;
  }
  .geo-note {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--ink-62);
    margin: var(--space-s) 0 0;
    max-width: 55ch;
  }

  /* ── HERO ─────────────────────────────────────────────────── */
  .geo-hero {
    padding: clamp(7rem, 18vh, 12rem) var(--margin) clamp(3rem, 8vh, 6rem);
    max-width: 1600px;
    margin-inline: auto;
  }
  .geo-hero__heading {
    font-family: var(--font-display);
    font-weight: var(--display-weight-hairline);
    font-size: var(--text-h1);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: var(--space-l) 0 0;
    max-width: 18ch;
    text-wrap: balance;
  }
  .geo-hero__tagline {
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    /* --text-lead (30px), no --text-subhead (22px): es la bajada del H1, el
       peldaño entre titular y cuerpo. A 22px competía con el body de 16px en
       vez de mediar entre el h1 y él. */
    font-size: var(--text-lead);
    line-height: 1.25;
    color: var(--ink-mid, var(--ink-62));
    margin: var(--space-m) 0 0;
    max-width: 30ch;
  }

  /* ── CTA (patrón cs-hero__visit) ──────────────────────────── */
  .geo-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: var(--space-l);
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.3em;
    transition: gap 0.3s ease, opacity 0.3s ease;
  }
  .geo-cta:hover { gap: 0.9em; opacity: 0.7; }

  /* Área táctil (auditoría Fase 5, 2026-08-06; alcance corregido 2026-08-11):
     los CTAs medían 21px de alto. Mismo patrón que .cs-hero__visit —
     pseudo-elemento en vez de min-height, porque el border-bottom es el
     subrayado del diseño y estirar la caja lo despegaría del texto.

     SIN media query: estaba limitado a ≤767px, así que en iPad estos CTAs
     —los enlaces más importantes de una página de servicio— seguían con un
     blanco de 22px. */
  .geo-cta {
    position: relative;
  }
  .geo-cta::after {
    content: '';
    position: absolute;
    inset: -12px -8px;
  }

  /* ── BLOQUES ──────────────────────────────────────────────── */
  .geo-block {
    max-width: 1600px;
    margin-inline: auto;
    padding: clamp(3rem, 7vh, 5.5rem) var(--margin);
    border-top: 1px solid var(--hairline);
    display: grid;
    gap: var(--space-s);
  }
  /* contenedor genérico de la 3ª columna cuando hay varios hijos */
  .geo-col3 {
    display: grid;
    gap: var(--space-m);
  }

  /* ── Stats (el cambio) ────────────────────────────────────── */
  .geo-stats {
    display: grid;
    gap: var(--space-m);
  }
  .geo-stat { display: grid; gap: 0.25rem; }
  .geo-stat__num {
    font-family: var(--font-display);
    font-weight: var(--display-weight-hairline);
    font-size: var(--text-names);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .geo-stat__note {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    line-height: 1.5;
    color: var(--ink-62);
    max-width: 34ch;
  }

  /* ── Causas ───────────────────────────────────────────────── */
  .geo-causes {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-m);
  }
  .geo-cause__title {
    font-family: var(--font-display);
    font-weight: var(--display-weight-light);
    font-size: var(--text-h3);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 0.4em;
  }

  /* ── Motores ──────────────────────────────────────────────── */
  .geo-engines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .geo-engine {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.55em 1em;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    color: var(--ink);
  }

  /* ── Escalones ────────────────────────────────────────────── */
  .geo-tiers {
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
    display: grid;
  }
  .geo-tier {
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.5rem, 3vh, 2.5rem) 0;
    border-top: 1px solid var(--hairline);
  }
  .geo-tier__name {
    font-family: var(--font-display);
    font-weight: var(--display-weight-light);
    font-size: var(--text-h3);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .geo-tier__price {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
  }
  /* hint de moneda local — lo llena el script; vacío = no ocupa espacio */
  .geo-tier__local {
    display: block;
    margin-top: 0.35em;
    color: var(--ink-62);
    letter-spacing: 0.1em;
  }
  .geo-tier__local:empty { display: none; }

  .geo-includes__label {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-62);
    margin: var(--space-s) 0 0.5em;
  }
  .geo-includes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45em;
  }
  .geo-includes li {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--ink-mid, var(--ink-62));
    padding-left: 1.2em;
    position: relative;
    max-width: 58ch;
  }
  .geo-includes li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--ink-62);
  }
  .geo-includes--no li::before { content: '✕'; font-size: 0.75em; top: 0.25em; }

  /* ── Checker ──────────────────────────────────────────────── */
  .geo-checker__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    max-width: 40rem;
  }

  /* ── Resultado del chequeo GEO (lo inyecta el JS) ─────────────
     Mismo lenguaje del resto de la página: hairlines, tinta, radius 2px.
     Sin cajas con sombra ni colores de semáforo — el ✓/✕ y el peso
     tipográfico bastan para leer el estado. */
  .geo-result {
    /* Más ancho que el form (40rem): el resultado es el momento en que la
       página entrega valor real y merece más presencia. Los checks a dos
       columnas en desktop aprovechan el aire que sobraba a la izquierda. */
    max-width: 52rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--hairline);
    padding-top: clamp(1.25rem, 3vw, 2rem);
  }
  .geo-result[hidden] { display: none; }
  .geo-result:focus { outline: none; }

  :global(.geo-result__loading),
  :global(.geo-result__error) {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--ink-62);
    margin: 0 0 1rem;
  }

  :global(.geo-result__head) {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  :global(.geo-result__score) {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    position: relative;
  }
  /* La barra lima marca el score alto — mismo acento que el resto del sitio.
     Sobre claro el lima no contrasta como TEXTO, solo como subrayado. */
  :global(.geo-result__score[data-nivel='alto'])::after {
    content: '';
    position: absolute;
    left: 0; right: 1.8em; bottom: 0.08em;
    height: 0.08em;
    background: var(--brand);
  }
  :global(.geo-result__score-max) {
    font-size: 0.3em;
    color: var(--ink-42);
    margin-left: 0.1em;
  }
  :global(.geo-result__host) {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-62);
    margin: 0;
  }
  :global(.geo-result__headtext) {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  :global(.geo-result__scorelabel) {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-62);
    margin: 0;
  }
  /* Nota al pie del informe (2026-08-14: bajó del encabezado al final).
     Arriba competía con el veredicto y empujaba lo accionable fuera de
     pantalla; acá cierra y aclara el alcance sin robar la primera lectura. */
  :global(.geo-result__disclaimer) {
    font-family: var(--font-body);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-62);
    margin: 0 0 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
    max-width: 58ch;
  }
  :global(.geo-result__disclaimer strong) {
    color: var(--ink-92, var(--ink-62));
    font-weight: 600;
  }

  /* ── Informe (reemplaza la lista plana, 2026-08-14) ───────────
     La jerarquía la da el ORDEN y el PESO, no el color: primero lo que hay
     que arreglar en tamaño de lectura, después lo resuelto en un <details>
     cerrado. Sin verde/rojo de semáforo — el sitio es crema y tinta, y un
     rojo de alerta acá se vería como un plugin pegado encima. */

  :global(.geo-report__verdict) {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.45;
    color: var(--ink);
    margin: 0;
    /* 52ch, no 34: a 34 el veredicto partía en dos renglones cortos al lado
       del score y dejaba media pantalla vacía a la derecha en desktop. */
    max-width: 52ch;
    text-wrap: balance;
  }

  :global(.geo-report__group) {
    border-top: 1px solid var(--hairline);
    padding-top: clamp(1rem, 2.5vw, 1.5rem);
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }
  :global(.geo-report__grouplabel) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-size: var(--text-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-62);
    margin: 0 0 1.1rem;
  }
  /* El contador en un círculo de hairline: da peso de "informe" sin recurrir
     a un badge de color. */
  :global(.geo-report__count) {
    display: grid;
    place-items: center;
    min-width: 1.7em;
    height: 1.7em;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  :global(.geo-report__fixes) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.4rem);
  }
  /* Cada falla es una entrada con su barra a la izquierda. El grosor de la
     barra codifica la severidad — más discreto que un color y funciona igual
     en escala de grises o para alguien con daltonismo. */
  :global(.geo-report__fix) {
    position: relative;
    padding-left: 1.1rem;
  }
  :global(.geo-report__fix)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35em;
    bottom: 0.15em;
    width: 2px;
    background: var(--ink-42);
  }
  :global(.geo-report__fix[data-nivel='critico'])::before {
    width: 4px;
    background: var(--ink);
  }
  :global(.geo-report__fix[data-nivel='importante'])::before {
    width: 3px;
    background: var(--ink-62);
  }
  :global(.geo-report__tag) {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-62);
    margin-bottom: 0.35rem;
  }
  :global(.geo-report__fix[data-nivel='critico'] .geo-report__tag) {
    color: var(--ink);
    font-weight: 600;
  }
  :global(.geo-report__fixtitle) {
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
    margin: 0 0 0.3rem;
    max-width: 40ch;
  }
  :global(.geo-report__fixdetail) {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    line-height: 1.6;
    color: var(--ink-62);
    margin: 0;
    max-width: 58ch;
  }

  :global(.geo-report__perfect) {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--ink);
    border-top: 1px solid var(--hairline);
    padding-top: 1.25rem;
    margin: 0 0 1.5rem;
    max-width: 52ch;
  }

  /* Lo resuelto: colapsado por defecto. Confirma sin robarle lectura a lo
     accionable, y quien quiera el detalle lo abre. */
  :global(.geo-report__ok) {
    border-top: 1px solid var(--hairline);
    padding-top: 1rem;
    margin-bottom: 1.25rem;
  }
  :global(.geo-report__ok summary) {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-62);
    cursor: pointer;
    /* 44px de alto táctil sin tocar el layout visual (norma del sitio). */
    padding-block: 0.7rem;
    list-style: none;
  }
  :global(.geo-report__ok summary)::-webkit-details-marker { display: none; }
  :global(.geo-report__ok summary)::after {
    content: '+';
    margin-left: 0.5em;
    color: var(--ink-42);
  }
  :global(.geo-report__ok[open] summary)::after { content: '–'; }
  :global(.geo-report__ok summary:hover) { color: var(--ink); }
  :global(.geo-report__ok summary:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  :global(.geo-report__okcount) {
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  :global(.geo-report__oklist) {
    list-style: none;
    margin: 0.5rem 0 0.75rem;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  @media (min-width: 768px) {
    :global(.geo-report__oklist) {
      grid-template-columns: 1fr 1fr;
      gap: 0.7rem 2rem;
    }
  }
  :global(.geo-report__oklist li) {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    line-height: 1.5;
    color: var(--ink-62);
  }
  :global(.geo-report__oklist strong) {
    color: var(--ink);
    font-weight: 500;
  }
  :global(.geo-report__okdetail) { display: block; }

  /* Sin datos: ni aprobado ni falla. Se muestra en gris y sin ícono para que
     se lea como lo que es — una zona que el checker no pudo medir. */
  :global(.geo-report__nodata) {
    border-top: 1px solid var(--hairline);
    padding-top: 1rem;
    margin-bottom: 1.25rem;
  }
  :global(.geo-report__nodata p) {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    line-height: 1.6;
    color: var(--ink-62);
    margin: 0 0 0.5rem;
    max-width: 58ch;
  }
  :global(.geo-report__nodata strong) { color: var(--ink); font-weight: 500; }

  /* CTA del resultado — BUG PREEXISTENTE, arreglado 2026-08-14.
     .geo-cta se declara arriba sin :global, así que Astro le agrega el atributo
     de scope (data-astro-cid-…) al selector Y a los elementos del .astro. El
     enlace del resultado lo inyecta el JS con innerHTML, o sea NO lleva ese
     atributo: no matcheaba ninguna regla y salía como un <a> pelado —azul,
     subrayado, con el estilo por defecto del navegador— justo en el CTA que
     cierra la herramienta. Se replica acá con :global para el caso inyectado. */
  :global(.geo-result .geo-cta) {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    position: relative;
    margin-top: 0;
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.3em;
    transition: gap 0.3s ease, opacity 0.3s ease;
  }
  :global(.geo-result .geo-cta:hover) { gap: 0.9em; opacity: 0.7; }
  /* Misma área táctil de 44px que el resto de los CTA del sitio. */
  :global(.geo-result .geo-cta)::after {
    content: '';
    position: absolute;
    inset: -12px -8px;
  }
  .geo-checker__input {
    flex: 1 1 16rem;
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: 2px;
    padding: 0.9em 1em;
    min-width: 0;
  }
  .geo-checker__input::placeholder { color: var(--ink-62); }
  .geo-checker__input:focus {
    outline: none;
    border-color: var(--ink);
  }
  .geo-checker__btn {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 2px;
    padding: 0.9em 1.6em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    /* 44px de alto táctil: es el botón que dispara el análisis, el control
       más importante de la página (auditoría Fase 5, 2026-08-06 — medía 38px
       porque el padding en em sobre --text-mono de 11px no alcanza). */
    min-height: 44px;
    justify-content: center;
    transition: gap 0.3s ease, opacity 0.3s ease;
  }
  .geo-checker__btn:hover { gap: 0.9em; opacity: 0.85; }

  /* ── Para quién ───────────────────────────────────────────── */
  .geo-forwhom {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-m);
  }
  /* 768px, no 640px (unificado 2026-08-06): a 640px la grilla pasaba a 2
     columnas dentro de lo que el resto del sitio todavía trata como mobile. */
  @media (min-width: 768px) {
    .geo-forwhom { grid-template-columns: 1fr 1fr; }
  }

  /* ── Evidencia — nota honesta, sin capturas inventadas ────── */
  .geo-evidence { font-style: italic; }

  /* ── FAQ ──────────────────────────────────────────────────── */
  .geo-faq {
    margin: var(--space-m) 0 0;
    display: grid;
    gap: var(--space-l);
  }
  .geo-faq__item { margin: 0; }
  .geo-faq__q {
    font-family: var(--font-display);
    font-weight: var(--display-weight-light);
    font-size: var(--text-h3);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 0.4em;
  }
  .geo-faq__a {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--ink-mid, var(--ink-62));
    margin: 0;
    max-width: 60ch;
  }

  /* ── Cierre ───────────────────────────────────────────────── */
  /* ── SIGUIENTE SERVICIO + ÍNDICE ─────────────────────────────
     Cierra el callejón sin salida que tenían las páginas de servicio: se
     terminaba de leer y el único camino era volver al nav. */
  .geo-more {
    max-width: 1600px;
    margin-inline: auto;
    border-top: 1px solid var(--ink);
  }

  /* Destino primario — mismo gesto que .cs-next en las páginas de caso */
  .geo-next {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 3vw, 2.5rem);
    padding: clamp(2.5rem, 8vh, 5rem) var(--margin);
    text-decoration: none;
    color: var(--ink);
  }
  .geo-next__label {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-62);
    flex-shrink: 0;
  }
  .geo-next__name {
    font-family: var(--font-display);
    font-weight: var(--display-weight-light);
    font-size: var(--text-names);
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .geo-next__arrow {
    font-family: var(--font-body);
    font-size: var(--text-h3);
    margin-left: auto;
    transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .geo-next:hover .geo-next__arrow,
  .geo-next:focus-visible .geo-next__arrow {
    transform: translateX(0.35em);
  }
  .geo-next:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -4px;
  }

  /* Índice del resto — nivel secundario, tipografía de metadatos */
  .geo-index {
    padding: 0 var(--margin) clamp(2.5rem, 7vh, 4.5rem);
    border-top: 1px solid var(--hairline);
    padding-top: clamp(1.5rem, 4vh, 2.5rem);
  }
  .geo-index__label {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-62);
    margin: 0 0 var(--space-s);
  }
  .geo-index__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  .geo-index__item + .geo-index__item {
    border-top: 1px solid var(--hairline);
  }
  .geo-index__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    /* 44px de área táctil: es una lista de destinos, y tablet/mobile son
       táctiles por igual (ver Nav.astro / FooterSection.astro). */
    min-height: 44px;
    padding-block: 0.5rem;
    text-decoration: none;
    color: var(--ink);
    transition: color 0.28s ease;
  }
  .geo-index__link:hover,
  .geo-index__link:focus-visible {
    color: var(--ink-62);
  }
  .geo-index__link:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .geo-index__num {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    /* --ink-62, no --ink-42: sobre el crema el 42% da 2.7:1 y AA pide 4.5:1
       (medido). El 42% sirve para numerales fantasma decorativos, pero acá el
       numeral es parte del texto del enlace. Mismo fix que en el toggle de
       idioma del pie (QA 2026-07-21). */
    color: var(--ink-62);
    flex-shrink: 0;
  }
  .geo-index__name {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .geo-index__all {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
    margin-top: var(--space-s);
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }

  /* Desde tablet: el índice en dos columnas — son 6 items y en una sola
     columna estiraba el cierre de la página sin necesidad. */
  @media (min-width: 768px) {
    .geo-index__list {
      /* grid-auto-flow: column + 3 filas fijas → llena la PRIMERA columna
         entera antes de pasar a la segunda. Con el flujo por defecto (por
         filas) los numerales quedaban 02·03 / 04·05 / 06·07 leídos en zigzag;
         así se leen 02·04·06 hacia abajo y luego 03·05·07, que es como se lee
         un índice. */
      grid-auto-flow: column;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: repeat(3, auto);
      column-gap: var(--space-xl);
    }
    /* con 2 columnas, el primer item de la SEGUNDA columna (el 4º del orden)
       no lleva borde superior: ya lo aporta el encabezado de su columna */
    .geo-index__item:nth-child(4) {
      border-top: none;
    }
  }

  .geo-closing {
    max-width: 1600px;
    margin-inline: auto;
    padding: clamp(4rem, 12vh, 9rem) var(--margin);
    border-top: 1px solid var(--hairline);
  }
  .geo-closing__statement {
    font-family: var(--font-display);
    font-weight: var(--display-weight-hairline);
    font-size: var(--text-h2);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 20ch;
    text-wrap: balance;
  }
  .geo-closing__channels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-l);
  }

  /* ── DESKTOP: composición asimétrica num/label/contenido ──── */
  @media (min-width: 900px) {
    .geo-block {
      /* num angosto · label como índice lateral estrecho · contenido protagónico.
         Antes el label era 1fr elástico: con títulos cortos ("Por qué no rinde")
         dejaba una columna casi vacía y comprimía el contenido a la derecha, con
         mucho aire muerto. Ahora el label es una columna estrecha fija (patrón
         editorial de índice) y el contenido absorbe todo el ancho restante →
         texto ancho, legible, sin hueco. */
      grid-template-columns: minmax(0, 4rem) minmax(0, 15rem) minmax(0, 1fr);
      column-gap: clamp(2rem, 4vw, 4.5rem);
      align-items: start;
    }
    .geo-block > .geo-num { grid-column: 1; }
    .geo-block > .geo-label { grid-column: 2; }
    .geo-block > .geo-body,
    .geo-block > .geo-col3,
    .geo-block > .geo-causes,
    .geo-block > .geo-tiers,
    .geo-block > .geo-forwhom,
    .geo-block > .geo-faq { grid-column: 3; margin-top: 0; }

    .geo-stats { grid-template-columns: repeat(3, 1fr); gap: var(--space-m); }

    .geo-tier {
      grid-template-columns: minmax(0, 4rem) minmax(0, 1fr);
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }
    .geo-tier > .geo-num { grid-column: 1; padding-top: 0.4em; }
    .geo-tier > .geo-tier__name,
    .geo-tier > .geo-tier__price,
    .geo-tier > .geo-body,
    .geo-tier > .geo-includes__label,
    .geo-tier > .geo-includes { grid-column: 2; }
  }

  /* ── Entrada del resultado del checker ────────────────────────
     Misma curva y duración que [data-geo-reveal] — el resultado se
     comporta como cualquier bloque del sitio, no como un widget aparte.
     Los bloques del informe entran escalonados con un delay por índice que
     pone el JS en --i; el score cuenta de 0 a su valor (ver script). */
  :global(.geo-report__fix),
  :global(.geo-report__ok),
  :global(.geo-report__nodata),
  :global(.geo-result .geo-cta) {
    opacity: 0;
    transform: translateY(14px);
    animation: geo-result-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i, 0) * 55ms);
  }

  @keyframes geo-result-in {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.geo-report__fix),
    :global(.geo-report__ok),
    :global(.geo-report__nodata),
    :global(.geo-result .geo-cta) {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  /* ── Reveal (mismo patrón del sitio) ──────────────────────── */
  [data-geo-reveal] {
    opacity: 0;
    transform: translateY(24px);
  }
  [data-geo-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-geo-reveal] { opacity: 1; transform: none; }
  }
</style>

<script>
  /* ── Reveal on scroll ─────────────────────────────────────── */
  const els = document.querySelectorAll('[data-geo-reveal]');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) {
    els.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -12% 0px' }
    );
    els.forEach((el) => io.observe(el));
  }

  /* ── Hint de moneda local ─────────────────────────────────────
     Sin APIs ni geolocalización: timezone → moneda, tasas aproximadas.
     Tasas de referencia al 2026-08-04 (actualizar de vez en cuando):
     TRM COP 3.144 · MXN 17,7 · CLP 925 · PEN 3,6 · EUR 0,90.
     ARS omitido a propósito: bimonetario + volatilidad → cualquier tasa
     fija sería errada en días; ese público lee USD con naturalidad. */
  const TZ_CURRENCY: Record<string, [string, number, string]> = {
    'America/Bogota': ['COP', 3144, 'es-CO'],
    'America/Mexico_City': ['MXN', 17.7, 'es-MX'],
    'America/Monterrey': ['MXN', 17.7, 'es-MX'],
    'America/Cancun': ['MXN', 17.7, 'es-MX'],
    'America/Tijuana': ['MXN', 17.7, 'es-MX'],
    'America/Lima': ['PEN', 3.6, 'es-PE'],
    'America/Santiago': ['CLP', 925, 'es-CL'],
    'Europe/Madrid': ['EUR', 0.9, 'es-ES'],
    'Atlantic/Canary': ['EUR', 0.9, 'es-ES'],
  };
  try {
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const hit = TZ_CURRENCY[tz];
    if (hit) {
      const [currency, rate, locale] = hit;
      document.querySelectorAll<HTMLElement>('[data-usd]').forEach((el) => {
        const usdVal = Number(el.dataset.usd);
        if (!usdVal) return;
        const local = new Intl.NumberFormat(locale, {
          style: 'currency',
          currency,
          maximumFractionDigits: 0,
        }).format(usdVal * rate);
        const prefix = el.dataset.prefix ? `${el.dataset.prefix} ` : '';
        el.textContent = `≈ ${prefix}${local} ${currency} aprox.`;
      });
    }
  } catch { /* sin hint — la página funciona igual en USD */ }

  /* ── Checker GEO v2: análisis técnico REAL en /api/geo-check ─────
     v1 mandaba la URL a WhatsApp sin analizar nada — el input con botón
     parecía una herramienta y no lo era (William 2026-08-05). Ahora el
     endpoint descarga el sitio y corre checks verificables (robots.txt vs
     bots de IA, schema, headings, sitemap…) y devuelve un score con las 3
     prioridades. El contacto por WhatsApp queda DESPUÉS del resultado, ya
     con el diagnóstico en la mano. */
  const form = document.querySelector<HTMLFormElement>('[data-geo-checker]');
  const waBase = document.querySelector<HTMLElement>('[data-wa-base]')?.dataset.waBase;
  const out = document.querySelector<HTMLElement>('[data-geo-result]');

  if (form && out) {
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const btnHtml = btn?.innerHTML ?? '';
    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[name="siteurl"]');
      const url = input?.value.trim();
      if (!url) return;

      if (btn) { btn.disabled = true; btn.textContent = form.dataset.loadingLabel || 'Analizando…'; }
      out.hidden = false;
      out.innerHTML = `<p class="geo-result__loading">${esc(form.dataset.loadingLabel || 'Analizando…')}</p>`;

      try {
        const res = await fetch('/api/geo-check', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url }),
        });
        const data = await res.json();

        if (!data.ok) {
          const waMsg = `${form.dataset.waMessage ?? ''} ${url}`;
          const waLink = waBase
            ? `${waBase}?text=${encodeURIComponent(waMsg)}`
            : `mailto:info@scuart.com?subject=${encodeURIComponent('Chequeo GEO')}&body=${encodeURIComponent(waMsg)}`;
          out.innerHTML =
            `<p class="geo-result__error">${esc(data.message || 'No pudimos analizar ese sitio.')}</p>` +
            `<a class="geo-cta" href="${waLink}" target="_blank" rel="noopener noreferrer">${esc(form.dataset.waCta || 'Escribinos y lo vemos a mano')} <span aria-hidden="true">↗</span></a>`;
          return;
        }

        /* ── Informe, no lista ────────────────────────────────────────
           Antes esto era una lista plana de 8 ítems donde un ✕ crítico pesaba
           lo mismo que un ✓ menor, y el número suelto no decía qué hacer
           (William: "el resultado es algo que no se entiende"). Ahora:
             1. Veredicto en UNA frase — qué significa ese número.
             2. Lo que hay que arreglar, con el detalle de QUÉ hacer, ordenado
                por severidad. Es lo primero que se lee porque es lo accionable.
             3. Lo que ya está bien, en una lista compacta y secundaria.
             4. Lo que no se pudo medir, aparte y sin fingir veredicto. */
        type Chk = { pass: boolean; label: string; detail: string; skipped: boolean; nivel: string };
        const nivel = data.score >= 80 ? 'alto' : data.score >= 55 ? 'medio' : 'bajo';
        const checks: Chk[] = data.checks;
        /* Ordenar por severidad. `data.prioridades` ya viene ordenado pero solo
           trae 3; acá se listan TODAS las fallas, así que hay que reordenarlas
           o salen en orden de declaración del endpoint — con el crítico
           enterrado debajo de dos menores, que es exactamente lo contrario de
           lo que un informe tiene que hacer. */
        const RANGO: Record<string, number> = { critico: 0, importante: 1, menor: 2 };
        const fallan = checks
          .filter(c => !c.pass && !c.skipped)
          .sort((a, b) => (RANGO[a.nivel] ?? 2) - (RANGO[b.nivel] ?? 2));
        const pasan = checks.filter(c => c.pass && !c.skipped);
        const sinDatos = checks.filter(c => c.skipped);

        /* El veredicto traduce el número. Un "80/100" no le dice nada a un
           dueño de negocio; "la base está, falta lo que te hace citable" sí.
           Los textos del informe los arma el JS, así que necesitan las dos
           versiones: la página EN existe y sin esto salía el informe en
           español debajo de un encabezado en inglés. */
        const en = document.documentElement.lang.startsWith('en');
        const VEREDICTO: Record<string, string> = en
          ? {
              alto: 'The technical foundation is solid. What is left are fine adjustments.',
              medio: 'AI engines can read your site, but it is missing what makes it quotable.',
              bajo: 'There are technical barriers stopping AI from understanding your business.',
            }
          : {
              alto: 'La base técnica está sólida. Lo que queda son ajustes finos.',
              medio: 'La IA puede leer tu sitio, pero le falta lo que lo hace citable.',
              bajo: 'Hay barreras técnicas que le impiden a la IA entender tu negocio.',
            };
        const ETIQUETA: Record<string, string> = en
          ? { critico: 'Critical', importante: 'Important', menor: 'Minor' }
          : { critico: 'Crítico', importante: 'Importante', menor: 'Menor' };
        const TXT = en
          ? {
              perfecto: 'We found no technical failures. That is uncommon — from here the work is content, not configuration.',
              resueltos: (n: number) => `${n === 1 ? 'point' : 'points'} already solved`,
              sinDatos: 'No data',
            }
          : {
              perfecto: 'No encontramos ninguna falla técnica. Es poco común — el trabajo acá pasa a ser de contenido, no de configuración.',
              resueltos: (n: number) => `${n === 1 ? 'punto ya resuelto' : 'puntos ya resueltos'}`,
              sinDatos: 'Sin datos',
            };

        const bloqueFallas = fallan.length
          ? `<div class="geo-report__group" data-tone="fix">
               <p class="geo-report__grouplabel">
                 ${esc(form.dataset.prioLabel || 'Lo que hay que arreglar')}
                 <span class="geo-report__count">${fallan.length}</span>
               </p>
               <ol class="geo-report__fixes">${fallan.map((c, i) => `
                 <li class="geo-report__fix" data-nivel="${esc(c.nivel)}" style="--i:${i}">
                   <span class="geo-report__tag">${esc(ETIQUETA[c.nivel] ?? 'Menor')}</span>
                   <p class="geo-report__fixtitle">${esc(c.label)}</p>
                   <p class="geo-report__fixdetail">${esc(c.detail)}</p>
                 </li>`).join('')}</ol>
             </div>`
          : `<p class="geo-report__perfect">${esc(TXT.perfecto)}</p>`;

        /* Lo que pasa va colapsado: confirma sin competir con lo accionable. */
        const bloqueOk = pasan.length
          ? `<details class="geo-report__ok">
               <summary><span class="geo-report__okcount">${pasan.length}</span> ${esc(TXT.resueltos(pasan.length))}</summary>
               <ul class="geo-report__oklist">${pasan.map(c => `
                 <li><span aria-hidden="true">✓</span> <strong>${esc(c.label)}</strong> <span class="geo-report__okdetail">${esc(c.detail)}</span></li>`).join('')}</ul>
             </details>`
          : '';

        const bloqueSinDatos = sinDatos.length
          ? `<div class="geo-report__nodata">${sinDatos.map(c => `
               <p><strong>${esc(TXT.sinDatos)} — ${esc(c.label)}.</strong> ${esc(c.detail)}</p>`).join('')}</div>`
          : '';

        const waMsg = `${form.dataset.waMessage ?? ''} ${data.url} (score ${data.score}/100)`;
        const waLink = waBase
          ? `${waBase}?text=${encodeURIComponent(waMsg)}`
          : `mailto:info@scuart.com?subject=${encodeURIComponent('Chequeo GEO')}&body=${encodeURIComponent(waMsg)}`;

        out.innerHTML =
          `<div class="geo-result__head">
             <span class="geo-result__score" data-nivel="${nivel}"><span data-score-num>0</span><span class="geo-result__score-max">/100</span></span>
             <div class="geo-result__headtext">
               <p class="geo-result__scorelabel">${en ? 'Technical readiness' : 'Preparación técnica'} · ${esc(data.host)}</p>
               <p class="geo-report__verdict">${esc(VEREDICTO[nivel])}</p>
             </div>
           </div>
           ${bloqueFallas}
           ${bloqueOk}
           ${bloqueSinDatos}
           <p class="geo-result__disclaimer">${
             en
               ? 'This measures whether AI <strong>can</strong> read you. It does not measure whether it <strong>mentions</strong> you — that is found by asking the engines, and that is the diagnosis.'
               : 'Esto mide si la IA <strong>puede</strong> leerte. No mide si te <strong>menciona</strong> — eso se sabe preguntándole a los motores, y es el diagnóstico.'
           }</p>
           <a class="geo-cta" href="${waLink}" target="_blank" rel="noopener noreferrer">${esc(form.dataset.waCta || 'Hablemos del resto')} <span aria-hidden="true">↗</span></a>`;

        /* Stagger sobre los bloques del informe, no sobre 8 ítems sueltos. */
        const animables = out.querySelectorAll<HTMLElement>('.geo-report__fix, .geo-report__ok, .geo-report__nodata, .geo-cta');
        animables.forEach((el, i) => el.style.setProperty('--i', String(i)));

        /* Conteo del score 0 → valor. Da la sensación de "medición" en curso.
           Se salta si el visitante pidió menos movimiento. */
        const numEl = out.querySelector<HTMLElement>('[data-score-num]');
        const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (numEl && !quieto && data.score > 0) {
          const dur = 900;
          const t0 = performance.now();
          const tick = (t: number) => {
            const p = Math.min(1, (t - t0) / dur);
            /* easeOutExpo — arranca rápido y frena, como un contador real */
            const e = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
            numEl.textContent = String(Math.round(data.score * e));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        } else if (numEl) {
          numEl.textContent = String(data.score);
        }

        out.setAttribute('tabindex', '-1');
        out.focus({ preventScroll: true });
      } catch {
        out.innerHTML = `<p class="geo-result__error">${esc(form.dataset.errorLabel || 'Algo falló. Probá de nuevo o escribinos.')}</p>`;
      } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = btnHtml; }
      }
    });
  }
</script>
