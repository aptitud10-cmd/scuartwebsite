---
/**
 * PortfolioSection.astro — Portfolio V4 · Work index tipográfico (patrón Locomotive)
 * SCUART — patrón "inline image en título" (referencia: locomotive.ca/en/work,
 * aprobado por William 2026-06-10, reafirmado 2026-06-17)
 *
 * ARQUITECTURA (fiel a Locomotive /work):
 *   - Lista vertical de 4 proyectos, SIN featured: museo, los 4 uniformes
 *   - Nombre PP Editorial New light GIGANTE centrado, capitalización normal
 *     (no mayúsculas), hairlines 1px borde a borde. SIN numeral ni ficha lateral.
 *   - Desktop hover/focus: la imagen se INCRUSTA inline dentro del nombre
 *     (entre la 1ª y 2ª palabra; prefijo si el nombre es una sola palabra)
 *   - Mobile/tablet: imagen SIEMPRE visible en reposo
 *   - Sin páginas de caso todavía → las filas NO son links
 *
 * COLOR V4 "Restringido": fondo negro --bg, nombres hueso --ink, hover → lima --brand.
 * Imágenes: versiones -trim (mockup de navegador sin fondo blanco).
 *
 * MOTION (spec ART_DIRECTION_MOTION_V4.md, restraint):
 *   - Entrada: IntersectionObserver + transición CSS fade-up, stagger 80ms
 *   - Hover: width 0→1.6em + opacity de la imagen inline, 280ms ease-out
 *   - prefers-reduced-motion: todo estático; inline aparece sin animación
 */

import type { Translations } from '../i18n/en';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const projects = t.portfolio.projects;

/**
 * Split del nombre para incrustar la imagen inline (idéntico EN/ES — son
 * nombres propios): 1 palabra → imagen como prefijo; 2+ → entre la 1ª y el resto.
 */
const rows = projects.map((p, i) => {
  const words = p.name.split(' ');
  const isPrefix = words.length === 1;
  return {
    ...p,
    isPrefix,
    before: isPrefix ? '' : words[0],
    after: isPrefix ? p.name : words.slice(1).join(' '),
    delay: `${i * 80}ms`,
    eager: i === 0,
  };
});
---

<section class="pf" aria-label={t.portfolio.sectionLabel} id="portfolio">
  <div class="pf-kicker-wrap">
    <p class="pf-kicker">{t.portfolio.sectionLabel}</p>
  </div>

  <ol class="pf-list">
    {rows.map((row) => (
      <li class="pf-row" style={`transition-delay: ${row.delay}`}>
        <a href={row.href} class="pf-row__link" aria-label={row.name}>
          <!-- Ficha técnica anclada al borde izquierdo — V5 (numeral · category · year) -->
          <p class="pf-meta" aria-hidden="true">
            <span class="pf-meta__num">{row.num}·</span>
            <span class="pf-meta__detail">{row.category} · {row.year}</span>
          </p>

          <!-- Nombre gigante con la imagen incrustada inline (desktop) -->
          <!-- prettier-ignore — los spans van pegados: el único espacio del nombre
               es el explícito dentro del último pf-word (evita doble gap en reposo) -->
          <h2 class="pf-name">
            {row.isPrefix
              ? <><span class="pf-inline" aria-hidden="true"><img src={row.image} alt="" loading="lazy" decoding="async" width="640" height="400" /></span><span class="pf-word">{row.after}</span></>
              : <><span class="pf-word">{row.before}</span><span class="pf-inline" aria-hidden="true"><img src={row.image} alt="" loading="lazy" decoding="async" width="640" height="400" /></span><span class="pf-word">{` ${row.after}`}</span></>
            }
          </h2>

          <!-- Imagen en reposo — mobile/tablet -->
          <div class="pf-stack-img">
            <img
              src={row.image}
              alt={row.alt}
              loading={row.eager ? 'eager' : 'lazy'}
              decoding="async"
              width="1280"
              height="800"
            />
          </div>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .pf {
    background-color: var(--bg);
    padding-block: 0;
  }

  .pf-kicker-wrap {
    padding-inline: var(--margin);
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
  }

  .pf-kicker {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    /* --ink-62 (62%) pasa WCAG AA 4.5:1 sobre --bg; --ink-42 daba 2.7:1 (fail) */
    color: var(--ink-62);
  }

  .pf-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  /* ── Ficha técnica anclada al borde izquierdo — V5 ─────────
   * Numeral + category + year pegados al margen izquierdo.
   * En mobile: arriba del nombre (flujo normal).
   * En desktop: posición absoluta, alineada a la primera línea del nombre.
   */
  .pf-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    margin: 0 0 var(--space-xs) 0;
    line-height: 1.3;
  }

  .pf-meta__num {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 400;
    /* --ink-62 (4.99:1) pasa AA; --ink-42 daba 2.71:1. La jerarquía vs
       .pf-meta__detail se mantiene por el weight (400 vs 500). */
    color: var(--ink-62);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }

  .pf-meta__detail {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    color: var(--ink-62);
    text-transform: uppercase;
    letter-spacing: 0.10em;
  }

  .pf-row {
    position: relative;
    border-bottom: 1px solid var(--ink);
    /* entrada fade-up via IntersectionObserver */
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pf-row.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .pf-row__link {
    display: block;
    padding: clamp(1.5rem, 2.5vw, 2.25rem) var(--margin);
    text-decoration: none;
    color: inherit;
  }

  .pf-row__link:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }

  /* ── Nombre gigante — capitalización normal (como Locomotive) ─ */
  .pf-name {
    font-family: var(--font-display);
    font-weight: 200;
    font-size: clamp(3.5rem, 13vw, 5rem);
    line-height: 1.0;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-align: center;
    text-transform: none;
    margin: 0;
  }

  .pf-word {
    /* las palabras del nombre fluyen con la imagen inline entre ellas */
    white-space: pre-wrap;
  }

  /* ── Imagen inline (gesto Locomotive) — solo desktop con hover ── */
  .pf-inline {
    display: none;
  }

  /* ── Imagen en reposo — mobile/tablet stack ─────────────── */
  .pf-stack-img {
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }

  .pf-stack-img img {
    display: block;
    width: 100%;
    height: auto;
    /* 16:10 — encuadra el mockup de navegador (trim ~1.85:1) sin recortar la barra */
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  /* ── Tablet (769-1023): igual stack, título más grande ──── */
  @media (min-width: 769px) {
    .pf-name {
      font-size: clamp(5rem, 10vw, 7rem);
    }

    .pf-stack-img img {
      max-width: 720px;
      margin-inline: auto;
    }
  }

  /* ── Desktop (>=1024 + hover real): work index Locomotive ── */
  @media (min-width: 1024px) and (hover: hover) {
    .pf-row__link {
      padding-block: clamp(1.25rem, 1.8vw, 2rem);
      padding-inline: var(--margin);
    }

    /* Hover: solo aparece la imagen incrustada en el nombre (Locomotive limpio).
       La fila NO se pinta de negro — se quitó la inversión (decisión William). */

    /* Ficha: absoluta, borde izquierdo del padding, alineada a la primera línea del nombre */
    .pf-meta {
      position: absolute;
      left: var(--margin);
      top: clamp(1.25rem, 1.8vw, 2rem);
      margin: 0;
      gap: 0.2em;
    }

    .pf-name {
      /* vw contenido (como Locomotive): nombres largos dejan aire lateral
         en pantallas grandes en vez de tocar los bordes. Piso más alto para
         que los nombres cortos no queden chicos. */
      font-size: clamp(6rem, 8.5vw, 11rem);
      text-align: center;
    }

    /* la imagen en reposo desaparece — el reposo desktop es tipográfico */
    .pf-stack-img {
      display: none;
    }

    /* imagen incrustada en el flujo del nombre */
    .pf-inline {
      display: inline-block;
      height: 0.82em;
      width: 0;
      overflow: hidden;
      vertical-align: -0.08em;
      opacity: 0;
      transition:
        width 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94),
        opacity 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94),
        margin 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .pf-inline img {
      display: block;
      height: 100%;
      width: calc(0.82em * 16 / 10);
      object-fit: cover;
    }

    .pf-row__link:hover .pf-inline,
    .pf-row__link:focus-visible .pf-inline {
      width: calc(0.82em * 16 / 10);
      opacity: 1;
      margin-inline: 0.12em;
    }

    /* ── Gesto propio SCUART (diferenciación de Locomotive, auditoría
       2026-07-21): la imagen inline lleva marco lima --brand — Locomotive la
       muestra a sangre, sin marco. El lima solo vive DENTRO del hover (sobre
       la foto oscura contrasta; sobre el crema del fondo moriría). ── */
    .pf-inline {
      border: 3px solid var(--brand);
      box-sizing: border-box;
    }
  }

  /* ── prefers-reduced-motion: todo estático y visible ────── */
  @media (prefers-reduced-motion: reduce) {
    .pf-row {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .pf-inline {
      transition: none;
    }
  }
</style>

<script>
  /* Entrada fade-up de las filas — stagger via transition-delay inline */
  const rows = document.querySelectorAll<HTMLElement>('.pf-row');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReduced) {
    rows.forEach((row) => row.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.2 }
    );
    rows.forEach((row) => io.observe(row));
  }
</script>
