---
/**
 * PortfolioSection.astro — Portfolio V3 · Work index tipográfico
 * SCUART — patrón "inline image en título" (referencia: locomotive.ca/en/work,
 * aprobado por William 2026-06-10) + redesign/RESEARCH_PORTFOLIO_2026.md
 *
 * ARQUITECTURA:
 *   - Lista vertical de 4 proyectos, SIN featured: museo, los 4 uniformes
 *   - Nombre Fraunces light GIGANTE centrado, hairlines 1px de borde a borde
 *   - Ficha mono real (num / category · year) en los extremos de cada fila
 *   - Desktop hover/focus: la imagen se INCRUSTA inline dentro del nombre
 *     (entre la 1ª y 2ª palabra; prefijo si el nombre es una sola palabra)
 *   - Mobile/tablet: imagen SIEMPRE visible en reposo (bloqueante del critic)
 *   - Sin páginas de caso todavía → las filas NO son links (nada de href="#")
 *
 * MOTION (restraint, P6 — sin GSAP/ScrollTrigger):
 *   - Entrada: IntersectionObserver + transición CSS fade-up, stagger 80ms
 *   - Hover: width 0→1.6em + opacity de la imagen inline, 280ms ease-out
 *   - prefers-reduced-motion: todo estático; inline aparece sin animación
 */

import type { Translations } from '../i18n/en';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const projects = t.portfolio.projects;

/**
 * Split del nombre para incrustar la imagen inline (idéntico EN/ES — son
 * nombres propios): 1 palabra → imagen como prefijo; 2+ → entre la 1ª y el resto.
 */
const rows = projects.map((p, i) => {
  const words = p.name.split(' ');
  const isPrefix = words.length === 1;
  return {
    ...p,
    isPrefix,
    before: isPrefix ? '' : words[0],
    after: isPrefix ? p.name : words.slice(1).join(' '),
    delay: `${i * 80}ms`,
    eager: i === 0,
  };
});
---

<section class="pf" aria-label={t.portfolio.sectionLabel} id="portfolio">
  <div class="pf-kicker-wrap">
    <p class="pf-kicker">{t.portfolio.sectionLabel}</p>
  </div>

  <ol class="pf-list">
    {rows.map((row) => (
      <li class="pf-row" tabindex="0" style={`transition-delay: ${row.delay}`}>
        <!-- Ficha mono — datos reales en los extremos de la fila -->
        <span class="pf-meta pf-meta--num" aria-hidden="true">{row.num}</span>
        <span class="pf-meta pf-meta--cat">{row.category} · {row.year}</span>

        <!-- Nombre gigante con la imagen incrustada inline (desktop) -->
        <!-- prettier-ignore — los spans van pegados: el único espacio del nombre
             es el explícito dentro del último pf-word (evita doble gap en reposo) -->
        <h3 class="pf-name">
          {row.isPrefix
            ? <><span class="pf-inline" aria-hidden="true"><img src={row.image} alt="" loading="lazy" decoding="async" width="640" height="360" /></span><span class="pf-word">{row.after}</span></>
            : <><span class="pf-word">{row.before}</span><span class="pf-inline" aria-hidden="true"><img src={row.image} alt="" loading="lazy" decoding="async" width="640" height="360" /></span><span class="pf-word">{` ${row.after}`}</span></>
          }
        </h3>

        <!-- Imagen en reposo — mobile/tablet (regla dura del critic) -->
        <div class="pf-stack-img">
          <img
            src={row.image}
            alt={row.alt}
            loading={row.eager ? 'eager' : 'lazy'}
            decoding="async"
            width="1280"
            height="720"
          />
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .pf {
    background-color: var(--hueso);
    padding-block: clamp(4rem, 8vw, 7rem) 0;
  }

  .pf-kicker-wrap {
    padding-inline: var(--margin);
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .pf-kicker {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }

  .pf-list {
    list-style: none;
    margin: 0;
    padding: 0;
    /* hairline superior del índice — full-bleed */
    border-top: 1px solid var(--borde);
  }

  .pf-row {
    position: relative;
    border-bottom: 1px solid var(--borde);
    padding: clamp(2rem, 4vw, 3.5rem) var(--margin);
    /* entrada fade-up via IntersectionObserver */
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pf-row.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .pf-row:focus-visible {
    outline: 2px solid var(--terracota);
    outline-offset: -2px;
  }

  /* ── Ficha mono ─────────────────────────────────────────── */
  .pf-meta {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    transition: color 0.28s ease;
  }

  /* ── Nombre gigante ─────────────────────────────────────── */
  .pf-name {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.5rem, 10vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--tinta);
    text-align: center;
    margin: 0;
    transition: color 0.28s ease;
  }

  .pf-word {
    /* las palabras del nombre fluyen con la imagen inline entre ellas */
    white-space: pre-wrap;
  }

  /* ── Imagen inline (gesto Locomotive) — solo desktop con hover ── */
  .pf-inline {
    display: none;
  }

  /* ── Imagen en reposo — mobile/tablet stack ─────────────── */
  .pf-stack-img {
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }

  .pf-stack-img img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* ── Mobile: ficha arriba de la fila, en los extremos ───── */
  .pf-meta--num {
    position: absolute;
    top: 0.875rem;
    left: var(--margin);
  }

  .pf-meta--cat {
    position: absolute;
    top: 0.875rem;
    right: var(--margin);
    text-align: right;
  }

  /* ── Tablet (769-1023): igual stack, título más grande ──── */
  @media (min-width: 769px) {
    .pf-name {
      font-size: clamp(3.5rem, 8vw, 4rem);
    }

    .pf-stack-img img {
      max-width: 640px;
      margin-inline: auto;
    }
  }

  /* ── Desktop (>=1024 + hover real): work index Locomotive ── */
  @media (min-width: 1024px) and (hover: hover) {
    .pf-row {
      padding-block: clamp(3rem, 4.5vw, 4rem);
    }

    .pf-name {
      font-size: clamp(4.5rem, 5.5vw, 6.5rem);
    }

    /* la imagen en reposo desaparece — el reposo desktop es tipográfico */
    .pf-stack-img {
      display: none;
    }

    /* ficha centrada verticalmente en los extremos de la fila */
    .pf-meta--num,
    .pf-meta--cat {
      top: 50%;
      transform: translateY(-50%);
    }

    /* imagen incrustada en el flujo del nombre */
    .pf-inline {
      display: inline-block;
      height: 0.82em;
      width: 0;
      overflow: hidden;
      vertical-align: -0.08em;
      opacity: 0;
      transition:
        width 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94),
        opacity 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94),
        margin 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .pf-inline img {
      display: block;
      height: 100%;
      width: calc(0.82em * 16 / 9);
      object-fit: cover;
    }

    .pf-row:hover .pf-inline,
    .pf-row:focus-visible .pf-inline {
      width: calc(0.82em * 16 / 9);
      opacity: 1;
      margin-inline: 0.12em;
    }

    .pf-row:hover .pf-name,
    .pf-row:focus-visible .pf-name {
      color: var(--terracota);
    }

    .pf-row:hover .pf-meta,
    .pf-row:focus-visible .pf-meta {
      color: var(--tinta);
    }
  }

  /* ── prefers-reduced-motion: todo estático y visible ────── */
  @media (prefers-reduced-motion: reduce) {
    .pf-row {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .pf-inline {
      transition: none;
    }
  }
</style>

<script>
  /* Entrada fade-up de las filas — stagger via transition-delay inline */
  const rows = document.querySelectorAll<HTMLElement>('.pf-row');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReduced) {
    rows.forEach((row) => row.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.2 }
    );
    rows.forEach((row) => io.observe(row));
  }
</script>
