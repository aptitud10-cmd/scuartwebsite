---
/**
 * ManifestoSection.astro — LA sección de marca de SCUART.
 * V3: fondo terracota full-bleed, grano fuerte, Fraunces display.
 *
 * ART_DIRECTION_V3_FINAL.md §5-MANIFESTO:
 * - Fondo --terracota (#A4471F) a pantalla completa con grano más fuerte (soft-light 0.08).
 * - Tipografía: Fraunces light 300, leading 1.02, letra hueso.
 * - Acento: --ambar en Fraunces itálica 400 (sobre terracota ~3.5:1 a 32px+ — OK display).
 * - Kicker: Hanken 500 uppercase tracking +0.14em, hueso 65%.
 * - Composición escalonada: line1 izquierda, line2 sangrada → rompe la grilla.
 * - Motion: máscara por líneas (patrón V3 del hero), una sola vez. Sin parallax.
 * - Corte directo hero→terracota: sin border-top (la alternancia ES el diseño).
 * - prefers-reduced-motion: todo estático y visible.
 */

import type { Translations } from '../i18n/en';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section class="manifesto" aria-label={t.manifesto.ariaLabel}>

  <!--
    Kicker — Hanken 500 uppercase, tracking +0.14em.
    Sistema de índices V3: "N°·01 / MANIFESTO".
    Color: hueso al 65% de opacidad sobre terracota.
    Igual en EN y ES (coherencia del sistema técnico).
  -->
  <p class="manifesto-kicker">{t.manifesto.kicker}</p>

  <!--
    Statement — Fraunces light 300, escalonado intencionalmente.
    Line1: alineada al margen izquierdo (col 1).
    Line2: sangrada hacia la derecha — rompe la grilla (spec §5).
    HTML real server-rendered: indexable sin JS.
    El acento (line2red) va en Fraunces itálica ambar — NO rojo (V3).
  -->
  <div class="manifesto-statement">
    <p class="manifesto-line manifesto-line--1">{t.manifesto.line1}</p>
    <p class="manifesto-line manifesto-line--2">
      {t.manifesto.line2a}<em class="manifesto-accent">{t.manifesto.line2red}</em>
    </p>
  </div>

  <!--
    Ancla inferior — tercer punto de peso que completa el 100vh (evita el
    "vacío" de dos líneas centradas en pantalla completa). Reutiliza el label
    del portfolio (la sección que sigue): el ancla ES el puente hacia el
    trabajo. aria-hidden: es señalética visual, no contenido navegable
    (el portfolio ya tiene su propio encabezado).
  -->
  <p class="manifesto-anchor" aria-hidden="true">{t.portfolio.sectionLabel} <span class="manifesto-anchor__arrow">↓</span></p>

</section>

<style>
/* ═══════════════════════════════════════════════════════════
   MANIFESTO SECTION — V3
   Mobile-first: 375px base. md: 768px. lg: 1280px.
   Fondo: --terracota. LA sección de marca del sitio.
   Corte directo con el hero (hueso→terracota): sin border.
   ═══════════════════════════════════════════════════════════ */

.manifesto {
  /* V4 Restringido: cuerpo oscuro de punta a punta (ART_DIRECTION_V4_RESTRINGIDO §4.1) */
  background-color: var(--bg);
  position: relative;
  overflow: hidden;

  /* Pantalla completa (decisión William 2026-07-28). Antes ocupaba solo el
     alto del contenido (~624px en 900) y se leía "corta". El statement de
     marca merece el viewport entero.
     svh = small viewport height: no se pelea con la barra dinámica de Safari.
     La grilla de 3 filas reparte ese alto en tercios (kicker arriba /
     statement al centro / ancla abajo) para que el 100vh se LLENE con
     jerarquía en vez de dejar crema muerto — el error de centrar 2 líneas
     solas en pantalla completa. */
  min-height: 100svh;
  display: grid;
  grid-template-rows: auto 1fr auto;
  box-sizing: border-box;

  /* Aire vertical proporcional al viewport (vh) en vez de tokens fijos: en
     pantallas altas el kicker/ancla no se pegan a los bordes. */
  padding-top: clamp(2rem, 8vh, 6rem);
  padding-bottom: clamp(1.5rem, 6vh, 4.5rem);
  padding-left: var(--margin);
  padding-right: var(--margin);
}

/* ─── KICKER ─────────────────────────────────────────────── */
/*
 * Geist 500 uppercase +0.14em tracking — sistema de índices.
 * Color: blanco 55% + difference (reacciona al plano azul, da un matiz legible).
 */
.manifesto-kicker {
  position: relative;
  z-index: 1;
  grid-row: 1;                     /* fila superior del 100vh */
  align-self: start;
  font-family: var(--font-body);   /* Geist Sans */
  font-size: var(--text-mono);     /* clamp(0.6875rem, 0.3vw + 0.6rem, 0.8125rem) = 11-13px */
  font-weight: 500;
  color: var(--ink-62);            /* hueso 62% sobre negro */
  text-transform: uppercase;
  letter-spacing: 0.14em;           /* sistema de índices: +0.14em exacto */
  line-height: 1.4;
  margin-bottom: 0;                 /* el grid reparte el alto, no el margin */
  text-align: center;              /* centrado grande — kicker alineado al eje */
}

/* ─── STATEMENT ─────────────────────────────────────────── */
/*
 * Contenedor de las 2 líneas del manifiesto.
 * z-index: 1 para quedar sobre el grano.
 */
.manifesto-statement {
  position: relative;
  z-index: 1;
  grid-row: 2;                     /* fila central del 100vh — protagonista */
  align-self: center;
  /* Centrado grande: el statement ocupa el ancho del contenedor (con el
     padding del .manifesto). Cada frase-<p> se centra y quiebra natural. */
  margin-inline: auto;
}

/* ─── ANCLA INFERIOR ─────────────────────────────────────────
 * Tercer punto de peso que cierra el 100vh. Mismo lenguaje del kicker
 * (Geist 500 uppercase +0.14em) para que lean como par arriba/abajo.
 * La flecha ↓ señala el portfolio que sigue.
 */
.manifesto-anchor {
  position: relative;
  z-index: 1;
  grid-row: 3;                     /* fila inferior del 100vh */
  align-self: end;
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  color: var(--ink-62);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  line-height: 1.4;
  margin: 0;
  text-align: center;
}

.manifesto-anchor__arrow {
  display: inline-block;
  margin-left: 0.4em;
  /* rebote sutil y lento — invita a bajar sin gritar */
  animation: manifesto-anchor-bob 2.4s ease-in-out infinite;
}

@keyframes manifesto-anchor-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(0.25em); }
}

@media (prefers-reduced-motion: reduce) {
  .manifesto-anchor__arrow { animation: none; }
}

/* ─── LÍNEAS ─────────────────────────────────────────────── */
/*
 * Fraunces Variable weight 300 (light) — en tamaño display grande el peso bajo es elegante.
 * Leading 1.02: apretado editorial (ART_DIRECTION §3: "1.0–1.05").
 * Tracking: -0.025em (ART_DIRECTION §3: "-0.02 a -0.03em en display grande").
 * Color: hueso (#F0E9DC) sobre terracota → contraste ~5:1 (OK para display ≥24px).
 * Escala: clamp(2rem, 5.5vw, 4.5rem) — Display L del doc. En Fraunces sin wdth axis.
 */
.manifesto-line {
  font-family: var(--font-display);   /* PP Editorial New */
  font-weight: 300;                   /* light — elegante en gigante */
  font-style: normal;
  /* Centrado grande + escala protagonista: ~83px @1280px. Sube de 64→83px
     para que el statement de marca NO quede más chico que los nombres del
     portfolio (~109px) — corrige jerarquía invertida, queda por debajo a
     propósito (el portfolio es el techo de escala del sitio). */
  font-size: clamp(2.5rem, 6.5vw, 5.75rem);
  line-height: 1.05;
  letter-spacing: -0.025em;
  color: var(--ink);                  /* hueso cálido sobre negro */
  margin: 0;
  text-align: center;                 /* centrado grande */
  text-wrap: balance;                 /* quiebre equilibrado de cada frase */
  overflow-wrap: anywhere;           /* anti-overflow mobile: "ventajas competitivas." */
  hyphens: manual;
}

.manifesto-line--1 {
  margin-bottom: 0.05em;
}

.manifesto-line--2 {
  /* Centrado grande: ambas líneas centradas en el eje, sin escalonado */
}

/* ─── ACENTO — ITÁLICA (no color) ───────────────────────────
 * Sistema unificado (§5): el énfasis YA NO es un color distinto (ámbar muere).
 * Es la ITÁLICA de PP Editorial New. El color lo da el difference, igual que el resto.
 * <em> correcto semánticamente: el acento es énfasis tipográfico.
 */
.manifesto-accent {
  font-style: italic;
  font-weight: 400;      /* itálica con más expresión que el 300 upright */
  color: inherit;        /* hereda el blanco+difference de la línea */
}

/* ─── REVEAL — sistema V3 de máscara por líneas ────────────
 * Patrón heredado del hero (Momento 1): line-mask + line-inner.
 * El JS crea las máscaras dinámicamente y anima con GSAP/CSS.
 * Estado por defecto (sin clases JS): texto plano visible — progressive enhancement.
 *
 * .manifesto-animating: añadido por JS al <section> antes del reveal.
 *   Activa las máscaras para ocultar las líneas antes de la animación.
 * ─────────────────────────────────────────────────────────── */

/* Sin .manifesto-animating: todo visible (progressive enhancement) */

/* Con .manifesto-animating activo: las líneas esperan el reveal */
.manifesto-animating .line-inner {
  transform: translateY(105%);
}

/* Clase .is-visible añadida por JS línea por línea: la máscara se levanta */
.manifesto-animating .line-inner.is-visible {
  transform: translateY(0);
  transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Stagger: cada línea tiene un delay incremental seteado vía JS (inline style) */

/* ─── reduced-motion ─────────────────────────────────────── */
/*
 * Sin motion: el reveal NO se activa.
 * El color terracota, el grano y la tipografía SE MANTIENEN (son identidad, no motion).
 * El sitio queda 100% legible y navegable sin ninguna animación.
 */
@media (prefers-reduced-motion: reduce) {
  .manifesto-animating .line-inner {
    transform: translateY(0) !important;
    transition: none !important;
  }
}

/* ═══════════════════════════════════════════════════════════
   TABLET (768px+) — escala intermedia
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 768px) {
  .manifesto-line {
    hyphens: none;
    overflow-wrap: normal;
  }
}

/* ═══════════════════════════════════════════════════════════
   DESKTOP (1280px+) — sangría dramática, escala máxima
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 1280px) {
  .manifesto-line {
    hyphens: none;
    overflow-wrap: normal;
  }
}
</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isDesktop = window.matchMedia('(min-width: 769px)').matches;

  const section = document.querySelector<HTMLElement>('.manifesto');
  if (!section) { console.warn('[Manifesto] section not found'); }
  else {

  /* ── REVEAL EN SCROLL ── */
  if (prefersReduced) {
    /* noop — CSS ya garantiza visibilidad */
  } else if (isDesktop) {
    /* DESKTOP: SplitText + ScrollTrigger */
    try {
      const { gsap } = await import('gsap');
      const { SplitText } = await import('gsap/SplitText');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(SplitText, ScrollTrigger);

      const kicker = section.querySelector<HTMLElement>('.manifesto-kicker');
      const anchor = section.querySelector<HTMLElement>('.manifesto-anchor');
      const statementEl = section.querySelector<HTMLElement>('.manifesto-statement');
      const lines = Array.from(section.querySelectorAll<HTMLElement>('.manifesto-line'));

      /* Kicker y ancla comparten el mismo fade suave — leen como par arriba/abajo */
      const chrome = [kicker, anchor].filter(Boolean) as HTMLElement[];
      if (chrome.length) {
        gsap.set(chrome, { opacity: 0 });
        ScrollTrigger.create({
          trigger: section,
          start: 'top 80%',
          once: true,
          onEnter: () => {
            gsap.to(chrome, { opacity: 1, duration: 0.4, ease: 'power2.out', stagger: 0.1 });
          },
        });
      }

      if (lines.length && statementEl) {
        gsap.set(lines, { opacity: 0 });

        /* Reveal POR LETRA con carácter orgánico — Dirección A del research
           DESIGN_RESEARCH_TEXT_REVEAL_CARACTER (2026-07-28).
           Arregla los 2 rechazos previos:
           · "uniforme": cada letra saca SU PROPIO random (función () => ...),
             no un valor compartido; + orden de arranque random (from:'random').
             Antes: mismo movimiento en las 40 letras → fila de soldados.
           · "muy largo": stagger.amount FIJO (0.4s total, no crece con el largo
             del texto) en vez de stagger acumulativo. Antes: duración 1s + stagger
             lineal = cola de ~2s.
           mask:'chars' recorta cada letra contra su caja → arregla también el bug
           de la 1ª línea que no animaba (la combinación chars+lines+mask fallaba).
           aria:'none' evita el aria-label prohibido en <p> (axe WCAG 4.1.2). */
        const splits = lines.map((line) =>
          new SplitText(line, { type: 'chars', aria: 'none' })
        );

        /* display:inline-block en cada char → yPercent/rotation funcionan sin
           romper el flujo; el overflow:clip de .manifesto-line hace de máscara.
           NO usamos mask:'chars' — recorta mal las letras con acento (í/á) del
           serif y dejaba glifos torcidos en el estado final. */
        const allChars = splits.flatMap((s) => s.chars) as HTMLElement[];
        gsap.set(allChars, { display: 'inline-block' });
        gsap.set(lines, { opacity: 1 });

        /* Estado inicial explícito (fuera de pantalla, abajo) — se aplica SOLO
           cuando el trigger dispara, para que las letras no se muevan antes de
           que el usuario llegue a la sección. */
        const revealChars = () => {
          gsap.fromTo(
            allChars,
            {
              /* Movimiento CONTENIDO (William 2026-07-28: "muy exagerado, bajale
                 al movimiento"). Antes: yPercent 80-130 + rotation ±5 = mucho
                 salto. Ahora: recorrido corto y casi sin rotación → sube suave,
                 mantiene el carácter (random por letra) sin dramatismo. */
              yPercent: () => gsap.utils.random(30, 55),
              rotation: () => gsap.utils.random(-2, 2),
              opacity: 0,
            },
            {
              yPercent: 0,
              rotation: 0,     /* termina exacto: sin rotación residual */
              opacity: 1,
              duration: () => gsap.utils.random(0.45, 0.6),
              ease: 'power3.out',
              stagger: { amount: 0.3, from: 'random' },
              /* limpia los transforms inline al terminar → glifos perfectamente
                 alineados en reposo (sin scale/rotate residual que los torcía) */
              clearProps: 'transform',
            }
          );
        };

        /* Estado de reposo antes del reveal: letras ocultas abajo. Así, aunque
           la sección ya esté en pantalla al cargar (es 100vh), el texto NO se
           anima hasta que el trigger lo dispara. yPercent moderado, coherente
           con el recorrido contenido del reveal. */
        gsap.set(allChars, { yPercent: 60, opacity: 0 });

        const revealST = ScrollTrigger.create({
          trigger: statementEl,
          /* 'top 65%': dispara cuando el TOPE del statement sube más allá del
             65% del viewport — o sea cuando el usuario ya scrolleó hacia él.
             Antes 'top 80%' + sección 100vh podía estar ya dentro al cargar. */
          start: 'top 65%',
          once: true,
          onEnter: revealChars,
        });

        /* Red de seguridad: si el manifiesto ya está por ENCIMA del punto de
           disparo al cargar (raro pero posible en pantallas muy altas), el
           onEnter no se dispararía nunca y el texto quedaría invisible. En ese
           caso revelamos igual — sin animación de scroll pero visible. */
        if (revealST.progress > 0) {
          revealChars();
          revealST.kill();
        }
      }
    } catch (err) {
      /* Falla dura de GSAP → dejar el texto visible sí o sí (nunca invisible). */
      console.error('[Manifesto] GSAP error:', err);
      section.querySelectorAll<HTMLElement>('.manifesto-line, .manifesto-line .char')
        .forEach((el) => { el.style.transform = 'none'; el.style.opacity = '1'; });
    }
  } else {
    /* MOBILE: IntersectionObserver + CSS fade-up */
    const kicker = section.querySelector<HTMLElement>('.manifesto-kicker');
    const lines = Array.from(section.querySelectorAll<HTMLElement>('.manifesto-line'));

    function wrapInLineMask(el: HTMLElement): HTMLElement {
      const mask = document.createElement('div');
      mask.className = 'line-mask';
      const inner = document.createElement('div');
      inner.className = 'line-inner';
      while (el.firstChild) inner.appendChild(el.firstChild);
      mask.appendChild(inner);
      el.appendChild(mask);
      return inner;
    }

    const kickerInner = kicker ? wrapInLineMask(kicker) : null;
    const lineInners = lines.map((line) => wrapInLineMask(line));
    section.classList.add('manifesto-animating');

    const delays = [0, 0.1, 0.22];
    const targets = [kickerInner, ...lineInners];

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            targets.forEach((inner, i) => {
              if (!inner) return;
              inner.style.transitionDelay = `${delays[i] ?? 0}s`;
              inner.classList.add('is-visible');
            });
            observer.disconnect();
          }
        });
      },
      { threshold: 0.15 }
    );

    observer.observe(section);
  }

  } /* end if section */
</script>
