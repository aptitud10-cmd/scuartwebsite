---
/**
 * ContactSection.astro — Sección 4: Contacto — Rediseño 2026-07-17
 *
 * Patrón sobrio premium (research 2026, Lama Lama / Locomotive):
 * statement conversacional + EMAIL como elemento tipográfico protagonista
 * + un CTA claro + nota de respuesta. SIN formulario largo, sin FAQ.
 *
 * MOTION (research motion 2026):
 *   - Statement: line-mask reveal (SplitText lines, yPercent 110, expo.out).
 *   - Email: entrada y+opacity; hover con underline que crece (CSS,
 *     cubic-bezier expo) + efecto magnético sutil (gsap.quickTo, factor 0.35,
 *     SOLO en dispositivos con hover real).
 *   - once:true en todos los reveals — no rebobinan.
 *
 * Progressive enhancement: el estado oculto lo aplica SOLO el JS.
 * Sin JS o con reduced-motion, todo visible y estático.
 *
 * El endpoint /api/contact se conserva en el repo (no se usa desde aquí).
 */

import type { Translations } from '../i18n/en';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const c = t.contact;

const EMAIL = 'info@scuart.com';
---

<section class="contact" id="contact" aria-label={c.kicker}>
  <p class="contact__kicker">{c.kicker}</p>

  <h2 class="contact__statement" data-contact-statement>{c.statement}</h2>

  <a class="contact__email" href={`mailto:${EMAIL}`} data-contact-email>{EMAIL}</a>

  <div class="contact__foot">
    <a class="contact__cta" href={`mailto:${EMAIL}`}>
      {c.ctaStart} <span class="contact__arrow" aria-hidden="true">&#x2192;</span>
    </a>
    <p class="contact__note">{c.subcopy}</p>
  </div>

  <!-- Segundo eje compositivo (fix visual-critic): los mercados en vertical
       al margen derecho — llena el ancho desktop con intención. -->
  <p class="contact__side" aria-hidden="true">{t.footer.markets}</p>
</section>

<style>
/* ═══════════════════════════════════════════════════════════
   CONTACTO — sobrio, el email es el diseño.
   Sistema del portafolio: hueso, tinta, hairlines, serif Light.
   ═══════════════════════════════════════════════════════════ */

.contact {
  background-color: var(--bg);
  padding: calc(var(--space-2xl) * 1.25) var(--margin) var(--space-2xl);
  scroll-margin-top: 72px;
  position: relative;
}

/* Mercados en vertical al margen derecho — solo desktop ancho */
.contact__side {
  display: none;
}

@media (min-width: 1024px) {
  .contact__side {
    display: block;
    position: absolute;
    top: clamp(4rem, 12vh, 8rem);
    right: calc(var(--margin) * 0.35);
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.25rem, 3.5vw, 3.5rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-18);
    margin: 0;
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
    /* no baja hasta el pie — el pie respira solo */
    max-height: calc(100% - clamp(12rem, 30vh, 18rem));
    overflow: hidden;
  }

  /* el pie no se mete debajo del texto vertical */
  .contact__foot {
    padding-right: clamp(4rem, 6vw, 7rem);
  }
}

.contact__kicker {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--ink-42);
  margin: 0 0 clamp(1.5rem, 4vh, 3rem) 0;
}

.contact__statement {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(1.75rem, 3.6vw, 3.25rem);
  line-height: 1.05;
  letter-spacing: -0.025em;
  color: var(--ink);
  max-width: 20ch;
  margin: 0 0 clamp(2.5rem, 7vh, 4.5rem) 0;
}

/* ── EL EMAIL — protagonista tipográfico ── */
.contact__email {
  display: inline-block;
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(2.5rem, 7.5vw, 6.5rem);
  line-height: 1;
  letter-spacing: -0.03em;
  color: var(--ink);
  text-decoration: none;
  padding-bottom: 0.08em;
  /* underline que crece — entra por la izquierda, sale por la derecha */
  background-image: linear-gradient(var(--ink), var(--ink));
  background-repeat: no-repeat;
  background-position: 100% 100%;
  background-size: 0% 2px;
  transition: background-size 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  will-change: transform;
}

.contact__email:hover,
.contact__email:focus-visible {
  background-position: 0% 100%;
  background-size: 100% 2px;
}

.contact__email:focus-visible {
  outline: 2px solid var(--brand);
  outline-offset: 4px;
}

/* ── Pie: CTA + nota ── */
.contact__foot {
  margin-top: clamp(2.5rem, 7vh, 4.5rem);
  padding-top: clamp(1.25rem, 3vh, 2rem);
  border-top: 1px solid var(--hairline);
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: var(--space-l);
  flex-wrap: wrap;
}

.contact__cta {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--ink);
  text-decoration: none;
  display: inline-flex;
  align-items: baseline;
  gap: 0.5em;
}

.contact__arrow {
  color: var(--brand);
  transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1);
}

.contact__cta:hover .contact__arrow,
.contact__cta:focus-visible .contact__arrow {
  transform: translateX(6px);
}

.contact__cta:focus-visible {
  outline: 2px solid var(--brand);
  outline-offset: 3px;
}

.contact__note {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--ink-42);
  margin: 0;
}

@media (max-width: 640px) {
  .contact__email {
    font-size: clamp(1.6rem, 9.5vw, 2.5rem);
  }
  .contact__foot {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-s);
  }
}

/* ── reduced-motion: todo visible, sin transiciones ── */
@media (prefers-reduced-motion: reduce) {
  .contact__statement,
  .contact__email,
  .contact__foot {
    opacity: 1 !important;
    transform: none !important;
  }
  .contact__email,
  .contact__arrow {
    transition: none;
  }
}
</style>

<script>
  /**
   * Contacto — motion premium (valores del research 2026):
   *   1. Statement: line-mask reveal (yPercent 110, expo.out, stagger 0.1).
   *   2. Email + pie: entrada y+opacity escalonada.
   *   3. Email magnético: quickTo factor 0.35, power3, solo hover:hover.
   */

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = window.matchMedia('(hover: hover)').matches;

  if (!reducedMotion) {
    try {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      const { SplitText } = await import('gsap/SplitText');
      gsap.registerPlugin(ScrollTrigger, SplitText);

      const section = document.querySelector<HTMLElement>('#contact');
      const statement = section?.querySelector<HTMLElement>('[data-contact-statement]') ?? null;
      const email = section?.querySelector<HTMLElement>('[data-contact-email]') ?? null;
      const foot = section?.querySelector<HTMLElement>('.contact__foot') ?? null;

      /* (1) Statement — line-mask reveal.
         IMPORTANTE: el split y el estado inicial se crean DENTRO de onEnter
         (gsap.from) — nunca hay estado oculto persistente. Si el trigger no
         dispara, el texto simplemente queda visible (robustez mobile). */
      if (section && statement) {
        ScrollTrigger.create({
          trigger: section,
          start: 'top 75%',
          once: true,
          onEnter: () => {
            const split = new SplitText(statement, {
              type: 'lines',
              mask: 'lines',
              autoSplit: true,
              aria: 'none',
            });
            gsap.from(split.lines, {
              yPercent: 110,
              duration: 1.0,
              ease: 'expo.out',
              stagger: 0.1,
              force3D: true,
            });
            /* (2) Email + pie entran después del statement */
            if (email) {
              gsap.set(email, { opacity: 0, y: 28 });
              gsap.to(email, {
                opacity: 1, y: 0, duration: 0.9, ease: 'expo.out', delay: 0.25,
              });
            }
            if (foot) {
              gsap.set(foot, { opacity: 0, y: 16 });
              gsap.to(foot, {
                opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', delay: 0.45,
              });
            }
          },
        });
      }

      /* (3) Email magnético — solo con cursor real */
      if (email && canHover) {
        const xTo = gsap.quickTo(email, 'x', { duration: 0.6, ease: 'power3' });
        const yTo = gsap.quickTo(email, 'y', { duration: 0.6, ease: 'power3' });

        email.addEventListener('mousemove', (e: MouseEvent) => {
          const r = email.getBoundingClientRect();
          xTo((e.clientX - r.left - r.width / 2) * 0.12);
          yTo((e.clientY - r.top - r.height / 2) * 0.35);
        });
        email.addEventListener('mouseleave', () => {
          xTo(0);
          yTo(0);
        });
      }
    } catch (err) {
      console.error('[ContactSection] motion init failed:', err);
      document
        .querySelectorAll<HTMLElement>('#contact [data-contact-statement], #contact [data-contact-email], #contact .contact__foot')
        .forEach((el) => {
          el.style.opacity = '1';
          el.style.transform = 'none';
        });
    }
  }
</script>
