---
/**
 * ContactSection.astro — Sección 4: CTA / Contacto — V3
 * SCUART — "El cierre del recorrido"
 *
 * V3: fondo barro-oscuro (#241710), tipografía Fraunces + Hanken, tokens terracota cálida.
 *
 * CONCEPTO: Cierre de proyecto premium, NO página de contacto genérica.
 * El recorrido: hero promete → portfolio prueba → método explica → ACÁ se convierte.
 *
 * JERARQUÍA VISUAL (≤3 niveles):
 *   N1 — Statement de cierre (Fraunces 300, hueso, gigante, col 1-5 desktop)
 *        Peso visual ≥45% de la sección. Sticky en desktop.
 *   N2 — Formulario brief (inputs línea fina borde-oscuro, CTA terracota único)
 *        col 7-12 desktop. Split horizontal asimétrico (anti R2).
 *   N3 — Links secundarios WhatsApp/email (mono, hueso 55%, al pie)
 *
 * ESTRUCTURA CONSERVADA ÍNTEGRA (aprobado — NO tocar lógica):
 *   - Todos los campos: name, business, email, country, whatDoYouNeed, budget, timeline, message
 *   - Honeypot: campo 'website' oculto
 *   - Endpoint: action="/api/contact" + fetch POST /api/contact
 *   - Estados: idle → loading → success/error
 *   - Mensajes de éxito/error, bloque WhatsApp/email alternativo
 *   - UN solo CTA de envío
 *
 * Solo cambia la PIEL: colores V3, tipografía Fraunces/Hanken, layout asimétrico.
 *
 * ACCESIBILIDAD:
 *   - Labels asociados via for/id (intactos — no tocar)
 *   - Contraste AA: hueso sobre barro-oscuro ~12:1 (AAA). hueso 65% = ~8:1 (AAA).
 *   - focus-visible claro en todos los inputs y links.
 */

import type { Translations } from '../i18n/en';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const c = t.contact;
---

<section class="contact" id="contact" aria-label={c.kicker}>

  <!-- Kicker / regla de entrada -->
  <div class="contact-header">
    <p class="contact-kicker">{c.kicker}</p>
  </div>

  <!-- Layout principal: desktop split col 1-5 statement | col 7-12 form -->
  <div class="contact-layout">

    <!--
      STATEMENT — N1, protagonista.
      Fraunces 300, hueso. Desktop: sticky mientras scrolleas el form.
      Mobile: bloque arriba del form (full-width).
    -->
    <div class="contact-statement">
      <h2 class="contact-statement__text">{c.statement}</h2>
      <p class="contact-statement__subcopy">{c.subcopy}</p>
    </div>

    <!--
      FORMULARIO — N2.
      action="/api/contact": fallback sin JS.
      method="POST": el endpoint acepta form-data como fallback.
      data-contact-form: hook para el JS de estado.
      ESTRUCTURA INTACTA — solo re-skin V3.
    -->
    <div class="contact-form-wrap">
      <form
        class="contact-form"
        action="/api/contact"
        method="POST"
        data-contact-form
        novalidate
      >

        <!--
          HONEYPOT — anti-spam.
          Campo 'website': oculto visualmente (no display:none).
          aria-hidden y tabIndex=-1 para no interferir con a11y.
        -->
        <div class="contact-form__honeypot" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input
            type="text"
            id="contact-website"
            name="website"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <!-- ── FILA 1: Name + Business ─────────────────────── -->
        <div class="contact-form__row contact-form__row--split">

          <div class="contact-form__field">
            <label class="contact-form__label" for="contact-name">
              {c.labelName} <span class="contact-form__required" aria-label="requerido">*</span>
            </label>
            <input
              class="contact-form__input"
              type="text"
              id="contact-name"
              name="name"
              placeholder={c.placeholderName}
              required
              autocomplete="name"
            />
          </div>

          <div class="contact-form__field">
            <label class="contact-form__label" for="contact-business">
              {c.labelBusiness}
            </label>
            <input
              class="contact-form__input"
              type="text"
              id="contact-business"
              name="business"
              placeholder={c.placeholderBusiness}
              autocomplete="organization"
            />
          </div>

        </div>

        <!-- ── FILA 2: Email + Country ───────────────────────── -->
        <div class="contact-form__row contact-form__row--split">

          <div class="contact-form__field">
            <label class="contact-form__label" for="contact-email">
              {c.labelEmail} <span class="contact-form__required" aria-label="requerido">*</span>
            </label>
            <input
              class="contact-form__input"
              type="email"
              id="contact-email"
              name="email"
              placeholder={c.placeholderEmail}
              required
              autocomplete="email"
            />
          </div>

          <div class="contact-form__field">
            <label class="contact-form__label" for="contact-country">
              {c.labelCountry}
            </label>
            <input
              class="contact-form__input"
              type="text"
              id="contact-country"
              name="country"
              placeholder={c.placeholderCountry}
            />
          </div>

        </div>

        <!-- ── FILA 3: What do you need (select) ─────────────── -->
        <div class="contact-form__row">
          <div class="contact-form__field">
            <label class="contact-form__label" for="contact-need">
              {c.labelWhatDoYouNeed}
            </label>
            <div class="contact-form__select-wrap">
              <select
                class="contact-form__input contact-form__select"
                id="contact-need"
                name="whatDoYouNeed"
              >
                {c.needOptions.map((opt) => (
                  <option value={opt.value}>{opt.label}</option>
                ))}
              </select>
              <span class="contact-form__select-arrow" aria-hidden="true">▾</span>
            </div>
          </div>
        </div>

        <!-- ── FILA 4: Budget + Timeline ─────────────────────── -->
        <div class="contact-form__row contact-form__row--split">

          <div class="contact-form__field">
            <label class="contact-form__label" for="contact-budget">
              {c.labelBudget}
            </label>
            <div class="contact-form__select-wrap">
              <select
                class="contact-form__input contact-form__select"
                id="contact-budget"
                name="budget"
              >
                {c.budgetOptions.map((opt) => (
                  <option value={opt.value}>{opt.label}</option>
                ))}
              </select>
              <span class="contact-form__select-arrow" aria-hidden="true">▾</span>
            </div>
          </div>

          <div class="contact-form__field">
            <label class="contact-form__label" for="contact-timeline">
              {c.labelTimeline}
            </label>
            <div class="contact-form__select-wrap">
              <select
                class="contact-form__input contact-form__select"
                id="contact-timeline"
                name="timeline"
              >
                {c.timelineOptions.map((opt) => (
                  <option value={opt.value}>{opt.label}</option>
                ))}
              </select>
              <span class="contact-form__select-arrow" aria-hidden="true">▾</span>
            </div>
          </div>

        </div>

        <!-- ── FILA 5: Message (textarea) ─────────────────────── -->
        <div class="contact-form__row">
          <div class="contact-form__field">
            <label class="contact-form__label" for="contact-message">
              {c.labelMessage} <span class="contact-form__required" aria-label="requerido">*</span>
            </label>
            <textarea
              class="contact-form__input contact-form__textarea"
              id="contact-message"
              name="message"
              placeholder={c.placeholderMessage}
              rows={4}
              required
            ></textarea>
          </div>
        </div>

        <!-- ── Mensaje de error inline ─────────────────────────── -->
        <div class="contact-form__error" data-contact-error aria-live="assertive" role="alert" hidden>
          {c.errorMessage}
        </div>

        <!-- ── Botón submit — CTA terracota único ──────────────── -->
        <div class="contact-form__row contact-form__row--submit">
          <button
            class="contact-form__submit"
            type="submit"
            data-contact-submit
            data-label-idle={c.submitLabel}
            data-label-loading={c.submitLoadingLabel}
          >
            {c.submitLabel}
          </button>
        </div>

      </form>

      <!--
        PANEL DE ÉXITO — oculto por defecto.
        JS lo muestra cuando el endpoint responde 200 ok:true.
      -->
      <div class="contact-success" data-contact-success hidden>
        <p class="contact-success__heading">{c.successHeading}</p>
        <p class="contact-success__body">{c.successBody}</p>
      </div>

      <!--
        BLOQUE SECUNDARIO — WhatsApp / Email — N3.
        Discreto, al pie del form. Mono hueso 55%.
        NO botón verde, NO flotante, NO protagonista.
      -->
      <div class="contact-alt">
        <span class="contact-alt__label">{c.alternativeLabel}</span>
        <span class="contact-alt__sep" aria-hidden="true">—</span>
        <a
          class="contact-alt__link"
          href={c.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${c.whatsappLabel} (abre en nueva ventana)`}
        >
          {c.whatsappLabel}
        </a>
        <span class="contact-alt__dot" aria-hidden="true">·</span>
        <a
          class="contact-alt__link"
          href={c.emailHref}
        >
          {c.emailLabel}
        </a>
      </div>

    </div>
    <!-- /contact-form-wrap -->

  </div>
  <!-- /contact-layout -->

</section>

<style>
/* ═══════════════════════════════════════════════════════════
   CONTACT SECTION — V3: barro-oscuro + terracota cálida
   Mobile-first: 375px base. md: 768px. lg: 1280px.
   ART_DIRECTION_V3_FINAL.md §5 (CONTACTO).
   ═══════════════════════════════════════════════════════════ */

/* ─── SECCIÓN ────────────────────────────────────────────── */

.contact {
  /* Plano NEGRO (ART_DIRECTION §4 — descanso + foco: pedir el proyecto).
     Sobre negro, blanco directo y difference coinciden → uso blanco directo
     (más predecible, sin riesgo del statement sticky + blend, §7 nota). */
  background-color: var(--bg);
  padding-top: var(--space-xl);
  padding-bottom: var(--space-2xl);
  padding-left: var(--margin);
  padding-right: var(--margin);
  position: relative;
  overflow-x: clip;
  scroll-margin-top: 72px;
}

/* ─── HEADER / KICKER ────────────────────────────────────── */

.contact-header {
  border-top: 1px solid var(--hairline);
  padding-top: var(--space-m);
  margin-bottom: var(--space-l);
}

.contact-kicker {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  color: var(--ink);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  line-height: 1.4;
}

/* ─── LAYOUT PRINCIPAL (mobile: columna) ─────────────────── */

.contact-layout {
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
}

/* ─── STATEMENT — N1 ─────────────────────────────────────── */

.contact-statement {
  display: flex;
  flex-direction: column;
  gap: var(--space-s);
}

.contact-statement__text {
  font-family: var(--font-display);
  font-weight: 300; /* Fraunces light — peso bajo = elegante en grande */
  font-size: clamp(2.75rem, 9vw, 7rem);
  line-height: 1.02;
  letter-spacing: -0.025em;
  color: var(--ink);
  /* Preserva los \n del i18n */
  white-space: pre-line;
  hyphens: none;
  -webkit-hyphens: none;
  overflow-wrap: break-word;
  word-break: normal;
  max-width: 100%;
  margin: 0;
}

.contact-statement__subcopy {
  font-family: var(--font-body);
  font-size: var(--text-subhead);
  font-weight: 400;
  color: var(--ink-62);
  line-height: 1.55;
  max-width: 36ch;
  margin: 0;
}

/* ─── FORM WRAP ───────────────────────────────────────────── */

.contact-form-wrap {
  display: flex;
  flex-direction: column;
  gap: var(--space-l);
}

/* ─── FORM ────────────────────────────────────────────────── */

.contact-form {
  display: flex;
  flex-direction: column;
  gap: var(--space-s);
}

/* ─── HONEYPOT — oculto visualmente ─────────────────────────
 * position:absolute + opacity:0 + pointer-events:none.
 * Visible en DOM para bots, invisible para humanos.
 */
.contact-form__honeypot {
  position: absolute;
  opacity: 0;
  pointer-events: none;
  height: 0;
  overflow: hidden;
  z-index: -1;
}

/* ─── FILAS ───────────────────────────────────────────────── */

.contact-form__row {
  display: flex;
  flex-direction: column;
  gap: var(--space-s);
}

.contact-form__row--submit {
  margin-top: var(--space-s);
}

/* ─── CAMPO INDIVIDUAL ───────────────────────────────────── */

.contact-form__field {
  display: flex;
  flex-direction: column;
  gap: var(--space-2xs);
  flex: 1;
}

/* ─── LABEL — Hanken 500 uppercase +0.14em hueso 65% ────────── */

.contact-form__label {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  color: var(--ink);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  line-height: 1.4;
  cursor: pointer;
}

.contact-form__required {
  color: var(--ink);
  margin-left: 0.1em;
}

/* ─── INPUT EDITORIAL — línea inferior hairline borde-oscuro ─
 * Estilo editorial: sin cajas, sin border-radius, sin fondo gris.
 * Border-bottom: borde-oscuro (#473321).
 * Focus: línea pasa a terracota (transición sutil).
 * Placeholder: hueso 40%.
 * Touch target mínimo 48px via min-height.
 */
.contact-form__input {
  font-family: var(--font-body);
  font-size: var(--text-body);
  font-weight: 400;
  color: var(--ink);
  background-color: transparent;
  border: none;
  border-bottom: 1px solid var(--hairline);
  border-radius: 0;
  padding: var(--space-xs) 0;
  width: 100%;
  min-height: 48px;
  line-height: 1.5;
  outline: none;
  transition: border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  -webkit-appearance: none;
  appearance: none;
}

.contact-form__input::placeholder {
  color: var(--ink-42);
  opacity: 1; /* Firefox normaliza */
}

/* Focus: la línea pasa a lima (--brand) */
.contact-form__input:focus {
  border-bottom-color: var(--brand);
}

.contact-form__input:focus-visible {
  border-bottom-color: var(--brand);
  /* Outline extra visible para teclado */
  outline: none;
  box-shadow: 0 2px 0 0 var(--brand);
}

/* Hover no-focus: línea sube levemente de luminosidad */
.contact-form__input:hover:not(:focus) {
  border-bottom-color: var(--hairline-strong);
}

/* ─── SELECT — wrapper para la flecha custom ─────────────── */

.contact-form__select-wrap {
  position: relative;
}

.contact-form__select {
  cursor: pointer;
  padding-right: 2em;
}

.contact-form__select option {
  background-color: var(--bg);
  color: #fff;
}

.contact-form__select-arrow {
  position: absolute;
  right: 0.25em;
  top: 50%;
  transform: translateY(-50%);
  font-family: var(--font-body);
  font-size: 0.75rem;
  color: var(--ink-62);
  pointer-events: none;
  line-height: 1;
  display: flex;
  align-items: center;
}

/* ─── TEXTAREA ────────────────────────────────────────────── */

.contact-form__textarea {
  resize: vertical;
  min-height: 96px;
  height: auto;
}

/* ─── ERROR INLINE ────────────────────────────────────────── */

.contact-form__error {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 400;
  color: var(--ink);
  line-height: 1.4;
  letter-spacing: 0.02em;
  padding: var(--space-xs) 0;
}

/* ─── BOTÓN SUBMIT — CTA lima, único bloque sólido de color del sitio ─
 * V4 Restringido §4.2: relleno --brand, texto --on-brand (negro), hover --brand-press.
 * WCAG: --on-brand (#0e0e0c) sobre --brand (#c6f24e) = ~13:1 (AAA).
 */
.contact-form__submit {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  color: var(--on-brand);          /* negro sobre lima — contraste AAA */
  background-color: var(--brand);  /* lima: el único relleno de color del sitio */
  border: 1px solid var(--brand);
  border-radius: 0;
  padding: 0.85em 1.75em;
  min-height: 48px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  line-height: 1.4;
  cursor: pointer;
  transition:
    background-color 0.25s ease,
    border-color 0.25s ease,
    opacity 0.25s ease;
  -webkit-appearance: none;
  appearance: none;
  align-self: flex-start;
}

/* Hover: lima se oscurece levemente */
.contact-form__submit:hover {
  background-color: var(--brand-press);
  border-color: var(--brand-press);
}

.contact-form__submit:active {
  opacity: 0.85;
}

.contact-form__submit:focus-visible {
  outline: 2px solid var(--brand);
  outline-offset: 3px;
}

.contact-form__submit:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

/* ─── PANEL DE ÉXITO ─────────────────────────────────────── */

.contact-success {
  display: flex;
  flex-direction: column;
  gap: var(--space-s);
  padding: var(--space-l) 0;
}

.contact-success__heading {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(2rem, 5vw, 4rem);
  line-height: 1.02;
  letter-spacing: -0.025em;
  color: var(--ink);
  margin: 0;
}

.contact-success__body {
  font-family: var(--font-body);
  font-size: var(--text-body);
  font-weight: 400;
  color: var(--ink-62);
  line-height: 1.6;
  max-width: 40ch;
  margin: 0;
}

/* ─── BLOQUE ALTERNATIVO (WhatsApp / Email) — N3 ─────────── */

.contact-alt {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.4em;
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 400;
  color: var(--ink-62);
  letter-spacing: 0.03em;
  line-height: 1.4;
  border-top: 1px solid var(--hairline);
  padding-top: var(--space-m);
  margin-top: var(--space-xs);
}

.contact-alt__sep,
.contact-alt__dot {
  opacity: 0.4;
}

.contact-alt__link {
  color: var(--ink-62);
  text-decoration: none;
  transition: color 0.2s ease;
  padding: 0.2em 0;
}

.contact-alt__link:hover {
  color: var(--ink);
}

.contact-alt__link:focus-visible {
  outline: 1px solid var(--brand);
  outline-offset: 2px;
  color: var(--ink);
}

/* ═══════════════════════════════════════════════════════════
   TABLET (768px+)
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 768px) {
  .contact {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  /* Filas split: 2 columnas en tablet+ */
  .contact-form__row--split {
    flex-direction: row;
    align-items: flex-start;
  }

  .contact-form {
    gap: var(--space-m);
  }

  .contact-form__row {
    gap: var(--space-m);
  }

  .contact-form__textarea {
    min-height: 120px;
  }
}

/* ═══════════════════════════════════════════════════════════
   DESKTOP (1280px+) — split asimétrico: statement col 1-5, form col 7-12
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 1280px) {
  .contact {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  /*
   * Grid 12 col en 2 zonas:
   * Col 1-5: statement (sticky).
   * Col 6: gutter.
   * Col 7-12: form.
   */
  .contact-layout {
    display: grid;
    grid-template-columns: 5fr 6fr;
    column-gap: calc(var(--gutter) * 2);
    row-gap: 0;
    align-items: start;
  }

  /* Statement: sticky desktop */
  .contact-statement {
    position: sticky;
    top: calc(72px + var(--space-l));
    align-self: start;
  }

  .contact-statement__subcopy {
    max-width: 30ch;
  }

  .contact-form-wrap {
    gap: var(--space-m);
  }
}

/* ═══════════════════════════════════════════════════════════
   REDUCED-MOTION — sin transiciones en inputs y links
   El grano y el color se mantienen (son identidad, no motion).
   ═══════════════════════════════════════════════════════════ */
@media (prefers-reduced-motion: reduce) {
  .contact-form__input,
  .contact-form__submit,
  .contact-alt__link {
    transition: none;
  }
}
</style>

<script>
  /**
   * ContactSection — JS progresivo para el formulario.
   *
   * PROGRESSIVE ENHANCEMENT:
   * El form tiene action/method — funciona sin JS como fallback.
   * Este script agrega: estados loading/success/error, fetch sin recarga.
   *
   * FLUJO:
   * 1. Submit → previene default → pone estado loading
   * 2. fetch POST /api/contact con JSON body
   * 3. Si ok:true → muestra panel success, oculta form
   * 4. Si ok:false → muestra error inline, restaura botón
   * 5. Si network error → muestra error inline
   */

  /**
   * ContactSection — Motion V4 (spec §A.6)
   *
   * G1 — Mask reveal del statement "LET'S / BUILD / SOMETHING." (SplitText).
   *       yPercent 105→0, 0.9s expo.out, stagger 0.12s. ScrollTrigger top 80%.
   *       Solo si !reducedMotion.
   *       Mobile: IO fade-up del bloque completo.
   *
   * G2 — CTA lima entra último: campos del form con IO stagger sutil (0.5s, 0.05s),
   *       el botón lima entra al final. IO, CSS. Sin GSAP (más simple).
   *       REGLA DURA: nada se mueve mientras el usuario escribe.
   *
   * prefers-reduced-motion: sin motion, todo visible.
   */
  (async () => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.matchMedia('(min-width: 769px)').matches;

    if (!reducedMotion) {
      const statementEl = document.querySelector<HTMLElement>('.contact-statement__text');

      if (statementEl) {
        if (isDesktop) {
          /* ── DESKTOP: SplitText mask reveal del statement ── */
          try {
            const { gsap } = await import('gsap');
            const { SplitText } = await import('gsap/SplitText');
            const { ScrollTrigger } = await import('gsap/ScrollTrigger');
            gsap.registerPlugin(SplitText, ScrollTrigger);

            const split = new SplitText(statementEl, {
              type: 'lines',
              mask: 'lines',
              autoSplit: true,
            });

            gsap.set(split.lines, { yPercent: 105 });

            ScrollTrigger.create({
              trigger: statementEl,
              start: 'top 80%',
              once: true,
              onEnter: () => {
                gsap.to(split.lines, {
                  yPercent: 0,
                  duration: 0.9,
                  ease: 'expo.out',
                  stagger: 0.12,
                });
              },
            });
          } catch (_) {
            /* Si GSAP falla: texto visible */
          }
        }
        /* Mobile: el bloque de statement es visible por defecto, sin motion especial */
      }

      /* ── G2: Campos del form con stagger sutil + botón lima entra último ──
         IO en el form-wrap. Cada fila de campos hace un fade sutil (IO + CSS).
         El botón tiene el delay más largo — es el punto final de la frase.
         CRÍTICO: solo en reposo antes de que el usuario interactúe. */
      const formWrap = document.querySelector<HTMLElement>('.contact-form-wrap');
      const formRows = document.querySelectorAll<HTMLElement>('.contact-form__row');
      const submitBtn = document.querySelector<HTMLElement>('[data-contact-submit]');

      if (formWrap && formRows.length) {
        /* Ocultar filas hasta que entren al viewport */
        formRows.forEach((row, i) => {
          row.style.opacity = '0';
          row.style.transform = 'translateY(12px)';
          row.style.transition = `opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1) ${i * 0.05}s, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) ${i * 0.05}s`;
        });

        /* El botón lima tiene delay extra — llega último */
        if (submitBtn) {
          const submitRow = submitBtn.closest('.contact-form__row');
          if (submitRow) {
            const lastDelay = formRows.length * 0.05 + 0.08;
            (submitRow as HTMLElement).style.transition = `opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1) ${lastDelay}s, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) ${lastDelay}s`;
          }
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                formRows.forEach((row) => {
                  row.style.opacity = '1';
                  row.style.transform = 'translateY(0)';
                });
                io.disconnect();
              }
            });
          },
          { threshold: 0.05 }
        );

        io.observe(formWrap);
      }
    }
  })();

  /* ── Formulario: lógica de envío (se conserva intacta — P5) ── */
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-contact-submit]');
  const errorEl = document.querySelector<HTMLElement>('[data-contact-error]');
  const successEl = document.querySelector<HTMLElement>('[data-contact-success]');

  if (!form || !submitBtn) {
    /* Sin elementos: el form funciona como action/method nativo. No hay JS que ejecutar. */
    // eslint-disable-next-line no-empty
  } else {

    const idleLabel = submitBtn.dataset.labelIdle ?? 'SEND →';
    const loadingLabel = submitBtn.dataset.labelLoading ?? 'SENDING…';

    /* ── Funciones de estado ─────────────────────────────── */

    function setLoading() {
      submitBtn!.disabled = true;
      submitBtn!.textContent = loadingLabel;
      if (errorEl) errorEl.hidden = true;
    }

    function setIdle() {
      submitBtn!.disabled = false;
      submitBtn!.textContent = idleLabel;
    }

    function showError(message?: string) {
      if (!errorEl) return;
      if (message) errorEl.textContent = message;
      errorEl.hidden = false;
    }

    function showSuccess() {
      if (form) form.hidden = true;
      if (successEl) successEl.hidden = false;
    }

    /* ── Submit handler ────────────────────────────────── */

    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      setLoading();

      /* Recopilar datos del form */
      const formData = new FormData(form!);
      const body: Record<string, string> = {};
      formData.forEach((value, key) => {
        body[key] = String(value);
      });

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });

        const data = await response.json() as { ok: boolean; error?: string };

        if (data.ok) {
          showSuccess();
        } else {
          setIdle();
          showError(data.error);
        }

      } catch (_) {
        /* Network error o response.json() falló */
        setIdle();
        showError();
      }
    });

  } /* fin guard */
</script>
