---
/**
 * ServicesSection.astro — Los 6 servicios de SCUART. REDISEÑO 2026-07-26 (v2).
 *
 * PROBLEMA: "larguero de texto sin movimiento ni wow". Rechazado: agrandar
 * tipografía; numerales gigantes estáticos en zig-zag.
 *
 * SOLUCIÓN (DESIGN_RESEARCH_SERVICIOS_PROCESO_2026-07, mecánica #3 + #1):
 * PIN + HIGHLIGHT SECUENCIAL — patrón canónico de agencias premiadas 2026.
 * La lista se clava en pantalla; al scrollear, UN servicio se resalta por vez
 * (se agranda + acento lima + los otros se atenúan). El usuario controla el
 * avance con su propio scroll → deja de ser "6 textos que se leen de golpe".
 * Un numeral gigante muta en vivo (01→06) sincronizado con el servicio activo.
 *
 * ⚠️ DESKTOP-ONLY (≥1024px). Regla de William + advertencia del research:
 * el pin puede romper el body-scroll-container de iOS. TODO el motion nuevo se
 * registra SOLO dentro de ScrollTrigger.matchMedia('(min-width:1024px)').
 * Mobile/tablet (<1024px) = layout apilado simple con reveal por fila, IDÉNTICO
 * a lo que ya funcionaba. NO se toca.
 *
 * COMPOSICIÓN (visual-composition):
 *   N1 — servicio activo (grande, lima). N2 — numeral gigante que muta.
 *   N3 — servicios inactivos (atenuados) + beneficio + kicker.
 */

import type { Translations, CapabilityService } from '../i18n/en';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const kicker = t.servicesKicker;
const items: CapabilityService[] = t.capabilities.items;

/* Diagramas isométricos por servicio (generados, aprobados por William 2026-07-27).
   Orden alineado a capabilities.items: 01 WEB · 02 SAAS · 03 AI · 04 ECOMMERCE ·
   05 ORDERING · 06 BRAND. Cada uno SUGIERE su servicio (no abstracto). */
const svcImages = [
  '/images/servicios/web-platforms.webp',
  '/images/servicios/saas.webp',
  '/images/servicios/ai.webp',
  '/images/servicios/ecommerce.webp',
  '/images/servicios/ordering.webp',
  '/images/servicios/brand.webp',
];
---

<section class="svc" id="services" aria-label={kicker} data-svc>
  <p class="svc__kicker">{kicker}</p>

  <div class="svc__stage" data-svc-stage>
    <!-- Panel visual: el diagrama del servicio activo (solo desktop, lo cruza el JS).
         Se apilan las 6 imágenes; el JS muestra solo la del servicio en foco. -->
    <div class="svc__visual" aria-hidden="true" data-svc-visual>
      {items.map((item, i) => (
        <img
          class="svc__img"
          src={svcImages[i]}
          alt=""
          loading="lazy"
          decoding="async"
          data-svc-img
          data-index={i}
        />
      ))}
      <span class="svc__bignum" data-svc-bignum>01</span>
    </div>

    <ol class="svc__list" data-svc-list>
      {items.map((item, i) => (
        <li class="svc__row" data-svc-row data-index={i}>
          <span class="svc__num" aria-hidden="true">{item.num}</span>
          <h2 class="svc__name">{item.name}</h2>
          <p class="svc__resolves">{item.resolves}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════
     SERVICIOS — fondo crema.
     BASE (mobile/tablet <1024px): lista apilada simple con reveal.
     DESKTOP (≥1024px): pin + highlight secuencial + numeral que muta.
     ═══════════════════════════════════════════════════════════ */
  .svc {
    background-color: var(--bg);
    padding: var(--space-2xl) var(--margin);
    overflow-x: clip;
  }

  .svc__kicker {
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-62);
    margin: 0 0 var(--space-xl) 0;
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--hairline);
  }

  .svc__stage { position: relative; }

  /* ── Panel visual (mobile): oculto. En mobile mandan las filas de texto;
     meter 6 diagramas grandes apilados haría un mega-larguero. Solo desktop. ── */
  .svc__visual { display: none; }
  .svc__bignum { display: none; }

  .svc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  /* ─── FILA base (mobile/tablet) ─── */
  .svc__row {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "num name"
      ".   resolves";
    column-gap: var(--space-m);
    row-gap: var(--space-2xs);
    align-items: baseline;
    border-bottom: 1px solid var(--hairline);
    padding-block: clamp(1.5rem, 3.5vh, 2.5rem);
  }

  .svc__num {
    grid-area: num;
    font-family: var(--font-body);
    font-size: var(--text-mono);
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--ink-62);
    font-variant-numeric: tabular-nums;
  }

  .svc__name {
    grid-area: name;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.9rem, 5vw, 2.75rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }

  .svc__resolves {
    grid-area: resolves;
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.5;
    color: var(--ink-mid);
    margin: 0;
    max-width: 52ch;
  }

  /* ─── reveal base (mobile/tablet) — lo aplica el JS ─── */
  .svc-animate-base .svc__row {
    opacity: 0;
    transform: translateY(20px);
  }

  /* ═══════════════════════════════════════════════════════════
     DESKTOP ≥1024px — PIN + HIGHLIGHT SECUENCIAL.
     La escena ocupa el alto del viewport; el numeral gigante vive
     a la izquierda, la lista a la derecha. El servicio activo se
     agranda y toma color; los demás se atenúan. Lo orquesta el JS.
     ═══════════════════════════════════════════════════════════ */
  @media (min-width: 1024px) {
    /* Sin pin: la sección tiene su propio padding vertical (antes 0 porque el
       pin manejaba el alto). */
    .svc { padding-block: var(--space-2xl); }

    .svc__kicker {
      margin-bottom: var(--space-xl);
      padding-top: 0;
    }

    .svc__stage {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: center;
      gap: clamp(2rem, 6vw, 6rem);
      /* Sin pin: el alto lo da el contenido (el panel de imagen es alto de por
         sí). min-height moderado para que respire, NO 100vh forzado que
         obligaba a scrollear la sección entera. */
      min-height: 80vh;
    }

    /* ── Panel visual — columna izquierda. El diagrama del servicio activo. ── */
    .svc__visual {
      display: block;
      grid-column: 1;
      position: relative;
      align-self: center;
      justify-self: stretch;
      aspect-ratio: 4 / 5;
      max-height: 78vh;
    }

    /* Las 6 imágenes apiladas; solo la activa es visible (crossfade). */
    .svc__img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      opacity: 0;
      transform: scale(0.985);
      transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.19,1,0.22,1);
      pointer-events: none;
    }
    .svc__img[data-active] {
      opacity: 1;
      transform: scale(1);
    }

    /* Numeral que muta — acento chico arriba-izquierda del panel, no protagonista */
    .svc__bignum {
      display: block;
      position: absolute;
      top: -0.1em;
      left: 0;
      z-index: 2;
      font-family: var(--font-display);
      font-weight: 300;
      font-size: clamp(3.5rem, 5vw, 5rem);
      line-height: 0.8;
      letter-spacing: -0.03em;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
      user-select: none;
    }
    .svc__bignum::after {
      content: '';
      position: absolute;
      left: 0.06em;
      bottom: 0.08em;
      width: 0.5em;
      height: 0.07em;
      background: var(--brand);
    }

    .svc__list {
      grid-column: 2;
      gap: 0;
    }

    /* Filas desktop: sin hairlines, sin grid de 2 áreas — cada una es un
       bloque que se resalta/atenúa. */
    .svc__row {
      display: block;
      border-bottom: none;
      /* menos padding → la lista llena mejor su columna (menos aire muerto) */
      padding-block: clamp(0.45rem, 1vh, 0.9rem);
      /* inactivo MÁS apagado → contraste dramático activo/inactivo (patrón
         Monolog: la lista gris, solo el activo pleno). Antes 0.28 apenas se
         distinguía. */
      opacity: 0.22; /* estado inactivo por defecto */
      transition: opacity 0.5s ease;
    }

    .svc__row .svc__num {
      display: inline-block;
      margin-right: 1em;
      vertical-align: middle;
      opacity: 0; /* el numeral chico se oculta en desktop; manda el gigante */
    }

    .svc__row .svc__name {
      display: inline-block;
      vertical-align: middle;
      /* más grande → presencia tipográfica tipo Monolog (la lista es el
         protagonista, no un larguero tímido) */
      font-size: clamp(2.25rem, 4vw, 4rem);
      line-height: 1.06;
      transition: color 0.4s ease;
    }

    .svc__row .svc__resolves {
      max-width: 46ch;
      margin-top: 0.5rem;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.5s ease, opacity 0.4s ease, margin-top 0.4s ease;
    }

    /* SERVICIO ACTIVO — resaltado */
    .svc__row[data-active] {
      opacity: 1;
    }
    .svc__row[data-active] .svc__name {
      /* activo: color pleno. Sin scale — el contraste opacidad/color ya lo
         destaca; el scale se veía nervioso al saltar entre servicios. */
      color: var(--ink);
    }
    .svc__row[data-active] .svc__resolves {
      max-height: 6rem;
      opacity: 1;
      margin-top: 0.75rem;
    }

    /* En desktop NO se usa el reveal-base (lo maneja el pin) */
    .svc-animate-base .svc__row { opacity: 0.28; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-animate-base .svc__row { opacity: 1; transform: none; }
    /* Con reduced-motion en desktop: mostrar todo, sin atenuar ni pin */
    .svc__row { opacity: 1 !important; }
    .svc__row .svc__resolves { max-height: none !important; opacity: 1 !important; }
    .svc__row .svc__num { opacity: 0.62 !important; }
  }
</style>

<script>
  /**
   * Servicios — dos vías, seleccionadas por ancho:
   *   <1024px (BASE): reveal por fila con IntersectionObserver-like (GSAP
   *     ScrollTrigger simple). Igual que la versión que ya funcionaba en mobile.
   *   ≥1024px (DESKTOP): pin + highlight secuencial + numeral que muta.
   *
   * Todo el motion se registra dentro de ScrollTrigger.matchMedia — así el
   * bloque desktop JAMÁS corre en mobile (no toca el body-scroll de iOS) y GSAP
   * limpia/recrea automáticamente al cruzar el breakpoint (resize).
   */

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.querySelector<HTMLElement>('[data-svc]');
  const list = document.querySelector<HTMLElement>('[data-svc-list]');

  if (section && list && !prefersReduced) {
    (async () => {
      try {
        const { gsap } = await import('gsap');
        const { ScrollTrigger } = await import('gsap/ScrollTrigger');
        gsap.registerPlugin(ScrollTrigger);

        const rows = gsap.utils.toArray<HTMLElement>('[data-svc-row]');
        const bignum = section.querySelector<HTMLElement>('[data-svc-bignum]');
        const imgs = gsap.utils.toArray<HTMLElement>('[data-svc-img]');

        ScrollTrigger.matchMedia({
          /* ─────────── DESKTOP ≥1024px: HOVER-to-preview (gesto Monolog) ──
             SIN pin (decisión William 2026-07-28: el pin trababa el scroll
             hasta pasar los 6 servicios). La sección se scrollea normal; los
             servicios se exploran con el CURSOR: al pasar el mouse sobre un
             nombre, su diagrama aparece al instante. Como Monolog. */
          '(min-width: 1024px)': () => {
            const setActive = (idx: number) => {
              rows.forEach((r, i) => {
                if (i === idx) r.setAttribute('data-active', '');
                else r.removeAttribute('data-active');
              });
              /* Diagrama del servicio activo (crossfade por CSS) */
              imgs.forEach((im, i) => {
                if (i === idx) im.setAttribute('data-active', '');
                else im.removeAttribute('data-active');
              });
              if (bignum) {
                const n = String(idx + 1).padStart(2, '0');
                if (bignum.textContent !== n) {
                  /* micro-transición del numeral al mutar */
                  gsap.fromTo(
                    bignum,
                    { yPercent: 8, opacity: 0.4 },
                    { yPercent: 0, opacity: 1, duration: 0.45, ease: 'expo.out', overwrite: true },
                  );
                  bignum.textContent = n;
                }
              }
            };
            /* Primer servicio activo por defecto (antes de tocar nada) */
            setActive(0);

            /* Hover sobre un servicio → su diagrama al instante. */
            const onRowEnter = (e: Event) => {
              const row = e.currentTarget as HTMLElement;
              const idx = Number(row.getAttribute('data-index'));
              if (Number.isNaN(idx)) return;
              setActive(idx);
            };

            rows.forEach((r) => {
              r.style.cursor = 'default';
              r.addEventListener('mouseenter', onRowEnter);
            });

            return () => {
              rows.forEach((r) => {
                r.removeAttribute('data-active');
                r.style.cursor = '';
                r.removeEventListener('mouseenter', onRowEnter);
              });
            };
          },

          /* ─────────── MOBILE/TABLET <1024px: reveal simple ───────────
             OJO: en mobile el scroller es document.body (directiva iOS
             body-scroll-container), NO window. ScrollTrigger observa el
             scroll del root por defecto, así que su trigger 'top 80%' NO
             dispara de forma fiable acá → las filas quedaban en opacity:0
             PARA SIEMPRE (pantalla en blanco). Por eso el reveal mobile usa
             IntersectionObserver nativo (observa el viewport real, ajeno a
             qué elemento scrollea) + un timeout de seguridad que garantiza
             que el contenido NUNCA quede invisible aunque todo falle. */
          '(max-width: 1023px)': () => {
            section.classList.add('svc-animate-base');

            const reveal = () => {
              gsap.to(rows, {
                opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', stagger: 0.08,
                overwrite: true,
              });
            };

            /* Red de seguridad dura: pase lo que pase, a los 1.2s el
               contenido se muestra. Si el observer ya reveló, este to()
               es un no-op (mismos valores). */
            const safety = window.setTimeout(reveal, 1200);

            const io = new IntersectionObserver((entries, obs) => {
              if (entries.some((e) => e.isIntersecting)) {
                window.clearTimeout(safety);
                reveal();
                obs.disconnect();
              }
            }, { rootMargin: '0px 0px -20% 0px' });
            io.observe(list);

            return () => { window.clearTimeout(safety); io.disconnect(); };
          },
        });
      } catch (err) {
        console.error('[ServicesSection] motion init failed:', err);
        document.querySelectorAll<HTMLElement>('[data-svc-row]').forEach((r) => {
          r.style.opacity = '1';
          r.style.transform = 'none';
        });
      }
    })();
  }
</script>
