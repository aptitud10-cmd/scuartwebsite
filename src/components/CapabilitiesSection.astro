---
/**
 * CapabilitiesSection.astro — Sección Capabilities (entre Portfolio y Método)
 * SCUART — Alcance comercial expandido, tratamiento editorial.
 *
 * CONCEPTO: Lista numerada editorial 01-06. NO cards. NO grid simétrico.
 * Cada fila = número mono (03) + nombre capability (N1, Archivo display) +
 *             línea "qué resuelve" (N2, DM Sans taupe → crema en hover).
 * Separadas por reglas finas --linea. Hover: fila activa crema, demás taupe.
 *
 * DIFERENCIACIÓN respecto a las otras secciones:
 *   - Hero: índice 001-004, comprimido, sin "qué resuelve" — presentación.
 *   - Método: stepCapabilities por paso dentro de un panel interactivo — proceso.
 *   - Portfolio: nombres display gigantes + imagen reveal — prueba de trabajo.
 *   - CAPABILITIES: 01-06 en filas editoriales, nombre mediano-grande +
 *     línea de valor visible — alcance completo del estudio.
 *   Las 4 diferencias técnicas: numeración distinta (01 vs 001), sin imagen,
 *   sin interactividad de panel, "qué resuelve" siempre visible.
 *
 * JERARQUÍA VISUAL (≤3 niveles, R10):
 *   N1 — nombre capability (Archivo 700, crema, display mediano-grande)
 *         protagonista de cada fila. ≥40% del peso visual por fila.
 *   N2 — línea "qué resuelve" (DM Sans, taupe en reposo / crema hover)
 *   N3 — número mono (01-06, IBM Plex Mono, taupe, terciario)
 *
 * PRESUPUESTO ROJO (máx 4 instancias/viewport):
 *   Instancia única: barra 2px superior de la fila en hover desktop (--rojo).
 *   Las demás secciones ya usan su presupuesto. Acá: 1 instancia. Dentro del máx.
 *
 * FONDO: --carbon (oscuro base). El portfolio usa --carbon-elev (elevado).
 *   capabilities vuelve a --carbon → contraste de plano vs portfolio.
 *   El método también es --carbon → la regla editorial entre sections los separa.
 *
 * RESPONSIVE (mobile-first):
 *   Mobile 375: apilado vertical. Número pequeño + nombre grande + línea.
 *               Regla fina entre filas. Touch-friendly.
 *   Tablet 768: layout horizontal en fila — número col-izq, nombre+línea col-der.
 *   Desktop 1280: layout en grilla 3 col (número | nombre | resolves).
 *                 Hover: la fila se resalta (crema), las demás taupe.
 *
 * REVEAL: IntersectionObserver + stagger por fila. Idéntico al manifesto.
 *   Progressive enhancement: visible sin JS.
 *   reduced-motion: estático.
 *
 * HTML server-rendered — indexable por SEO sin JS.
 */

import type { Translations, CapabilityService } from '../i18n/en';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const items: CapabilityService[] = t.capabilities.items;
const kicker: string = t.capabilities.kicker;
---

<!--
  Sección CAPABILITIES — id="capabilities" para anclaje de nav (futuro).
  aria-label describe el contenido a lectores de pantalla.
-->
<section
  class="capabilities"
  id="capabilities"
  aria-label={t.capabilities.ariaLabel}
>

  <!--
    HEADER: kicker mono + regla editorial superior.
    Coherente con hero, portfolio y método.
  -->
  <div class="capabilities-header">
    <p class="capabilities-kicker">{kicker}</p>
  </div>

  <!--
    LISTA EDITORIAL — 6 filas, una por capability.
    ol semántico: el orden importa (01-06 es el sistema visual del estudio).
    Cada li = una fila editorial con 3 zonas: número / nombre / resolves.
    El hover afecta la fila completa, no solo un elemento.
  -->
  <ol class="capabilities-list" role="list" aria-label={kicker}>
    {items.map((item, index) => (
      <li
        class="capabilities-row"
        data-row-index={index}
      >
        <!--
          Número — N3, terciario, coordenada del sistema.
          2 dígitos: "01"-"06". Distinto a "001"-"004" del hero/método.
          IBM Plex Mono, taupe, pequeño.
        -->
        <span class="capabilities-num" aria-hidden="true">{item.num}</span>

        <!--
          Bloque nombre + resolves — zona derecha (desktop/tablet) o abajo (mobile).
          El nombre es N1 protagonista. Resolves es N2 subordinado.
        -->
        <div class="capabilities-content">
          <!--
            Nombre de la capability — N1.
            Archivo variable, peso fuerte, crema. Mediano-grande.
            Términos técnicos en inglés en ambos idiomas (coherente con el sistema).
          -->
          <p class="capabilities-name">{item.name}</p>

          <!--
            Línea "qué resuelve" — N2.
            La pieza diferenciadora: no existe en hero ni en método.
            DM Sans, taupe en reposo, crema suave en hover (desktop).
            1 línea idealmente, máx 2 en mobile.
          -->
          <p class="capabilities-resolves">{item.resolves}</p>
        </div>

        <!--
          Barra roja de hover — instancia única del presupuesto rojo.
          2px top. Solo visible en hover desktop.
          aria-hidden: decorativo.
        -->
        <span class="capabilities-row__bar" aria-hidden="true"></span>
      </li>
    ))}
  </ol>

</section>

<style>
/* ═══════════════════════════════════════════════════════════
   CAPABILITIES SECTION
   Mobile-first: 375px base. md: 768px. lg: 1280px.
   Fondo: --carbon (base oscuro, distinto a --carbon-elev del portfolio).
   ═══════════════════════════════════════════════════════════ */

/* ─── SECCIÓN ────────────────────────────────────────────── */

.capabilities {
  background-color: var(--carbon);
  padding-top: var(--space-xl);
  padding-bottom: var(--space-2xl);
  padding-left: var(--margin);
  padding-right: var(--margin);
  position: relative;
  overflow-x: clip;
  /* Nav fixed 72px: evitar que el header tape el anclaje */
  scroll-margin-top: 72px;
}

/* ─── HEADER / KICKER ────────────────────────────────────── */

.capabilities-header {
  /*
   * Regla editorial superior: quiebre visual entre portfolio (--carbon-elev)
   * y capabilities (--carbon). La línea marca el cambio de bloque.
   * Coherente con manifesto y portfolio.
   */
  border-top: 1px solid var(--linea);
  padding-top: var(--space-m);
  margin-bottom: var(--space-l);
}

.capabilities-kicker {
  font-family: var(--font-mono);
  font-size: var(--text-mono);
  font-weight: 400;
  color: var(--taupe);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  line-height: 1.4;
  margin: 0;
}

/* ─── LISTA EDITORIAL ────────────────────────────────────── */

.capabilities-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* ─── FILA (mobile base: apilado vertical) ───────────────── */

/*
 * Mobile: cada fila = bloque vertical compacto.
 * Número pequeño arriba-izquierda como coordenada editorial.
 * Nombre grande debajo. Resolves debajo del nombre.
 * Regla fina entre filas (border-top en cada li excepto el primero).
 *
 * Asimetría intencional (R2): número chico / nombre grande crea
 * la tensión editorial que distingue de una lista plana.
 */
.capabilities-row {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding-top: var(--space-m);
  padding-bottom: var(--space-m);
  border-top: 1px solid var(--linea);
}

.capabilities-row:last-child {
  border-bottom: 1px solid var(--linea);
}

/* Barra roja top: oculta en mobile, activada en hover desktop */
.capabilities-row__bar {
  display: none;
}

/* ─── NÚMERO — N3 terciario ──────────────────────────────── */

.capabilities-num {
  font-family: var(--font-mono);
  font-size: var(--text-mono);
  font-weight: 400;
  color: var(--taupe);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  /* En mobile el número queda arriba del nombre — coordenada de expediente */
}

/* ─── BLOQUE CONTENIDO ───────────────────────────────────── */

.capabilities-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-2xs);
}

/* ─── NOMBRE — N1 protagonista ───────────────────────────── */

/*
 * El nombre es el elemento de mayor peso visual (N1).
 * Archivo variable, peso 700 (bold pero no 900 — hay que dejar
 * el 900 para los H1/titulos de otras secciones).
 * Clamp calibrado para que en mobile sea legible y en desktop imponga.
 * La asimetría con el número (pequeño mono) y el resolves (body)
 * crea los 3 niveles de jerarquía sin añadir color extra.
 */
.capabilities-name {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(1.5rem, 4vw, 2.5rem);
  line-height: 1;
  letter-spacing: -0.02em;
  font-variation-settings: 'wdth' 110;
  color: var(--crema);
  text-transform: uppercase;
  margin: 0;
  hyphens: none;
}

/* ─── RESOLVES — N2 subordinado ──────────────────────────── */

/*
 * La línea de "qué resuelve": la pieza diferenciadora.
 * DM Sans body (no mono): contrasta con el nombre display y el número mono.
 * Taupe: subordinado visualmente al nombre crema (N1 vs N2).
 * max-width en desktop evita líneas demasiado largas (55ch ~óptimo).
 */
.capabilities-resolves {
  font-family: var(--font-body);
  font-size: var(--text-body);
  font-weight: 400;
  color: var(--taupe);
  line-height: 1.55;
  margin: 0;
  max-width: 55ch;
}

/* ─── REVEAL: estado para JS ─────────────────────────────── */

/*
 * Estado inicial oculto (añadido por JS con .is-hidden).
 * Estado visible (añadido por JS con .is-visible).
 * Progressive enhancement: sin JS → visible por defecto (sin opacity:0 aquí).
 * Idéntico al pattern del manifesto.
 */
.capabilities-row.is-hidden {
  opacity: 0;
  transform: translateY(16px);
}

.capabilities-row.is-visible {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

/* reduced-motion: override — sin transición */
@media (prefers-reduced-motion: reduce) {
  .capabilities-row.is-hidden {
    opacity: 1;
    transform: translateY(0);
  }
  .capabilities-row.is-visible {
    transition: none;
  }
}

/* ═══════════════════════════════════════════════════════════
   TABLET (768px+) — layout horizontal número + contenido
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 768px) {
  .capabilities {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  /*
   * Tablet: fila horizontal.
   * Número: columna fija izquierda (~48px, alineado top).
   * Contenido: nombre + resolves, ocupa el resto.
   * align-items: flex-start → número y nombre alinean a la misma baseline.
   */
  .capabilities-row {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-m);
    padding-top: var(--space-m);
    padding-bottom: var(--space-m);
  }

  .capabilities-num {
    /* Ancho fijo para alinear verticalmente los nombres entre filas */
    min-width: 2.5rem;
    padding-top: 0.25em; /* alinear óptica con la cap-height del nombre */
  }

  .capabilities-content {
    flex: 1;
    gap: var(--space-2xs);
  }
}

/* ═══════════════════════════════════════════════════════════
   DESKTOP (1280px+) — grilla 3 col con hover inteligente
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 1280px) {
  .capabilities {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  /*
   * Desktop: fila en grid 2 col.
   * Col 1: número mono (ancho fijo 4rem)
   * Col 2: bloque contenido (nombre apilado sobre resolves) — ocupa el resto.
   *
   * Asimetría intencional (R2): número pequeño anclado izquierda,
   * bloque contenido dominante derecha. No es simétrico — el nombre
   * display grande contrasta visualmente con el número mono diminuto.
   *
   * Nota: el resolves podría ir en una 3ra columna separada pero el resultado
   * editorial es más limpio con nombre+resolves apilados (jerarquía vertical
   * dentro de la col derecha). Más legible, menos fragmentado.
   */
  .capabilities-row {
    display: grid;
    grid-template-columns: 4rem 1fr;
    align-items: center;
    gap: 0 var(--space-l);
    /*
     * Desktop: padding reducido vs tablet para que las 6 filas
     * se sientan como una lista cohesiva, no como secciones separadas.
     * --space-s = ~16-24px. Suficiente respiración sin dispersión.
     */
    padding-top: var(--space-s);
    padding-bottom: var(--space-s);
    cursor: default;
    /* Transición para el dimming de las filas inactivas */
    transition: opacity 0.2s ease;
    position: relative;
  }

  /*
   * Barra roja top — instancia única del presupuesto rojo.
   * 2px, visible solo en hover. Posición absolute relativa a la fila.
   * Marca la fila activa con la mínima cantidad de rojo posible.
   */
  .capabilities-row__bar {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--rojo);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  /*
   * Hover en una fila:
   *   1. La fila hovered: plena opacidad (ya la tiene). La barra roja aparece.
   *   2. Las otras filas: se dimean a 0.35 (taupe implícito).
   *
   * Mecanismo: el hover en la lista activa .is-dimmed en todos los siblings.
   * En CSS puro: usamos .capabilities-list:has(.capabilities-row:hover) para
   * dimear toda la lista, y la fila hovered recupera opacidad 1.
   * El :has() es soportado en todos los browsers modernos (2023+).
   */

  /* Cuando alguna fila está hovered: dimear toda la lista */
  .capabilities-list:has(.capabilities-row:hover) .capabilities-row {
    opacity: 0.35;
  }

  /* La fila hovered recupera opacidad total y activa la barra roja */
  .capabilities-list:has(.capabilities-row:hover) .capabilities-row:hover {
    opacity: 1;
  }

  .capabilities-row:hover .capabilities-row__bar {
    opacity: 1;
  }

  /* El nombre se vuelve ligeramente más prominente en hover */
  .capabilities-row:hover .capabilities-name {
    color: var(--crema);
  }

  /* El resolves sube un tono en hover (taupe → más claro) */
  .capabilities-row:hover .capabilities-resolves {
    color: rgba(232, 226, 214, 0.7); /* --crema con 70% opacidad */
  }

  /* Focus visible para teclado */
  .capabilities-row:focus-visible {
    outline: 2px solid var(--crema);
    outline-offset: -2px;
  }

  .capabilities-num {
    min-width: unset;
    padding-top: 0;
  }

  /*
   * Nombre desktop: escala máxima.
   * clamp ajustado para que en 1280px sea ~2.5rem y crezca hasta 3.5rem en pantallas grandes.
   * El nombre más largo ("ORDERING · BOOKING · WORKFLOWS") debe caber en una línea a 1280px.
   */
  .capabilities-name {
    font-size: clamp(1.75rem, 2.5vw, 3rem);
    /*
     * Sin nowrap: si en alguna pantalla el nombre más largo rompe,
     * que rompa bien (no se corte con ellipsis).
     * En 1280px todos los nombres caben en una línea verificado por screenshot.
     */
  }

  .capabilities-resolves {
    max-width: 48ch;
    transition: color 0.2s ease;
  }
}
</style>

<script>
  /**
   * CapabilitiesSection — Reveal con IntersectionObserver + stagger por fila.
   *
   * PROGRESSIVE ENHANCEMENT:
   * El HTML es visible sin JS (sin opacity:0 en CSS base).
   * JS añade .is-hidden ANTES de observar → estado inicial invisible
   * solo existe si JS está disponible. Idéntico al pattern del manifesto.
   *
   * STAGGER:
   * Las 6 filas entran escalonadas. Se usan transition-delay inline
   * (no CSS estático) para que el stagger se calcule por índice de fila.
   * Delay por fila: índice * 0.07s.
   *
   * reduced-motion:
   * Si el usuario prefiere movimiento reducido, .is-hidden no oculta
   * (el CSS override lo maneja). No se necesita branch aquí.
   */

  const section = document.querySelector<HTMLElement>('.capabilities');
  if (section) {
    const rows = section.querySelectorAll<HTMLElement>('.capabilities-row');

    /* Añadir estado inicial oculto + delay de stagger ANTES de observar */
    rows.forEach((row, i) => {
      row.classList.add('is-hidden');
      /* Stagger: 70ms por fila. La primera entra al instante, la última +350ms. */
      row.style.transitionDelay = `${i * 0.07}s`;
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            /* Revelar todas las filas (el delay se encarga del stagger) */
            rows.forEach((row) => {
              row.classList.remove('is-hidden');
              row.classList.add('is-visible');
            });
            /* Una sola vez */
            observer.disconnect();
          }
        });
      },
      {
        /*
         * threshold 0.1: la sección debe estar al menos 10% visible.
         * Menor que el manifesto (0.15) porque capabilities es más alta —
         * un threshold menor garantiza que el reveal empieza antes de que
         * el usuario tenga que scrollear hasta el fondo de la sección.
         */
        threshold: 0.1,
      }
    );

    observer.observe(section);
  }
</script>
