---
/**
 * CapabilitiesSection.astro — V3 "Terracota cálida en alternancia"
 * SCUART — ART_DIRECTION_V3_FINAL.md §5-CAPABILITIES
 *
 * CONCEPTO V3: Lista editorial vertical de 6 servicios.
 * Numerales gigantes Fraunces light (01–06) solapados con el nombre —
 * elemento gráfico-arquitectónico, no etiqueta. Fondo hueso.
 *
 * COMPOSICIÓN:
 *   - Numeral: position:absolute, Fraunces 300, clamp(4rem→7rem),
 *     color terracota al 15% opacidad (elemento gráfico de fondo).
 *   - Nombre del servicio: Fraunces 400, Display M, tinta.
 *     Se solapa con el numeral — composición editorial superpuesta.
 *   - resolves: Hanken 400, tinta-suave.
 *   - Divisores hairline --borde.
 *
 * ASIMETRÍA DESKTOP: filas pares tienen padding-left extra —
 * la lista NO es una tabla centrada monótona.
 *
 * REVEAL: IntersectionObserver + stagger. Sin GSAP.
 * Progressive enhancement: visible sin JS.
 * prefers-reduced-motion: estático.
 *
 * TOKENS USADOS (todos V3): --hueso, --tinta, --tinta-suave, --terracota,
 *   --borde, --font-display, --font-body, --font-mono, --text-mono.
 * PROHIBIDOS en este archivo: --carbon, --crema, --taupe, --rojo, --linea.
 */

import type { Translations, CapabilityService } from '../i18n/en';

// Props tipado via Astro.props — consumida por el runtime de Astro
const { t } = Astro.props as { t: Translations };
const items: CapabilityService[] = t.capabilities.items;
const kicker: string = t.capabilities.kicker;
---

<section
  class="cap"
  id="capabilities"
  aria-label={t.capabilities.ariaLabel}
>

  <div class="cap-header">
    <p class="cap-kicker">{kicker}</p>
  </div>

  <ol class="cap-list" role="list" aria-label={kicker}>
    {items.map((item, index) => (
      <li
        class="cap-row"
        data-row-index={index}
        data-even={index % 2 === 1 ? 'true' : 'false'}
      >
        <!--
          Numeral gigante: elemento gráfico-arquitectónico.
          aria-hidden: no aporta info semántica (el número está implícito en el orden de lista).
          position:absolute dentro de .cap-row (position:relative).
          Color terracota al 15% = presente como textura, no protagonista.
        -->
        <span class="cap-num" aria-hidden="true">{item.num}</span>

        <div class="cap-content">
          <!--
            Nombre del servicio: N1, Fraunces 400, tinta.
            El nombre se solapa con la parte inferior del numeral — solapamiento editorial.
            No es un bug; es la composición intencional (ver §5 capabilities).
          -->
          <p class="cap-name">{item.name}</p>

          <!--
            resolves: N2, Hanken, tinta-suave.
            La diferenciadora — siempre visible (no hover-only).
          -->
          <p class="cap-resolves">{item.resolves}</p>
        </div>
      </li>
    ))}
  </ol>

</section>

<style>
/* ═══════════════════════════════════════════════════════════
   CAPABILITIES SECTION — V4 "Restringido" (1 color + negro/hueso)
   Fondo: --bg negro. Mobile-first: 375px → 768px → 1280px.
   ═══════════════════════════════════════════════════════════ */

/* ─── SECCIÓN ────────────────────────────────────────────── */

.cap {
  /* Cuerpo OSCURO de punta a punta (V4 §4: el video del hero es el único color) */
  background-color: var(--bg);
  isolation: isolate;
  padding-top: var(--space-xl);
  padding-bottom: var(--space-2xl);
  padding-left: var(--margin);
  padding-right: var(--margin);
  position: relative;
  overflow-x: clip;
  scroll-margin-top: 72px;
}

/* ─── HEADER / KICKER ────────────────────────────────────── */

.cap-header {
  border-top: 1px solid var(--hairline);
  padding-top: var(--space-m);
  margin-bottom: var(--space-l);
}

.cap-kicker {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  color: var(--ink-62);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  line-height: 1.4;
  margin: 0;
}

/* ─── LISTA EDITORIAL ────────────────────────────────────── */

.cap-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* ─── FILA — mobile base ─────────────────────────────────── */

/*
 * Mobile (375px):
 * El numeral position:absolute arriba-izquierda.
 * El contenido (nombre + resolves) tiene padding-top suficiente para
 * que el nombre se solape con la parte INFERIOR del numeral gigante.
 * El solapamiento es la composición intencional — el numeral "asoma"
 * por encima del nombre como elemento gráfico de fondo.
 */
.cap-row {
  position: relative;
  display: flex;
  flex-direction: column;
  padding-top: var(--space-m);
  padding-bottom: var(--space-m);
  border-top: 1px solid var(--hairline);
  /* Overflow visible para que el numeral gigante sobresalga si hace falta */
  overflow: visible;
}

.cap-row:last-child {
  border-bottom: 1px solid var(--hairline);
}

/* ─── NUMERAL GIGANTE — elemento gráfico-arquitectónico ─── */

/*
 * Fraunces 300 light, tamaño display.
 * Color: terracota al 15% de opacidad — presente como textura, no protagonista.
 * position:absolute en mobile: se ubica arriba-izquierda, el contenido se solapa.
 */
.cap-num {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(3.5rem, 8vw, 6.5rem);
  line-height: 0.9;
  letter-spacing: -0.03em;
  color: var(--ink-18);  /* hueso 18% — fantasma sobre negro */
  font-variant-numeric: tabular-nums;
  font-style: normal;
  /* Mobile: numeral como fondo del bloque — position relative para flujo */
  position: relative;
  display: block;
  pointer-events: none;
  /* Negativo margin-bottom para que el nombre "suba" y se solape */
  margin-bottom: calc(-1 * clamp(1.5rem, 3.5vw, 3rem));
  /* El numeral define la altura mínima del bloque superior */
  min-height: clamp(2.5rem, 6vw, 5rem);
}

/* ─── CONTENIDO (nombre + resolves) ─────────────────────── */

.cap-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-2xs);
  /* z-index positivo para solaparse sobre el numeral */
  position: relative;
  z-index: 1;
  padding-top: 0;
}

/* ─── NOMBRE — N1 protagonista ───────────────────────────── */

/*
 * Fraunces 400 (normal, no light) — más presencia que el numeral en 300.
 * Display M: clamp(1.75rem→2.5rem).
 * tinta (casi-negro cálido) sobre hueso — contraste AAA.
 */
.cap-name {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  line-height: 1.0;
  letter-spacing: -0.02em;
  color: var(--ink);
  font-style: normal;
  margin: 0;
  hyphens: none;
}

/* ─── RESOLVES — N2 subordinado ──────────────────────────── */

/*
 * Hanken 400, tinta-suave, body.
 * Contraste tinta-suave #6B5D4F sobre hueso #F0E9DC: ~5.2:1 (AA).
 */
.cap-resolves {
  font-family: var(--font-body);
  font-size: var(--text-body);
  font-weight: 400;
  color: var(--ink-62);
  line-height: 1.55;
  margin: 0;
  max-width: 52ch;
}

/* ─── REVEAL: estados para IntersectionObserver ──────────── */

/*
 * Progressive enhancement: sin JS → visible (sin opacity:0 en base).
 * JS añade .is-hidden antes de observar.
 */
.cap-row.is-hidden {
  opacity: 0;
  transform: translateY(20px);
}

.cap-row.is-visible {
  opacity: 1;
  transform: translateY(0);
  transition:
    opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
    transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
}

@media (prefers-reduced-motion: reduce) {
  .cap-row.is-hidden {
    opacity: 1;
    transform: none;
  }
  .cap-row.is-visible {
    transition: none;
  }
}

/* ═══════════════════════════════════════════════════════════
   TABLET (768px+)
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 768px) {
  .cap {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  /*
   * Tablet: fila horizontal.
   * Numeral position:absolute anclado izquierda, grande.
   * Contenido (nombre + resolves) arranca con padding-left para no tapar
   * el numeral, pero el nombre "sube" con margin-top negativo para solaparse.
   */
  .cap-row {
    flex-direction: row;
    align-items: flex-start;
    padding-top: var(--space-l);
    padding-bottom: var(--space-m);
    overflow: visible;
  }

  .cap-num {
    position: absolute;
    top: calc(var(--space-l) * 0.4);
    left: 0;
    margin-bottom: 0;
    min-height: unset;
    font-size: clamp(4rem, 9vw, 7rem);
    z-index: 0;
  }

  .cap-content {
    /* Empuja el contenido a la derecha del numeral */
    padding-left: clamp(4.5rem, 10vw, 8rem);
    flex: 1;
    /* El nombre sube para solaparse con la parte inferior del numeral */
    margin-top: calc(-1 * clamp(0.5rem, 1.5vw, 1.5rem));
  }

  .cap-name {
    font-size: clamp(1.875rem, 3.5vw, 2.625rem);
  }
}

/* ═══════════════════════════════════════════════════════════
   DESKTOP (1280px+) — asimetría editorial izq/der alternada
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 1280px) {
  .cap {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  .cap-row {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-m);
    /* Transición de hover sutil */
    transition: opacity 0.2s ease;
    cursor: default;
  }

  /*
   * Asimetría editorial: filas pares (índice 1,3,5) sangran a la derecha.
   * La lista no es una tabla centrada monótona — alternancia intencional.
   */
  .cap-row[data-even="true"] .cap-content {
    padding-left: clamp(6rem, 14vw, 12rem);
    max-width: 72ch;
  }

  .cap-row[data-even="false"] .cap-content {
    padding-left: clamp(4.5rem, 9vw, 8rem);
    max-width: 64ch;
  }

  .cap-num {
    font-size: clamp(4.5rem, 10vw, 8rem);
    top: calc(var(--space-xl) * 0.35);
  }

  .cap-name {
    font-size: clamp(2rem, 3vw, 3rem);
  }

  .cap-resolves {
    max-width: 52ch;
  }

  /* Hover: dimear la lista excepto la fila hovered */
  .cap-list:has(.cap-row:hover) .cap-row {
    opacity: 0.4;
  }

  .cap-list:has(.cap-row:hover) .cap-row:hover {
    opacity: 1;
  }

  /* Focus visible teclado */
  .cap-row:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 4px;
  }
}
</style>

<script>
  /**
   * CapabilitiesSection — Reveal IntersectionObserver + stagger.
   *
   * Progressive enhancement:
   * Sin JS → filas visibles (sin opacity:0 en CSS base).
   * Con JS → se añade .is-hidden antes de observar, luego .is-visible con stagger.
   *
   * prefers-reduced-motion: el CSS override maneja — no hace falta branch aquí.
   */

  const section = document.querySelector<HTMLElement>('.cap');
  if (section) {
    const rows = section.querySelectorAll<HTMLElement>('.cap-row');

    rows.forEach((row, i) => {
      row.classList.add('is-hidden');
      /* Stagger: 80ms por fila. Más lento que el V1 (70ms) — más editorial. */
      row.style.transitionDelay = `${i * 0.08}s`;
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            rows.forEach((row) => {
              row.classList.remove('is-hidden');
              row.classList.add('is-visible');
            });
            observer.disconnect();
          }
        });
      },
      { threshold: 0.08 }
    );

    observer.observe(section);
  }
</script>
