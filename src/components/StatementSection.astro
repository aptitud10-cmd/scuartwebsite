---
/**
 * StatementSection.astro — Sección "About" dark, COPIA EXACTA del commit e1823ae.
 *
 * Extraída literalmente del bloque `stu-about` de StudioSection.astro (e1823ae):
 * markup, CSS y JS idénticos. Copy exacto del original (hardcodeado por idioma,
 * tal como estaba en i18n del commit viejo). Mecanismo Trionn: full-bleed dark,
 * frase gigante en mix-blend-difference que se ilumina palabra por palabra con
 * el scroll (scrub), + anotaciones ancladas en las esquinas.
 */

import type { Translations } from '../i18n/en';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const lang = t === undefined ? 'en' : (t.nav.langLabel === 'EN' ? 'es' : 'en');

/* Copy EXACTO del commit e1823ae (aboutStatement / whatWeDoLabel de i18n viejo) */
const COPY = {
  es: {
    whatWeDoLabel: 'QUÉ HACEMOS',
    statement:
      'Hacemos que tu marca se sienta memorable, con webs que transmiten confianza, no solo diseño — diseñadas con criterio, no por tendencia.',
    valuesLead: 'DISEÑAMOS PARA QUE DURE',
    valuesList: 'CLARIDAD PRIMERO, OFICIO SIEMPRE, HECHO PARA ESCALAR',
    mission:
      'Nuestra misión es hacer que la tecnología se sienta humana, diseñando productos digitales intuitivos, con propósito y significado para las personas.',
  },
  en: {
    whatWeDoLabel: 'WHAT WE DO',
    statement:
      'We make your brand feel unforgettable, with websites that earn trust, not just attention — designed with intent, not trend.',
    valuesLead: 'WE DESIGN FOR LONGEVITY',
    valuesList: 'CLARITY FIRST, CRAFT ALWAYS, BUILT TO SCALE',
    mission:
      'Our mission is to make technology feel human by designing digital products that are intuitive, purposeful, and meaningful to people.',
  },
} as const;

const c = COPY[lang as 'es' | 'en'];
---

<div class="stu-part stu-about" id="studio-what" aria-label={c.whatWeDoLabel}>

  <!-- Fondo negro sólido (--bg-dark vía CSS). Antes había un <video> que
       apuntaba a /studio-bg.{webm,mp4,poster} — archivos que NO existen →
       3× 404 por pageview + contraste impredecible del texto en
       mix-blend-difference sobre frames variables + video que no se pausaba
       con prefers-reduced-motion. Quitarlo cierra los tres problemas: la
       sección ya se veía como bloque negro con la frase iluminándose, que es
       el diseño real. Si algún día hay video, se re-agrega con los archivos. -->

  <div class="stu-about__inner">

    <!-- Frase fusionada gigante en mix-blend-difference -->
    <p class="stu-about__statement" data-stu-about-statement>
      {c.statement}
    </p>

    <!-- Anotaciones de esquina -->
    <div class="stu-about__values" data-stu-annotation>
      <p class="stu-about__values-lead">{c.valuesLead}</p>
      <p class="stu-about__values-list">{c.valuesList}</p>
    </div>

    <p class="stu-about__mission" data-stu-annotation>
      {c.mission}
    </p>
  </div>
</div>

<style>
.stu-about {
  position: relative;
  isolation: isolate;
  background-color: #0a0a0a; /* fondo negro sólido (único momento dark del sitio) */

  /* Full-bleed robusto: el fondo negro llega a los bordes del viewport SIN
     depender de compensar un padding del <main> (que no tiene ninguno). Usa
     100vw centrado con left-50%/translateX. Así el bleed es exacto en todo
     viewport y el padding del __inner (--margin) es el ÚNICO responsable del
     aire lateral del texto → nada toca el borde. */
  width: 100vw;
  margin-left: 50%;
  transform: translateX(-50%);
  padding: 0; /* el aire lo pone __inner */

  /* Pantalla completa (decisión de William). svh = small viewport height:
     no se pelea con la barra dinámica de Safari en mobile. Antes esto era
     100svh y se bajó por "mucho negro abajo" — ahora el __inner reparte el
     alto (grilla 1fr/auto en desktop, flex centrado en mobile) así que la
     altura completa se LLENA en vez de dejar hueco muerto. */
  min-height: 100svh;

  display: flex;
  align-items: stretch;
  overflow: hidden;
}

/* Contenedor del texto — sobre el fondo negro, en blend-difference */
.stu-about__inner {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  /* Padding lateral GARANTIZADO: la sección es full-bleed (margin negativo
     saca el bloque a los bordes del viewport). Este padding repone el aire para
     que NADA (ni la frase ni las anotaciones de esquina) toque el borde.
     Piso 1.5rem en mobile chico, hasta --margin en desktop. */
  padding-top: var(--space-2xl);
  padding-bottom: var(--space-2xl);
  padding-left: max(var(--margin), 1.5rem);
  padding-right: max(var(--margin), 1.5rem);
  /* mix-blend-difference: el texto se invierte contra el fondo → legible. */
  mix-blend-mode: difference;
}

/* ── Frase gigante — VOZ PROPIA (no Trionn) ──
   Antes era una copia de trionn.com: Geist sans BOLD 700 gigante. Eso metía
   una tercera voz tipográfica en el sitio (el hero + cuerpo hablan en serif
   PP Editorial; esto gritaba en sans gorda) → se sentía "hecho por otra
   persona". Ahora la frase habla el MISMO idioma que el Manifiesto y el
   portfolio: PP Editorial New LIGHT, serif fina. El fondo oscuro y el
   mix-blend-difference se quedan — el momento dramático sigue; lo que cambia
   es que deja de ser prestado.
   IMPORTANTE: sin opacity en CSS base — lo aplica el JS, así sin JS o si
   GSAP falla, todo se ve. */
.stu-about__statement {
  font-family: var(--font-display); /* PP Editorial New — misma voz que todo el sitio */
  font-weight: var(--display-weight-light);
  /* PICO DRAMÁTICO (2026-08-02): es el único momento oscuro del sitio → debe ser
     el texto MÁS grande de todo. Sube de --text-h2 a un rango propio mayor que
     el hero, para que domine. La iluminación por scroll (JS abajo) le da el
     golpe. */
  font-size: clamp(2.5rem, 6.5vw, 7.5rem);
  line-height: 1.05;
  letter-spacing: -0.02em;
  color: #ffffff; /* blanco puro: el encendido de la frase debe ser máximo contraste */
  text-align: center;
  /* max-width más apretado → saltos de línea más dramáticos, la frase respira menos y golpea más */
  max-width: 15em;
  margin: 0 auto var(--space-2xl) auto; /* mx-auto: centrada en la página */
}

/* ── Anotaciones de esquina ── */
.stu-about__values-lead,
.stu-about__values-list {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  line-height: 1.5;
  margin: 0;
  color: #ffffff;
}

.stu-about__values-list {
  color: rgba(255, 255, 255, 0.6);
}

.stu-about__mission {
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.8);
  margin: 0;
  max-width: 34ch;
}

/* ── MOBILE (<768px): anotaciones en flujo, apiladas bajo la frase ── */
@media (max-width: 767px) {
  .stu-about {
    /* Sin 100svh forzado en mobile: la sección toma el alto de su contenido
       (frase + anotaciones) + padding. Antes heredaba 100svh de la regla base
       y, como el contenido se apila arriba, quedaba medio viewport de NEGRO
       MUERTO abajo. Ahora el bloque negro abraza el contenido, sin hueco. */
    min-height: auto;
    align-items: flex-start;
  }
  .stu-about__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    /* Padding vertical generoso arriba y abajo → el negro respira alrededor del
       texto sin dejar un vacío enorme. */
    padding-top: calc(var(--space-2xl) + 2rem); /* respiro bajo el nav */
    padding-bottom: var(--space-2xl);
  }
  .stu-about__statement {
    max-width: 100%;
    margin-bottom: var(--space-m);
  }
  .stu-about__mission {
    max-width: 100%;
  }
}

/* ── TABLET/DESKTOP (≥768px): frase centrada, anotaciones en esquinas.
   La sección es 100svh (William). La grilla reparte ese alto: fila 1 (1fr)
   con el statement centrado verticalmente, fila 2 (auto) con las notas
   ancladas abajo. Así el viewport completo se LLENA con jerarquía —el
   statement domina el centro, las notas cierran abajo— sin negro muerto. */
@media (min-width: 768px) {
  .stu-about__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr auto;
    column-gap: var(--space-l);
    row-gap: var(--space-2xl);
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-2xl);
  }
  .stu-about__statement {
    grid-column: 1 / -1;
    grid-row: 1;
    align-self: center;
    margin-bottom: 0;
  }
  .stu-about__values {
    grid-column: 1;
    grid-row: 2;
    align-self: end;
  }
  .stu-about__mission {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
    align-self: end;
    text-align: right;
  }
}

/* ── reduced-motion: frase y anotaciones visibles desde el inicio ── */
@media (prefers-reduced-motion: reduce) {
  .stu-about__statement,
  .stu-about [data-stu-annotation] {
    opacity: 1 !important;
    filter: none !important;
    transform: none !important;
  }
}
</style>

<script>
  /* ─── About — reveal blur+opacity (mecanismo Trionn) — COPIA EXACTA e1823ae ── */

  const reducedMotionPart1 = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const aboutEl = document.querySelector<HTMLElement>('#studio-what');
  const statementEl = aboutEl?.querySelector<HTMLElement>('[data-stu-about-statement]') ?? null;
  const annotationEls = aboutEl
    ? Array.from(aboutEl.querySelectorAll<HTMLElement>('[data-stu-annotation]'))
    : [];

  if (aboutEl && statementEl && !reducedMotionPart1) {
    try {
      const { gsap } = await import('gsap');
      const { SplitText } = await import('gsap/SplitText');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(SplitText, ScrollTrigger);

      /* (1) Frase — ILUMINACIÓN POR SCROLL (mecanismo Trionn).
         La frase arranca gris-tenue; cada palabra pasa a blanco a medida
         que la sección cruza el viewport. Atado al scroll con scrub —
         NO es una animación de una vez: el usuario controla con el scroll. */
      /* aria:'none' — el texto visible ya es legible; sin esto SplitText mete
         un aria-label prohibido en el <p> (axe aria-prohibited-attr, QA 2026-07-22). */
      const split = new SplitText(statementEl, { type: 'words', autoSplit: true, aria: 'none' });
      /* Arranca casi invisible (0.08): apenas se intuye sobre el negro. El
         contraste con el blanco encendido hace el efecto mucho más dramático —
         la frase "se prende" con el scroll en vez de solo aclararse. */
      gsap.set(split.words, { opacity: 0.08 });

      /* Rango de scroll DISTINTO por viewport (gsap.matchMedia):
         - Desktop: recorrido más largo (la sección es 100svh, hay scroll de sobra).
         - Mobile: recorrido CORTO y que arranca ya entrada la sección, para que
           las letras se enciendan RÁPIDO (no "se demoran") y terminen antes de
           que el usuario pase de largo. */
      const mm = gsap.matchMedia();
      mm.add(
        {
          isDesktop: '(min-width: 768px)',
          isMobile: '(max-width: 767px)',
        },
        (ctx) => {
          const { isMobile } = ctx.conditions as { isMobile: boolean };
          gsap.to(split.words, {
            opacity: 1,
            ease: 'none',
            stagger: 0.5,
            scrollTrigger: {
              trigger: aboutEl,
              /* ARRANQUE MÁS ABAJO (William 2026-08-05, ref. Trionn): antes era
                 'top 90%' — las palabras empezaban a encenderse con la sección
                 apenas asomada (10% visible), así que para cuando el usuario la
                 miraba ya estaban casi todas blancas y el efecto no se veía.
                 En Trionn el texto se completa cuando la sección va por la MITAD
                 del scroll. 'top 55%' = arranca con la sección bien entrada en
                 pantalla; el end en 'center'/'top' cierra a mitad de recorrido. */
              start: isMobile ? 'top 60%' : 'top 50%',
              /* end atado a 'bottom' (no 'center'): el recorrido cubre TODA la
                 altura de la sección, así el encendido acompaña el scroll en
                 vez de completarse antes de que el usuario termine de pasarla. */
              end: isMobile ? 'bottom 75%' : 'bottom 70%',
              scrub: true,
            },
          });
        }
      );

      /* (2) Anotaciones de esquina — fade-up escalonado (one-shot) */
      if (annotationEls.length) {
        gsap.set(annotationEls, { opacity: 0, y: 18 });
        gsap.to(annotationEls, {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: 'power3.out',
          stagger: 0.12,
          scrollTrigger: { trigger: aboutEl, start: 'top 45%', once: true },
        });
      }

    } catch (err) {
      /* Fix del catch silencioso: loguear + dejar TODO visible. */
      console.error('[StatementSection About] motion init failed:', err);
      statementEl.style.opacity = '1';
      statementEl.style.filter = 'none';
      annotationEls.forEach((el) => {
        el.style.opacity = '1';
        el.style.transform = 'none';
      });
    }
  }
</script>
