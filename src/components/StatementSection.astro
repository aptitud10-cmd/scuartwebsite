---
/**
 * StatementSection.astro — Sección "About" dark, COPIA EXACTA del commit e1823ae.
 *
 * Extraída literalmente del bloque `stu-about` de StudioSection.astro (e1823ae):
 * markup, CSS y JS idénticos. Copy exacto del original (hardcodeado por idioma,
 * tal como estaba en i18n del commit viejo). Mecanismo Trionn: full-bleed dark,
 * frase gigante en mix-blend-difference que se ilumina palabra por palabra con
 * el scroll (scrub), + anotaciones ancladas en las esquinas.
 */

import type { Translations } from '../i18n/en';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const lang = t === undefined ? 'en' : (t.nav.langLabel === 'EN' ? 'es' : 'en');

/* COPY REESCRITO 2026-08-11 (elegido por William tras la auditoría de copy,
   que calificó esta sección 2.0/10 — lo peor del sitio).

   QUÉ SE FUE Y POR QUÉ:

   1. statement — era "Hacemos que tu marca se sienta memorable, con webs que
      transmiten confianza, no solo diseño — diseñadas con criterio, no por
      tendencia." 24 palabras, 4 cláusulas, 3 negaciones, y TRES sujetos en una
      sola oración ("hacemos que tu marca" → "webs que transmiten" → "diseñadas
      con criterio"). Es la tipografía MÁS GRANDE del sitio, en su único momento
      oscuro, con revelado palabra por palabra que obliga a leerla entera: el
      máximo dispositivo dramático gastado en algo que cualquier agencia firma.
      Además contenía "con webs", contradiciendo al Manifiesto ("No hacemos
      webs" en su versión vieja) dos secciones más arriba.
      Ahora: 10 palabras, un sujeto, cero negaciones. Y dice lo único que los
      tres casos prueban JUNTOS: diseño + infraestructura.

   2. mission — era "Nuestra misión es hacer que la tecnología se sienta humana,
      diseñando productos digitales intuitivos, con propósito y significado para
      las personas." Cuatro adjetivos de relleno seguidos; el auditor la llamó
      "la frase más corporate-vacía del sitio" y existe idéntica en miles de
      portafolios. Ahora dice el hecho que ninguna agencia puede copiar: que
      atiende la misma persona que construye. Eso además desactiva el problema
      del "nosotros" del resto del sitio: una vez dicho, se lee como voz de
      marca y no como inflar el tamaño del estudio.

   3. values — era "CLARIDAD PRIMERO, OFICIO SIEMPRE, HECHO PARA ESCALAR", una
      tríada intercambiable ("craft always" es EL cliché de agencia 2024-2026).
      Ahora, en el mismo espacio y el mismo tratamiento tipográfico, van cuatro
      hechos verificables entrando a menius.app. Es la conversión más barata de
      humo en prueba que tenía el sitio.

   TODO lo afirmado acá está verificado en el código de Menius (2026-08-11):
   SaaS propio en producción, Stripe Connect + MercadoPago + Wompi, dos apps
   Expo (comensal y repartidor), i18n es/en en tres capas. */
const COPY = {
  es: {
    whatWeDoLabel: 'QUÉ HACEMOS',
    statement:
      'Diseñamos la marca y construimos el sistema que la sostiene.',
    valuesLead: 'LO QUE HAY DETRÁS',
    /* "DOS APPS NATIVAS" se quitó el 2026-08-13 (decisión de William:
       100% transparencia). Era engañoso: la app del comensal tiene 24 commits
       en 3 días y la del repartidor UN SOLO commit cuyo propio mensaje dice
       "scaffold inicial". Ante un cliente técnico que preguntara, no se
       sostenía. Además dos features que se le atribuían —biometría y GPS en
       la app de cliente— tienen el paquete instalado pero CERO uso en código.

       NO se reemplaza por otro dato: los tres que quedan son verificables
       entrando a menius.app y alcanzan. Sumar relleno para conservar el ritmo
       de cuatro sería volver al mismo problema. */
    valuesList:
      'UN SAAS PROPIO EN PRODUCCIÓN · TRES PASARELAS DE PAGO · BILINGÜE ES/EN',
    mission:
      'SCUART es un estudio de una persona: el que diseña es el que construye y el que responde. Sin capas intermedias, sin cuentas que administrar.',
  },
  en: {
    whatWeDoLabel: 'WHAT WE DO',
    statement:
      'We design the brand and build the system that holds it up.',
    valuesLead: 'WHAT IS BEHIND IT',
    /* Ver la nota en el bloque `es`: "TWO NATIVE APPS" se quitó por no ser
       defendible ante un cliente técnico. */
    valuesList:
      'OUR OWN SAAS IN PRODUCTION · THREE PAYMENT GATEWAYS · BILINGUAL EN/ES',
    mission:
      'SCUART is a one-person studio: the person who designs is the one who builds and the one who answers. No layers in between, no account managers.',
  },
} as const;

const c = COPY[lang as 'es' | 'en'];
---

<div class="stu-part stu-about" id="studio-what" aria-label={c.whatWeDoLabel}>

  <!-- Fondo negro sólido (--bg-dark vía CSS). Antes había un <video> que
       apuntaba a /studio-bg.{webm,mp4,poster} — archivos que NO existen →
       3× 404 por pageview + contraste impredecible del texto en
       mix-blend-difference sobre frames variables + video que no se pausaba
       con prefers-reduced-motion. Quitarlo cierra los tres problemas: la
       sección ya se veía como bloque negro con la frase iluminándose, que es
       el diseño real. Si algún día hay video, se re-agrega con los archivos. -->

  <div class="stu-about__inner">

    <!-- Frase fusionada gigante en mix-blend-difference -->
    <p class="stu-about__statement" data-stu-about-statement>
      {c.statement}
    </p>

    <!-- Anotaciones de esquina -->
    <div class="stu-about__values" data-stu-annotation>
      <p class="stu-about__values-lead">{c.valuesLead}</p>
      <p class="stu-about__values-list">{c.valuesList}</p>
    </div>

    <p class="stu-about__mission" data-stu-annotation>
      {c.mission}
    </p>
  </div>
</div>

<style>
.stu-about {
  position: relative;
  isolation: isolate;
  background-color: #0a0a0a; /* fondo negro sólido (único momento dark del sitio) */

  /* Full-bleed robusto: el fondo negro llega a los bordes del viewport SIN
     depender de compensar un padding del <main> (que no tiene ninguno). Usa
     100vw centrado con left-50%/translateX. Así el bleed es exacto en todo
     viewport y el padding del __inner (--margin) es el ÚNICO responsable del
     aire lateral del texto → nada toca el borde. */
  width: 100vw;
  margin-left: 50%;
  transform: translateX(-50%);
  padding: 0; /* el aire lo pone __inner */

  /* SIN min-height:100svh (2026-08-11, aprobado por William).
     La sección forzaba pantalla completa y el grid repartía el sobrante como
     hueco: los tres visual-critics midieron 45% de vacío en desktop y 65% en
     tablet (1900px de alto con ~450px de contenido). No se leía como respiro
     editorial sino como sección rota — fue el defecto #1 o #2 en los tres
     viewports.
     Ahora la sección toma el alto de su contenido y el aire lo pone el padding
     de __inner, que es generoso a propósito. El negro sigue siendo el quiebre
     de ritmo del sitio; lo que se va es el vacío no diseñado. */

  display: flex;
  align-items: stretch;
  overflow: hidden;
}

/* Contenedor del texto — sobre el fondo negro, en blend-difference */
.stu-about__inner {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  /* Padding lateral GARANTIZADO: la sección es full-bleed (margin negativo
     saca el bloque a los bordes del viewport). Este padding repone el aire para
     que NADA (ni la frase ni las anotaciones de esquina) toque el borde.
     Piso 1.5rem en mobile chico, hasta --margin en desktop. */
  padding-top: var(--space-2xl);
  padding-bottom: var(--space-2xl);
  padding-left: max(var(--margin), 1.5rem);
  padding-right: max(var(--margin), 1.5rem);
  /* mix-blend-difference: el texto se invierte contra el fondo → legible. */
  mix-blend-mode: difference;
}

/* ── Frase gigante — VOZ PROPIA (no Trionn) ──
   Antes era una copia de trionn.com: Geist sans BOLD 700 gigante. Eso metía
   una tercera voz tipográfica en el sitio (el hero + cuerpo hablan en serif
   PP Editorial; esto gritaba en sans gorda) → se sentía "hecho por otra
   persona". Ahora la frase habla el MISMO idioma que el Manifiesto y el
   portfolio: PP Editorial New LIGHT, serif fina. El fondo oscuro y el
   mix-blend-difference se quedan — el momento dramático sigue; lo que cambia
   es que deja de ser prestado.
   IMPORTANTE: sin opacity en CSS base — lo aplica el JS, así sin JS o si
   GSAP falla, todo se ve. */
.stu-about__statement {
  font-family: var(--font-display); /* PP Editorial New — misma voz que todo el sitio */
  font-weight: var(--display-weight-light);
  /* PICO DRAMÁTICO (2026-08-02): es el único momento oscuro del sitio → debe ser
     el texto MÁS grande de todo. Sube de --text-h2 a un rango propio mayor que
     el hero, para que domine. La iluminación por scroll (JS abajo) le da el
     golpe. */
  font-size: clamp(2.5rem, 6.5vw, 7.5rem);
  line-height: 1.05;
  letter-spacing: -0.02em;
  color: #ffffff; /* blanco puro: el encendido de la frase debe ser máximo contraste */
  text-align: center;
  /* max-width más apretado → saltos de línea más dramáticos, la frase respira menos y golpea más */
  max-width: 15em;
  margin: 0 auto var(--space-2xl) auto; /* mx-auto: centrada en la página */
}

/* ── Anotaciones de esquina ── */
.stu-about__values-lead,
.stu-about__values-list {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  line-height: 1.5;
  margin: 0;
  color: #ffffff;
}

.stu-about__values-list {
  color: rgba(255, 255, 255, 0.6);
}

.stu-about__mission {
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.8);
  margin: 0;
  max-width: 34ch;
}

/* ── MOBILE (<768px): anotaciones en flujo, apiladas bajo la frase ── */
@media (max-width: 767px) {
  .stu-about {
    /* Sin 100svh forzado en mobile: la sección toma el alto de su contenido
       (frase + anotaciones) + padding. Antes heredaba 100svh de la regla base
       y, como el contenido se apila arriba, quedaba medio viewport de NEGRO
       MUERTO abajo. Ahora el bloque negro abraza el contenido, sin hueco. */
    min-height: auto;
    align-items: flex-start;
  }
  .stu-about__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    /* Padding vertical generoso arriba y abajo → el negro respira alrededor del
       texto sin dejar un vacío enorme. */
    padding-top: calc(var(--space-2xl) + 2rem); /* respiro bajo el nav */
    padding-bottom: var(--space-2xl);
  }
  .stu-about__statement {
    max-width: 100%;
    margin-bottom: var(--space-m);
  }
  .stu-about__mission {
    max-width: 100%;
  }
}

/* ── TABLET/DESKTOP (≥768px): frase arriba, anotaciones en esquinas.
   FILAS `auto auto`, no `1fr auto` (2026-08-11). Con el min-height:100svh
   quitado de la sección, un `1fr` en la primera fila ya no tiene alto sobrante
   que repartir — pero dejarlo invitaba a que el hueco volviera si alguien
   reponía una altura fija. `auto` hace explícito que cada fila mide lo que
   mide su contenido, y el aire entre ellas lo pone row-gap.
   Por lo mismo el statement pasa de `align-self: center` a `start`: centrar
   dentro de una fila que ya no tiene holgura no hacía nada, y era la regla
   que producía la frase flotando en medio del vacío. */
@media (min-width: 768px) {
  .stu-about__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--space-l);
    /* ESPACIADO INTERNO PROPORCIONADO (2026-08-11).
       Medido en 1440px, el bloque tenía 200px arriba (--space-3xl) + 144px de
       row-gap + 144px abajo = 488px de aire para 633px de contenido. Eso es lo
       que se leía como "42% de vacío": no era hueco muerto de la grilla —el
       min-height ya estaba quitado— sino padding desproporcionado.
       --space-3xl está calibrado para separar SECCIONES entre sí, no para el
       interior de una. Acá el aire tiene que respirar contra el contenido, no
       contra la página. Con --space-2xl arriba y --space-xl en gap y abajo, el
       aire pasa a ~320px: sigue siendo generoso y editorial (es el único
       momento oscuro del sitio, merece respiro) sin leerse como sección rota. */
    row-gap: var(--space-xl);
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);
  }
  .stu-about__statement {
    grid-column: 1 / -1;
    grid-row: 1;
    align-self: start;
    margin-bottom: 0;
  }
  .stu-about__values {
    grid-column: 1;
    grid-row: 2;
    align-self: end;
  }
  .stu-about__mission {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
    align-self: end;
    text-align: right;
  }
}

/* ── reduced-motion: frase y anotaciones visibles desde el inicio ── */
@media (prefers-reduced-motion: reduce) {
  .stu-about__statement,
  .stu-about [data-stu-annotation] {
    opacity: 1 !important;
    filter: none !important;
    transform: none !important;
  }
}
</style>

<script>
  /* ─── About — reveal blur+opacity (mecanismo Trionn) — COPIA EXACTA e1823ae ── */

  const reducedMotionPart1 = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const aboutEl = document.querySelector<HTMLElement>('#studio-what');
  const statementEl = aboutEl?.querySelector<HTMLElement>('[data-stu-about-statement]') ?? null;
  const annotationEls = aboutEl
    ? Array.from(aboutEl.querySelectorAll<HTMLElement>('[data-stu-annotation]'))
    : [];

  if (aboutEl && statementEl && !reducedMotionPart1) {
    try {
      const { gsap } = await import('gsap');
      const { SplitText } = await import('gsap/SplitText');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(SplitText, ScrollTrigger);

      /* (1) Frase — ILUMINACIÓN POR SCROLL (mecanismo Trionn).
         La frase arranca gris-tenue; cada palabra pasa a blanco a medida
         que la sección cruza el viewport. Atado al scroll con scrub —
         NO es una animación de una vez: el usuario controla con el scroll. */
      /* aria:'none' — el texto visible ya es legible; sin esto SplitText mete
         un aria-label prohibido en el <p> (axe aria-prohibited-attr, QA 2026-07-22). */
      const split = new SplitText(statementEl, { type: 'words', autoSplit: true, aria: 'none' });
      /* PISO DE OPACIDAD 0.65 (2026-08-11, aprobado por William).
         Historia: 0.08 → 0.47 (09-ago, por accesibilidad) → 0.65 (hoy).

         El 0.47 arreglaba el contraste (4.82:1, pasa AA) pero rompía el diseño:
         los TRES visual-critics, por separado, señalaron que el momento más
         dramático del sitio —su único fondo oscuro— se veía gris apagado en
         reposo. El de desktop lo describió con precisión: en la misma línea
         conviven palabras en blanco pleno y palabras en gris, y eso lee como
         defecto, no como efecto.

         0.65 = 8.45:1, que cruza AAA (7:1) con margen. Y el gesto se conserva:
         el salto a blanco pleno sigue siendo 2.3× de contraste, suficiente para
         que el ojo perciba el encendido —que es cambio RELATIVO, no absoluto.
         Como el efecto es `scrub`, el usuario controla la opacidad y puede
         quedarse en cualquier punto indefinidamente: el piso tiene que ser
         legible por sí solo, no un estado de paso. */
      gsap.set(split.words, { opacity: 0.65 });

      /* Rango de scroll DISTINTO por viewport (gsap.matchMedia):
         - Desktop: recorrido más largo (la sección es 100svh, hay scroll de sobra).
         - Mobile: recorrido CORTO y que arranca ya entrada la sección, para que
           las letras se enciendan RÁPIDO (no "se demoran") y terminen antes de
           que el usuario pase de largo. */
      const mm = gsap.matchMedia();
      mm.add(
        {
          isDesktop: '(min-width: 768px)',
          isMobile: '(max-width: 767px)',
        },
        (ctx) => {
          const { isMobile } = ctx.conditions as { isMobile: boolean };
          gsap.to(split.words, {
            opacity: 1,
            ease: 'none',
            stagger: 0.5,
            scrollTrigger: {
              trigger: aboutEl,
              /* ARRANQUE: la sección ya bien entrada en pantalla (William
                 2026-08-05, ref. Trionn). Con 'top 90%' las palabras se
                 encendían con la sección apenas asomada y el efecto no se veía. */
              start: isMobile ? 'top 60%' : 'top 50%',
              /* FIN EN EL CENTRO DE LA PANTALLA (William 2026-08-11).
                 Antes: 'bottom 70%' — el recorrido cubría TODA la altura de la
                 sección, así que el encendido seguía activo mucho después de
                 que la frase estuviera a la vista. Consecuencia: en casi
                 cualquier punto del scroll la frase se veía PARTIDA EN DOS
                 COLORES (primeras palabras en blanco, últimas en gris). El
                 visual-critic de desktop lo marcó: "en la misma línea conviven
                 blanco pleno y gris, y eso lee como defecto, no como efecto".

                 'center 50%' = el encendido se COMPLETA cuando el centro de la
                 sección llega al centro del viewport, que es el comportamiento
                 de Trionn que William pidió: cuando el usuario tiene la frase
                 enfrente, ya está toda blanca. El gesto palabra-por-palabra se
                 conserva —es el gesto— pero ocurre durante la ENTRADA, no
                 durante toda la permanencia en pantalla. */
              end: isMobile ? 'center 55%' : 'center 50%',
              scrub: true,
            },
          });
        }
      );

      /* (2) Anotaciones de esquina — fade-up escalonado (one-shot) */
      if (annotationEls.length) {
        gsap.set(annotationEls, { opacity: 0, y: 18 });
        const revealAnnotations = () => {
          gsap.to(annotationEls, {
            opacity: 1,
            y: 0,
            duration: 0.7,
            ease: 'power3.out',
            stagger: 0.12,
          });
        };
        const annST = ScrollTrigger.create({
          trigger: aboutEl,
          start: 'top 45%',
          once: true,
          onEnter: revealAnnotations,
        });

        /* RED DE SEGURIDAD (2026-08-09). Con `once: true`, si la sección ya
           está POR ENCIMA del punto de disparo al cargar —recargar la página a
           media altura, un deep-link a #studio-what, restauración de scroll del
           navegador— el onEnter no se dispara NUNCA y las anotaciones quedan en
           opacity:0 de forma permanente.
           ManifestoSection.astro ya tenía este mismo arreglo; nunca se propagó
           acá. Si el trigger ya está pasado, revelamos igual: sin animación de
           scroll, pero visible. */
        if (annST.progress > 0) {
          revealAnnotations();
          annST.kill();
        }
      }

    } catch (err) {
      /* Fix del catch silencioso: loguear + dejar TODO visible. */
      console.error('[StatementSection About] motion init failed:', err);
      statementEl.style.opacity = '1';
      statementEl.style.filter = 'none';
      annotationEls.forEach((el) => {
        el.style.opacity = '1';
        el.style.transform = 'none';
      });
    }
  }
</script>
