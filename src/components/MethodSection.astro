---
/**
 * MethodSection.astro — V3 "Terracota cálida en alternancia"
 * SCUART — ART_DIRECTION_V3_FINAL.md §5-METHOD + §6-MOMENTO 3
 *
 * CONCEPTO V3:
 * Fondo --barro-elevado (#2E1F15). Numerales gigantes 001–004 Fraunces light.
 * El ritmo oscuro-cálido de method rompe la monotonía hueso antes del contacto.
 *
 * MOMENTO 3 — DESKTOP (≥1280px):
 *   Columna izquierda PINEADA con GSAP ScrollTrigger. Los numerales 001–004
 *   se quedan fijos mientras el contenido de cada paso scrollea a la derecha.
 *   El numeral activo pasa a --ambar; los inactivos son hueso al 15%.
 *   Scrub: true — el pin sigue el scroll sin clicks.
 *
 * MOBILE / TABLET (<1280px):
 *   Sin pin. Timeline vertical: numeral grande arriba de cada paso,
 *   hairline --borde-oscuro entre pasos, reveal GSAP sutil al entrar.
 *
 * prefers-reduced-motion: sin pin, sin reveals — todo estático y visible.
 *
 * CONTRASTE VERIFICADO:
 *   hueso #F0E9DC sobre barro-elevado #2E1F15 → ~11:1 (AAA).
 *   hueso 65% (rgba 240,233,220,0.65) sobre barro-elevado → ~6.5:1 (AA).
 *   ambar #D99A4E sobre barro-elevado → ~7.2:1 (AA). Numeral activo.
 *   terracota #A4471F sobre barro-elevado → ~3.8:1 — NO USAR PARA TEXTO.
 *
 * TOKENS USADOS (todos V3 o neutros):
 *   --barro-elevado, --hueso, --tinta-suave, --ambar, --borde-oscuro,
 *   --font-display, --font-body, --font-mono, --text-mono, --text-body.
 * PROHIBIDOS: --carbon, --crema, --taupe, --rojo, --linea.
 */

import type { Translations, MethodStep } from '../i18n/en';

// Props tipado via Astro.props — la interfaz es consumida por el runtime de Astro
const { t } = Astro.props as { t: Translations };
const kicker: string = t.method.kicker;
const steps: MethodStep[] = t.method.steps;
const capabilitiesLabel: string = t.method.capabilitiesLabel;
const whatChangesLabel: string = t.method.whatChangesLabel;
---

<section
  class="mth"
  id="method"
  aria-label={kicker}
>

  <div class="mth-header">
    <p class="mth-kicker">{kicker}</p>
  </div>

  <!--
    LAYOUT PRINCIPAL — visible en todos los viewports.
    Desktop: columna izquierda pineada (numerales) + columna derecha (pasos).
    Tablet/Mobile: stack vertical (sin pin, sin columnas).
    La estructura HTML es compartida — CSS y JS controlan el comportamiento.
  -->
  <div class="mth-body" data-mth-body>

    <!--
      COLUMNA IZQUIERDA — numerales pineados en desktop.
      En tablet/mobile: cada numeral está dentro del bloque de paso (ver mth-step).
      Esta columna es visible SOLO en desktop (≥1280px).
      aria-hidden: el contenido semántico está en los pasos del lado derecho.
    -->
    <div class="mth-nums" aria-hidden="true" data-mth-nums>
      {steps.map((step, i) => (
        <span
          class="mth-num-item"
          data-num-index={i}
          aria-hidden="true"
        >{step.num}</span>
      ))}
    </div>

    <!--
      COLUMNA DERECHA — los 4 pasos del método.
      Desktop: scrollean mientras los numerales quedan pineados.
      Mobile/Tablet: stack vertical con su propio numeral visible.
    -->
    <div class="mth-steps" data-mth-steps>
      {steps.map((step, i) => (
        <div
          class="mth-step"
          data-step-index={i}
          role="article"
          aria-label={`${step.num} ${step.title}`}
        >
          <!--
            Numeral mobile/tablet — visible solo en <1280px.
            En desktop está oculto (el numeral vive en mth-nums pineado).
            aria-hidden: redundante con aria-label del bloque.
          -->
          <span class="mth-step__num-mobile" aria-hidden="true">{step.num}</span>

          <div class="mth-step__content">
            <h2 class="mth-step__title">{step.title}</h2>

            <p class="mth-step__body">{step.body}</p>

            <hr class="mth-step__rule" aria-hidden="true" />

            <div class="mth-step__caps">
              <p class="mth-step__label">{capabilitiesLabel}</p>
              <ul class="mth-step__caps-list" role="list">
                {step.stepCapabilities.map((cap) => (
                  <li class="mth-step__caps-item">{cap}</li>
                ))}
              </ul>
            </div>

            <hr class="mth-step__rule" aria-hidden="true" />

            <div class="mth-step__change">
              <p class="mth-step__label">{whatChangesLabel}</p>
              <p class="mth-step__change-text">&#x2192; {step.whatChanges}</p>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>

</section>

<style>
/* ═══════════════════════════════════════════════════════════
   METHOD SECTION — V4 "Restringido" (1 color + negro/hueso)
   Fondo: --bg negro. Mobile-first: 375px → 768px → 1280px.
   ═══════════════════════════════════════════════════════════ */

/* ─── SECCIÓN ────────────────────────────────────────────── */

.mth {
  /* Cuerpo OSCURO de punta a punta (V4 §4: el video del hero es el único color) */
  background-color: var(--bg);
  isolation: isolate;
  padding-top: var(--space-xl);
  padding-bottom: var(--space-2xl);
  padding-left: var(--margin);
  padding-right: var(--margin);
  position: relative;
  overflow-x: clip;
  scroll-margin-top: 72px;
}

/* ─── HEADER / KICKER ────────────────────────────────────── */

.mth-header {
  border-top: 1px solid var(--hairline);
  padding-top: var(--space-m);
  margin-bottom: var(--space-l);
}

.mth-kicker {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  color: var(--ink-62);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  line-height: 1.4;
  margin: 0;
}

/* ─── BODY — layout principal ────────────────────────────── */

/*
 * Mobile: columna única (mth-nums oculto, mth-steps a pantalla completa).
 */
.mth-body {
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* ─── COLUMNA NUMERALES — oculta en mobile/tablet ────────── */

.mth-nums {
  display: none; /* visible solo en desktop via media query */
}

.mth-num-item {
  display: block;
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(5rem, 12vw, 11rem);
  line-height: 0.88;
  letter-spacing: -0.04em;
  font-variant-numeric: tabular-nums;
  font-style: normal;
  /* Inactivo: hueso 18% — fantasma sobre negro */
  color: var(--ink-18);
  transition: color 0.4s ease;
}

/* Numeral activo (clase añadida por JS) — acento de texto (tinta sobre blanco, lima sobre negro) */
.mth-num-item.is-active {
  color: var(--accent-text);
}

/* ─── PASOS — stack vertical mobile ─────────────────────── */

.mth-steps {
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* ─── BLOQUE DE PASO ─────────────────────────────────────── */

/*
 * Mobile: padding vertical + hairline entre pasos.
 */
.mth-step {
  padding-top: var(--space-m);
  padding-bottom: var(--space-m);
  border-top: 1px solid var(--hairline);
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.mth-step:last-child {
  border-bottom: 1px solid var(--hairline);
}

/* ─── NUMERAL MOBILE — visible en <1280px ────────────────── */

.mth-step__num-mobile {
  display: block;
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(3rem, 9vw, 6rem);
  line-height: 0.88;
  letter-spacing: -0.04em;
  font-variant-numeric: tabular-nums;
  font-style: normal;
  color: var(--ink-18);  /* hueso 18% — fantasma sobre negro */
  pointer-events: none;
}

/* ─── CONTENIDO DEL PASO ─────────────────────────────────── */

.mth-step__content {
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* ─── TÍTULO — Fraunces 300, hueso ───────────────────────── */

.mth-step__title {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(1.875rem, 6vw, 4rem);
  line-height: 1.0;
  letter-spacing: -0.025em;
  color: var(--ink);
  font-style: normal;
  margin: 0 0 var(--space-s) 0;
  hyphens: none;
}

/* ─── BODY — Geist, hueso 62% ───────────────────────────── */

.mth-step__body {
  font-family: var(--font-body);
  font-size: var(--text-body);
  font-weight: 400;
  color: var(--ink-62);
  line-height: 1.65;
  max-width: 52ch;
  margin: 0 0 var(--space-m) 0;
}

/* ─── REGLA HAIRLINE ─────────────────────────────────────── */

.mth-step__rule {
  border: none;
  border-top: 1px solid var(--hairline);
  margin: var(--space-s) 0;
}

/* ─── LABEL MONO (CAPABILITIES / WHAT CHANGES) ───────────── */

/* Geist 500 uppercase — ficha técnica. Hueso 62%. */
.mth-step__label {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  color: var(--ink-62);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  line-height: 1.4;
  margin: 0 0 var(--space-2xs) 0;
}

/* ─── CAPABILITIES DEL PASO ──────────────────────────────── */

.mth-step__caps {
  margin-bottom: 0;
}

.mth-step__caps-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem var(--space-s);
}

.mth-step__caps-item {
  font-family: var(--font-body);
  font-size: 0.6875rem; /* 11px */
  font-weight: 400;
  color: var(--ink-62);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  line-height: 1.4;
}

/* ─── WHAT CHANGES ───────────────────────────────────────── */

.mth-step__change {
  display: flex;
  flex-direction: column;
  gap: var(--space-2xs);
}

/* Texto de cierre — hueso, ligero protagonismo. */
.mth-step__change-text {
  font-family: var(--font-body);
  font-size: clamp(0.75rem, 0.4vw + 0.68rem, 0.875rem);
  font-weight: 400;
  color: var(--ink);
  letter-spacing: 0.04em;
  line-height: 1.6;
  margin: 0;
}

/* ─── REVEAL MOBILE: estado para GSAP ────────────────────── */

/*
 * GSAP set() aplica opacity:0 y y:14 antes del reveal.
 * Progressive enhancement: sin JS → visible (sin opacity:0 aquí).
 */

/* ═══════════════════════════════════════════════════════════
   TABLET (768px+) — más aire, sin pin
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 768px) {
  .mth {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  .mth-header {
    margin-bottom: var(--space-l);
  }

  .mth-step {
    padding-top: var(--space-l);
    padding-bottom: var(--space-l);
  }

  .mth-step__num-mobile {
    font-size: clamp(4rem, 10vw, 7rem);
  }

  .mth-step__title {
    font-size: clamp(2.25rem, 5vw, 4.5rem);
  }

  .mth-step__body {
    max-width: 56ch;
  }

  .mth-step__caps-list {
    gap: var(--space-xs) var(--space-m);
  }
}

/* ═══════════════════════════════════════════════════════════
   DESKTOP (1280px+) — pin ScrollTrigger
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 1280px) {
  .mth {
    padding-top: var(--space-2xl);
    /* Sin padding-bottom aquí — el ScrollTrigger maneja el espacio */
    padding-bottom: 0;
  }

  /*
   * Grid 2 col: numerales (col 1) + pasos (col 2).
   * 5fr para la col de numerales, 7fr para el contenido.
   * El pin es sobre .mth-nums — GSAP controla la posición.
   */
  .mth-body {
    display: grid;
    grid-template-columns: 5fr 7fr;
    column-gap: var(--space-2xl);
    align-items: start;
  }

  /* Columna numerales: visible en desktop */
  .mth-nums {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    /* JS (GSAP) añade position:sticky y top via ScrollTrigger pin */
    grid-column: 1;
    align-self: start;
    /* Padding-bottom para que el último numeral tenga aire al final del pin */
    padding-bottom: var(--space-2xl);
    padding-top: 0;
  }

  /*
   * Numerales desktop más grandes.
   * Solo uno visible a la vez (los inactivos tienen opacity baja ya en la base).
   * JS controla cuál está activo vía .is-active.
   */
  .mth-num-item {
    font-size: clamp(6rem, 13vw, 11rem);
  }

  /* Numeral mobile: oculto en desktop */
  .mth-step__num-mobile {
    display: none;
  }

  /* Columna pasos */
  .mth-steps {
    grid-column: 2;
    /* Padding-bottom: espacio después del último paso */
    padding-bottom: var(--space-2xl);
  }

  .mth-step {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    /* Separador solo superior */
    border-bottom: none;
    flex-direction: column;
    gap: 0;
  }

  .mth-step:last-child {
    border-bottom: none;
  }

  .mth-step__title {
    font-size: clamp(2.5rem, 4.5vw, 5rem);
    margin-bottom: var(--space-m);
  }

  .mth-step__body {
    max-width: 48ch;
    margin-bottom: var(--space-l);
  }

  .mth-step__caps-list {
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
  }

  .mth-step__change {
    padding-top: var(--space-m);
    gap: var(--space-xs);
  }

  .mth-step__change-text {
    font-size: clamp(0.9rem, 0.4vw + 0.8rem, 1.0625rem);
  }
}

/* ═══════════════════════════════════════════════════════════
   REDUCED-MOTION — todo estático y visible
   ═══════════════════════════════════════════════════════════ */
@media (prefers-reduced-motion: reduce) {
  .mth-num-item {
    transition: none;
  }
  .mth-step {
    /* Asegurar visibilidad aunque GSAP no corra */
    opacity: 1 !important;
    transform: none !important;
  }
}
</style>

<script>
  /**
   * MethodSection — V3 MOMENTO 3
   *
   * DESKTOP (≥1280px):
   *   GSAP ScrollTrigger pin de la columna de numerales.
   *   Cada paso activa su numeral (→ ambar) mientras scrollea.
   *   Mecanismo: un ScrollTrigger por paso que detecta cuándo el paso
   *   entra en la zona central del viewport y marca su numeral como activo.
   *
   * MOBILE / TABLET (<1280px):
   *   GSAP ScrollTrigger reveal: cada paso entra con fade + y sutil.
   *   Progressive enhancement: sin GSAP → pasos visibles estáticos.
   *
   * prefers-reduced-motion: sin nada — todo visible estático.
   */

  const isDesktop = () => window.matchMedia('(min-width: 1280px)').matches;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion) {
    try {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(ScrollTrigger);

      const section = document.querySelector<HTMLElement>('.mth');
      if (!section) throw new Error('mth section not found');

      const numItems = section.querySelectorAll<HTMLElement>('.mth-num-item');
      const steps = section.querySelectorAll<HTMLElement>('.mth-step');

      if (isDesktop()) {
        /* ── DESKTOP: pin de la columna de numerales ── */
        const numsCol = section.querySelector<HTMLElement>('.mth-nums');
        const stepsCol = section.querySelector<HTMLElement>('.mth-steps');

        if (numsCol && stepsCol) {
          /*
           * Pin: la columna de numerales se queda fija mientras
           * la columna de pasos scrollea.
           * endTrigger: el último step. end: "bottom center".
           * pinSpacing: false — el espacio lo maneja el layout CSS.
           */
          ScrollTrigger.create({
            trigger: numsCol,
            start: 'top top+=100px',
            endTrigger: stepsCol,
            end: 'bottom center',
            pin: true,
            pinSpacing: false,
          });

          /* Un ScrollTrigger por paso — activa el numeral correspondiente */
          steps.forEach((step, i) => {
            ScrollTrigger.create({
              trigger: step,
              start: 'top center',
              end: 'bottom center',
              onEnter: () => {
                numItems.forEach((n, ni) => {
                  n.classList.toggle('is-active', ni === i);
                });
              },
              onEnterBack: () => {
                numItems.forEach((n, ni) => {
                  n.classList.toggle('is-active', ni === i);
                });
              },
            });
          });

          /* Activar el primer numeral al cargar */
          if (numItems[0]) numItems[0].classList.add('is-active');

          /* Desktop: el título sube con el bloque del paso (fade simple — spec §A.5).
             NO mask reveal en desktop para no pasar de 2 gestos sobre el pin. */
          steps.forEach((step) => {
            const title = step.querySelector<HTMLElement>('.mth-step__title');
            if (!title) return;
            gsap.set(title, { opacity: 0, y: 12 });
            ScrollTrigger.create({
              trigger: step,
              start: 'top 75%',
              once: true,
              onEnter: () => {
                gsap.to(title, {
                  opacity: 1,
                  y: 0,
                  duration: 0.7,
                  ease: 'expo.out',
                });
              },
            });
          });
        }

      } else {
        /* ── MOBILE / TABLET: reveal sutil por paso + mask reveal del título ── */
        const { SplitText } = await import('gsap/SplitText');
        gsap.registerPlugin(SplitText);

        steps.forEach((step) => {
          gsap.set(step, { opacity: 0, y: 16 });
          ScrollTrigger.create({
            trigger: step,
            start: 'top 88%',
            once: true,
            onEnter: () => {
              gsap.to(step, {
                opacity: 1,
                y: 0,
                duration: 0.7,
                ease: 'expo.out',
              });

              /* Mask reveal del título — solo en mobile/tablet (spec §A.5).
                 En desktop ya hay pin + fade: solo 2 gestos. En mobile el título
                 necesita más presencia porque no hay pin. */
              const title = step.querySelector<HTMLElement>('.mth-step__title');
              if (title) {
                const split = new SplitText(title, {
                  type: 'lines',
                  mask: 'lines',
                  autoSplit: true,
                });
                gsap.from(split.lines, {
                  yPercent: 105,
                  duration: 0.8,
                  ease: 'expo.out',
                  stagger: 0.08,
                  delay: 0.1, /* pequeño delay para que el bloque entre primero */
                });
              }
            },
          });
        });
      }

    } catch (_) {
      /* Si GSAP falla → pasos visibles por CSS (opacity:1 por defecto en base) */
    }
  }
</script>
