---
/**
 * CookieBanner.astro — Banner de consentimiento de cookies.
 * Aparece en la primera visita. Guarda preferencia en localStorage.
 * Sin tracking: solo cookies técnicas necesarias.
 */

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;

/* Copy conversacional, no legalés (tendencia 2026: lenguaje humano, no jurídico).
   Voz SCUART — directa, sin humo. Aceptar/Rechazar con igual peso (equal
   prominence, requisito legal 2026: ninguno puede verse más "correcto"). */
const copy = {
  es: {
    text: 'Solo cookies técnicas, las justas para que el sitio funcione. Nada de rastreo.',
    accept: 'De acuerdo',
    decline: 'Solo las esenciales',
    privacyLabel: 'Privacidad',
    privacyHref: '/es/privacidad',
  },
  en: {
    text: 'Only technical cookies — just enough to make the site work. No tracking.',
    accept: 'Got it',
    decline: 'Essential only',
    privacyLabel: 'Privacy',
    privacyHref: '/en/privacy',
  },
};

const c = copy[lang];
---

<div class="cookie" id="cookie-banner" aria-live="polite" hidden>
  <p class="cookie__text">
    {c.text}
    <a href={c.privacyHref} class="cookie__link">{c.privacyLabel}</a>.
  </p>
  <div class="cookie__actions">
    <button class="cookie__btn cookie__btn--decline" id="cookie-decline">{c.decline}</button>
    <button class="cookie__btn cookie__btn--accept" id="cookie-accept">{c.accept}</button>
  </div>
</div>

<style>
/* Bloque COMPACTO abajo-izquierda — NO una barra full-width estirada (lo más
   genérico) ni una card cuadrada con sombra (2018). Chico, tipográfico, con un
   borde-acento lima a la izquierda que lo ata a la marca. Evidencia 2026: el
   banner debe integrarse al lenguaje del sitio y ser minimalista real, con copy
   conversacional y acciones de igual peso. */
.cookie {
  position: fixed;
  bottom: max(var(--space-m), env(safe-area-inset-bottom));
  /* Anclado a la DERECHA: el wordmark del hero vive abajo-IZQUIERDA — si el
     banner arranca a la izquierda se monta sobre "SCUART" en la primera visita
     (los ~1.2s que tarda en aparecer, el usuario aún mira el hero). La derecha
     del hero está libre, así nunca se pisan en ningún viewport. En mobile el
     max-width no alcanza y ocupa casi todo el ancho igual (left+right definidos). */
  right: var(--space-m);
  left: auto;
  z-index: 1000;
  max-width: 30rem;
  background-color: color-mix(in srgb, var(--ink) 90%, transparent);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  border-left: 2px solid var(--brand);
  color: var(--bg);
  padding: var(--space-s) var(--space-m);
  display: flex;
  flex-direction: column;
  gap: var(--space-s);
}

.cookie[hidden] {
  display: none;
}

/* Mobile: el banner ocupa el ancho abajo (left+right), como antes. En viewport
   chico el hero es más alto y el wordmark escala, así que el banner al pie no
   lo tapa; y a 30rem descolgado a la derecha se vería raro. */
@media (max-width: 520px) {
  .cookie {
    left: var(--space-m);
    right: var(--space-m);
    max-width: none;
  }
}

/* En la sección Contacto el banner se desvanece por completo y deja de recibir
   clics, para no competir con el email (CTA principal). */
.cookie[data-dimmed] {
  opacity: 0;
  pointer-events: none;
  transform: translateY(0.5rem);
}

/* Al scrollear el banner se ATENÚA pero SIGUE CLICKEABLE (2026-07-28): el usuario
   ya vio que existe, pero debe poder aceptar/rechazar en cualquier momento sin
   volver arriba. Se hace discreto (semi-transparente + un pelín más chico), no
   desaparece. Al hover/focus vuelve a opacidad plena. */
.cookie[data-faded]:not([data-dimmed]) {
  opacity: 0.55;
  transform: scale(0.97);
  transform-origin: bottom right;
}
.cookie[data-faded]:not([data-dimmed]):hover,
.cookie[data-faded]:not([data-dimmed]):focus-within {
  opacity: 1;
  transform: scale(1);
}

.cookie {
  transition: opacity 0.4s ease, transform 0.4s ease;
}

@media (prefers-reduced-motion: reduce) {
  .cookie {
    transition: opacity 0.2s ease;
  }
  .cookie[data-dimmed] {
    transform: none;
  }
}

.cookie__text {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  line-height: 1.5;
  color: rgba(244, 242, 236, 0.8);
}

.cookie__link {
  color: var(--bg);
  /* underline explícito: el link no debe distinguirse solo por color (WCAG 1.4.1) */
  text-decoration: underline;
  text-underline-offset: 2px;
}

.cookie__actions {
  display: flex;
  align-items: center;
  gap: var(--space-m);
  justify-content: flex-end;
  flex-shrink: 0;
}

.cookie__btn {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border: none;
  background: none;
  cursor: pointer;
  padding: 0.35em 0;
  transition: opacity 0.2s, color 0.2s;
}

/* IGUAL PESO (equal prominence, requisito legal 2026): ambos botones son texto
   del mismo tamaño/peso — ninguno se ve más "correcto" que el otro. Se
   diferencian solo por un subrayado de acento que aparece al hover. */
.cookie__btn--decline,
.cookie__btn--accept {
  color: var(--bg);
  background-image: linear-gradient(currentColor, currentColor);
  background-repeat: no-repeat;
  background-position: 0 100%;
  background-size: 0% 1px;
  transition: background-size 0.3s ease;
}
.cookie__btn--decline:hover,
.cookie__btn--decline:focus-visible,
.cookie__btn--accept:hover,
.cookie__btn--accept:focus-visible {
  background-size: 100% 1px;
}
/* El acento lima marca cuál es el primario SIN darle más tamaño ni relleno. */
.cookie__btn--accept {
  background-image: linear-gradient(var(--brand), var(--brand));
  background-size: 100% 1px;
}
.cookie__btn--accept:hover,
.cookie__btn--accept:focus-visible {
  background-size: 100% 2px;
}

@media (prefers-reduced-motion: reduce) {
  .cookie__btn {
    transition: none;
  }
}
</style>

<script>
  const COOKIE_KEY = 'scuart_cookies_consent';
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('cookie-accept');
  const declineBtn = document.getElementById('cookie-decline');

  if (banner && !localStorage.getItem(COOKIE_KEY)) {
    /* Mostrar con micro-delay para no bloquear el LCP */
    setTimeout(() => {
      banner.removeAttribute('hidden');
    }, 1200);

    /* ATENUAR POR SCROLL (universal, 2026-07-28): el banner es position:fixed y
       flotaba tapando contenido. Antes se atenuaba solo al llegar a #contact —
       pero las páginas de caso NO tienen #contact, así que ahí nunca se atenuaba
       y tapaba el hero (bug reportado por William). Solución robusta: se atenúa
       en cuanto el usuario scrollea más allá de la primera pantalla — funciona
       igual en TODAS las páginas (home, casos, legales). No persiste la decisión:
       solo se hace discreto, no cuenta como "aceptar".
       iOS: el scroll puede vivir en document.body, no en window (ver CLAUDE.md
       body-scroll-container) → leo el mayor de los dos. */
    const readScrollY = () =>
      Math.max(window.scrollY || 0, document.body.scrollTop || 0, document.documentElement.scrollTop || 0);

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        if (!localStorage.getItem(COOKIE_KEY)) {
          // umbral: media pantalla — pasado eso el usuario ya vio el banner. Se
          // ATENÚA (data-faded, sigue clickeable), no se esconde.
          if (readScrollY() > window.innerHeight * 0.5) banner.setAttribute('data-faded', '');
          else banner.removeAttribute('data-faded');
        }
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    document.body.addEventListener('scroll', onScroll, { passive: true });

    /* Extra en el home: al llegar a Contacto (el CTA principal) el banner se
       mantiene atenuado aunque el usuario suba — no debe competir con la conversión. */
    const contact = document.querySelector('#contact, .contact');
    if (contact && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (localStorage.getItem(COOKIE_KEY)) return;
          if (entry.isIntersecting) banner.setAttribute('data-dimmed', '');
        },
        { threshold: 0.15 },
      );
      io.observe(contact);
    }
  }

  const dismiss = (value: string) => {
    localStorage.setItem(COOKIE_KEY, value);
    banner?.setAttribute('hidden', '');
  };
  acceptBtn?.addEventListener('click', () => dismiss('accepted'));
  declineBtn?.addEventListener('click', () => dismiss('essential'));
</script>
