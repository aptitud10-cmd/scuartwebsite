---
/**
 * CookieBanner.astro — Banner de consentimiento de cookies.
 * Aparece en la primera visita. Guarda preferencia en localStorage.
 * Sin tracking: solo cookies técnicas necesarias.
 */

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;

/* Copy conversacional, no legalés (tendencia 2026: lenguaje humano, no jurídico).
   Voz SCUART — directa, sin humo. Aceptar/Rechazar con igual peso (equal
   prominence, requisito legal 2026: ninguno puede verse más "correcto"). */
const copy = {
  es: {
    text: 'Solo cookies técnicas, las justas para que el sitio funcione. Nada de rastreo.',
    accept: 'De acuerdo',
    decline: 'Solo las esenciales',
    privacyLabel: 'Privacidad',
    privacyHref: '/es/privacidad',
  },
  en: {
    text: 'Only technical cookies — just enough to make the site work. No tracking.',
    accept: 'Got it',
    decline: 'Essential only',
    privacyLabel: 'Privacy',
    privacyHref: '/en/privacy',
  },
};

const c = copy[lang];
---

<div class="cookie" id="cookie-banner" aria-live="polite" hidden>
  <p class="cookie__text">
    {c.text}
    <a href={c.privacyHref} class="cookie__link">{c.privacyLabel}</a>.
  </p>
  <div class="cookie__actions">
    <button class="cookie__btn cookie__btn--decline" id="cookie-decline">{c.decline}</button>
    <button class="cookie__btn cookie__btn--accept" id="cookie-accept">{c.accept}</button>
  </div>
</div>

<style>
/* BARRA AL PIE, DELGADA (William 2026-08-04) — reemplaza el bloque flotante
   abajo-derecha. El bloque anterior se ancló a la derecha "porque el wordmark
   del hero vive abajo-izquierda"; ese hero (réplica Locomotive) ya no se
   renderiza. El hero actual es tipográfico y su titular ocupa TODO el ancho:
   la derecha dejó de estar libre y el banner se montaba sobre "VENDER MÁS.".
   Solución: franja de ancho completo pegada al borde inferior, baja, con texto
   y acciones en UNA fila. No flota sobre la composición — se lee como pie del
   sitio (patrón Stripe/Linear/Vercel). El acento lima pasa de borde-izquierdo a
   borde-superior, que es el canto visible de una barra. */
.cookie {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  /* CLARA, no negra (William 2026-08-04): el bloque oscuro pesaba sobre el
     crema del sitio y se leía como cartel pegado. Ahora es el MISMO fondo del
     cuerpo con blur — la barra pertenece a la página en vez de aterrizar sobre
     ella. La jerarquía la da un hairline de tinta arriba (no un filo lima de
     2px, que gritaba); el lima queda reservado al botón primario. */
  /* OPACO, no translúcido: con 88% + blur el párrafo del hero se leía A TRAVÉS
     de la barra y chocaba con el copy de cookies (verificado 2026-08-04). El
     blur no alcanza contra texto de alto contraste. --surface es el crema un
     paso más profundo que --bg: separa la barra del cuerpo sin ser otro color. */
  background-color: var(--surface, #ece9e1);
  border-top: 1px solid var(--ink-18);
  color: var(--ink);
  /* safe-area en el padding, NO en bottom: la barra debe tocar el borde real de
     la pantalla; el inset solo empuja el CONTENIDO hacia arriba (iOS home bar). */
  padding: 0.9rem var(--space-m);
  padding-bottom: max(0.9rem, calc(env(safe-area-inset-bottom) + 0.4rem));
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-l, 2rem);
}

.cookie[hidden] {
  display: none;
}

/* Mobile: la fila única no entra (texto + 2 botones en 375px queda apretado).
   Vuelve a dos filas DENTRO de la barra full-width: texto arriba, acciones
   abajo-derecha. Sigue siendo una franja al pie, no un bloque flotante.
   Breakpoint unificado a 767px (antes 620px) — ver tokens.css §escala mobile. */
@media (max-width: 767px) {
  .cookie {
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    padding: 0.7rem var(--space-s);
    padding-bottom: max(0.7rem, calc(env(safe-area-inset-bottom) + 0.35rem));
  }
  .cookie__text {
    font-size: var(--text-mono);
    line-height: 1.4;
  }
  .cookie__actions {
    gap: var(--space-s);
  }
  .cookie__btn {
    font-size: var(--text-mono);
    /* En la barra compacta el target de 48px estira demasiado la franja.
       44px sigue cumpliendo WCAG 2.5.8 (target mínimo 24px) y AAA táctil. */
    min-height: 44px;
  }
}

/* En Contacto el banner NO debe competir con el CTA principal, pero tampoco
   puede volverse inalcanzable: bajo GDPR el usuario que aún no eligió tiene que
   poder aceptar o rechazar en cualquier momento (2026-08-04). Antes esto era
   opacity:0 + pointer-events:none → el control desaparecía de verdad. Ahora se
   atenúa fuerte y SIGUE clickeable; al hover/focus vuelve a opacidad plena. */
/* Igual que data-faded: la atenuación necesita hover para revertirse, y en
   touch no hay hover. En mobile el banner queda opaco (2026-08-05). */
@media (hover: hover) and (pointer: fine) {
  .cookie[data-dimmed] {
    opacity: 0.25;
  }
  .cookie[data-dimmed]:hover,
  .cookie[data-dimmed]:focus-within {
    opacity: 1;
  }
}

/* Al scrollear el banner se ATENÚA pero SIGUE CLICKEABLE (2026-07-28): el usuario
   ya vio que existe, pero debe poder aceptar/rechazar en cualquier momento sin
   volver arriba. En barra full-width el scale(0.97) anterior se leía como glitch
   (la franja se despegaba de los bordes) → atenuación SOLO por opacidad. */
/* La atenuación por scroll es SOLO para punteros con hover (desktop): ahí el
   usuario puede devolverle opacidad plena pasando el mouse. En touch no hay
   hover, así que el banner quedaba a 0.6 PARA SIEMPRE — el contenido de atrás
   se filtraba y se leía como "se ve pero no se ve" (William, iPhone
   2026-08-05). En mobile se mantiene opaco y legible. */
@media (hover: hover) and (pointer: fine) {
  .cookie[data-faded]:not([data-dimmed]) {
    opacity: 0.6;
  }
}
.cookie[data-faded]:not([data-dimmed]):hover,
.cookie[data-faded]:not([data-dimmed]):focus-within {
  opacity: 1;
}

.cookie {
  transition: opacity 0.4s ease;
}

@media (prefers-reduced-motion: reduce) {
  .cookie {
    transition: opacity 0.2s ease;
  }
}

.cookie__text {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  line-height: 1.5;
  color: var(--ink-mid);
  /* La barra es discreta pero el texto no debe volverse ilegible al estirarse
     en desktop: limitamos la medida y dejamos que las acciones tomen su ancho. */
  max-width: 52ch;
}

.cookie__link {
  color: var(--ink);
  /* underline explícito: el link no debe distinguirse solo por color (WCAG 1.4.1) */
  text-decoration: underline;
  text-underline-offset: 2px;
  text-decoration-thickness: 1px;
  /* ÁREA TÁCTIL (auditoría 2026-08-10). Medido en 375px: 54×12px — el
     objetivo más chico del sitio, y es el primero que ve un visitante nuevo.
     Es un link INLINE dentro de un <p>: un min-height lo convertiría en caja
     y rompería el flujo del párrafo. El pseudo-elemento extiende el área
     táctil a 44px de alto sin alterar la maquetación ni el subrayado —
     mismo patrón que ya usan los links del nav. */
  position: relative;
}

.cookie__link::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  /* centra 44px sobre la caja real del texto (~12px) */
  top: 50%;
  height: 44px;
  transform: translateY(-50%);
}

.cookie__actions {
  display: flex;
  align-items: center;
  gap: var(--space-m);
  justify-content: flex-end;
  flex-shrink: 0;
}

.cookie__btn {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border: none;
  background: none;
  cursor: pointer;
  /* Touch target ≥48px (directiva mobile): el área clickeable era ~18px de alto
     (padding 0.35em 0). Se sube a min-height 48 + padding lateral, SIN cambiar
     el font-size (para no romper el equal-prominence legal Aceptar/Rechazar).
     El underline de acento se mantiene al fondo del área (background-position). */
  min-height: 48px;
  padding: 0 0.5em;
  display: inline-flex;
  align-items: center;
  transition: opacity 0.2s, color 0.2s;
}

/* IGUAL PESO (equal prominence, requisito legal 2026): ambos botones son texto
   del mismo tamaño/peso — ninguno se ve más "correcto" que el otro. Se
   diferencian solo por un subrayado de acento que aparece al hover. */
.cookie__btn--decline,
.cookie__btn--accept {
  color: var(--ink);
  background-image: linear-gradient(currentColor, currentColor);
  background-repeat: no-repeat;
  background-position: 0 calc(100% - 12px);
  background-size: 0% 1px;
  transition: background-size 0.3s ease;
}
.cookie__btn--decline:hover,
.cookie__btn--decline:focus-visible,
.cookie__btn--accept:hover,
.cookie__btn--accept:focus-visible {
  background-size: 100% 1px;
}
/* El acento lima marca cuál es el primario SIN darle más tamaño ni relleno.
   Sobre fondo CLARO el lima puro no contrasta como texto (falla WCAG), así que
   se usa solo como SUBRAYADO: el texto queda en tinta y el lima lo señala. */
.cookie__btn--accept {
  background-image: linear-gradient(var(--brand), var(--brand));
  background-size: 100% 2px;
}
.cookie__btn--accept:hover,
.cookie__btn--accept:focus-visible {
  background-size: 100% 3px;
}

/* Foco visible sobre fondo claro: el lima es invisible acá (1.16:1) — se usa
   tinta, igual que el resto del sitio. */
.cookie__btn:focus-visible {
  outline: 2px solid var(--ink);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  .cookie__btn {
    transition: none;
  }
}
</style>

<script>
  const COOKIE_KEY = 'scuart_cookies_consent';
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('cookie-accept');
  const declineBtn = document.getElementById('cookie-decline');

  if (banner && !localStorage.getItem(COOKIE_KEY)) {
    /* Mostrar con micro-delay para no bloquear el LCP */
    setTimeout(() => {
      banner.removeAttribute('hidden');
    }, 1200);

    /* ATENUAR POR SCROLL (universal, 2026-07-28): el banner es position:fixed y
       flotaba tapando contenido. Antes se atenuaba solo al llegar a #contact —
       pero las páginas de caso NO tienen #contact, así que ahí nunca se atenuaba
       y tapaba el hero (bug reportado por William). Solución robusta: se atenúa
       en cuanto el usuario scrollea más allá de la primera pantalla — funciona
       igual en TODAS las páginas (home, casos, legales). No persiste la decisión:
       solo se hace discreto, no cuenta como "aceptar".
       iOS: el scroll puede vivir en document.body, no en window (ver CLAUDE.md
       body-scroll-container) → leo el mayor de los dos. */
    const readScrollY = () =>
      Math.max(window.scrollY || 0, document.body.scrollTop || 0, document.documentElement.scrollTop || 0);

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        if (!localStorage.getItem(COOKIE_KEY)) {
          // umbral: media pantalla — pasado eso el usuario ya vio el banner. Se
          // ATENÚA (data-faded, sigue clickeable), no se esconde.
          if (readScrollY() > window.innerHeight * 0.5) banner.setAttribute('data-faded', '');
          else banner.removeAttribute('data-faded');
        }
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    document.body.addEventListener('scroll', onScroll, { passive: true });

    /* Extra en el home: al llegar a Contacto (el CTA principal) el banner se
       mantiene atenuado aunque el usuario suba — no debe competir con la conversión. */
    const contact = document.querySelector('#contact, .contact');
    if (contact && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (localStorage.getItem(COOKIE_KEY)) return;
          if (entry.isIntersecting) banner.setAttribute('data-dimmed', '');
        },
        { threshold: 0.15 },
      );
      io.observe(contact);
    }
  }

  /* La barra es position:fixed y por lo tanto NO ocupa espacio en el flujo: el
     hero (100vh) la ignoraba y su banda inferior — CTA + capacidades — quedaba
     DEBAJO del banner (verificado 2026-08-04). Publicamos la altura real de la
     barra como --cookiebar-h en :root; el hero la resta de su alto para que su
     contenido nunca caiga tapado. Al aceptar/rechazar vuelve a 0px. */
  const publishHeight = () => {
    const h = banner && !banner.hasAttribute('hidden') ? banner.offsetHeight : 0;
    document.documentElement.style.setProperty('--cookiebar-h', `${h}px`);
  };

  if (banner) {
    /* se recalcula al aparecer, al cambiar de tamaño y al reflowear el texto */
    if ('ResizeObserver' in window) {
      new ResizeObserver(publishHeight).observe(banner);
    }
    window.addEventListener('resize', publishHeight, { passive: true });
  }

  const dismiss = (value: string) => {
    localStorage.setItem(COOKIE_KEY, value);
    banner?.setAttribute('hidden', '');
    publishHeight();
  };
  acceptBtn?.addEventListener('click', () => dismiss('accepted'));
  declineBtn?.addEventListener('click', () => dismiss('essential'));
</script>
