---
/**
 * HeroSection.astro — Hero V3 "Locomotive" — VIDEO FULL-BLEED
 *
 * PATRÓN (referencia: locomotive.ca, traída por William 2026-06-16):
 *   Un video ocupa TODA la pantalla (full-bleed, 100svh).
 *   El texto va ENCIMA del video, no al lado:
 *     - Nav minimal arriba: wordmark + links + "Let's talk" (CTA).
 *     - Wordmark grande abajo-izquierda: nombre del estudio en Fraunces, naranja.
 *   Cero grid de 12 columnas, cero ficha técnica, cero coordenadas, cero numeral.
 *   Es una sola imagen viva con tipografía sobreimpresa.
 *
 * COLOR — copia el esquema Locomotive (decisión de William):
 *   Cyan/celeste sobre el video para TODO el texto (nav + wordmark), igual que
 *   Locomotive usa un solo color de acento. Token AISLADO aquí (--hero-accent),
 *   NO toca la paleta global (yeso + verde botella del resto del sitio).
 *   ⚠️ El cuerpo del sitio sigue en su paleta — el hero es la "portada" cyan.
 *
 * VIDEO — placeholder hasta que William lo cree/consiga:
 *   <video> apunta a /video/hero.mp4 (+ .webm opcional). MIENTRAS no exista,
 *   se ve la capa .hero-fallback (base cyan/roja animada) por debajo del <video>
 *   transparente, así el hero se ve completo HOY. Cuando William ponga el archivo
 *   en /public/video/hero.mp4, arranca solo — CERO cambios de código.
 *   autoplay muted loop playsinline = autoplay permitido en todos los browsers.
 *
 * --font-display: "Fraunces Variable", serif
 *   SWAP A PP EDITORIAL NEW: cambiar SOLO el token en tokens.css.
 *
 * MOTION — GSAP:
 *   - Video/poster: scale 1.06 → 1, opacity in, 1.6s expo.out (entra como telón).
 *   - Nav: fade + y, 0.6s.
 *   - Wordmark: line-reveal por líneas con máscara (yPercent 110→0), stagger.
 *   prefers-reduced-motion: todo estático visible, sin scale.
 *
 * .hero-v3 — clase conservada: el IntersectionObserver de Nav.astro la usa.
 */

import type { Translations } from '../i18n/en';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const lang = t.nav.langHref === '/es' ? 'en' : 'es';

/*
 * Wordmark abajo-izquierda — dos líneas, serif display.
 * Descriptor propio (2026-07-22): antes era réplica literal de Locomotive
 * ("Digital-first Design Agency") — texto de otra marca y encima "Agency",
 * cuando SCUART se define como ESTUDIO en todo el resto del sitio.
 * Ahora: estudio de diseño y tecnología, bilingüe. Localizado ES/EN.
 */
const wordmarkName = 'SCUART';
/* Descriptor del hero — enriquecido con keyword "web" (SEO 2026-07-28) sin
   ensuciar el minimalismo: sigue corto, ahora nombra lo que el sitio hace. */
const wordmarkDescriptor =
  lang === 'es'
    ? 'Estudio de diseño y desarrollo web'
    : 'Web design & development studio';

/* CTA superior derecha — "Let's talk" / "Hablemos" */
const letsTalk = lang === 'es' ? 'Hablemos' : "Let's talk";
---

<section class="hero-v3" aria-label={t.hero.ariaLabel}>

  <!-- ────────────────────────────────────────────────────────────────
       VIDEO FULL-BLEED — el fondo es la composición
       ──────────────────────────────────────────────────────────────── -->
  <div class="hero-media" aria-hidden="true">
    <!--
      FONDO PROVISIONAL — rojo Locomotive animado (decisión William 2026-06-16):
      mientras no exista el video real (Runway → montaje en Premiere), esta capa
      .hero-fallback muestra un rojo saturado con un brillo que se mueve lento.
      El mix-blend-mode de nav/wordmark hace que el texto reaccione (sobre rojo → cyan),
      así se ve la estética final HOY sin video.

      SWAP A VIDEO REAL: poné el archivo en /public/video/hero.mp4
      (opcional /public/video/hero.webm para mejor compresión) y arranca solo.
      El <video> se monta ENCIMA del fallback (z-index) y lo tapa al cargar.
      Si el video no existe, el <video> queda transparente y se ve el rojo.
    -->
    <div class="hero-fallback"></div>
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    >
      <source src="/video/hero.webm" type="video/webm" />
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- ────────────────────────────────────────────────────────────────
       NAV MINIMAL — sobre el video, arriba
       ──────────────────────────────────────────────────────────────── -->
  <header class="hero-nav" role="navigation" aria-label="Navegación principal">
    <a href={`/${lang}`} class="hero-nav__brand" aria-label="SCUART — Inicio">
      SCUART<sup class="hero-nav__reg" aria-hidden="true">®</sup>
    </a>

    <!--
      Links centrales — patrón Locomotive: una sola tira separada por comas
      ("Work, Agency, Careers, Store"). Las comas son pseudo-elementos ::after
      (CSS) con su propio margin — no dependen del whitespace del HTML, que
      el flex colapsa. En blanco (no acento), como la referencia.
    -->
    <nav class="hero-nav__center" aria-label="Secciones">
      <a href={`/${lang}#portfolio`} class="hero-nav__link" data-comma>{t.nav.portfolio}</a>
      <a href={`/${lang}#services`} class="hero-nav__link" data-comma>{t.nav.method}</a>
      <a href={`/${lang}#contact`} class="hero-nav__link">{t.nav.contact}</a>
    </nav>

    <div class="hero-nav__right">
      <!-- Switch de idioma movido al footer (decisión William 2026-06-16):
           hero más limpio; el usuario cambia idioma desde el pie de página. -->
      <a href={`/${lang}#contact`} class="hero-nav__cta">{letsTalk}</a>
    </div>
  </header>

  <!-- ────────────────────────────────────────────────────────────────
       WORDMARK — abajo-izquierda, grande, sobre el video.
       Patrón Locomotive: recuadro de disciplinas + nombre + descriptor + asterisco.
       El recuadro (DIS/DEV/AI) es el equivalente SCUART del OPS/DES/DEV de ellos.
       ──────────────────────────────────────────────────────────────── -->
  <div class="hero-wordmark">
    <h1 class="hero-wordmark__name">
      <!--
        Recuadro de disciplinas — SVG, geometría de Locomotive (OPS | DES/DEV):
        · marco exterior apaisado
        · VERTICAL completa al ~55% → separa DIS (izquierda, centrada en toda la altura)
          de la zona derecha
        · HORIZONTAL solo en la mitad DERECHA (de la vertical al borde) → separa DEV/AI
        DIS NO es cruzado por ninguna línea (queda en su celda alta intacto).
        viewBox apaisado 200×76, stroke grueso (4 ≈ líneas de Locomotive).
      -->
      <svg class="hero-disc" viewBox="0 0 200 76" role="img"
           aria-label="Disciplinas: Diseño, Desarrollo, AI" preserveAspectRatio="xMidYMid meet">
        <!-- marco exterior -->
        <rect x="2" y="2" width="196" height="72" fill="none" stroke="#fff" stroke-width="4"/>
        <!-- HORQUILLA ⊣ como Locomotive: vertical larga + brazo horizontal a la DERECHA -->
        <!-- VERTICAL LARGA: de arriba a abajo. Separa DIS de DEV/AI -->
        <line x1="100" y1="8" x2="100" y2="68" stroke="#fff" stroke-width="4"/>
        <!-- BRAZO HORIZONTAL: a la DERECHA, largo, casi hasta el borde (separa DEV de AI). -->
        <line x1="100" y1="38" x2="192" y2="38" stroke="#fff" stroke-width="4"/>
        <!-- textos: DIS centrado en la mitad izquierda, DEV/AI a la derecha de la vertical -->
        <text x="50"  y="39" fill="#fff" text-anchor="middle" dominant-baseline="central" class="hero-disc__txt">DIS</text>
        <text x="150" y="22" fill="#fff" text-anchor="middle" dominant-baseline="central" class="hero-disc__txt">DEV</text>
        <text x="150" y="56" fill="#fff" text-anchor="middle" dominant-baseline="central" class="hero-disc__txt">AI</text>
      </svg>
      <span class="hero-wordmark__word" data-reveal>{wordmarkName}<sup class="hero-wordmark__reg" aria-hidden="true">®</sup></span>
    </h1>
    <p class="hero-wordmark__descriptor" data-reveal>
      {wordmarkDescriptor}<!-- Asterisco AUTÉNTICO de PP Editorial New (carácter de la fuente) -->
      <span class="hero-wordmark__star" aria-hidden="true">*</span>
    </p>
  </div>

  <!-- Scroll cue — esquina inferior derecha -->
  <span class="hero-scroll-cue" aria-hidden="true">↓</span>

</section>

<style>
/* ═══════════════════════════════════════════════════════════════════
   HERO "LOCOMOTIVE" — RÉPLICA EXACTA del sistema tipográfico de locomotive.ca
   Valores extraídos del sitio real (computed styles @1440px, 2026-06-16):
     - Nav:      HelveticaNowDisplay 26px / 400 / sin tracking / Title Case
                 → acá: Geist Sans (sans neutra equivalente).
     - Wordmark: LocomotiveNew (serif custom) 70px / 400 / line-height 1.1
                 → acá: Fraunces (tu serif licenciada).
     - left: 40px exacto (brand y wordmark). Wordmark pegado al fondo.
     - COLOR: el texto es BLANCO. NO tiene color propio: el efecto de color que
       cambia según el video lo da `mix-blend-mode: difference` en el contenedor
       (.hero-nav y .hero-wordmark). Sobre claro → oscuro; sobre rojo → cyan; etc.
       Esto es EXACTAMENTE lo que hace Locomotive (clases .c-header y
       .c-home-hero_content tienen mix-blend-mode: difference).
   Mobile-first: 375px base → md:768px → lg:1280px.
   ═══════════════════════════════════════════════════════════════════ */

.hero-v3 {
  /* left exacto de Locomotive = 40px. Lo usamos como margen del hero. */
  --hero-edge: 40px;

  position: relative;
  min-height: 100svh;
  height: 100svh;
  overflow: hidden;
  background-color: #0b0b0a;      /* base oscura mientras carga el video/poster */
  isolation: isolate;             /* CRÍTICO: aísla el mix-blend al hero, no a toda la página */
  display: flex;
  flex-direction: column;
}

/* ── Video full-bleed ─────────────────────────────────────────────── */
.hero-media {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
}

.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
  will-change: transform, opacity;
  z-index: 1;                      /* ENCIMA del fallback: al cargar el video real, lo tapa */
  /* Oculto hasta que HAYA video real cargado (clase .is-ready la pone el JS en loadeddata).
     Así un /video/hero.mp4 inexistente NO muestra un recuadro roto/negro: manda el rojo. */
  opacity: 0;
}

.hero-video.is-ready {
  opacity: 1;
}

/* ── Fondo provisional rojo Locomotive (sin video) ──────────────────
 * Rojo saturado con un brillo radial que respira y se desplaza lento.
 * Queda DEBAJO del <video> (z-index 0). Cuando el video real cargue,
 * el <video> opaco lo tapa. Si no hay video, esto es lo que se ve.
 * El mix-blend-mode de nav/wordmark convierte el blanco en cyan sobre este rojo.
 */
.hero-fallback {
  position: absolute;
  inset: -20%;                     /* más grande que el viewport: el brillo puede salir y entrar */
  z-index: 0;
  background-color: #d61f16;       /* rojo bombero Locomotive (base) */
  background-image:
    radial-gradient(60% 55% at 35% 35%, #ff5a3c 0%, rgba(255,90,60,0) 60%),
    radial-gradient(70% 60% at 70% 70%, #ff3a24 0%, rgba(214,31,22,0) 65%),
    linear-gradient(130deg, #b3140d 0%, #e7251c 50%, #b3140d 100%);
  will-change: transform;
  /* Estado base = primer frame de hero-drift: sin esto, en CPU lenta el
     elemento pinta sin transform y salta al arrancar la animación (CLS
     0.63 en tablet, QA 2026-07-21). */
  transform: scale(1.1) translate3d(-6%, -4%, 0);
  /* dos animaciones: el bloque entero deriva, y los brillos pulsan */
  animation:
    hero-drift 9s ease-in-out infinite alternate,
    hero-pulse 5s ease-in-out infinite alternate;
}

/* Deriva del bloque — desplazamiento amplio y visible (el "brillo" cruza la pantalla) */
@keyframes hero-drift {
  0%   { transform: scale(1.1) translate3d(-6%, -4%, 0); }
  100% { transform: scale(1.18) translate3d(6%, 4%, 0); }
}

/* Pulso de saturación/brillo — la luz "respira" notoriamente */
@keyframes hero-pulse {
  0%   { filter: saturate(0.95) brightness(0.92); }
  100% { filter: saturate(1.25) brightness(1.12); }
}

@media (prefers-reduced-motion: reduce) {
  .hero-fallback { animation: none; transform: scale(1.1); }
}

/* Sin scrim: mix-blend-mode: difference ya garantiza contraste contra cualquier fondo. */

/* ════════════════════════════════════════════════════════════════════
   NAV — réplica Locomotive: 26px, blanco, mix-blend difference
   ════════════════════════════════════════════════════════════════════ */
.hero-nav {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding:
    max(var(--hero-edge), env(safe-area-inset-top))
    max(var(--hero-edge), env(safe-area-inset-right))
    0
    max(var(--hero-edge), env(safe-area-inset-left));
  /* EL EFECTO: el texto blanco se invierte según el video que tiene detrás */
  mix-blend-mode: difference;
  color: #fff;
  opacity: 0; /* GSAP revela */
}

/* Todo el texto del nav es BLANCO — el color lo crea el blend, no el texto. */
.hero-nav__brand {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: 1.625rem;          /* 26px exacto */
  letter-spacing: -0.01em;
  color: #fff;
  text-decoration: none;
  line-height: 1.2;
  display: inline-flex;
  align-items: baseline;
  gap: 0.06em;
  flex-shrink: 0;
}

.hero-nav__reg {
  font-size: 0.5em;
  color: #fff;
  vertical-align: super;
}

/*
 * Links centrales — "Work, Services, Contact": una tira, Title Case, blanco, 26px.
 * Posición a la DERECHA-centro (como Locomotive: el bloque de links vive cerca
 * del CTA, no pegado al brand). margin-left:auto los empuja a la derecha;
 * el gap con .hero-nav__right los separa del "Let's talk".
 * Ocultos en mobile.
 */
.hero-nav__center {
  display: none;
  align-items: baseline;
  margin-left: auto;            /* empuja el bloque de links a la derecha */
  margin-right: clamp(2rem, 6vw, 5rem);  /* separación del CTA "Let's talk" */
}

.hero-nav__link {
  font-family: var(--font-body);
  font-size: 1.625rem;          /* 26px exacto */
  font-weight: 400;
  color: #fff;
  text-decoration: none;
  /* Los labels YA vienen en Title Case desde i18n — sin transform */
  letter-spacing: 0;
  line-height: 1.2;
  position: relative;
  background-image: linear-gradient(#fff, #fff);
  background-repeat: no-repeat;
  background-position: 0 100%;
  background-size: 0% 1px;
  transition: background-size 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  padding-bottom: 2px;
}

/* Coma + espacio entre links (no en el último) */
.hero-nav__link[data-comma]::after {
  content: ',\00a0';
  color: #fff;
}

.hero-nav__link:hover {
  background-size: 100% 1px;
}

.hero-nav__link:focus-visible {
  outline: 2px solid #fff;
  outline-offset: 3px;
}

.hero-nav__right {
  display: flex;
  align-items: baseline;
  gap: 1.5rem;
  flex-shrink: 0;
}

.hero-nav__lang {
  display: flex;
  align-items: baseline;
  gap: 0.3em;
  font-family: var(--font-body);
  font-size: 1.625rem;          /* 26px exacto */
  font-weight: 400;
  text-transform: uppercase;     /* "EN"/"ES" códigos de idioma */
  letter-spacing: 0;
  line-height: 1.2;
}

.hero-nav__lang-active {
  color: #fff;
}

.hero-nav__lang-sep {
  color: #fff;
  opacity: 0.5;
}

.hero-nav__lang-other {
  color: #fff;
  opacity: 0.55;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.hero-nav__lang-other:hover {
  opacity: 1;
}

.hero-nav__lang-other:focus-visible {
  outline: 2px solid #fff;
  outline-offset: 3px;
}

/* CTA "Let's talk" — blanco, Title Case, 26px, igual que los links */
.hero-nav__cta {
  font-family: var(--font-body);
  font-size: 1.625rem;          /* 26px exacto */
  font-weight: 400;
  color: #fff;
  text-decoration: none;
  text-transform: none;
  letter-spacing: 0;
  line-height: 1.2;
  position: relative;
  background-image: linear-gradient(#fff, #fff);
  background-repeat: no-repeat;
  background-position: 0 100%;
  background-size: 0% 1px;
  transition: background-size 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  padding-bottom: 2px;
}

.hero-nav__cta:hover {
  background-size: 100% 1px;
}

.hero-nav__cta:focus-visible {
  outline: 2px solid #fff;
  outline-offset: 3px;
}

/* ════════════════════════════════════════════════════════════════════
   WORDMARK — abajo-izquierda. Réplica Locomotive: serif 70px, blanco, blend.
   ════════════════════════════════════════════════════════════════════ */
.hero-wordmark {
  position: relative;
  z-index: 3;
  margin-top: auto; /* pegado al fondo */
  padding:
    0
    var(--hero-edge)
    max(var(--hero-edge), calc(env(safe-area-inset-bottom) + 1.5rem))
    max(var(--hero-edge), env(safe-area-inset-left));
  /* MISMO efecto que el nav: el wordmark blanco reacciona al video */
  mix-blend-mode: difference;
  color: #fff;
}

/*
 * Wordmark — DOS líneas de la MISMA serif, MISMO tamaño (70px @desktop),
 * peso 400, line-height 1.1. Blanco (el blend le da el color).
 * Es UN bloque tipográfico sólido, como "Locomotive® / Digital-first Design Agency".
 */
.hero-wordmark__name,
.hero-wordmark__descriptor {
  font-family: var(--font-display);
  font-weight: 400;
  font-style: normal;
  font-size: clamp(2.5rem, 11vw, 4.375rem);   /* 70px @desktop */
  line-height: 1.1;
  letter-spacing: -0.005em;
  color: #fff;
  margin: 0;
}

.hero-wordmark__name {
  display: flex;
  align-items: flex-start;      /* recuadro alineado al TOPE (como Locomotive) */
  gap: 0.3em;
}

.hero-wordmark__word {
  display: inline-flex;
  align-items: flex-start;
  gap: 0.04em;
}

.hero-wordmark__reg {
  font-size: 0.32em;
  font-weight: 400;
  color: #fff;
  vertical-align: super;
  margin-top: 0.3em;
}

/* ── Recuadro de disciplinas DIS/DEV/AI ──────────────────────────────
 * RÉPLICA EXACTA del OPS/DES/DEV de Locomotive. Medidas reales extraídas
 * del DevTools de locomotive.ca (wordmark 70px): recuadro 176.92 × 88.48 px.
 *   → altura  = 88.48/70  = 1.264em (relativo al font-size del wordmark)
 *   → ancho   = 176.92/70 = 2.527em
 *   → ratio apaisado ~2:1. Celda izquierda alta (DIS) + columna derecha (DEV/AI).
 * El recuadro se mide en `em` del wordmark, NO en su propio font-size,
 * para que escale 1:1 con la palabra en todos los breakpoints.
 */
.hero-disc {
  /* Locomotive: recuadro y palabra arrancan en el MISMO margen (sin sobresalir).
     El recuadro alinea su tope y base con la mayúscula de la línea 1.
     Altura = cap-height de "SCUART" (~57px = 0.82em @70px). */
  height: 0.82em;
  width: auto;
  flex-shrink: 0;
  align-self: flex-start;
  margin-top: 0.03em;          /* tope del recuadro = techo de la mayúscula */
  overflow: visible;
}

/* Texto dentro del SVG — sans del sitio, tamaño en unidades del viewBox (200×76) */
.hero-disc__txt {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 17px;              /* más chico, con aire, como Locomotive */
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.hero-disc__col .hero-disc__cell--sm:first-child {
  border-bottom: 1px solid #fff;
}

/* ── Asterisco auténtico de PP Editorial New (carácter de la fuente) ── */
.hero-wordmark__star {
  font-family: var(--font-display);
  font-weight: 400;
  margin-left: -0.05em;
  font-size: 1em;               /* mismo cuerpo que el descriptor */
  line-height: 1;
}

/* ── Scroll cue ───────────────────────────────────────────────────── */
.hero-scroll-cue {
  position: absolute;
  z-index: 3;
  right: var(--hero-edge);
  bottom: max(var(--hero-edge), calc(env(safe-area-inset-bottom) + 1rem));
  font-family: var(--font-body);
  font-size: 1.25rem;
  font-weight: 400;
  color: #fff;
  mix-blend-mode: difference;
  opacity: 0.85;
  display: none; /* se muestra desde tablet */
}

/* ════════════════════════════════════════════════════════════════════
   TABLET (768px+)
   ════════════════════════════════════════════════════════════════════ */
@media (min-width: 768px) {
  .hero-nav__center {
    display: flex;
  }

  .hero-scroll-cue {
    display: inline;
  }

  .hero-wordmark__name,
  .hero-wordmark__descriptor {
    font-size: clamp(3.5rem, 8vw, 4.375rem);
  }
}

/* ════════════════════════════════════════════════════════════════════
   DESKTOP (1280px+) — 70px exacto como Locomotive
   ════════════════════════════════════════════════════════════════════ */
@media (min-width: 1280px) {
  .hero-wordmark__name,
  .hero-wordmark__descriptor {
    font-size: 4.375rem;   /* 70px exacto */
  }
}

/* Ultrawide: Locomotive escala un poco; mantenemos proporción sobria */
@media (min-width: 1920px) {
  .hero-wordmark__name,
  .hero-wordmark__descriptor {
    font-size: 5.5rem;
  }
}

/* ── Máscaras de line-reveal (las inserta el script) ──────────────── */
.line-mask {
  display: block;
  overflow: hidden;
}

.line-inner {
  display: block;
}

/* ── reduced-motion: estático, sin scale ──────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .hero-nav { opacity: 1; }
  .hero-video { transform: none !important; opacity: 1 !important; }
}
</style>

<script>
  /**
   * Hero V3 "Locomotive" — Motion GSAP.
   *
   * PROGRESSIVE ENHANCEMENT: wordmark y nav son HTML server-rendered;
   * sin JS se ven igual (CSS deja .hero-nav en opacity:0 → el script lo revela;
   * si el script no corre, el bloque reduced-motion del CSS lo deja visible).
   *
   * SECUENCIA:
   * 1. Video/poster: scale 1.06→1 + opacity 0→1, 1.6s expo.out. Telón que entra.
   * 2. Nav: fade + y -8→0, 0.6s.
   * 3. Wordmark: line-reveal por líneas (máscara real, yPercent 110→0), stagger.
   * 4. Scroll cue: loop sutil.
   *
   * prefers-reduced-motion: todo visible de inmediato (CSS ya lo cubre; el JS no corre).
   */

  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isDesktop = window.matchMedia('(min-width: 769px)').matches;

  /* Video real: solo se vuelve visible (.is-ready) cuando carga de verdad.
     Mientras /video/hero.mp4 no exista, queda oculto y manda el fondo rojo. */
  const videoEl = document.querySelector<HTMLVideoElement>('.hero-video');
  if (videoEl) {
    const reveal = () => videoEl.classList.add('is-ready');
    if (videoEl.readyState >= 2) reveal();
    else videoEl.addEventListener('loadeddata', reveal, { once: true });
  }

  if (!reducedMotion) {
    const heroNav    = document.querySelector<HTMLElement>('.hero-nav');
    const heroVideo  = document.querySelector<HTMLElement>('.hero-video, .hero-fallback');
    const heroMedia  = document.querySelector<HTMLElement>('.hero-media');
    const revealEls  = document.querySelectorAll<HTMLElement>('[data-reveal]');
    const scrollCue  = document.querySelector<HTMLElement>('.hero-scroll-cue');

    /* ── Construir máscaras de line-reveal sobre cada elemento [data-reveal] ── */
    const inners: HTMLElement[] = [];
    revealEls.forEach((el) => {
      try {
        const original = el.innerHTML;
        const mask = document.createElement('span');
        mask.className = 'line-mask';
        const inner = document.createElement('span');
        inner.className = 'line-inner';
        inner.innerHTML = original;
        mask.appendChild(inner);
        el.innerHTML = '';
        el.appendChild(mask);
        inners.push(inner);
      } catch (_) {
        /* Fallback: queda el texto plano visible */
      }
    });

    /* ── Bloquear scroll durante la secuencia de entrada (desktop: Lenis; mobile: body) ──
       Lenis puede no estar listo al momento que corre este script (Layout.astro lo carga
       en el body pero los scripts de componentes también son módulos). Esperamos el evento
       'lenis:ready' para obtener la instancia, con fallback a window.__lenis si ya está. */
    type LenisInstance = { stop: () => void; start: () => void };
    let lenisInstance: LenisInstance | null = null;

    const getLenis = (): LenisInstance | null =>
      ((window as unknown as Record<string, unknown>)['__lenis'] as LenisInstance) ?? null;

    const blockScroll = () => {
      if (isDesktop) {
        const l = getLenis();
        if (l) l.stop();
      } else {
        /* Mobile: el scroller es document.body. Congelamos overflow temporalmente. */
        document.body.style.overflow = 'hidden';
      }
    };

    const unblockScroll = () => {
      if (isDesktop) {
        const l = getLenis();
        if (l) l.start();
      } else {
        document.body.style.overflow = '';
      }
    };

    /* ── Estados iniciales ──────────────────────────────── */
    const heroVideoEl = document.querySelector<HTMLElement>('.hero-video');
    if (heroVideoEl) gsap.set(heroVideoEl, { scale: 1.06, transformOrigin: 'center center' });
    if (heroNav) gsap.set(heroNav, { opacity: 0, y: -8 });
    if (inners.length) gsap.set(inners, { yPercent: 110 });

    /* ── Timeline ───────────────────────────────────────── */
    blockScroll();

    const tl = gsap.timeline({
      defaults: { ease: 'expo.out' },
      onComplete: () => {
        unblockScroll();
      },
    });

    if (heroVideoEl) tl.to(heroVideoEl, { scale: 1, duration: 1.6 }, 0);
    if (heroNav) tl.to(heroNav, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, 0.25);
    if (inners.length) tl.to(inners, { yPercent: 0, duration: 1.1, stagger: 0.12 }, 0.45);

    /* Scroll cue — loop sutil al terminar */
    tl.call(() => {
      if (scrollCue) {
        gsap.to(scrollCue, { y: 7, duration: 0.9, ease: 'sine.inOut', yoyo: true, repeat: -1 });
      }
    });

    /* ── Parallax de salida del hero video [propuesta SCUART, desktop only, cortable] ──
       El video se desplaza más lento que el scroll al salir, creando profundidad.
       RIESGO: con mix-blend-mode:difference activo, puede titilado del texto.
       Si titila visualmente: eliminar este bloque ScrollTrigger. */
    if (isDesktop && heroMedia) {
      const heroSection = document.querySelector<HTMLElement>('.hero-v3');
      if (heroSection) {
        ScrollTrigger.create({
          trigger: heroSection,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
          onUpdate: (self) => {
            gsap.set(heroMedia, { yPercent: self.progress * -10 });
          },
        });
      }
    }
  }
</script>
