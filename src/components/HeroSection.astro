---
/**
 * HeroSection.astro — Hero V3 "Terracota cálida en alternancia"
 * ART_DIRECTION_V3_FINAL.md §5-HERO
 *
 * Composición:
 * - Fondo hueso (#F0E9DC) con grano obligatorio
 * - Kicker mono arriba-izquierda: "SCUART / DESIGN STUDIO · BOGOTÁ · 2026"
 * - Índice mono arriba-derecha col 10-12 (desktop)
 * - H1: Fraunces 300 light, 3 líneas, tinta sobre hueso.
 *   La palabra "SHARP" (EN) / "MEJOR" (ES) en Fraunces 400 itálica terracota — gesto de marca.
 * - Subhead: Hanken Grotesk tinta-suave, max 38ch, col 1-6
 * - CTA: "START A PROJECT →" / "EMPEZAR UN PROYECTO →"
 * - Franja terracota 1px vertical (col 9 desktop) / horizontal (mobile)
 *
 * MOTION — Momento 1 (ART_DIRECTION_V3_FINAL.md §6):
 * H1 entra por líneas con máscara (line-mask/line-inner, clip de abajo hacia arriba),
 * expo.out, ~0.9s, stagger 0.12s entre líneas.
 * La palabra itálica terracota entra con delay +0.2s extra — el gesto de marca aterriza último.
 * prefers-reduced-motion: todo estático visible, sin máscara, sin animación.
 *
 * PROGRESSIVE ENHANCEMENT:
 * El H1 es HTML server-rendered visible por defecto.
 * GSAP agrega .hero-animating al <h1> para activar las máscaras (opacity: 0 inicial).
 * Si el script falla: texto plano visible completo.
 *
 * Copy e i18n keys: CONSERVADOS de Concepto B (aprobado 2026-06-07).
 * isRed sigue disponible en los tokens pero NO se usa en V3 (el rojo fue reemplazado
 * por terracota/itálica como gesto de marca — preservado en la interfaz para no romper
 * la forma del diccionario).
 */

import type { Translations } from '../i18n/en';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<!--
  HERO V3 — fondo hueso, Fraunces light, grano obligatorio
  Layout:
  - mobile 375: flex column, margen lateral var(--margin)
  - tablet 768: grid 6 col
  - desktop 1280: grid 12 col, H1 col 1-9, índice col 10-12
-->
<section class="hero" aria-label={t.hero.ariaLabel}>

  <!--
    Líneas editoriales de grilla: 1px tinta 8% opacidad.
    Col 3/6/9 desktop. Ocultas en mobile.
    GSAP gestiona el estado inicial y el reveal.
  -->
  <div class="grid-lines" aria-hidden="true">
    <div class="grid-line" data-col="3"></div>
    <div class="grid-line" data-col="6"></div>
    <div class="grid-line" data-col="9"></div>
  </div>

  <!--
    Franja terracota costura (gesto de marca estructural):
    - Desktop/tablet: vertical 1px sobre eje col 9
    - Mobile: horizontal 1px, separa headline del resto
  -->
  <div class="hero-terracota-bar" aria-hidden="true"></div>

  <!--
    Kicker — mono uppercase arriba-izquierda
    Muestra el índice editorial del estudio.
  -->
  <p class="hero-kicker">
    {t.hero.kicker}
  </p>

  <!--
    Índice de estudio — col 10-12 desktop (arriba-derecha).
    Coordenadas reales de Bogotá (ART_DIRECTION_V3_FINAL.md §7.2).
    Oculto en mobile/tablet.
  -->
  <p class="hero-studio-index" aria-hidden="true">
    SCUART / DESIGN STUDIO<br />
    4.7110° N, 74.0721° W<br />
    BOGOTÁ · 2026
  </p>

  <!--
    H1 — texto real server-rendered, visible por defecto (progressive enhancement).
    Fraunces 300 light. 3 líneas fijas en desktop.
    La palabra con isItalicAccent=true recibe la clase .italic-acento (Fraunces 400 itálica terracota).
    isRed conservado en la interfaz pero ignorado en V3 (no se renderiza --rojo aquí).
    GSAP envuelve cada .h1-line en .line-mask > .line-inner para el line-reveal.
  -->
  <h1 class="hero-h1">
    <span class="h1-line" data-line="1">
      {t.hero.line1.map((token, i) => (
        <>
          {i > 0 && <span class="h1-space" aria-hidden="true"> </span>}
          <span
            class={`h1-word${token.isItalicAccent ? ' italic-acento' : ''}`}
          >{token.word}</span>
        </>
      ))}
    </span>
    <span class="h1-line" data-line="2">
      {t.hero.line2.map((token, i) => (
        <>
          {i > 0 && <span class="h1-space" aria-hidden="true"> </span>}
          <span
            class={`h1-word${token.isItalicAccent ? ' italic-acento' : ''}`}
          >{token.word}</span>
        </>
      ))}
    </span>
    <span class="h1-line" data-line="3">
      {t.hero.line3.map((token, i) => (
        <>
          {i > 0 && <span class="h1-space" aria-hidden="true"> </span>}
          <span
            class={`h1-word${token.isItalicAccent ? ' italic-acento' : ''}`}
          >{token.word}</span>
        </>
      ))}
    </span>
  </h1>

  <!--
    Subhead — Hanken Grotesk tinta-suave, col 1-6 desktop
  -->
  <p class="hero-subhead">
    {t.hero.subhead}
  </p>

  <!--
    CTA — "START A PROJECT →" / "EMPEZAR UN PROYECTO →"
    Borde hairline borde, texto tinta. Hover: terracota.
    Touch target mínimo 48px (P9).
  -->
  <a class="hero-cta" href="#contact">
    {t.hero.cta} <span aria-hidden="true">→</span>
  </a>

  <!--
    Índice de capacidades 001-004.
    Desktop: col 9-12 alineado verticalmente al centro del headline.
    Mobile/tablet: lista mono full-width debajo del CTA.
    Se lee como ficha técnica de estudio, NO lista de servicios con bullets.
  -->
  <ul class="hero-capabilities" aria-label="Capacidades del estudio">
    {t.hero.capabilities.map((item) => (
      <li class="hero-capabilities__item">
        <span class="hero-capabilities__num">{item.num}</span>
        <span class="hero-capabilities__sep" aria-hidden="true"> / </span>
        <span class="hero-capabilities__label">{item.label}</span>
      </li>
    ))}
  </ul>

</section>

<style>
/* ═══════════════════════════════════════════════════════════
   HERO V3 — fondo hueso, Fraunces light
   Mobile-first: 375px base. md: 768px. lg: 1280px.
   ═══════════════════════════════════════════════════════════ */

.hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  padding-left: var(--margin);
  padding-right: var(--margin);
  padding-top: 0;
  padding-bottom: var(--space-2xl);
  max-width: 100%;
  overflow-x: clip;
  /* V3: fondo hueso. El grano viene de body::after (fixed, lo atraviesa). */
  background-color: var(--hueso);
  color: var(--tinta);
}

/* ─── GRILLA EDITORIAL ───────────────────────────────────── */

.grid-lines {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.grid-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 1px;
  /* Línea editorial V3: tinta al 8% sobre hueso */
  background-color: var(--linea-claro);
  opacity: 0; /* GSAP revela en la entrada */
}

.grid-line[data-col="3"] {
  left: 25%;
  display: none;
}

.grid-line[data-col="6"] {
  left: 50%;
  display: none;
}

.grid-line[data-col="9"] {
  left: 75%;
  display: none;
}

/* ─── FRANJA TERRACOTA — costura estructura ──────────────── */
/*
 * Mobile: regla horizontal 1px, full-width desde el margen,
 *         debajo del H1 (JS la posiciona).
 * Desktop/tablet: vertical 1px sobre eje col 9.
 * El terracota como estructura visible = el sitio "es" terracota.
 */
.hero-terracota-bar {
  position: absolute;
  background-color: var(--terracota);
  pointer-events: none;
  z-index: 2;
  opacity: 0; /* GSAP revela */

  /* Mobile: horizontal */
  left: var(--margin);
  right: var(--margin);
  height: 1px;
  width: auto;
  top: auto;
  bottom: auto;
}

/* ─── KICKER ─────────────────────────────────────────────── */

.hero-kicker {
  position: relative;
  z-index: 2;
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  line-height: 1.4;
  color: var(--tinta-suave);
  margin-top: clamp(88px, 14vh, 120px);
  margin-bottom: var(--space-m);
  flex-shrink: 0;
  opacity: 0; /* GSAP revela */
}

/* ─── ÍNDICE DE ESTUDIO — solo desktop ───────────────────── */

.hero-studio-index {
  display: none; /* solo desktop — ver breakpoint 1280px */
  position: absolute;
  z-index: 2;
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  line-height: 1.8;
  color: var(--tinta-suave);
  opacity: 0; /* GSAP revela */
  text-align: right;
}

/* ─── H1 ─────────────────────────────────────────────────── */
/*
 * Fraunces 300 light. Leading 1.02, tracking -0.025em.
 * 3 líneas fijas en desktop.
 * Sentence/title case editorial (NO caps condensadas del diseño bloqueado).
 * .italic-acento hereda de global.css: itálica 400 terracota — el gesto de marca.
 *
 * PROGRESSIVE ENHANCEMENT:
 * Por defecto el H1 es texto plano visible (no se oculta con opacity:0).
 * El script agrega .hero-animating al <h1> ANTES de crear las máscaras,
 * lo que oculta el contenido original. Luego crea los line-mask/line-inner
 * y anima desde abajo. Sin JS: texto visible sin ninguna máscara.
 */
.hero-h1 {
  position: relative;
  z-index: 2;
  font-family: var(--font-display);
  font-weight: var(--display-weight-light);
  /* Mobile: 6vw preferred — con copy de 3 líneas largas queda 5-6 líneas manejables */
  font-size: clamp(1.6rem, 6vw, 2.8rem);
  line-height: var(--display-leading);
  letter-spacing: var(--display-tracking);
  color: var(--tinta);
  hyphens: manual;
  overflow-wrap: anywhere;
  flex-shrink: 0;
  margin-bottom: 0;
  margin-top: 0;
}

/*
 * .hero-h1.hero-animating — estado durante la animación GSAP.
 * El script vacía el contenido de cada .h1-line y lo mete en .line-mask > .line-inner.
 * No usamos visibility:hidden porque se hereda a los hijos: en su lugar el GSAP
 * pone los .line-inner en yPercent:102 (fuera del overflow:hidden del .line-mask),
 * lo que los oculta sin afectar la herencia de visibilidad.
 * Esta clase se agrega antes de construir las masks y se remueve al finalizar el tl.
 */
.hero-h1.hero-animating {
  /* Solo necesaria como hook de JS — sin estilos propios. */
}

.h1-line {
  display: block;
}

.h1-word {
  display: inline;
}

/* La palabra itálica (italic-acento) dentro del H1:
 * Como es display:inline junto al resto de la línea, necesitamos
 * que el inline-block del ancestor no rompa el layout.
 * Se mantiene inline para preservar el flujo natural del texto. */
.hero-h1 .italic-acento {
  display: inline;
}

.h1-space {
  display: inline;
}

/* ─── SUBHEAD ────────────────────────────────────────────── */

.hero-subhead {
  position: relative;
  z-index: 2;
  font-family: var(--font-body);
  font-size: var(--text-subhead);
  font-weight: 400;
  color: var(--tinta-suave);
  line-height: 1.55;
  letter-spacing: 0;
  margin-top: var(--space-xl);
  max-width: 38ch;
  flex-shrink: 0;
  opacity: 0; /* GSAP revela */
}

/* ─── CTA ────────────────────────────────────────────────── */

.hero-cta {
  position: relative;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 0.5em;
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  color: var(--tinta);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  line-height: 1.4;
  text-decoration: none;
  margin-top: var(--space-l);
  padding: 0.75em 1.5em;
  /* Borde hairline borde sobre hueso */
  border: 1px solid var(--borde);
  flex-shrink: 0;
  opacity: 0; /* GSAP revela */
  /* Touch target mínimo 48px (P9) */
  min-height: 48px;
  align-self: flex-start;
  transition: border-color 0.25s ease, color 0.25s ease, background-color 0.25s ease;
}

.hero-cta:hover {
  border-color: var(--terracota);
  color: var(--hueso);
  background-color: var(--terracota);
}

/* ─── ÍNDICE DE CAPACIDADES ──────────────────────────────── */
/*
 * Mobile: lista mono full-width, debajo del CTA.
 * Desktop: col 9-12, alineada verticalmente al centro del headline.
 */
.hero-capabilities {
  position: relative;
  z-index: 2;
  list-style: none;
  margin: 0;
  padding: 0;
  margin-top: var(--space-l);
  flex-shrink: 0;
  opacity: 0; /* GSAP revela */
}

.hero-capabilities__item {
  display: block;
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  color: var(--tinta-suave);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  line-height: 2;
}

.hero-capabilities__num {
  display: inline;
  font-variant-numeric: tabular-nums;
}

.hero-capabilities__sep {
  color: var(--tinta-suave);
  opacity: 0.4;
}

.hero-capabilities__label {
  display: inline;
}

/* ═══════════════════════════════════════════════════════════
   TABLET (768px+)
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 768px) {
  .hero {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: auto auto auto auto auto;
    column-gap: var(--gutter);
    align-items: start;
    row-gap: 0;
  }

  .grid-line[data-col="6"] {
    display: block;
  }

  .hero-kicker {
    grid-column: 1 / 7;
    margin-bottom: var(--space-s);
  }

  .hero-h1 {
    grid-column: 1 / 7;
    align-self: start;
    /* Tablet: preferred 4.8vw → ~37px en 768px */
    font-size: clamp(2rem, 4.8vw, 3.8rem);
    hyphens: none;
    overflow-wrap: normal;
    text-wrap: balance;
  }

  .hero-subhead {
    grid-column: 1 / 5;
    max-width: none;
    margin-top: var(--space-l);
  }

  .hero-cta {
    grid-column: 1 / 4;
    margin-top: var(--space-m);
    align-self: start;
  }

  .hero-capabilities {
    grid-column: 1 / 7;
    margin-top: var(--space-m);
  }

  /* Franja terracota tablet: vertical 1px en col 5/6 */
  .hero-terracota-bar {
    left: calc(var(--margin) + (100% - 2 * var(--margin)) * 0.667);
    right: auto;
    width: 1px;
    height: auto;
    top: 22%;
    bottom: 12%;
    transform-origin: top center;
  }
}

/* ═══════════════════════════════════════════════════════════
   DESKTOP (1280px+)
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 1280px) {
  .hero {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto auto auto;
    min-height: 100svh;
    align-items: start;
  }

  .grid-line[data-col="3"],
  .grid-line[data-col="6"],
  .grid-line[data-col="9"] {
    display: block;
  }

  /* Kicker: fila superior, col 1-9 (izquierda) */
  .hero-kicker {
    grid-column: 1 / 10;
    grid-row: 1;
    margin-bottom: var(--space-m);
  }

  /* Índice de estudio: col 10-12, fila 1, desktop */
  .hero-studio-index {
    display: block;
    grid-column: 10 / 13;
    grid-row: 1;
    align-self: end;
    margin-bottom: 0;
    padding-bottom: var(--space-xs);
  }

  /* H1: col 1-9, fila 2 */
  .hero-h1 {
    grid-column: 1 / 10;
    grid-row: 2;
    align-self: start;
    /* Desktop: clamp ancho — 88-112px según ART_DIRECTION §3 tabla escala */
    font-size: clamp(3.5rem, 5.5vw, 7rem);
    text-wrap: unset;
    hyphens: none;
    overflow-wrap: normal;
  }

  /* Subhead: col 1-6, fila 3 */
  .hero-subhead {
    grid-column: 1 / 7;
    grid-row: 3;
    max-width: 50ch;
    margin-top: var(--space-l);
  }

  /* CTA: col 1-3, fila 4 */
  .hero-cta {
    grid-column: 1 / 4;
    grid-row: 4;
    margin-top: var(--space-m);
    align-self: start;
  }

  /*
   * Índice de capacidades: col 10-12, fila 2-4.
   * Alineado verticalmente al centro del headline.
   * Sistema de índices mono — lectura como ficha técnica.
   */
  .hero-capabilities {
    grid-column: 10 / 13;
    grid-row: 2 / 5;
    align-self: center;
    margin-top: 0;
  }

  .hero-capabilities__item {
    line-height: 2.4;
  }

  /*
   * Franja terracota desktop: vertical 1px sobre eje col 9.
   * Col 9 de 12 = 8/12 del interior = 66.6%.
   */
  .hero-terracota-bar {
    left: calc(var(--margin) + (100% - 2 * var(--margin)) * 0.6667);
    right: auto;
    width: 1px;
    height: auto;
    top: 20%;
    bottom: 18%;
    transform-origin: top center;
  }
}
</style>

<script>
  /**
   * Hero V3 — Animación GSAP (Momento 1, ART_DIRECTION_V3_FINAL.md §6)
   *
   * PROGRESSIVE ENHANCEMENT:
   * El H1 es HTML server-rendered visible sin JS.
   * Este script es enhancement: si falla, el hero se ve completo y estático.
   *
   * SECUENCIA:
   * 1. Líneas de grilla (scaleY 0→1, expo.out, 1.1s)
   * 2. Kicker + índice de estudio (fade, 0.6s)
   * 3. H1 line-reveal: CADA LÍNEA completa entra con máscara (clip abajo→arriba)
   *    - .h1-line[data-line="1"]: translateY(100%)→0, 0.9s expo.out
   *    - .h1-line[data-line="2"]: stagger +0.12s
   *    - .h1-line[data-line="3"] sin itálica: stagger +0.12s
   *    - La palabra .italic-acento dentro de line 3: delay extra +0.2s — aterriza ÚLTIMA
   *      (el gesto de marca como firma: "SHARP"/"MEJOR" en terracota llega al final)
   * 4. Franja terracota (scale 0→1, 0.5s)
   * 5. Índice de capacidades (fade + translateY, stagger 0.08s)
   * 6. Subhead + CTA (fade)
   *
   * IMPLEMENTACIÓN DEL LINE-REVEAL:
   * No usamos SplitText de GSAP Club (no disponible en OSS).
   * Envolvemos cada .h1-line en un .line-mask (overflow:hidden) y animamos
   * el .line-inner (el span del contenido) con translateY 100%→0.
   * La itálica está DENTRO del line-inner de line3 — al animar line3 entra sola.
   * Para el delay extra de la itálica: animamos el span.italic-acento por separado
   * desde el mismo frame de inicio que line3, pero con ese +0.2s de offset.
   *
   * REDUCED-MOTION: todo estático visible de inmediato, sin masks, sin animación.
   */

  import { gsap } from 'gsap';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Helper: posiciona la franja terracota en mobile (horizontal, entre H1 y subhead) */
  function positionTerracotaBarMobile(
    bar: HTMLElement | null,
    h1: HTMLElement | null
  ) {
    if (!bar || !h1) return;
    const h1Rect = h1.getBoundingClientRect();
    const scrollTop = window.scrollY || document.documentElement.scrollTop;
    bar.style.top = `${h1Rect.bottom + scrollTop + 16}px`;
    bar.style.bottom = 'auto';
  }

  if (!reducedMotion) {
    /* ── Referencias DOM ── */
    const heroH1 = document.querySelector<HTMLElement>('.hero-h1');
    const h1Lines = document.querySelectorAll<HTMLElement>('.h1-line');
    const gridLines = document.querySelectorAll<HTMLElement>('.grid-line');
    const terracotaBar = document.querySelector<HTMLElement>('.hero-terracota-bar');
    const kicker = document.querySelector<HTMLElement>('.hero-kicker');
    const studioIndex = document.querySelector<HTMLElement>('.hero-studio-index');
    const heroSubhead = document.querySelector<HTMLElement>('.hero-subhead');
    const heroCta = document.querySelector<HTMLElement>('.hero-cta');
    const capabilityItems = document.querySelectorAll<HTMLElement>('.hero-capabilities__item');
    const capabilities = document.querySelector<HTMLElement>('.hero-capabilities');

    const isMobile = window.innerWidth < 768;

    /*
     * Construir las masks de línea ANTES de agregar .hero-animating.
     * Para cada .h1-line: crear .line-mask que la envuelve y .line-inner con el contenido.
     *
     * Estructura resultante:
     *   <span class="h1-line" data-line="1">
     *     <span class="line-mask">
     *       <span class="line-inner">DESIGN + TECHNOLOGY</span>
     *     </span>
     *   </span>
     *
     * La itálica dentro de line3 queda DENTRO del line-inner — el span.italic-acento
     * es un inline dentro del texto, no una línea separada.
     */
    const lineInners: HTMLElement[] = [];

    h1Lines.forEach((lineEl) => {
      try {
        /* Extraer el contenido HTML de la línea */
        const originalContent = lineEl.innerHTML;

        /* Crear la máscara */
        const mask = document.createElement('span');
        mask.className = 'line-mask';

        /* Crear el inner animado */
        const inner = document.createElement('span');
        inner.className = 'line-inner';
        inner.innerHTML = originalContent;

        mask.appendChild(inner);
        lineEl.innerHTML = '';
        lineEl.appendChild(mask);

        lineInners.push(inner);
      } catch (_) {
        /* Si falla la construcción de una línea, la dejamos como está */
      }
    });

    /*
     * Activar .hero-animating AHORA (después de construir las masks).
     * Esta clase oculta .h1-line via visibility:hidden en CSS.
     * Luego GSAP anima los line-inner que SÍ son visibles (están dentro del mask).
     *
     * Nota: usamos visibility:hidden en .h1-line.hero-animating (ver CSS arriba)
     * pero los line-inner dentro del mask NO heredan esa visibility si les
     * hacemos un set explícito. En su lugar, el estado inicial de los line-inner
     * es translateY(100%) que los manda debajo del overflow:hidden del mask.
     */
    if (heroH1) heroH1.classList.add('hero-animating');

    /* ── Estados iniciales ── */
    gsap.set(gridLines, { opacity: 1, scaleY: 0, transformOrigin: 'top center' });

    if (isMobile) {
      positionTerracotaBarMobile(terracotaBar, heroH1);
      if (terracotaBar) gsap.set(terracotaBar, { opacity: 1, scaleX: 0, transformOrigin: 'left center' });
    } else {
      if (terracotaBar) gsap.set(terracotaBar, { opacity: 1, scaleY: 0, transformOrigin: 'top center' });
    }

    gsap.set(kicker, { opacity: 0 });
    if (studioIndex) gsap.set(studioIndex, { opacity: 0 });
    gsap.set(heroSubhead, { opacity: 0 });
    gsap.set(heroCta, { opacity: 0 });
    if (capabilities) gsap.set(capabilities, { opacity: 1 }); /* el container es visible */
    gsap.set(capabilityItems, { opacity: 0, y: 8 });

    /* Líneas del H1: empiezan debajo de la máscara */
    if (lineInners.length > 0) {
      gsap.set(lineInners, { yPercent: 102 });
      /* Hacerlos visibles AHORA (la máscara los oculta, no visibility:hidden) */
      gsap.set(lineInners, { visibility: 'visible' });
    }

    /* ── Timeline principal ── */
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });

    /* 1. Líneas de grilla */
    tl.to(gridLines, { scaleY: 1, duration: 1.1, stagger: 0.06 });

    /* 2. Kicker + índice de estudio */
    tl.to(kicker, { opacity: 1, duration: 0.6 }, '-=0.5');
    if (studioIndex) tl.to(studioIndex, { opacity: 1, duration: 0.6 }, '<');

    /* 3. H1 line-reveal — líneas 1, 2, 3 con stagger 0.12s
     *    Cada línea entra como bloque (toda la línea de una vez).
     *    La itálica dentro de line3 viene dentro del line-inner[2] — no necesita
     *    tratamiento separado para el reveal de línea.
     *
     *    Para el gesto de marca (la itálica aterriza "última"):
     *    La línea 3 entra como bloque. Inmediatamente después, la palabra .italic-acento
     *    hace un micro-refuerzo: scale 0.92→1 + un leve color-fade desde tinta a terracota
     *    (ya tiene terracota desde el CSS, así que el "aterrizaje" es el scale).
     *    Esto da el efecto de "la firma llega al final" sin separar la línea en piezas.
     */
    if (lineInners.length >= 3) {
      /* Las 3 líneas entran con stagger */
      tl.to(
        lineInners,
        {
          yPercent: 0,
          duration: 0.9,
          stagger: 0.12,
        },
        '-=0.2'
      );

      /* La itálica dentro de line3: micro-refuerzo (scale 0.94→1) con +0.2s de delay
       * respecto al inicio del reveal de line3.
       * lineInners[2] es la línea 3; buscamos el .italic-acento dentro de ella. */
      const italicEl = lineInners[2]?.querySelector<HTMLElement>('.italic-acento');
      if (italicEl) {
        /* Estado inicial: ligeramente reducida y sin color visible (hereda el color del
         * parent que aún no entró — el mask lo ocultaba). Al entrar el line-inner, la
         * itálica ya es terracota (CSS), pero con scale 0.94 parece que "se asienta". */
        gsap.set(italicEl, { scale: 0.94, transformOrigin: 'left bottom' });
        /* El label '<+0.2' es relativo al inicio del último tween que arrancó en el tl,
         * que fue el stagger de los 3 lineInners. El tercer inner empieza en t + 0.24s
         * (2 × stagger 0.12s). '<+0.2' cuenta desde ese mismo inicio → +0.2s después
         * de que el stagger arrancó, es decir ~0.44s desde que comenzó el reveal de líneas. */
        tl.to(
          italicEl,
          { scale: 1, duration: 0.6, ease: 'expo.out' },
          `<+${0.12 * 2 + 0.2}`
        );
      }
    } else if (lineInners.length > 0) {
      /* Fallback: si por alguna razón no se construyeron los 3 inners */
      tl.to(lineInners, { yPercent: 0, duration: 0.9, stagger: 0.12 }, '-=0.2');
    }

    /* 4. Franja terracota */
    if (isMobile) {
      tl.to(terracotaBar, { scaleX: 1, duration: 0.5, ease: 'expo.out' }, '+=0.05');
    } else {
      tl.to(terracotaBar, { scaleY: 1, duration: 0.8, ease: 'expo.out' }, '-=0.7');
    }

    /* 5. Índice de capacidades */
    tl.to(
      capabilityItems,
      { opacity: 1, y: 0, duration: 0.5, stagger: 0.08, ease: 'expo.out' },
      '-=0.4'
    );

    /* 6. Subhead + CTA */
    tl.to(heroSubhead, { opacity: 1, duration: 0.7 }, '+=0.05');
    tl.to(heroCta, { opacity: 1, duration: 0.5 }, '<+0.15');

    /* Al terminar la animación, remover .hero-animating (no es necesaria ya) */
    tl.call(() => {
      if (heroH1) heroH1.classList.remove('hero-animating');
    });

  } else {
    /* ── reduced-motion: todo visible de inmediato ── */
    const allAnimated = document.querySelectorAll<HTMLElement>(
      '.grid-line, .hero-terracota-bar, .hero-kicker, .hero-studio-index, .hero-subhead, .hero-cta'
    );
    gsap.set(allAnimated, { opacity: 1 });

    const gridLinesRM = document.querySelectorAll<HTMLElement>('.grid-line');
    gsap.set(gridLinesRM, { scaleY: 1 });

    const barRM = document.querySelector<HTMLElement>('.hero-terracota-bar');
    if (barRM) gsap.set(barRM, { scaleX: 1, scaleY: 1 });

    const capRM = document.querySelectorAll<HTMLElement>('.hero-capabilities__item');
    gsap.set(capRM, { opacity: 1, y: 0 });

    const capContainerRM = document.querySelector<HTMLElement>('.hero-capabilities');
    if (capContainerRM) gsap.set(capContainerRM, { opacity: 1 });

    /* H1 es HTML plano visible por defecto en reduced-motion — no necesita set */
    /* La itálica terracota es CSS puro — visible siempre */
  }
</script>
