---
/**
 * HeroSection.astro — Hero "portada de dossier editorial"
 *
 * ORIGEN: composición aprobada por William en producción (main, 2026-06-07):
 *   kicker → headline 3 líneas con el "+" como único acento → capacidades
 *   001-004 → subhead → CTA. Referencia que William validó (2026-07-30).
 *
 * REESCRITURA 2026-08-04 (dirección director creativo, tras BLOCK del
 * visual-critic nota 7.5 — "se lee como template de estudio Framer": kicker
 * mono + titular serif + índice numerado a la derecha era EXACTAMENTE el
 * layout genérico que el critic reconoce). El copy y el sistema de ciclo se
 * conservan intactos; lo que cambia es la COMPOSICIÓN:
 *
 *   - Se mata el split de dos columnas (titular izq / índice der). Todo pasa
 *     a UNA columna alineada al margen izquierdo, estructura vertical tipo
 *     dossier editorial.
 *   - Barra superior de firma (SCUART / EST. 2025 · NYC + LATAM) reemplaza
 *     el kicker suelto — es la cabecera de un documento, no un label de hero.
 *   - El bloque-frase gana JERARQUÍA DE TAMAÑO real: tesis 0.62, conector
 *     0.34, beneficio-que-cicla 1.0 (el más grande de toda la página). Antes
 *     las tres líneas eran del mismo tamaño (--text-h1 plano) — el critic
 *     marcó eso como "todo igual, sin jerarquía".
 *   - Barra marcadora lima bajo el beneficio: se redimensiona al ancho de
 *     cada palabra del ciclo. Es el elemento vivo del hero.
 *   - El índice numerado 001-004 vertical se reemplaza por una línea de
 *     texto corrido sin números, en una banda inferior junto al CTA.
 *   - La grilla de líneas verticales decorativas (.grid-lines) se elimina:
 *     era decoración sin función que reforzaba el look "template".
 *
 * FONT: --font-display de esta branch es SERIF (PP Editorial New / Fraunces).
 *
 * PROGRESSIVE ENHANCEMENT:
 *   El H1 es HTML real server-rendered, visible sin JS. GSAP es enhancement
 *   no-bloqueante — si falla, el hero se ve completo estático. El "+" se
 *   pinta en lima vía CSS puro (.h1-word--plus), no depende de JS.
 *
 * .hero-v3 — clase conservada: el IntersectionObserver de Nav.astro la usa.
 */

import type { Translations } from '../i18n/en';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const lang = t.nav.langHref === '/es' ? 'en' : 'es';

/* ── Copy del hero, hardcodeado por idioma (patrón de esta branch: el copy
   visible del hero NO vive en el i18n, solo el ariaLabel). ── */
/* ── Copy del hero. Estructura (William 2026-08-04): recupera el copy de marca
   que vende directo ("DISEÑO + TECNOLOGÍA / PARA NEGOCIOS QUE NECESITAN / …")
   y le suma el gesto vivo: la última palabra CICLA el beneficio real de negocio
   (VERSE MEJOR → VENDER MÁS → CRECER → DESTACAR). Así el copy que ya funcionaba
   gana un movimiento que demuestra el resultado, sin jerga técnica.
     tesis (con "+" acento) → conector → palabra-beneficio que cicla.
   cycle[0] lo rinde el server (indexable / sin-JS); el resto rota con JS. ── */
const copy = {
  es: {
    signatureMeta: 'EST. 2025 · NYC + LATAM',
    /* tesis: DISEÑO + TECNOLOGÍA. El "+" es signo tipográfico (acento), en
       LIMA — es el glifo con significado del hero. */
    thesis: [
      { word: 'DISEÑO', accent: false },
      { word: '+', accent: true },
      { word: 'TECNOLOGÍA', accent: false },
    ],
    /* conector: minúscula itálica (Fraunces) — respiro editorial */
    connector: 'para negocios que necesitan',
    /* palabra-beneficio que cicla. Todas mayúscula display, en tinta. */
    cycle: ['VERSE MEJOR.', 'VENDER MÁS.', 'CRECER.', 'DESTACAR.'],
    subhead:
      'Webs premium, plataformas y sistemas digitales para negocios ambiciosos en USA y LATAM. Un solo equipo, de principio a fin.',
    cta: 'EMPEZAR PROYECTO',
  },
  en: {
    signatureMeta: 'EST. 2025 · NYC + LATAM',
    thesis: [
      { word: 'DESIGN', accent: false },
      { word: '+', accent: true },
      { word: 'TECHNOLOGY', accent: false },
    ],
    connector: 'for businesses that need to',
    cycle: ['LOOK SHARP.', 'SELL MORE.', 'GROW.', 'STAND OUT.'],
    subhead:
      'Premium websites, platforms and digital systems for ambitious businesses across the US and LATAM. One team, start to finish.',
    cta: 'START A PROJECT',
  },
};

const c = copy[lang];

/* Capacidades — línea de texto corrido, SIN números (reemplaza el índice
   001-004 vertical que el visual-critic marcó como "ficha técnica de
   estudio" genérica). Términos técnicos en inglés en ambos idiomas
   (convención del sitio, igual que PORTFOLIO). */
const capabilities = [
  'WEB PLATFORMS',
  'SAAS + SYSTEMS',
  'AI AUTOMATION',
  'ORDERING · BOOKING · WORKFLOWS',
];
---

<section class="hero-v3 hero" aria-label={t.hero.ariaLabel}>

  <!-- Grano de textura (mejora 2026-07-30): SVG fractalNoise inline como
       data-URI. Le da al crema plano una textura de impreso premium sin peso
       de imagen ni JS. Muy sutil (opacity baja), pointer-events:none. -->
  <div class="hero-grain" aria-hidden="true"></div>

  <!-- Barra superior de firma — cabecera de dossier, reemplaza el kicker
       suelto. Izquierda: wordmark. Derecha: metadato de estudio. Hairline
       cruza debajo de toda la fila. -->
  <div class="hero-signature">
    <span class="hero-signature__mark">SCUART</span>
    <span class="hero-signature__meta">{c.signatureMeta}</span>
  </div>

  <!-- Bloque-frase — el corazón del hero. UNA columna, alineada a izquierda.
       Jerarquía por TAMAÑO (no por peso — todo 300): tesis 0.62 · conector
       0.34 · beneficio-que-cicla 1.0 (el más grande de la página). -->
  <div class="hero-frase">
    <h1 class="hero-h1">
      <span class="h1-line h1-line--thesis" data-line="thesis">
        {c.thesis.map((token, i) => (
          <>
            {i > 0 && <span class="h1-space" aria-hidden="true"> </span>}
            <span class={`h1-word${token.accent ? ' h1-word--plus' : ''}`}>{token.word}</span>
          </>
        ))}
      </span>
      <span class="h1-line h1-line--connector" data-line="connector">
        <span class="h1-word">{c.connector}</span>
      </span>
      <span class="h1-line h1-line--result" data-line="result">
        {/* Palabra-resultado que cicla. data-cycle lleva la lista JSON; el JS
           rota el textContent con fade y re-dimensiona la barra marcadora.
           Sin JS queda cycle[0] fijo y la barra queda al ancho de esa
           palabra vía CSS (width: 100% del span inline-block). */}
        <span class="h1-cycle-wrap">
          <span
            class="h1-word h1-word--accent h1-cycle"
            data-cycle={JSON.stringify(c.cycle)}
            aria-label={c.cycle.join(', ')}
          >{c.cycle[0]}</span>
          <span class="h1-cycle-bar" aria-hidden="true"></span>
        </span>
      </span>
    </h1>

    <!-- Subhead — debajo del bloque-frase, ancho completo (no a un costado) -->
    <p class="hero-subhead">{c.subhead}</p>
  </div>

  <!-- Banda inferior de cierre — reemplaza el índice numerado vertical.
       CTA a la izquierda, capacidades como línea corrida a la derecha.
       Hairline cruza arriba de toda la fila. -->
  <div class="hero-band">
    <a class="hero-cta" href={`/${lang}#contact`}>
      {c.cta} <span aria-hidden="true">→</span>
    </a>
    <p class="hero-band__caps">
      {capabilities.map((label, i) => (
        <>
          {i > 0 && <span class="hero-band__sep" aria-hidden="true"> · </span>}
          <span>{label}</span>
        </>
      ))}
    </p>
  </div>

</section>

<style>
/* ═══════════════════════════════════════════════════════════
   HERO — portada de dossier editorial. Paleta redesign-v3
   (crema/tinta/lima). Mobile-first: 375px base. md: 768px. lg: 1280px.
   ═══════════════════════════════════════════════════════════ */

.hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  padding-left: var(--margin);
  padding-right: var(--margin);
  /* padding-top explícito con safe-area (iPhone notch) — antes dependía
     solo del clamp(vh) de .hero-signature, que no conoce el inset real. */
  padding-top: max(0px, env(safe-area-inset-top));
  /* --cookiebar-h: altura real de la barra de cookies, publicada por
     CookieBanner.astro (0px cuando no está). La barra es position:fixed y no
     ocupa flujo — sin esto la banda inferior del hero (CTA + capacidades)
     queda TAPADA por el banner en la primera visita. */
  padding-bottom: calc(var(--space-l) + var(--cookiebar-h, 0px));
  background-color: var(--bg);
  color: var(--ink);
  max-width: 100%;
  overflow-x: clip;
}

/* ─── GRANO / TEXTURA ────────────────────────────────────── */
/* inset:0 por defecto (relativo a .hero). En desktop (≥1280px) .hero gana
   max-width y el grain se libera a full-bleed real vía 100vw/-50vw — ver
   media query desktop más abajo. */
/* APAGADO (2026-08-13). William reportó tres veces, con captura, que el hero
   se veía como un bloque gris distinto del resto de la página — primero como
   un recuadro con bordes laterales, después como una banda contra el
   manifiesto blanco de abajo.

   CAUSA: el sitio tenía DOS granos. El global (body::after en global.css,
   opacity 0.03) cubre TODA la página; este, propio del hero, sumaba una
   segunda capa que ninguna otra sección tiene. Estaba a opacity 0.5 —16 veces
   el global— y bajarlo a 0.06 NO alcanzó: la diferencia seguía siendo visible
   en pantalla real.

   POR QUÉ SE APAGA EN VEZ DE SEGUIR AFINÁNDOLO: el hero ya recibe el grano
   global como el resto del sitio, así que no pierde textura — pierde la capa
   DUPLICADA que lo separaba visualmente. Misma decisión y mismo criterio que
   con el grano en iOS (ver global.css): se estaba pagando un defecto visible
   por una textura que nadie ve.

   NOTA DE MÉTODO: Chromium headless NUNCA reprodujo este defecto. Medí once
   columnas de 850px, muestreé el borde exacto entre secciones, comparé
   desviación estándar dentro y fuera — todo dio idéntico, antes y después.
   No confiar en la medición headless para juzgar esta capa: solo la pantalla
   real de William lo mostró. Mismo caso que feedback_parpadeo_ios_grain.

   El div .hero-grain se conserva en el markup (aria-hidden) por si se quiere
   reactivar con otro tratamiento; hoy no pinta nada. */
.hero-grain {
  display: none;
}

/* ─── BARRA SUPERIOR DE FIRMA ────────────────────────────── */
/* Cabecera de dossier: wordmark izquierda, metadato de estudio derecha,
   hairline cruza debajo de toda la fila. Geist mono uppercase chico. */
.hero-signature {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-s);
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  color: var(--ink-mid);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  line-height: 1.4;
  margin-top: clamp(88px, 14vh, 120px);
  padding-bottom: var(--space-s);
  border-bottom: 1px solid var(--hairline);
  flex-shrink: 0;
  opacity: 0; /* GSAP revela */
}
.hero-signature__mark {
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.1em;
}
.hero-signature__meta {
  font-weight: 400;
}

/* ─── BLOQUE-FRASE ───────────────────────────────────────── */
.hero-frase {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  margin-top: var(--space-l);
}

/* ─── H1 ─────────────────────────────────────────────────── */
.hero-h1 {
  font-family: var(--font-display);
  /* Peso LIGHT (300): PP Editorial New solo tiene el corte Light (fonts.css
     declara font-weight 300 400). Es el peso base de todo el sitio. La
     jerarquía entre líneas la da el TAMAÑO (ver .h1-line--thesis/--result),
     no el peso — todas las líneas son 300. */
  font-weight: var(--display-weight-light);
  line-height: var(--display-leading);
  letter-spacing: var(--display-tracking);
  color: var(--ink);
  hyphens: manual;
  overflow-wrap: anywhere;
  margin: 0;
}
.h1-line { display: block; }
.h1-word { display: inline-block; }

/* Tesis (DISEÑO + TECNOLOGÍA): registro MEDIANO — 0.62 del beneficio.
   Base MOBILE (375px→767px): piso subido a 30px→40px con letter-spacing
   propio -0.01em (no el -0.025em de --display-tracking, que a 30px se ve
   apretado). Tablet/desktop pisan estos valores en sus media queries. */
.h1-line--thesis {
  font-size: clamp(1.875rem, 2.551vw + 1.277rem, 2.5rem); /* 30px@375 → 40px@767 */
  letter-spacing: -0.01em;
}

/* El "+" de la tesis — glifo con significado, en LIMA. CSS-first: se ve lima
   sin depender de JS (progressive enhancement correcto). */
.h1-word--plus { color: var(--brand); }

/* Conector editorial: minúscula itálica, CHICO — 0.34 del beneficio.
   Rompe el muro de mayúsculas (visual-critic 2026-08-03) y hace VISIBLE lo
   que la frase ya dice: el ojo salta de la tesis al beneficio. La itálica
   cae en Fraunces (2º en --font-display) — PP Editorial no tiene itálico. */
.h1-line--connector {
  /* Base MOBILE (375px→767px): piso 16px→19px, letter-spacing propio.
     Tablet/desktop pisan estos valores en sus media queries. */
  font-size: clamp(1rem, 0.765vw + 0.821rem, 1.1875rem); /* 16px@375 → 19px@767 */
  text-transform: lowercase;
  font-style: italic;
  font-weight: var(--display-weight-normal);
  color: var(--ink-mid);
  line-height: 1.15;
  letter-spacing: -0.01em;
  margin: 0.2em 0 0.2em;
}
.h1-line--connector .h1-space { letter-spacing: 0; }

/* Beneficio que cicla: el registro MÁS GRANDE de toda la página. Domina la
   composición (nivel 1 de jerarquía, ≥40% del peso visual del hero). En
   TINTA — el lima se reserva para el "+" y la barra marcadora, nunca texto
   grande sobre crema (rechina a esta escala).
   Mínimo local 2.5rem (no el 1.9rem de --text-h1): en 375px el visual-critic
   marcó el titular como "chico, tímido". --text-h1 es token global (lo usan
   Manifesto/Statement/Contact) — se sube el piso SOLO acá, override local del
   hero, sin tocar el token. El tope 8.5rem se mantiene igual al de --text-h1. */
.h1-line--result {
  /* Base MOBILE (375px→767px). Antes era un override local fijo (54px@375)
     que existía SOLO para compensar que --text-h1 daba 30px en mobile —
     un parche contra el token roto. Con la escala mobile propia en
     tokens.css (2026-08-06) el token ya da 44px, así que el beneficio
     vuelve a derivarse de él: 1.25 × --text-h1 = 55px@375. Mantiene el
     tamaño que el critic pidió, pero ahora ESCALA con el sistema en vez
     de estar clavado — si William ajusta --text-h1, el hero sigue.
     line-height/letter-spacing propios — puede wrappear a 2 líneas, es
     deseable (domina más). Tablet/desktop pisan esto en sus media queries. */
  font-size: calc(var(--text-h1) * 1.25);
  line-height: 1.02;
  letter-spacing: -0.025em;
  margin-top: 0.05em;
  /* aire abajo para que la barra lima (bottom:-0.14em) caiga fuera del texto
     sin que el subhead se le suba encima */
  padding-bottom: 0.18em;
  /* ALTURA RESERVADA PARA 2 LÍNEAS (fix William 2026-08-05, "el sitio
     temblequea cuando las palabras grandes cambian"): las palabras del ciclo
     tienen largo distinto — "VERSE MEJOR." envuelve a 2 líneas en 375px y
     "CRECER." entra en 1. Sin reserva, el bloque cambiaba de alto en cada
     rotación y EMPUJABA todo lo de abajo (medido: salto de 55px en 375px, la
     banda del CTA se movía igual). Tablet y desktop ya tenían su min-height;
     mobile no. 2.04em = 2 × line-height(1.02) — el alto de dos líneas. */
  min-height: 2.04em;
}
.h1-word--accent { color: var(--ink); }

/* Envoltorio de la palabra-cicla + su barra marcadora. inline-block para que
   la barra se posicione relativa a este bloque y no al H1 completo. */
.h1-cycle-wrap {
  position: relative;
  display: inline-block;
}
.h1-cycle {
  display: inline-block;
  will-change: transform, opacity;
  padding-bottom: 0.05em; /* aire para que el fade vertical no se recorte */
}

/* Barra marcadora lima — tipo resaltador, bajo el beneficio. El JS mide
   getClientRects() de .h1-cycle y posiciona la barra bajo la ÚLTIMA línea
   (left/width vía inline style) — necesario porque cuando el beneficio
   wrappea a 2 líneas (mobile, a veces tablet), el bounding box completo
   del span daría el ancho de la línea más larga y una posición incorrecta.
   Sin JS: left:0/width:100% del wrap, que envuelve exactamente a cycle[0]
   en una sola línea (estático, sin animación) — progressive enhancement. */
.h1-cycle-bar {
  position: absolute;
  left: 0;
  /* bottom NEGATIVO (fix William 2026-08-06: "la raya lima está muy pegada").
     Antes era 0.08em POSITIVO, que mete la barra DENTRO de la caja de texto:
     con line-height 1.02 el descender de la serif casi la toca y se lee como
     subrayado apretado, no como resaltador. En negativo la barra cae por
     DEBAJO de la línea base y respira.
     En em, así escala con el font-size dinámico de tablet/desktop. */
  bottom: -0.22em;
  height: 0.09em;
  width: 100%;
  background-color: var(--brand);
  transform-origin: left center;
  pointer-events: none;
}

.h1-space { display: inline; }

/* word-clip / word-inner: inyectados por GSAP para el word-reveal.
   SIN máscara vertical (bug 2026-08-03: recortaba diacríticos Ñ/Í). El
   reveal es fade+slide corto en .word-inner, no necesita recortar nada. */
:global(.word-clip) {
  display: inline-block;
  vertical-align: bottom;
}
:global(.word-inner) { display: inline-block; }

/* ─── SUBHEAD ────────────────────────────────────────────── */
.hero-subhead {
  position: relative;
  font-family: var(--font-body);
  font-size: var(--text-subhead);
  font-weight: 400;
  color: var(--ink-mid);
  line-height: 1.5;
  margin-top: var(--space-l);
  max-width: 48ch;
  opacity: 0; /* GSAP revela */
}

/* ─── BANDA INFERIOR DE CIERRE ───────────────────────────── */
.hero-band {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-m);
  margin-top: var(--space-l);
  padding-top: var(--space-s);
  border-top: 1px solid var(--hairline);
  flex-shrink: 0;
  opacity: 0; /* GSAP revela */
}

/* ─── CTA ────────────────────────────────────────────────── */
.hero-cta {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  color: var(--ink);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  line-height: 1.4;
  text-decoration: none;
  padding: 0.75em 1.5em;
  border: 1px solid var(--hairline-strong);
  flex-shrink: 0;
  min-height: 48px; /* touch target */
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5em;
  transition: border-color 0.25s ease, background-color 0.25s ease, color 0.25s ease;
}
.hero-cta:hover,
.hero-cta:focus-visible {
  border-color: var(--brand);
  background-color: var(--brand);
  color: var(--on-brand);
}
/* la flecha del CTA — hover desktop la desplaza (ver media query 1280px) */
.hero-cta span {
  display: inline-block;
  transition: transform 0.2s ease;
}

/* ─── CAPACIDADES — línea corrida, sin números ───────────── */
.hero-band__caps {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 400;
  color: var(--ink-mid);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  line-height: 1.7;
  margin: 0;
  max-width: 46ch;
}
.hero-band__sep { opacity: 0.5; }

/* ═══════════════════════════════════════════════════════════
   MOBILE (hasta 767px) — el beneficio DOMINA, cartel vertical.
   Base del archivo ya es mobile-first; estas reglas son las que SOLO
   aplican <768px y deben pisar la cascada de tablet/desktop más abajo
   (CTA full-width, orden de la banda, alineación de capacidades).
   ═══════════════════════════════════════════════════════════ */
@media (max-width: 767px) {
  /* Hueco superior (auditoría 2026-08-12, reporte de William con captura).
     Medido: 114px en mobile contra 64px en tablet y 32px en desktop — la
     pantalla MÁS CHICA se comía el margen MÁS GRANDE, un 14% del alto del
     iPhone antes de que empiece nada, justo en el hero.

     Causa: el clamp(88px, 14vh, 120px) de la regla base. El 14vh está pensado
     para pantallas anchas y bajas; en un teléfono alto el término vh dispara.
     Tablet ya tenía la corrección (margin-top: 64px fijo, con el comentario
     "evita el hueco vertical") pero se aplicó SOLO a su breakpoint — mobile
     quedó heredando el clamp original. Mismo patrón que las áreas táctiles:
     el fix existía, en el media query equivocado.

     48px fijo + safe-area: por debajo de tablet (64px) porque hay menos alto
     que repartir, y con max() para no comerse el notch del iPhone — el hero
     ya aplica env(safe-area-inset-top) en su padding, así que acá el inset
     solo actúa si el padding no alcanzó. */
  .hero-signature {
    margin-top: max(48px, env(safe-area-inset-top));
  }

  .hero-cta {
    width: 100%;
    min-height: 56px;
  }
  .hero-band__caps {
    /* no heredar el text-align:right de tablet — cuidado con la cascada */
    text-align: left;
  }
}

/* ═══════════════════════════════════════════════════════════
   TABLET (720px–1279px) — layout dedicado, mata el hueco vertical.
   Dos sub-rangos: portrait 720-1023px, landscape 1024-1279px.
   Portal extendido desde 720px (no 768px) para foldables/iPad mini.
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 720px) and (max-width: 1279px) {
  .hero {
    min-height: auto;
    padding-bottom: 48px;
  }
  .hero-signature {
    margin-top: 64px; /* fijo, no clamp con 14vh — evita el hueco vertical */
  }
  .hero-band {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .hero-cta {
    width: auto; /* resetea el full-width heredado del mobile base */
  }
  .hero-band__caps {
    text-align: right;
  }

  /* Tamaños fijos (no clamp heredado) + transición corta entre sub-rangos
     para suavizar la rotación física de iPad (720-1023 ⇄ 1024-1279). */
  .h1-line--thesis,
  .h1-line--connector {
    transition: font-size 180ms ease, margin-top 180ms ease;
  }
  .h1-line--thesis { font-size: 3.4rem; letter-spacing: -0.02em; }
  .h1-line--connector {
    font-size: 1.7rem;
    letter-spacing: -0.01em;
    /* RITMO PROPIO de tablet (critic 2026-08-04: el conector casi chocaba el
       beneficio → se veía "desktop apretado"). Aire vertical explícito arriba
       y abajo del conector para que la diagonal respire en el viewport medio,
       no sea un reflow comprimido del desktop. */
    margin-top: 0.5em;
    margin-bottom: 0.65em;
  }
  /* .h1-line--result: 5rem es el TOPE en tablet (bajado de 5.6 → deja aire para
     que el conector no colisione; la palabra más larga sigue ocupando buena
     parte del ancho sin comerse la línea de arriba). El JS escala .h1-cycle
     hacia abajo desde este tope — ver bloque "font-size dinámico" más abajo. */
  .h1-line--result {
    font-size: 5rem;
    letter-spacing: -0.03em;
    transition: margin-top 180ms ease;
  }
  .hero-subhead {
    font-size: 19px;
    max-width: 40ch;
  }
}

/* Sub-rango landscape (1024-1279px): un paso más grande, todavía tablet
   (no entra al desktop grid hasta 1280px). El tope del dinámico sube a
   6.8rem acorde. */
@media (min-width: 1024px) and (max-width: 1279px) {
  .h1-line--thesis { font-size: 4.1rem; }
  .h1-line--connector { font-size: 2rem; margin-top: 0.55em; margin-bottom: 0.7em; }
  .h1-line--result { font-size: 6rem; }
}

/* ─── FONT-SIZE DINÁMICO POR PALABRA (tablet 720px+ / desktop) ───────────
   Compartido entre tablet y desktop: el JS mide cada palabra del ciclo y
   escala .h1-cycle hacia abajo desde el tope (font-size de .h1-line--result,
   calibrado para que la palabra MÁS LARGA ocupe ~90% del ancho útil) —
   nunca lo supera. Anclaje por la BASE: .h1-line--result pasa a flex con
   align-items:flex-end y min-height fija al tope, así el cambio de tamaño
   entre palabras crece/encoge hacia ARRIBA sin mover la barra lima ni el
   resto del layout. En mobile (<720px) NO se activa — el beneficio wrappea
   por alto ahí, no por ancho, y usa tamaño fijo (54-72px) sin JS. */
@media (min-width: 720px) {
  .h1-line--result {
    display: flex;
    align-items: flex-end;
    /* Beneficio ANCLADO A LA DERECHA (decisión William 2026-08-04): las
       palabras del ciclo tienen anchos muy distintos ("VERSE MEJOR." llena,
       "CRECER." no). Con el beneficio a la izquierda, las cortas dejaban un
       hueco a la DERECHA que reintroducía el "vacío desktop" que motivó todo
       el rediseño. Anclado a la derecha, el aire de las palabras cortas queda
       a la IZQUIERDA, bajo el conector sangrado — se lee como escalón editorial
       (diagonal: tesis ancho → conector sangrado izq → beneficio der), no como
       hueco. La barra lima (hija de .h1-cycle-wrap, width:100% del wrap) sigue
       a la palabra automáticamente. Solo tablet+desktop; mobile (<720px) queda
       a la izquierda porque ahí el beneficio wrappea a 2 líneas y domina por alto. */
    justify-content: flex-end;
    /* min-height = line-height heredado de .hero-h1 (1.02, tablet) — em
       relativo al font-size del propio elemento (el tope). Desktop pisa
       este valor a 0.92em porque ahí .h1-line--result declara line-height
       propio (0.92) — ver media query 1280px. */
    min-height: 1.02em;
  }
  /* el JS aplica el font-size dinámico en .h1-cycle-wrap (no en .h1-cycle
     directamente) para que .h1-cycle-bar — hijo del wrap, no de .h1-cycle —
     herede el mismo em-context vía cascada normal. Si el font-size dinámico
     viviera solo en .h1-cycle, la barra (bottom/height en em) seguiría
     tomando el em del tope heredado de .h1-line--result, quedando gruesa/
     mal ubicada bajo palabras cortas. */
  .h1-cycle-wrap {
    transition: font-size 0.42s cubic-bezier(0.16, 1, 0.3, 1);
  }
}

/* ═══════════════════════════════════════════════════════════
   DESKTOP (1280px+) — el texto ocupa el ancho, mata el vacío.
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 1280px) {
  .hero {
    display: grid;
    grid-template-rows: auto 1fr auto;
    /* SIN align-content:start (fix 2026-08-04): empaquetaba las tres filas
       arriba y anulaba el 1fr — la fila del medio no se estiraba, la banda
       (CTA + capacidades) quedaba pegada al contenido y caía FUERA del
       viewport. El CTA, que es el botón que convierte, no se veía en desktop
       aunque sí en mobile y tablet. Con el 1fr activo la fila central absorbe
       el aire sobrante y empuja la banda al fondo, dentro de la pantalla. */
    /* SIN max-width en .hero (2026-08-12, reporte de William con captura).
       El tope de 1728px vivía acá, en el CONTENEDOR: el hero medía 1728px
       centrado y en un monitor más ancho quedaban ~131px a cada lado que
       pertenecían al body. Aunque el color de los dos fondos es el mismo
       (rgb(244,242,236) medido en ambos), el borde se percibía igual porque
       el hero es lo único de la página con ancho acotado — el resto de las
       secciones (manifesto, portfolio, services, contact, foot) ya iban a
       0→100% del viewport, así que el corte se leía como un recuadro.

       El tope pasa a los HIJOS (.hero-signature, .hero-frase, .hero-band):
       gobierna la COMPOSICIÓN —que es lo que hay que acotar para que la
       frase no se estire en ultrawide— mientras la superficie del hero llega
       a los bordes como todas las demás secciones. */
    /* height fijo: el hero es una portada, ocupa exactamente una pantalla.
       Sin esto el contenido vuelve a empujar la banda fuera. Se DESCUENTA
       --cookiebar-h: con height:100vh a secas el grid reparte sobre la altura
       completa y la banda cae bajo el banner aunque haya padding-bottom (el
       padding empuja hacia adentro pero el reparto ya ocurrió). Restándolo del
       alto, el grid resuelve sobre el espacio realmente disponible. */
    min-height: calc(100vh - var(--cookiebar-h, 0px));
    height: calc(100vh - var(--cookiebar-h, 0px));
    /* el padding-bottom de la regla base ya no debe sumar la barra: el alto la
       descuenta. Vuelve al espaciado normal. */
    padding-bottom: var(--space-l);
  }
  /* el grano/textura recupera full-bleed real: .hero ya no es 100% del
     viewport (tiene max-width:1728px centrado), así que el grain se libera
     del contenedor con el truco 100vw/-50vw. overflow-x:clip en .hero
     (heredado, ver regla base) contiene cualquier desborde horizontal.

     COSTURA LATERAL (corregido 2026-08-12, reporte de William con captura en
     un monitor de 2000px+): el grano salía a 100vw pero el FONDO del hero se
     quedaba en 1728px. Como el grano lleva mix-blend-mode: multiply, los
     ~136px de cada lado quedaban levemente MÁS OSCUROS que el centro y se
     leía un recuadro — no como decisión editorial, sino como si el sitio no
     hubiera terminado de cargar. Los dos fondos ya eran el mismo color
     (medido: rgb(244,242,236) en .hero y en body); el borde lo dibujaba el
     blend, no el color.

     Se arregla llevando el FONDO a full-bleed en vez de achicar el grano: el
     tope de 1728px sigue gobernando la COMPOSICIÓN (sin él la frase se
     estira y se pierde en ultrawide), pero la superficie pintada llega a los
     bordes y la costura desaparece. */
  /* El tope de composición, ahora en los hijos: cada bloque del hero se
     centra dentro de 1728px mientras el .hero llega a los bordes. */
  .hero-signature,
  .hero-frase,
  .hero-band {
    max-width: 1728px;
    margin-inline: auto;
    width: 100%;
  }

  /* El bloque que liberaba .hero-grain a 100vw se eliminó: el grano propio del
     hero está apagado (ver la regla base). El grano global de body::after ya
     es `position: fixed; inset: 0`, así que cubre el ancho completo solo. */

  .hero-frase {
    /* align-self:center, no start (fix 2026-08-04): con el 1fr activo la fila
       central tiene toda la altura sobrante — centrar el bloque-frase reparte
       el aire arriba y abajo en vez de acumular ~280px muertos bajo la firma. */
    align-self: center;
    /* El --space-l (64px) fijo de la regla base desbordaba la fila y empujaba
       la banda del CTA bajo la barra de cookies; pero margin-top:0 dejaba el
       titular chocando contra la firma. Un mínimo proporcional resuelve las
       dos: separa de la cabecera y cede cuando falta altura. */
    margin-top: clamp(8px, 1.6vh, 40px);
  }

  /* ── Márgenes que ceden (fix 2026-08-04) ──────────────────────────
     Medición a 1280×800: signature 43px + frase 541px + band 157px = 741px
     de contenido, MÁS 240px de márgenes fijos (112 + 64 + 64) = 981px en un
     viewport de 800. El grid no podía resolverlo porque los márgenes viven
     DENTRO de las filas: el 1fr no tiene nada que absorber. Se cambian por
     valores proporcionales a la altura real de pantalla, con tope bajo — así
     el aire se reparte en pantallas altas y se comprime en las bajas, y la
     banda con el CTA siempre entra. */
  .hero-signature {
    margin-top: clamp(28px, 4vh, 56px);
  }
  /* Subhead DEBAJO del bloque-frase, en su propia franja vertical (NO absolute
     a la altura del beneficio — eso lo solapaba con palabras largas del ciclo
     como "DESTACAR." que crecen hacia la izquierda, tapando el texto. Bug
     critic 2026-08-04). Acá el subhead nunca comparte banda horizontal con el
     beneficio: cada uno en su fila. El aire del interior de la diagonal (con
     palabras cortas) se lee como respiro del ciclo vivo, no como hueco.
     margin-top proporcional (no --space-l fijo): en pantallas bajas los 64px
     fijos empujaban la banda del CTA fuera del viewport. */
  .hero-subhead {
    max-width: 44ch;
    margin-top: clamp(20px, 3vh, 40px);
  }
  /* La banda vuelve a UNA fila en desktop (CTA izq / capacidades der). En
     column medía 157px de alto y era la causa principal de que el CTA cayera
     fuera en 1280×700 — el bloque de tablet ya la ponía en row, pero acá se
     reafirma junto al gap reducido. */
  .hero-band {
    margin-top: clamp(12px, 2vh, 40px);
    padding-top: clamp(12px, 2vh, 24px);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
  }
  .hero-band__caps {
    text-align: right;
  }

  /* Las tres líneas se atan al ANCHO y a la ALTURA del viewport (fix
     2026-08-04). Antes solo miraban vw: en una pantalla baja (1280×700, laptop
     con barra de tareas) el titular conservaba su tamaño de 1280×800 y la
     banda con el CTA volvía a caer fuera. Con min(vw, vh) el bloque-frase cede
     cuando falta altura y el CTA entra en todos los casos. */
  .h1-line--result {
    /* clamp(...) = el TOPE del dinámico: font-size calibrado para que la
       palabra MÁS LARGA del ciclo ("VERSE MEJOR.") ocupe ~90% del ancho
       útil. El JS escala .h1-cycle hacia abajo desde acá para las palabras
       más cortas, nunca lo supera. */
    font-size: clamp(4.5rem, min(13vw, 21vh), 15rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    min-height: 0.92em; /* pisa el 1.02em del bloque 720px — line-height propio de este breakpoint */
  }
  .h1-line--thesis {
    font-size: clamp(3rem, min(8vw, 13vh), 9.3rem);
    line-height: 1.0;
    letter-spacing: -0.025em;
  }
  .h1-line--connector {
    font-size: clamp(1.8rem, min(4.4vw, 7vh), 5.1rem);
    text-indent: 8%;
    letter-spacing: 0;
  }
  .h1-cycle-bar {
    height: 0.10em;
  }

  /* Hover CTA (desktop): la flecha se desplaza 3px además del fondo lima
     que ya aplica en todos los tamaños. */
  .hero-cta:hover span,
  .hero-cta:focus-visible span {
    transform: translateX(3px);
  }
}
</style>

<script>
  /**
   * Animación GSAP del hero — portada de dossier.
   *
   * PROGRESSIVE ENHANCEMENT: todo el hero es HTML/CSS visible por defecto.
   * Si este script falla, el hero se ve completo estático. Nunca invisible.
   *
   * Secuencia:
   * 1. Barra de firma (fade)
   * 2. H1 reveal: tesis (split, stagger) + conector + beneficio (fade+slide)
   * 3. Barra marcadora lima: wipe (scaleX 0→1) sincronizado con el beneficio
   * 4. Subhead + banda inferior (fade)
   *
   * EL GESTO: el beneficio en tinta cicla (VERSE MEJOR → VENDER MÁS → …) y la
   * barra lima se re-dimensiona al ancho de cada palabra — es el elemento
   * vivo del hero. Ligero (textContent + fade + transform), no toca CWV.
   * REDUCED-MOTION: todo estático visible, sin ciclo, barra ya dibujada al
   * ancho de cycle[0] vía CSS (width:100%).
   */

  import { gsap } from 'gsap';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isDesktop = window.matchMedia('(min-width: 1280px)').matches;
  /* Font-size dinámico por palabra: SOLO tablet (720px+) y desktop. En
     mobile el beneficio domina por ALTO (wrappea a 2 líneas), no por ancho
     — se queda con el tamaño fijo de la spec mobile (54-72px), sin JS. */
  const fluidWidthActive = window.matchMedia('(min-width: 720px)').matches;

  /* Mide la ÚLTIMA línea renderizada de .h1-cycle y devuelve su posición
     relativa a .h1-cycle-wrap (el contenedor position:relative de la barra).
     getClientRects() da un DOMRect por línea de texto — cuando el beneficio
     wrappea (mobile, a veces tablet), el bounding box completo del span
     daría el ancho de la línea MÁS LARGA y la posición de la PRIMERA línea:
     mal para una barra que debe quedar bajo la última. Tomamos el último
     rect explícitamente. */
  const measureLastLineRect = (cycleEl: HTMLElement, wrapEl: HTMLElement): { left: number; width: number } => {
    const rects = cycleEl.getClientRects();
    const lastRect = rects.length > 0 ? rects[rects.length - 1] : cycleEl.getBoundingClientRect();
    const wrapRect = wrapEl.getBoundingClientRect();
    return { left: lastRect.left - wrapRect.left, width: lastRect.width };
  };

  /* ── Font-size dinámico por palabra (tablet/desktop) ──
     Calcula, para cada palabra del ciclo, el font-size que la acerca a
     TARGET_RATIO (90%) del ancho útil, con TOPE = el font-size que ya trae
     .h1-line--result por CSS (calibrado para que la palabra MÁS LARGA del
     ciclo ocupe ~90%). Las palabras más cortas escalan hacia ese tope sin
     pasarlo nunca — measured width crece linealmente con font-size, así que
     scale = targetWidth / widthAtTope da el tamaño exacto en una sola
     medición (sin iterar). Usa un medidor oculto (misma fuente/tracking)
     para no tocar el DOM visible mientras mide. */
  const TARGET_RATIO = 0.9;
  const computeWordFontSizes = (
    words: string[],
    cycleEl: HTMLElement,
    heroFrase: HTMLElement
  ): number[] => {
    const topFontSizePx = parseFloat(getComputedStyle(cycleEl).fontSize);
    const usefulWidth = heroFrase.getBoundingClientRect().width;
    const targetWidth = usefulWidth * TARGET_RATIO;

    /* medidor oculto: mismo font-family/weight/letter-spacing que .h1-cycle,
       fuera de flujo (position:fixed, visibility:hidden) para no causar
       reflow visible ni afectar el layout real mientras mide. */
    const measurer = document.createElement('span');
    const cs = getComputedStyle(cycleEl);
    measurer.style.position = 'fixed';
    measurer.style.visibility = 'hidden';
    measurer.style.left = '-9999px';
    measurer.style.top = '0';
    measurer.style.whiteSpace = 'nowrap';
    measurer.style.fontFamily = cs.fontFamily;
    measurer.style.fontWeight = cs.fontWeight;
    measurer.style.fontStyle = cs.fontStyle;
    measurer.style.letterSpacing = cs.letterSpacing;
    measurer.style.fontSize = `${topFontSizePx}px`;
    document.body.appendChild(measurer);

    const sizes = words.map((word) => {
      measurer.textContent = word;
      const widthAtTop = measurer.getBoundingClientRect().width;
      if (widthAtTop <= 0) return topFontSizePx;
      const scale = Math.min(1, targetWidth / widthAtTop);
      return topFontSizePx * scale;
    });

    document.body.removeChild(measurer);
    return sizes;
  };

  if (!reducedMotion) {
    /* ── Word-split del H1 ──
       Envuelve cada palabra en clip>inner para el reveal escalonado. La
       palabra ciclante (.h1-cycle) se EXCLUYE del split: su textContent debe
       quedar intacto para que el ciclado JS lo reemplace. Igual entra en el
       reveal, como bloque completo. */
    const heroH1 = document.querySelector<HTMLElement>('.hero-h1');
    let wordInners: HTMLElement[] = [];

    if (heroH1) {
      try {
        const wordSpans = heroH1.querySelectorAll<HTMLElement>('.h1-word:not(.h1-cycle)');
        wordSpans.forEach((wordEl) => {
          const text = wordEl.textContent ?? '';
          const isPlus = wordEl.classList.contains('h1-word--plus');

          const clip = document.createElement('span');
          clip.className = 'word-clip';

          const inner = document.createElement('span');
          inner.className = 'word-inner';
          if (isPlus) inner.classList.add('h1-word--plus');
          inner.textContent = text;

          clip.appendChild(inner);
          wordEl.replaceWith(clip);
          wordInners.push(inner);
        });
      } catch (_) {
        wordInners = [];
      }
    }

    /* la palabra ciclante entra al reveal como bloque entero (sin split) */
    const cycleEl = heroH1?.querySelector<HTMLElement>('.h1-cycle') ?? null;
    const cycleBar = heroH1?.querySelector<HTMLElement>('.h1-cycle-bar') ?? null;
    const cycleWrap = heroH1?.querySelector<HTMLElement>('.h1-cycle-wrap') ?? null;
    const heroFrase = document.querySelector<HTMLElement>('.hero-frase');

    /* ── Referencias DOM ── */
    const signature = document.querySelector<HTMLElement>('.hero-signature');
    const heroSubhead = document.querySelector<HTMLElement>('.hero-subhead');
    const heroBand = document.querySelector<HTMLElement>('.hero-band');

    /* ── Estados iniciales ── */
    gsap.set(signature, { opacity: 0 });
    gsap.set(heroSubhead, { opacity: 0 });
    gsap.set(heroBand, { opacity: 0 });

    /* Reveal sin máscara: fade + slide corto (no yPercent:110 tras un clip,
       que exponía/recortaba diacríticos). Sobrio y a prueba de tildes. */
    if (wordInners.length > 0) gsap.set(wordInners, { opacity: 0, yPercent: 40 });
    if (cycleEl) gsap.set(cycleEl, { opacity: 0, yPercent: 40 });
    /* la barra arranca colapsada — el wipe la revela al final del reveal */
    if (cycleBar) gsap.set(cycleBar, { scaleX: 0 });

    /* ── Timeline principal ── */
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });

    tl.to(signature, { opacity: 1, duration: 0.6 });

    /* Desktop (≥1280px): stagger/duration más marcados — la tesis ocupa
       mucho más ancho ahí y el reveal palabra-por-palabra se nota más. */
    const thesisStagger = isDesktop ? 0.09 : 0.07;
    const resultDuration = isDesktop ? 0.95 : 0.85;

    if (wordInners.length > 0) {
      tl.to(wordInners, { opacity: 1, yPercent: 0, duration: 0.85, stagger: thesisStagger }, '-=0.3');
    }
    if (cycleEl) {
      tl.to(cycleEl, { opacity: 1, yPercent: 0, duration: resultDuration }, '<+0.15');
    }
    /* wipe de la barra, izq→der, al final del reveal del beneficio */
    if (cycleBar) {
      tl.to(cycleBar, { scaleX: 1, duration: 0.5, ease: 'power3.out' }, '-=0.35');
    }

    tl.to(heroSubhead, { opacity: 1, duration: 0.7 }, '-=0.15');
    tl.to(heroBand, { opacity: 1, duration: 0.6 }, '<+0.1');

    /* ── EL GESTO: el beneficio CICLA y la barra lima se re-dimensiona ──
       "VERSE MEJOR." → "VENDER MÁS." → "CRECER." → "DESTACAR."
       Demuestra el resultado real de negocio en vez de solo nombrarlo. La
       barra lima acompaña como un resaltador que se ajusta al ancho de cada
       palabra: colapsa (scaleX→0) y vuelve a crecer al ancho nuevo.
       document.fonts.ready asegura que la medición de ancho no se haga con
       la fuente fallback (FOUT) antes de que cargue PP Editorial New. */
    if (cycleEl && cycleWrap) {
      let words: string[] = [];
      try {
        words = JSON.parse(cycleEl.dataset.cycle ?? '[]');
      } catch (_) {
        words = [];
      }
      if (words.length > 1) {
        let idx = 0;
        const HOLD = 1900; // ms que cada palabra queda quieta
        /* tamaños precalculados por palabra (tablet/desktop). null en mobile
           — ahí el font-size queda fijo por CSS (54-72px), sin dinámico. */
        let wordFontSizes: number[] | null = null;

        /* posiciona la barra bajo la ÚLTIMA línea del beneficio (left+width,
           no solo width) — necesario en 2 líneas (mobile, a veces tablet). */
        const resizeBar = () => {
          if (!cycleBar || !cycleEl || !cycleWrap) return;
          const { left, width } = measureLastLineRect(cycleEl, cycleWrap);
          gsap.set(cycleBar, { left, width });
        };

        const cycleNext = () => {
          idx = (idx + 1) % words.length;
          gsap.to(cycleEl, {
            opacity: 0,
            yPercent: -18,
            duration: 0.3,
            ease: 'power2.in',
          });
          if (cycleBar) {
            gsap.to(cycleBar, { scaleX: 0, duration: 0.25, ease: 'power2.in', transformOrigin: 'right center' });
          }
          gsap.delayedCall(0.3, () => {
            if (!cycleEl) return;
            cycleEl.textContent = words[idx];
            gsap.fromTo(
              cycleEl,
              { opacity: 0, yPercent: 22 },
              { opacity: 1, yPercent: 0, duration: 0.42, ease: 'expo.out' }
            );
            /* Font-size dinámico (tablet/desktop): anima .h1-cycle-wrap al
               tamaño precalculado de esta palabra, EN PARALELO con el fade+
               slide (misma duración 0.42s) — no como salto separado. Anclado
               por flex-end en .h1-line--result (CSS), así el cambio de
               tamaño crece/encoge hacia ARRIBA sin mover la barra ni el
               resto del layout. */
            if (cycleWrap && wordFontSizes && wordFontSizes[idx] != null) {
              gsap.to(cycleWrap, {
                fontSize: wordFontSizes[idx],
                duration: 0.42,
                ease: 'expo.out',
                onComplete: () => {
                  /* remide la barra recién cuando el font-size llegó a su
                     valor final — getClientRects() sobre el tamaño real. */
                  if (cycleBar && cycleEl && cycleWrap) {
                    const { left, width } = measureLastLineRect(cycleEl, cycleWrap);
                    gsap.set(cycleBar, { transformOrigin: 'left center', left, width });
                    gsap.fromTo(cycleBar, { scaleX: 0 }, { scaleX: 1, duration: 0.4, ease: 'power3.out', delay: 0.08 });
                  }
                },
              });
              return;
            }
            /* mobile (sin dinámico): la barra se remide de inmediato, tal
               como antes. */
            if (cycleBar && cycleWrap) {
              const { left, width } = measureLastLineRect(cycleEl, cycleWrap);
              gsap.set(cycleBar, { transformOrigin: 'left center', left, width });
              gsap.fromTo(cycleBar, { scaleX: 0 }, { scaleX: 1, duration: 0.4, ease: 'power3.out', delay: 0.08 });
            }
          });
        };

        /* espera a que la fuente display esté lista antes de la primera
           medición — evita que la barra (y los font-sizes dinámicos) se
           calculen con la fuente fallback (FOUT) antes de que cargue PP
           Editorial New. */
        document.fonts.ready
          .then(() => {
            if (fluidWidthActive && cycleEl && cycleWrap && heroFrase) {
              wordFontSizes = computeWordFontSizes(words, cycleEl, heroFrase);
              /* aplica el tamaño de cycle[0] (ya visible) sin animación —
                 es el estado inicial, no una transición. */
              gsap.set(cycleWrap, { fontSize: wordFontSizes[0] });
            }
            resizeBar();
          })
          .catch(() => {
            resizeBar();
          });

        /* ── Timer del ciclo ──────────────────────────────────────────────
           BUG ARREGLADO 2026-08-06 (William: "las letras del hero no rotan"):
           el visibilitychange creaba un setInterval NUEVO en cada vuelta a la
           pestaña SIN garantizar que el anterior estuviera limpio. En iOS,
           bloquear/desbloquear el teléfono dispara visibilitychange cada vez:
           a los pocos ciclos había N intervalos corriendo sobre el mismo
           elemento, cada uno avanzando `idx` por su cuenta. El efecto visible
           es que las palabras saltan, parpadean o parecen congelarse — no que
           "no hay animación", sino que hay varias peleándose.
           Ahora: un único timer, con `start` idempotente (no arranca si ya
           hay uno) y `stop` que además anula la referencia. */
        let timer: number | null = null;
        const startCycle = () => {
          if (timer !== null) return; /* idempotente: nunca dos a la vez */
          timer = window.setInterval(cycleNext, HOLD + 720);
        };
        const stopCycle = () => {
          if (timer === null) return;
          window.clearInterval(timer);
          timer = null;
        };

        /* arranca solo si la pestaña está visible: si el usuario abrió el sitio
           en una pestaña de fondo, el ciclo espera a que la mire de verdad. */
        if (!document.hidden) startCycle();

        document.addEventListener('visibilitychange', () => {
          if (document.hidden) stopCycle();
          else startCycle();
        });

        /* pagehide: iOS mete la página en bfcache al cambiar de app. Sin esto
           el intervalo sigue vivo en una página congelada y al volver se suma
           al que crea visibilitychange. */
        window.addEventListener('pagehide', stopCycle);
        window.addEventListener('pageshow', () => {
          if (!document.hidden) startCycle();
        });

        /* re-mide la barra (y recalcula los font-sizes dinámicos, porque el
           ancho útil cambió) si el viewport cambia de tamaño (resize/rotate
           entre tablet/desktop). En mobile sigue sin dinámico. */
        window.addEventListener(
          'resize',
          () => {
            const stillFluid = window.matchMedia('(min-width: 720px)').matches;
            if (stillFluid && cycleEl && cycleWrap && heroFrase) {
              wordFontSizes = computeWordFontSizes(words, cycleEl, heroFrase);
              gsap.set(cycleWrap, { fontSize: wordFontSizes[idx] });
            }
            if (cycleBar && cycleEl && cycleWrap) {
              const { left, width } = measureLastLineRect(cycleEl, cycleWrap);
              gsap.set(cycleBar, { transformOrigin: 'left center', left, width });
            }
          },
          { passive: true }
        );
      }
    }
  } else {
    /* ── reduced-motion: todo visible de inmediato, sin ciclo, MISMO tamaño
       grande del beneficio (reduced-motion no implica versión chica). Sin
       CAMBIOS de tamaño dinámicos (no hay ciclo, no hay para qué animar) —
       pero cycle[0] SÍ toma su tamaño calculado (tablet/desktop) una única
       vez y queda estático ahí, igual que el resto del sistema. La barra se
       mide bajo la última línea igual que en el modo animado — cycle[0]
       puede wrappear a 2 líneas en mobile angosto. ── */
    const allAnimated = document.querySelectorAll<HTMLElement>(
      '.hero-signature, .hero-subhead, .hero-band'
    );
    gsap.set(allAnimated, { opacity: 1 });

    const cycleElStatic = document.querySelector<HTMLElement>('.h1-cycle');
    const cycleBarStatic = document.querySelector<HTMLElement>('.h1-cycle-bar');
    const cycleWrapStatic = document.querySelector<HTMLElement>('.h1-cycle-wrap');
    const heroFraseStatic = document.querySelector<HTMLElement>('.hero-frase');
    if (cycleElStatic && cycleBarStatic && cycleWrapStatic) {
      const setStaticBar = () => {
        if (fluidWidthActive && heroFraseStatic) {
          let wordsStatic: string[] = [];
          try {
            wordsStatic = JSON.parse(cycleElStatic.dataset.cycle ?? '[]');
          } catch (_) {
            wordsStatic = [];
          }
          if (wordsStatic.length > 0) {
            const sizes = computeWordFontSizes(wordsStatic, cycleElStatic, heroFraseStatic);
            gsap.set(cycleWrapStatic, { fontSize: sizes[0] });
          }
        }
        const { left, width } = measureLastLineRect(cycleElStatic, cycleWrapStatic);
        gsap.set(cycleBarStatic, { left, width, scaleX: 1 });
      };
      document.fonts.ready.then(setStaticBar).catch(setStaticBar);
    }
  }
</script>
