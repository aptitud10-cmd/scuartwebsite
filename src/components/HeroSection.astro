---
/**
 * HeroSection.astro — Seccion hero compartida entre /en y /es
 * Recibe las traducciones como prop — el markup HTML es identico en ambos idiomas.
 * Esto garantiza DRY sin duplicar el HTML del hero (P6).
 *
 * Basado en DIRECCION_B_v2_REFINADA.md + DESIGN_RESPONSIVE.md §3/§4/§7/§13.
 * Design Gate: APPROVED_WITH_MINOR_FIXES (visual-critic Etapa A).
 *
 * PROGRESSIVE ENHANCEMENT (fix iter.5):
 * El H1 es HTML real, visible por defecto. GSAP es enhancement no-bloqueante.
 * Eliminada la isla React HeroGSAP — el word-reveal lo maneja el script GSAP
 * de este mismo archivo operando sobre el texto ya presente en el DOM.
 */

import type { Translations } from '../i18n/en';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

/* Construir el texto plano de cada linea para el aria-label (ya existia) */
---

<!--
  HERO — §3 DESIGN_RESPONSIVE
  Estructura responsive mobile-first:
  - mobile 375: min-height 100svh, H1 anclado ~42%, indice mono arriba, lomo-cuaderno
  - tablet 768: 6 col, indice arriba derecha, subhead col 1-4
  - desktop 1280: 12 col, H1 col 1-8, franja roja col 9, indice col 9-12
-->
<section class="hero" aria-label="Seccion principal">

  <!--
    Grilla editorial (§4): lineas verticales 1px crema 7%
    col 3/6/9 desktop. En mobile se ocultan — el lomo-cuaderno las reemplaza.
    Sin transform inicial en CSS — GSAP lo maneja completamente.
  -->
  <div class="grid-lines" aria-hidden="true">
    <div class="grid-line" data-col="3"></div>
    <div class="grid-line" data-col="6"></div>
    <div class="grid-line" data-col="9"></div>
  </div>

  <!-- Lomo-cuaderno: solo mobile (§4 §12) — linea a izquierda del viewport -->
  <div class="hero-notebook-spine" aria-hidden="true"></div>

  <!-- Franja roja: col 9 desktop / regla horizontal mobile (§7) -->
  <!-- Instancia 1 del presupuesto rojo (max 4) -->
  <div class="hero-red-bar" aria-hidden="true"></div>

  <!--
    Indice mono — clamp(88px, 14vh, 120px) desde top
    §3: "indice mono arriba a clamp(88px,14vh,120px)"
    §5: IBM Plex Mono 11-13px uppercase tracking +0.04em
  -->
  <p class="hero-index">
    {t.hero.index}
  </p>

  <!--
    Meta columna derecha — SOLO DESKTOP (col 10-12)
    §5 + §7: "ficha tecnica de estudio" en mono taupe.
    Acompana la franja roja vertical y da estructura editorial a la columna derecha.
    Info complementaria al indice arriba — sin duplicar "SCUART / ESTUDIO DE DISENO".
    NO se muestra en mobile ni tablet.
  -->
  <aside class="hero-meta" aria-hidden="true">
    <span class="hero-meta__number">{t.meta_col.number}</span>
    <span class="hero-meta__label">{t.meta_col.label}</span>
    <span class="hero-meta__divider"></span>
    <span class="hero-meta__coords">{t.meta_col.coords}</span>
    <span class="hero-meta__type">{t.meta_col.type}</span>
  </aside>

  <!--
    H1 — texto real server-rendered, visible por defecto (progressive enhancement).
    §3: H1 anclado ~42% desde arriba, 2 lineas fijas, leading 0.92, tracking -0.025em
    §11 anti-overflow: hyphens manual + overflow-wrap anywhere.

    PROGRESSIVE ENHANCEMENT (fix iter.5):
    - El texto existe en el HTML estatico: indexable, accesible, visible sin JS.
    - Palabras rojas marcadas con .h1-word--rojo (color rojo en CSS por defecto).
    - El script GSAP de abajo envuelve cada .h1-word en .word-clip/.word para
      el word-reveal — si el script falla, el texto plano ya es visible.
    - Sin aria-hidden (es el h1 real del documento).
  -->
  <h1 class="hero-h1">
    <!-- Linea 1: palabras como spans individuales para el word-reveal GSAP -->
    <span class="h1-line" data-line="1">
      {t.hero.line1.map((token, i) => (
        <>
          {i > 0 && <span class="h1-space" aria-hidden="true"> </span>}
          <span class={`h1-word${token.isRed ? ' h1-word--rojo' : ''}`}>{token.word}</span>
        </>
      ))}
    </span>
    <!-- Linea 2 -->
    <span class="h1-line" data-line="2">
      {t.hero.line2.map((token, i) => (
        <>
          {i > 0 && <span class="h1-space" aria-hidden="true"> </span>}
          <span class={`h1-word${token.isRed ? ' h1-word--rojo' : ''}`}>{token.word}</span>
        </>
      ))}
    </span>
  </h1>

  <!--
    Subhead-filtro — DM Sans (->Messina futuro), taupe, leading 1.5
    §3: "subhead margin-top --space-l"
    Col 1-6 desktop.
  -->
  <p class="hero-subhead">
    {t.hero.subhead}
  </p>

</section>

<style>
/* ═══════════════════════════════════════════════════════════
   HERO
   ═══════════════════════════════════════════════════════════ */

.hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  padding-left: var(--margin);
  padding-right: var(--margin);
  padding-bottom: var(--space-2xl);
  /* Anti-overflow mobile §11 */
  max-width: 100%;
  overflow-x: clip;
}

/* ─── GRILLA EDITORIAL (§4) ──────────────────────────────── */

.grid-lines {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.grid-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 1px;
  background-color: var(--linea);
  /* Sin transform aqui — GSAP maneja el estado inicial */
  opacity: 0; /* GSAP lo revela */
}

/* Col 3 (≈ primer cuarto del interior) */
.grid-line[data-col="3"] {
  left: 25%;
  display: none;
}

/* Col 6 (≈ mitad) */
.grid-line[data-col="6"] {
  left: 50%;
  display: none;
}

/* Col 9 (≈ tercer cuarto) — franja roja en mismo eje */
.grid-line[data-col="9"] {
  left: 75%;
  display: none;
}

/* ─── LOMO-CUADERNO mobile (§4 §12) ─────────────────────── */
/*
 * Linea vertical crema 7% a 20px del borde izquierdo del viewport.
 * Solo mobile — en tablet+ desaparece (las col lines toman su rol).
 * "Margen de cuaderno" que ancla todo el contenido.
 */
.hero-notebook-spine {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 20px;
  width: 1px;
  background-color: var(--linea);
  pointer-events: none;
  z-index: 1;
  opacity: 0; /* GSAP revela */
  display: block;
}

/* ─── FRANJA ROJA (§7) ──────────────────────────────────── */
/*
 * Mobile: regla horizontal 2px, ~33% de ancho, anclada a izquierda,
 *         bajo el H1 hero (instancia de rojo).
 * Desktop: franja vertical 2px sobre eje col 9 (misma X que la grid-line),
 *          tramo alineado al H1 (no recorre toda la pagina).
 */
.hero-red-bar {
  position: absolute;
  background-color: var(--rojo);
  pointer-events: none;
  z-index: 2;
  opacity: 0; /* GSAP revela */

  /* Mobile: regla horizontal */
  /*
   * iter.4: cambiado de top:62%/68% a bottom-anchored.
   * Anclar desde abajo: queda sobre el subhead, debajo del H1.
   * bottom: ~28% = espacio para subhead (~4 lineas) + padding bottom.
   * Con min-height 100svh = 812px, bottom 28% ≈ 227px desde abajo.
   */
  left: 0;
  width: 33%;
  height: 2px;
  top: auto;
  /* iter.4: bottom 22% ≈ 179px desde abajo — debajo del H1, encima del subhead */
  bottom: 22%;
  transform-origin: left center;
}

/* ─── INDICE MONO (§3) ──────────────────────────────────── */
.hero-index {
  position: relative;
  z-index: 2;
  font-family: var(--font-mono);
  font-size: var(--text-mono);
  font-weight: 400;
  color: var(--taupe);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  line-height: 1.4;
  /* §3: clamp(88px, 14vh, 120px) desde top */
  margin-top: clamp(88px, 14vh, 120px);
  margin-bottom: auto; /* flex: empuja H1 hacia el 42% desde arriba */
  flex-shrink: 0;
  opacity: 0; /* GSAP revela */
}

/* ─── H1 (§3 §5) ────────────────────────────────────────── */
/*
 * Archivo variable wght 900 wdth 110 (rango aprobado 105-115).
 * Mobile wdth reducido a 95 para que entre mejor en 375px (iter.4: 100→95).
 * Leading 0.92, tracking -0.025em, 2 lineas fijas.
 * text-wrap balance: favorece agrupamiento 2-por-linea vs 1-por-linea.
 * Anti-overflow: hyphens + overflow-wrap.
 */
.hero-h1 {
  position: relative;
  z-index: 2;
  font-family: var(--font-display);
  font-weight: var(--display-weight-heavy);
  font-size: var(--text-h1);
  line-height: 0.92;
  letter-spacing: -0.025em;
  color: var(--crema);
  /* wdth mobile: 95 (iter.4: mas estrecho para que 2 palabras entren por linea) */
  font-variation-settings: 'wdth' 95;
  text-wrap: balance;
  hyphens: manual;
  overflow-wrap: anywhere;
  flex-shrink: 0;
  margin-bottom: 0;
  /* Aire adicional entre H1 y subhead — iter.4 */
  margin-top: 0;
}

/* Lineas del H1 — bloque para que cada linea ocupe su propia fila */
.h1-line {
  display: block;
}

/* Cada palabra — inline-block por defecto, visible sin JS */
.h1-word {
  display: inline-block;
}

/* Palabras rojas: color rojo visible en CSS sin JS (progressive enhancement) */
.h1-word--rojo {
  color: var(--rojo);
}

/* Espacio entre palabras */
.h1-space {
  display: inline;
}

/*
 * Cuando el script GSAP confirma que va a animar (.hero-h1.will-animate),
 * los .h1-word son envueltos en .word-clip por el script — en ese momento
 * el overflow:hidden del .word-clip clipea el word-inner durante el yPercent.
 * El estado initial de yPercent lo setea GSAP (no CSS) para evitar flash.
 */
:global(.word-clip) {
  display: inline-block;
  overflow: hidden;
  vertical-align: bottom;
  padding-bottom: 0.05em;
  margin-bottom: -0.05em;
}

:global(.word-inner) {
  display: inline-block;
}

/* ─── SUBHEAD-FILTRO (§3 §5) ────────────────────────────── */
.hero-subhead {
  position: relative;
  z-index: 2;
  font-family: var(--font-body);
  font-size: var(--text-subhead);
  font-weight: 400;
  color: var(--taupe);
  line-height: 1.5;
  letter-spacing: 0;
  /* iter.4: mas aire H1→subhead en mobile (space-l→space-xl) */
  margin-top: var(--space-xl);
  max-width: 38ch;
  flex-shrink: 0;
  opacity: 0; /* GSAP revela */
}

/* ═══════════════════════════════════════════════════════════
   TABLET (768px+)
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 768px) {
  .hero {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: auto 1fr auto;
    column-gap: var(--gutter);
    align-items: start;
  }

  /* Lomo solo mobile */
  .hero-notebook-spine {
    display: none;
  }

  /* Col 6 visible en tablet */
  .grid-line[data-col="6"] {
    display: block;
  }

  .hero-index {
    grid-column: 1 / 7;
    text-align: right;
    margin-bottom: 0;
  }

  .hero-h1 {
    grid-column: 1 / 7;
    align-self: center;
    /* wdth tablet: 105 (iter.4: ligeramente expandido vs mobile 95) */
    font-variation-settings: 'wdth' 105;
    /* iter.4: balance ayuda a que 2 palabras agrupen por linea en 768 */
    text-wrap: balance;
    hyphens: none;
    overflow-wrap: normal;
  }

  .hero-subhead {
    grid-column: 1 / 5;
    max-width: none;
    /* iter.4: restituir space-l en tablet (el space-xl es solo mobile) */
    margin-top: var(--space-l);
  }

  /*
   * Franja roja tablet (§7): col 6 encendida, vertical.
   * iter.4: cambiado de left:50% (cruzaba el texto H1) a col 5/6 borde
   * = calc(margin + (100% - 2*margin) * 5/6) ≈ 81% del viewport a 768px.
   * Queda despues del texto, intencional al margen derecho.
   * Tramo acortado: top 25% → bottom 15% (solo acompana el H1, no sangra).
   */
  .hero-red-bar {
    left: calc(var(--margin) + (100% - 2 * var(--margin)) * 0.833);
    width: 2px;
    height: auto;
    top: 25%;
    bottom: 15%;
    transform-origin: top center;
  }
}

/* ─── META COLUMNA DERECHA (solo desktop) ──────────────────── */
.hero-meta {
  display: none; /* oculto mobile/tablet */
}

/* ═══════════════════════════════════════════════════════════
   DESKTOP (1280px+)
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 1280px) {
  .hero {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    min-height: 100svh;
  }

  /* Col 3/6/9 visibles */
  .grid-line[data-col="3"],
  .grid-line[data-col="6"],
  .grid-line[data-col="9"] {
    display: block;
  }

  .hero-index {
    grid-column: 9 / 13;
    text-align: left;
  }

  .hero-h1 {
    /* Col 1-8 alineacion izquierda dura (§3) */
    grid-column: 1 / 9;
    align-self: center;
    font-size: clamp(4rem, 5vw, 6rem);
    /* wdth desktop: 110 (rango aprobado 105-115) */
    font-variation-settings: 'wdth' 110;
    /* iter.4: anular balance mobile — desktop tiene composicion de texto controlada */
    text-wrap: unset;
    hyphens: none;
    overflow-wrap: normal;
  }

  .hero-subhead {
    grid-column: 1 / 7;
    max-width: 50ch;
  }

  /*
   * Franja roja desktop (§7): vertical 2px sobre eje col 9.
   * Col 9 = 75% del ancho interior del grid.
   */
  .hero-red-bar {
    left: calc(var(--margin) + (100% - 2 * var(--margin)) * 0.75);
    width: 2px;
    height: auto;
    top: 28%;
    bottom: 30%;
    transform-origin: top center;
  }

  /*
   * Meta columna derecha — visible solo desktop.
   * Col 9-12, apilada verticalmente.
   */
  .hero-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    grid-column: 10 / 13;
    align-self: center;
    position: relative;
    z-index: 2;
    opacity: 0; /* GSAP revela */
    padding-left: var(--gutter);
  }

  .hero-meta__number {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    font-weight: 400;
    color: var(--crema);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.4;
    opacity: 0.7;
  }

  .hero-meta__label,
  .hero-meta__coords,
  .hero-meta__type {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    font-weight: 400;
    color: var(--taupe);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  /* Linea divisoria 1px crema 9% entre N°/label y coordenadas */
  .hero-meta__divider {
    display: block;
    width: 100%;
    height: 1px;
    background-color: var(--linea);
    margin: 0.75rem 0;
  }

  .hero-meta__type {
    margin-top: 0.25rem;
    opacity: 0.7;
  }
}
</style>

<script>
  /**
   * Animacion GSAP del hero — SISTEMA UNIFICADO (fix iter.5).
   *
   * PROGRESSIVE ENHANCEMENT:
   * Todo el hero es HTML/CSS visible por defecto. Este script es enhancement.
   * Si falla: el hero se ve completo, sin animacion. Nunca invisible.
   *
   * Secuencia §13 DESIGN_RESPONSIVE:
   * 1. Lineas de grilla (scaleY 0→1, 1.1s expo.out)
   * 2. Indice mono fade-in
   * 3. H1 word-reveal (yPercent 110→0, stagger por palabra)
   * 4. Franja roja (scaleX/Y 0→1)
   * 5. Subhead + meta columna
   *
   * Word-reveal del H1: opera sobre .h1-word ya presentes en el DOM
   * (el texto existe como HTML real — no reemplazado por JS).
   * El script envuelve cada .h1-word en .word-clip + .word-inner para
   * el efecto de clip. Si el script no corre, los .h1-word son texto plano.
   */

  import { gsap } from 'gsap';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion) {
    /* ── Word-split del H1 (opera sobre texto ya en el DOM) ── */
    /*
     * Envuelve cada .h1-word en <span class="word-clip"><span class="word-inner">
     * para el efecto de reveal con yPercent. El texto original sigue presente.
     * Si este bloque lanza, el catch no interrumpe el resto de la animacion.
     */
    const heroH1 = document.querySelector<HTMLElement>('.hero-h1');
    let wordInners: HTMLElement[] = [];
    let wordInnersRojo: HTMLElement[] = [];

    if (heroH1) {
      try {
        const wordSpans = heroH1.querySelectorAll<HTMLElement>('.h1-word');
        wordSpans.forEach((wordEl) => {
          const isRojo = wordEl.classList.contains('h1-word--rojo');
          const text = wordEl.textContent ?? '';

          /* Crear la estructura: word-clip > word-inner */
          const clip = document.createElement('span');
          clip.className = 'word-clip';

          const inner = document.createElement('span');
          inner.className = isRojo ? 'word-inner word-inner--rojo' : 'word-inner';
          inner.textContent = text;

          clip.appendChild(inner);

          /* Reemplazar el .h1-word original con el clip */
          wordEl.replaceWith(clip);

          if (isRojo) {
            wordInnersRojo.push(inner);
          } else {
            wordInners.push(inner);
          }
        });
      } catch (_) {
        /* Si el word-split falla, el texto plano ya es visible — no pasa nada */
        wordInners = [];
        wordInnersRojo = [];
      }
    }

    /* ── Elementos del hero (sin H1 — se anima por separado) ── */
    const gridLines = document.querySelectorAll<HTMLElement>('.grid-line');
    const spine = document.querySelector<HTMLElement>('.hero-notebook-spine');
    const redBar = document.querySelector<HTMLElement>('.hero-red-bar');
    const heroIndex = document.querySelector<HTMLElement>('.hero-index');
    const heroSubhead = document.querySelector<HTMLElement>('.hero-subhead');
    const heroMeta = document.querySelector<HTMLElement>('.hero-meta');

    /* Estados iniciales — solo se setean SI el word-split funciono */
    gsap.set(gridLines, { opacity: 1, scaleY: 0, transformOrigin: 'top center' });
    if (spine) gsap.set(spine, { opacity: 1, scaleY: 0, transformOrigin: 'top center' });

    const isMobile = window.innerWidth < 768;
    if (isMobile) {
      gsap.set(redBar, { opacity: 1, scaleX: 0, transformOrigin: 'left center' });
    } else {
      gsap.set(redBar, { opacity: 1, scaleY: 0, transformOrigin: 'top center' });
    }

    gsap.set(heroIndex, { opacity: 0 });
    gsap.set(heroSubhead, { opacity: 0 });
    if (heroMeta) gsap.set(heroMeta, { opacity: 0 });

    /* Estado inicial de los word-inners (yPercent fuera del clip) */
    if (wordInners.length > 0) {
      gsap.set(wordInners, { yPercent: 110 });
    }
    if (wordInnersRojo.length > 0) {
      gsap.set(wordInnersRojo, { yPercent: 110 });
    }

    /* ── Timeline unificada ── */
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });

    /* 1. Grilla / lomo */
    /*
     * Bug fix iter.7: querySelector encuentra el elemento aunque tenga display:none.
     * En tablet/desktop el lomo tiene display:none (CSS) pero spine !== null,
     * haciendo que la rama del else (gridLines) nunca se ejecutara.
     * Fix: chequear visibilidad real con offsetParent en lugar de existencia del nodo.
     */
    const spineVisible = spine !== null && spine.offsetParent !== null;
    if (spineVisible) {
      tl.to(spine, { scaleY: 1, duration: 1.1 });
    } else {
      tl.to(gridLines, { scaleY: 1, duration: 1.1, stagger: 0.06 });
    }

    /* 2. Indice mono */
    tl.to(heroIndex, { opacity: 1, duration: 0.6 }, '-=0.5');

    /* 3. H1 word-reveal — linea 1 (no-rojo primero, rojo con delay) */
    if (wordInners.length > 0) {
      tl.to(wordInners, { yPercent: 0, duration: 0.85, stagger: 0.08 }, '-=0.2');
    }
    if (wordInnersRojo.length > 0) {
      /* Palabras rojas: 0.25s despues del inicio de la linea 1 */
      tl.to(wordInnersRojo, { yPercent: 0, duration: 0.85, stagger: 0.05 }, '<+0.25');
    }

    /* 4. Franja roja */
    if (isMobile) {
      tl.to(redBar, { scaleX: 1, duration: 0.6, ease: 'expo.out' }, '+=0.4');
    } else {
      tl.to(redBar, { scaleY: 1, duration: 0.8, ease: 'expo.out' }, '-=0.5');
    }

    /* 5. Subhead + meta */
    tl.to(heroSubhead, { opacity: 1, duration: 0.7 }, '+=0.1');
    if (heroMeta) {
      tl.to(heroMeta, { opacity: 1, duration: 0.6 }, '<+0.1');
    }

  } else {
    /* reduced-motion: todo visible de inmediato (sin animacion) */
    /* Los elementos con opacity:0 en CSS se fuerzan a 1 con GSAP (ya importado) */
    const allAnimated = document.querySelectorAll<HTMLElement>(
      '.grid-line, .hero-notebook-spine, .hero-red-bar, .hero-index, .hero-subhead, .hero-meta'
    );
    gsap.set(allAnimated, { opacity: 1 });

    const gridLinesRM = document.querySelectorAll<HTMLElement>('.grid-line');
    gsap.set(gridLinesRM, { scaleY: 1 });

    const spineRM = document.querySelector<HTMLElement>('.hero-notebook-spine');
    if (spineRM) gsap.set(spineRM, { scaleY: 1 });

    const redBarRM = document.querySelector<HTMLElement>('.hero-red-bar');
    if (redBarRM) gsap.set(redBarRM, { scaleX: 1, scaleY: 1 });
    /* El H1 es texto plano visible por defecto — no necesita set */
  }
</script>
