---
/**
 * HeroSection.astro — Hero Concepto B: "Design + Technology como sistema"
 * Aprobado por William (2026-06-07).
 *
 * Composicion:
 * - Kicker mono arriba-izquierda
 * - Headline 3 lineas: "DESIGN [+rojo] TECHNOLOGY / FOR BUSINESSES THAT NEED TO / LOOK SHARP AND WORK BETTER."
 * - El "+" es signo tipografico integrado al headline — mismo peso/tamaño, color --rojo
 * - Indice de capacidades 001-004 (col 9-12 desktop / lista debajo en mobile)
 * - Subhead DM Sans taupe col 1-6
 * - Franja roja: costura vertical 2px sobre col 9 (desktop/tablet) / horizontal (mobile)
 * - CTA "START A PROJECT →"
 *
 * PROGRESSIVE ENHANCEMENT:
 * El H1 es HTML real server-rendered, visible sin JS.
 * GSAP es enhancement no-bloqueante — si falla, hero visible completo.
 *
 * Presupuesto rojo: 2 instancias (el "+" + la franja costura). Maximo respetado.
 * meta_col: campo conservado en diccionario pero NO renderizado aqui
 *   (el indice de capacidades reemplaza su funcion).
 */

import type { Translations } from '../i18n/en';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<!--
  HERO — Concepto B
  Layout:
  - mobile 375: flex column, lomo-cuaderno, kicker → H1 → subhead → capacidades → CTA
  - tablet 768: grid 6 col, headline col 1-6, capacidades debajo subhead
  - desktop 1280: grid 12 col, headline col 1-8, capacidades col 9-12, subhead col 1-6, CTA col 1-3
-->
<section class="hero" aria-label={t.hero.ariaLabel}>

  <!--
    Grilla editorial: lineas verticales 1px crema 9%
    col 3/6/9 desktop. Mobile: ocultas (lomo-cuaderno las reemplaza).
    GSAP maneja el estado inicial (opacity 0) y la animacion de entrada.
  -->
  <div class="grid-lines" aria-hidden="true">
    <div class="grid-line" data-col="3"></div>
    <div class="grid-line" data-col="6"></div>
    <div class="grid-line" data-col="9"></div>
  </div>

  <!-- Lomo-cuaderno: solo mobile — linea vertical izquierda del viewport -->
  <div class="hero-notebook-spine" aria-hidden="true"></div>

  <!--
    Franja roja costura (instancia 2 del presupuesto rojo):
    - Desktop/tablet: vertical 2px sobre eje col 9, tramo alineado al bloque de contenido
    - Mobile: horizontal 2px, separa headline del indice de capacidades
  -->
  <div class="hero-red-bar" aria-hidden="true"></div>

  <!--
    Kicker — mono uppercase arriba-izquierda
    Fila 1 del grid en desktop. Plano en mobile/tablet (flujo normal).
  -->
  <p class="hero-kicker">
    {t.hero.kicker}
  </p>

  <!--
    H1 — texto real server-rendered, visible por defecto (progressive enhancement).
    3 lineas: DESIGN [+rojo] TECHNOLOGY / FOR BUSINESSES THAT NEED TO / LOOK SHARP AND WORK BETTER.
    El "+" tiene color --rojo via .h1-word--rojo (CSS, sin JS).
    GSAP envuelve cada .h1-word en .word-clip/.word-inner para el word-reveal.
    El "+" entra al final de line1 con animacion propia (scale + fade).
  -->
  <h1 class="hero-h1">
    <!-- Linea 1: DESIGN [+rojo] TECHNOLOGY -->
    <span class="h1-line" data-line="1">
      {t.hero.line1.map((token, i) => (
        <>
          {i > 0 && <span class="h1-space" aria-hidden="true"> </span>}
          <span
            class={`h1-word${token.isRed ? ' h1-word--rojo' : ''}${token.word === '+' ? ' h1-plus' : ''}`}
            data-plus={token.word === '+' ? 'true' : undefined}
          >{token.word}</span>
        </>
      ))}
    </span>
    <!-- Linea 2 -->
    <span class="h1-line" data-line="2">
      {t.hero.line2.map((token, i) => (
        <>
          {i > 0 && <span class="h1-space" aria-hidden="true"> </span>}
          <span class={`h1-word${token.isRed ? ' h1-word--rojo' : ''}`}>{token.word}</span>
        </>
      ))}
    </span>
    <!-- Linea 3 -->
    <span class="h1-line" data-line="3">
      {t.hero.line3.map((token, i) => (
        <>
          {i > 0 && <span class="h1-space" aria-hidden="true"> </span>}
          <span class={`h1-word${token.isRed ? ' h1-word--rojo' : ''}`}>{token.word}</span>
        </>
      ))}
    </span>
  </h1>

  <!--
    Subhead — DM Sans taupe col 1-6 desktop
  -->
  <p class="hero-subhead">
    {t.hero.subhead}
  </p>

  <!--
    CTA — "START A PROJECT →"
    Mono/display, presencia clara. Abajo-izquierda.
  -->
  <a class="hero-cta" href="#contact">
    {t.hero.cta} <span aria-hidden="true">→</span>
  </a>

  <!--
    Indice de capacidades 001-004.
    Desktop: col 9-12, alineado al bloque headline como documento editorial.
    Mobile/tablet: lista mono full-width debajo del subhead.
    Se lee como ficha tecnica de estudio, NO como lista de servicios con bullets.
  -->
  <ul class="hero-capabilities" aria-label="Capacidades del estudio">
    {t.hero.capabilities.map((item) => (
      <li class="hero-capabilities__item">
        <span class="hero-capabilities__num">{item.num}</span>
        <span class="hero-capabilities__sep" aria-hidden="true"> / </span>
        <span class="hero-capabilities__label">{item.label}</span>
      </li>
    ))}
  </ul>

</section>

<style>
/* ═══════════════════════════════════════════════════════════
   HERO — Concepto B
   Mobile-first: 375px base. md: 768px. lg: 1280px.
   ═══════════════════════════════════════════════════════════ */

.hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  padding-left: var(--margin);
  padding-right: var(--margin);
  padding-top: 0;
  padding-bottom: var(--space-2xl);
  max-width: 100%;
  overflow-x: clip;
}

/* ─── GRILLA EDITORIAL ───────────────────────────────────── */

.grid-lines {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.grid-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 1px;
  background-color: var(--linea);
  opacity: 0; /* GSAP revela */
}

.grid-line[data-col="3"] {
  left: 25%;
  display: none;
}

.grid-line[data-col="6"] {
  left: 50%;
  display: none;
}

.grid-line[data-col="9"] {
  left: 75%;
  display: none;
}

/* ─── LOMO-CUADERNO mobile ───────────────────────────────── */

.hero-notebook-spine {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 20px;
  width: 1px;
  background-color: var(--linea);
  pointer-events: none;
  z-index: 1;
  opacity: 0; /* GSAP revela */
  display: block;
}

/* ─── FRANJA ROJA — costura diseno/sistema ───────────────── */
/*
 * Mobile: regla horizontal 2px, full-width desde el margen,
 *         entre subhead y capacidades (JS la posiciona via clase .is-mobile).
 * Desktop/tablet: vertical 2px sobre eje col 9, tramo del bloque de contenido.
 * Instancia 2 del presupuesto rojo (max 2 aprobado).
 */
.hero-red-bar {
  position: absolute;
  background-color: var(--rojo);
  pointer-events: none;
  z-index: 2;
  opacity: 0; /* GSAP revela */

  /* Mobile: horizontal */
  left: var(--margin);
  right: var(--margin);
  height: 1px;
  width: auto;
  top: auto;
  bottom: auto;
  /* posicion mobile: entre capacidades y subhead — se setea dinamicamente en JS
     pero con fallback CSS para reduced-motion/no-JS */
}

/* ─── KICKER ─────────────────────────────────────────────── */

.hero-kicker {
  position: relative;
  z-index: 2;
  font-family: var(--font-mono);
  font-size: var(--text-mono);
  font-weight: 400;
  color: var(--taupe);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  line-height: 1.4;
  margin-top: clamp(88px, 14vh, 120px);
  margin-bottom: var(--space-m);
  flex-shrink: 0;
  opacity: 0; /* GSAP revela */
}

/* ─── H1 ─────────────────────────────────────────────────── */
/*
 * Archivo variable 900 wdth 95 mobile → 105 tablet → 110 desktop.
 * Leading 0.92, tracking -0.025em. 3 lineas fijas en desktop.
 * El "+" (.h1-plus) es inline, mismo tamaño/peso/baseline que el resto.
 * Color rojo aplicado via .h1-word--rojo (CSS, sin JS).
 */
.hero-h1 {
  position: relative;
  z-index: 2;
  font-family: var(--font-display);
  font-weight: var(--display-weight-heavy);
  /* Mobile: override del token global para que el copy largo no ocupe todo el viewport.
     El token --text-h1 (10.5vw preferred) fue calibrado para copy corto de 2 líneas.
     Con el copy nuevo de 3 líneas largas, bajamos el preferred a 6vw → ~22.5px en 375px.
     Esto da ~6-7 líneas y deja respirar subhead + CTA en el fold. */
  font-size: clamp(1.6rem, 6vw, 2.8rem);
  line-height: 0.92;
  letter-spacing: -0.025em;
  color: var(--crema);
  font-variation-settings: 'wdth' 95;
  hyphens: manual;
  overflow-wrap: anywhere;
  flex-shrink: 0;
  margin-bottom: 0;
  margin-top: 0;
}

.h1-line {
  display: block;
}

.h1-word {
  display: inline-block;
}

/* El "+" — mismo display/peso/tamaño que el resto, color rojo */
.h1-word--rojo {
  color: var(--rojo);
}

/*
 * .h1-plus: espaciado lateral leve para que respire como signo tipografico.
 * No es padding/margin de objeto — es el espacio natural de la palabra en el flujo.
 * Las h1-space antes/despues ya dan el espacio de palabra. No agregar extra.
 */
.h1-plus {
  /* Sin estilos adicionales — el espacio ya viene del h1-space entre palabras.
     Solo se usa como hook de JS para la animacion diferenciada del "+". */
}

.h1-space {
  display: inline;
}

/* word-clip / word-inner: inyectados por GSAP para el word-reveal */
:global(.word-clip) {
  display: inline-block;
  overflow: hidden;
  vertical-align: bottom;
  padding-bottom: 0.05em;
  margin-bottom: -0.05em;
}

:global(.word-inner) {
  display: inline-block;
}

/* ─── SUBHEAD ────────────────────────────────────────────── */

.hero-subhead {
  position: relative;
  z-index: 2;
  font-family: var(--font-body);
  font-size: var(--text-subhead);
  font-weight: 400;
  color: var(--taupe);
  line-height: 1.5;
  letter-spacing: 0;
  margin-top: var(--space-xl);
  max-width: 38ch;
  flex-shrink: 0;
  opacity: 0; /* GSAP revela */
}

/* ─── CTA ────────────────────────────────────────────────── */

.hero-cta {
  position: relative;
  z-index: 2;
  display: inline-block;
  font-family: var(--font-mono);
  font-size: var(--text-mono);
  font-weight: 400;
  color: var(--crema);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  line-height: 1.4;
  text-decoration: none;
  margin-top: var(--space-l);
  padding: 0.75em 1.5em;
  border: 1px solid var(--linea-hover);
  flex-shrink: 0;
  opacity: 0; /* GSAP revela */
  /* Touch target minimo 48px (P9) */
  min-height: 48px;
  align-self: flex-start;
  display: flex;
  align-items: center;
  gap: 0.5em;
}

.hero-cta:hover {
  border-color: var(--crema);
  color: var(--crema);
}

/* ─── INDICE DE CAPACIDADES ──────────────────────────────── */
/*
 * Mobile: lista mono full-width, debajo del CTA.
 * Desktop: col 9-12, alineada al centro vertical del headline.
 * Se lee como ficha tecnica de estudio — no bullets, no cards, no iconos.
 */
.hero-capabilities {
  position: relative;
  z-index: 2;
  list-style: none;
  margin: 0;
  padding: 0;
  margin-top: var(--space-l);
  flex-shrink: 0;
  opacity: 0; /* GSAP revela */
}

.hero-capabilities__item {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--text-mono);
  font-weight: 400;
  color: var(--taupe);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  line-height: 2;
}

.hero-capabilities__num {
  display: inline;
  /* Alineacion de numeracion: tabular para que 001/002/003/004 queden en columna */
  font-variant-numeric: tabular-nums;
}

.hero-capabilities__sep {
  color: var(--taupe);
  opacity: 0.5;
}

.hero-capabilities__label {
  display: inline;
}

/* ═══════════════════════════════════════════════════════════
   TABLET (768px+)
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 768px) {
  .hero {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: auto auto auto auto auto;
    column-gap: var(--gutter);
    align-items: start;
    row-gap: 0;
  }

  /* Lomo solo mobile */
  .hero-notebook-spine {
    display: none;
  }

  /* Col 6 visible en tablet */
  .grid-line[data-col="6"] {
    display: block;
  }

  .hero-kicker {
    grid-column: 1 / 7;
    margin-bottom: var(--space-s);
    /* En tablet el kicker va arriba, ocupa toda la fila */
  }

  .hero-h1 {
    grid-column: 1 / 7;
    align-self: start;
    /* Tablet: preferred 4.8vw → ~37px en 768px. ~5-6 líneas, CTA entra en el fold. */
    font-size: clamp(2rem, 4.8vw, 3.8rem);
    font-variation-settings: 'wdth' 105;
    hyphens: none;
    overflow-wrap: normal;
    text-wrap: balance;
  }

  .hero-subhead {
    grid-column: 1 / 5;
    max-width: none;
    margin-top: var(--space-l);
  }

  .hero-cta {
    grid-column: 1 / 4;
    margin-top: var(--space-m);
    align-self: start;
  }

  /* Capacidades: debajo del subhead en tablet, 4 columnas */
  .hero-capabilities {
    grid-column: 1 / 7;
    margin-top: var(--space-m);
    /* En tablet las capacidades van en columna, debajo del CTA */
  }

  /*
   * Franja roja tablet: vertical 2px sobre col 5/6
   * Separa el bloque de contenido de la columna derecha (aunque colapsada).
   * left = margen + 4/6 del interior del grid (4 columnas de 6 = 66.6%)
   */
  .hero-red-bar {
    left: calc(var(--margin) + (100% - 2 * var(--margin)) * 0.667);
    right: auto;
    width: 1px;
    height: auto;
    top: 22%;
    bottom: 12%;
    transform-origin: top center;
  }
}

/* ═══════════════════════════════════════════════════════════
   DESKTOP (1280px+)
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 1280px) {
  .hero {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto auto auto;
    min-height: 100svh;
    align-items: start;
  }

  /* Col 3/6/9 visibles */
  .grid-line[data-col="3"],
  .grid-line[data-col="6"],
  .grid-line[data-col="9"] {
    display: block;
  }

  /* Kicker: fila superior, col 1-8 (izquierda) */
  .hero-kicker {
    grid-column: 1 / 9;
    grid-row: 1;
    margin-bottom: var(--space-m);
  }

  /* H1: col 1-8, fila 2 */
  .hero-h1 {
    grid-column: 1 / 9;
    grid-row: 2;
    align-self: start;
    font-size: clamp(3.5rem, 4.8vw, 6rem);
    font-variation-settings: 'wdth' 110;
    text-wrap: unset;
    hyphens: none;
    overflow-wrap: normal;
  }

  /* Subhead: col 1-6, fila 3 */
  .hero-subhead {
    grid-column: 1 / 7;
    grid-row: 3;
    max-width: 50ch;
    margin-top: var(--space-l);
  }

  /* CTA: col 1-3, fila 4 */
  .hero-cta {
    grid-column: 1 / 4;
    grid-row: 4;
    margin-top: var(--space-m);
    align-self: start;
  }

  /*
   * Indice de capacidades: col 9-12, fila 2.
   * Alineado verticalmente al centro del headline.
   * Se lee como documento editorial de estudio — NO lista con bullets.
   */
  .hero-capabilities {
    grid-column: 9 / 13;
    grid-row: 2 / 5;
    align-self: center;
    margin-top: 0;
    padding-left: var(--gutter);
  }

  .hero-capabilities__item {
    line-height: 2.4;
    /* En desktop hay mas aire entre items — se ve como indice editorial */
  }

  /*
   * Franja roja desktop: vertical 2px sobre eje col 9 (costura diseno/sistema).
   * Col 9 = 8/12 del interior = 66.6% + margen.
   * Tramo alineado al bloque de contenido (no recorre toda la pagina).
   */
  .hero-red-bar {
    left: calc(var(--margin) + (100% - 2 * var(--margin)) * 0.6667);
    right: auto;
    width: 1px;
    height: auto;
    top: 20%;
    bottom: 18%;
    transform-origin: top center;
  }
}
</style>

<script>
  /**
   * Animacion GSAP del hero — Concepto B (2026-06-07).
   *
   * PROGRESSIVE ENHANCEMENT:
   * Todo el hero es HTML/CSS visible por defecto. Este script es enhancement.
   * Si falla: el hero se ve completo estatico. Nunca invisible.
   *
   * Secuencia aprobada:
   * 1. Grilla/lomo (scaleY 0→1, expo.out)
   * 2. Kicker (fade)
   * 3. H1 word-reveal lineas 1+2+3 (yPercent 110→0, stagger)
   *    3a. El "+" entra AL FINAL de line1 con scale 0.6→1 + fade (beat propio)
   * 4. Indice de capacidades 001-004 (fade + leve translateY, stagger — "imprime linea por linea")
   * 5. Franja roja costura (scale 0→1)
   * 6. Subhead + CTA (fade)
   *
   * INTERACCION (solo desktop pointer:fine):
   * Micro-pulso scale en el "+" al hover cercano — GSAP quickTo.
   * Muy sutil. Solo el "+", no todo el hero.
   *
   * REDUCED-MOTION: todo estatico visible, sin animacion.
   */

  import { gsap } from 'gsap';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Helper: posicion de la franja roja mobile ── */
  /*
   * En mobile la franja es horizontal. La posicionamos entre el subhead y
   * el indice de capacidades. Se calcula una vez al cargar.
   */
  function positionRedBarMobile(redBar: HTMLElement | null, subhead: HTMLElement | null) {
    if (!redBar || !subhead) return;
    const subheadRect = subhead.getBoundingClientRect();
    const scrollTop = window.scrollY || document.documentElement.scrollTop;
    redBar.style.top = `${subheadRect.bottom + scrollTop + 20}px`;
    redBar.style.bottom = 'auto';
  }

  if (!reducedMotion) {
    /* ── Word-split del H1 ── */
    const heroH1 = document.querySelector<HTMLElement>('.hero-h1');
    let wordInners: HTMLElement[] = [];
    let plusInner: HTMLElement | null = null;

    if (heroH1) {
      try {
        const wordSpans = heroH1.querySelectorAll<HTMLElement>('.h1-word');
        wordSpans.forEach((wordEl) => {
          const isRojo = wordEl.classList.contains('h1-word--rojo');
          const isPlus = wordEl.dataset.plus === 'true';
          const text = wordEl.textContent ?? '';

          const clip = document.createElement('span');
          clip.className = 'word-clip';

          const inner = document.createElement('span');
          inner.className = 'word-inner';
          if (isRojo) inner.style.color = 'var(--rojo)';
          inner.textContent = text;

          clip.appendChild(inner);
          wordEl.replaceWith(clip);

          if (isPlus) {
            /* El "+" se anima separado: no va al array wordInners */
            plusInner = inner;
          } else {
            wordInners.push(inner);
          }
        });
      } catch (_) {
        wordInners = [];
        plusInner = null;
      }
    }

    /* ── Referencias DOM ── */
    const gridLines = document.querySelectorAll<HTMLElement>('.grid-line');
    const spine = document.querySelector<HTMLElement>('.hero-notebook-spine');
    const redBar = document.querySelector<HTMLElement>('.hero-red-bar');
    const kicker = document.querySelector<HTMLElement>('.hero-kicker');
    const heroSubhead = document.querySelector<HTMLElement>('.hero-subhead');
    const heroCta = document.querySelector<HTMLElement>('.hero-cta');
    const capabilityItems = document.querySelectorAll<HTMLElement>('.hero-capabilities__item');
    const capabilities = document.querySelector<HTMLElement>('.hero-capabilities');

    const isMobile = window.innerWidth < 768;

    /* ── Estados iniciales ── */
    gsap.set(gridLines, { opacity: 1, scaleY: 0, transformOrigin: 'top center' });
    if (spine) gsap.set(spine, { opacity: 1, scaleY: 0, transformOrigin: 'top center' });

    if (isMobile) {
      positionRedBarMobile(redBar, heroSubhead);
      if (redBar) gsap.set(redBar, { opacity: 1, scaleX: 0, transformOrigin: 'left center' });
    } else {
      if (redBar) gsap.set(redBar, { opacity: 1, scaleY: 0, transformOrigin: 'top center' });
    }

    gsap.set(kicker, { opacity: 0 });
    gsap.set(heroSubhead, { opacity: 0 });
    gsap.set(heroCta, { opacity: 0 });
    if (capabilities) gsap.set(capabilities, { opacity: 1 });
    gsap.set(capabilityItems, { opacity: 0, y: 8 });

    if (wordInners.length > 0) {
      gsap.set(wordInners, { yPercent: 110 });
    }
    if (plusInner) {
      /* El "+" empieza invisible y pequeno — entra con beat propio */
      gsap.set(plusInner, { opacity: 0, scale: 0.6, transformOrigin: 'center center' });
    }

    /* ── Timeline principal ── */
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });

    /* 1. Grilla / lomo */
    const spineVisible = spine !== null && spine.offsetParent !== null;
    if (spineVisible) {
      tl.to(spine, { scaleY: 1, duration: 1.1 });
    } else {
      tl.to(gridLines, { scaleY: 1, duration: 1.1, stagger: 0.06 });
    }

    /* 2. Kicker */
    tl.to(kicker, { opacity: 1, duration: 0.6 }, '-=0.5');

    /* 3. H1 word-reveal (todas las palabras excepto el "+") */
    if (wordInners.length > 0) {
      tl.to(wordInners, { yPercent: 0, duration: 0.85, stagger: 0.07 }, '-=0.3');
    }

    /* 3a. El "+" entra al final de line1 con su beat propio: scale + fade */
    if (plusInner) {
      tl.to(
        plusInner,
        { opacity: 1, scale: 1, duration: 0.55, ease: 'expo.out' },
        /* Entra 0.2s despues de que arranca el stagger de line1 (~2 palabras ya mostraron) */
        wordInners.length > 0 ? '<+0.2' : '-=0.3'
      );
    }

    /* 4. Franja roja costura */
    if (isMobile) {
      tl.to(redBar, { scaleX: 1, duration: 0.5, ease: 'expo.out' }, '+=0.1');
    } else {
      tl.to(redBar, { scaleY: 1, duration: 0.8, ease: 'expo.out' }, '-=0.6');
    }

    /* 5. Indice de capacidades — "se imprime linea por linea" */
    tl.to(
      capabilityItems,
      { opacity: 1, y: 0, duration: 0.5, stagger: 0.12, ease: 'expo.out' },
      '-=0.4'
    );

    /* 6. Subhead + CTA */
    tl.to(heroSubhead, { opacity: 1, duration: 0.7 }, '+=0.05');
    tl.to(heroCta, { opacity: 1, duration: 0.5 }, '<+0.15');

    /* ── Micro-interaccion en el "+" (solo desktop pointer:fine) ── */
    /*
     * Pulso scale sutil al pasar cerca del "+".
     * NO magnetico en todo el hero — SOLO el "+".
     * Progressive enhancement: si el "+" no existe, no pasa nada.
     */
    const isPointerFine = window.matchMedia('(pointer: fine)').matches;
    /* Captura en const para que TS pueda estrechar el tipo dentro de los callbacks */
    const plusInnerRef: HTMLElement | null = plusInner;
    if (isPointerFine && plusInnerRef) {
      const plusInnerEl: HTMLElement = plusInnerRef;
      const plusClip = plusInnerEl.parentElement;
      if (plusClip) {
        let pulseTween: gsap.core.Tween | null = null;

        plusClip.addEventListener('mouseenter', () => {
          if (pulseTween) pulseTween.kill();
          pulseTween = gsap.to(plusInnerEl, {
            scale: 1.12,
            duration: 0.35,
            ease: 'expo.out',
          });
        });

        plusClip.addEventListener('mouseleave', () => {
          if (pulseTween) pulseTween.kill();
          pulseTween = gsap.to(plusInnerEl, {
            scale: 1,
            duration: 0.55,
            ease: 'expo.out',
          });
        });
      }
    }

  } else {
    /* ── reduced-motion: todo visible de inmediato ── */
    const allAnimated = document.querySelectorAll<HTMLElement>(
      '.grid-line, .hero-notebook-spine, .hero-red-bar, .hero-kicker, .hero-subhead, .hero-cta'
    );
    gsap.set(allAnimated, { opacity: 1 });

    const gridLinesRM = document.querySelectorAll<HTMLElement>('.grid-line');
    gsap.set(gridLinesRM, { scaleY: 1 });

    const spineRM = document.querySelector<HTMLElement>('.hero-notebook-spine');
    if (spineRM) gsap.set(spineRM, { scaleY: 1 });

    const redBarRM = document.querySelector<HTMLElement>('.hero-red-bar');
    if (redBarRM) gsap.set(redBarRM, { scaleX: 1, scaleY: 1 });

    const capRM = document.querySelectorAll<HTMLElement>('.hero-capabilities__item');
    gsap.set(capRM, { opacity: 1, y: 0 });

    const capContainerRM = document.querySelector<HTMLElement>('.hero-capabilities');
    if (capContainerRM) gsap.set(capContainerRM, { opacity: 1 });

    /* H1 y su "+" son HTML plano visible por defecto — no necesitan set */
    /* El "+" tiene color --rojo en CSS via .h1-word--rojo */
  }
</script>
