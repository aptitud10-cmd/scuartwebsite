---
/**
 * FooterSection.astro — Cierre editorial de marca
 * SCUART — Footer premium, NO bloque de contacto repetido.
 *
 * CONCEPTO:
 * La ContactSection (arriba) tiene el CTA fuerte: "LET'S BUILD SOMETHING." /
 * "EMPECEMOS." + form + WhatsApp/email. Ese es el momento de conversión.
 * Este footer es el cierre de MARCA — la firma visual del estudio.
 * No repite el CTA. No duplica los links de contacto como protagonistas.
 *
 * JERARQUÍA VISUAL (≤3 niveles):
 *   N1 — "SCUART+" — Archivo 900, crema, display statement al fondo.
 *        Ocupa ≥40% del peso visual. Es la firma del estudio, el cierre.
 *        El "+" en --rojo: instancia 1 del presupuesto rojo del footer.
 *   N2 — Barra de datos superior: nav links (Portfolio/Method/Contact)
 *        + selector EN/ES. Mono taupe. Separada del SCUART por --linea arriba.
 *   N3 — Créditos al pie del SCUART: año + mercados + email discreto. Mono
 *        taupe, textura de ficha de estudio. En una línea separada por "·".
 *
 * PRESUPUESTO ROJO:
 *   Instancia 1: el "+" en "SCUART+" (firma tipográfica — extensión del sistema
 *   del hero donde el "+" es el gesto de marca).
 *   Total = 1 instancia. Contenido, sin ruido.
 *
 * FONDO: --carbon-elev (#1A1A18) en vez de --carbon (#0E0E0E).
 *   Razón: el ContactSection usa --carbon. El footer en --carbon-elev crea un
 *   plano ligeramente diferente — profundidad sutil que refuerza el cierre.
 *   La diferencia #0E0E0E vs #1A1A18 es perceptible como "otro plano" sin
 *   romper la cohesión cromática general.
 *
 * COMPOSICIÓN (anti R2 — no apilado simétrico default):
 *   Dos bandas horizontales intencionales:
 *   — Banda datos/nav: asimétrica — nav izquierda | lang derecha. Desktop:
 *     grilla 5fr/7fr. Información operativa en servicio del cierre.
 *   — Banda firma: el SCUART+ gigante rompe el ritmo micro de los datos.
 *     Los créditos debajo son la cola micro de la firma.
 *
 * DATOS USADOS (sin inventar nada):
 *   - Email: hello@scuart.com (de t.contact.emailHref)
 *   - WhatsApp: wa.me/[WHATSAPP_NUMBER] (de t.contact.whatsappHref — placeholder)
 *   - Mercados: "Bogotá · US · LATAM" (estudio de Bogotá, sirve US + LATAM)
 *   - Año: 2026 (año actual del proyecto)
 *   - Nav anchors: #portfolio #method #contact (del Nav.astro)
 *
 * REVEAL: IntersectionObserver CSS-only vía clase .is-visible.
 *   Sin GSAP. Solo opacity + translateY leve, una vez al entrar al viewport.
 *   prefers-reduced-motion: todo visible de inmediato.
 */

import type { Translations } from '../i18n/en';
import type { Lang } from '../i18n/index';

interface Props {
  t: Translations;
  lang: Lang;
}

const { t, lang } = Astro.props;
const f = t.footer;
---

<footer class="site-footer" aria-label={f.ariaLabel}>

  <!--
    REGLA SUPERIOR — línea crema 9% que separa el footer del contacto.
    Misma textura que las kicker-lines del resto del sitio.
    Crea el "corte de plano" editorial antes del cierre.
  -->
  <div class="footer-rule" aria-hidden="true"></div>

  <!--
    BANDA DATOS/NAV — N2.
    Desktop: asimétrica — nav (5fr izquierda) | lang switch (2fr derecha).
    Mobile: apilado en dos filas (nav | lang), separados por gap.
    Mono taupe uppercase. Touch targets ≥44px en links (padding).
  -->
  <div class="footer-meta">

    <!-- Nav links del estudio — anchors ya funcionales -->
    <nav class="footer-nav" aria-label="Navegación de pie de página">
      <a href={`/${lang}#portfolio`} class="footer-nav__link">
        {t.nav.portfolio}
      </a>
      <span class="footer-nav__sep" aria-hidden="true">·</span>
      <a href={`/${lang}#method`} class="footer-nav__link">
        {t.nav.method}
      </a>
      <span class="footer-nav__sep" aria-hidden="true">·</span>
      <a href={`/${lang}#contact`} class="footer-nav__link">
        {t.nav.contact}
      </a>
    </nav>

    <!-- Selector de idioma — mismo patrón que Nav.astro pero adaptado al footer -->
    <div class="footer-lang" role="navigation" aria-label="Selector de idioma">
      <span class="footer-lang__active" aria-current="true">
        {lang.toUpperCase()}
      </span>
      <span class="footer-lang__sep" aria-hidden="true">/</span>
      <a
        href={t.nav.langHref}
        class="footer-lang__other"
        hreflang={t.nav.langLabel.toLowerCase()}
        aria-label={`Cambiar idioma a ${t.nav.langLabel}`}
      >
        {t.nav.langLabel}
      </a>
    </div>

  </div>

  <!--
    FIRMA — N1. Protagonista del footer.
    "SCUART" + "+" rojo como firma visual del estudio.
    Archivo 900, crema. El "+" extiende el gesto del hero (el "+" como signo
    de unión diseño/tecnología) ahora como marca de cierre.
    clamp calibrado: mínimo 4rem para que los 7 chars (SCUART+) entren
    en 375px sin corte. wdth 110 en tablet/desktop (igual que hero).
  -->
  <div class="footer-brand">
    <p class="footer-wordmark" aria-label="SCUART+">
      <span class="footer-wordmark__name">SCUART</span><span
        class="footer-wordmark__plus"
        aria-hidden="true"
      >+</span>
    </p>
  </div>

  <!--
    CRÉDITOS — N3.
    Mono taupe, al pie de la firma. Una línea con separadores "·".
    No repite el CTA de contacto — solo datos de ficha editorial:
    año · estudio · mercados · email discreto.
  -->
  <div class="footer-credits">
    <span class="footer-credits__item">{f.builtBy}</span>
    <span class="footer-credits__dot" aria-hidden="true">·</span>
    <span class="footer-credits__item">{f.markets}</span>
    <span class="footer-credits__dot" aria-hidden="true">·</span>
    <a
      href={t.contact.emailHref}
      class="footer-credits__link"
      aria-label="Email del estudio"
    >hello@scuart.com</a>
    <span class="footer-credits__dot" aria-hidden="true">·</span>
    <a
      href={t.contact.whatsappHref}
      class="footer-credits__link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="WhatsApp del estudio (abre en nueva ventana)"
    >WhatsApp</a>
  </div>

</footer>

<style>
/* ═══════════════════════════════════════════════════════════
   FOOTER — Cierre editorial de marca
   Mobile-first: 375px base. md: 768px. lg: 1280px.
   Fondo: --carbon-elev (#1A1A18) — plano diferente del --carbon del contacto.
   ═══════════════════════════════════════════════════════════ */

.site-footer {
  background-color: var(--carbon-elev);
  padding-left: var(--margin);
  padding-right: var(--margin);
  padding-top: var(--space-xl);
  padding-bottom: var(--space-l);
  position: relative;
  overflow-x: clip;
  /* Reveal: empieza invisible — IntersectionObserver agrega .is-visible */
  opacity: 0;
  transform: translateY(16px);
  transition: opacity 0.7s ease, transform 0.7s ease;
}

/* Clase que dispara el reveal al entrar al viewport */
.site-footer.is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* ─── REGLA SUPERIOR ─────────────────────────────────────── */
/*
 * Línea de entrada: separa el footer del contacto.
 * Misma textura --linea que en el resto del sitio.
 * margin-bottom editorial: espacio antes de los datos/nav.
 */
.footer-rule {
  width: 100%;
  height: 1px;
  background-color: var(--linea);
  margin-bottom: var(--space-l);
}

/* ─── BANDA META/NAV — N2 ────────────────────────────────── */
/*
 * Mobile: columna — nav arriba, lang abajo, con gap s.
 * Tablet+: fila — nav izquierda (flex:1), lang derecha.
 */
.footer-meta {
  display: flex;
  flex-direction: column;
  gap: var(--space-s);
  margin-bottom: var(--space-2xl);
}

/* ─── NAV LINKS ───────────────────────────────────────────── */
.footer-nav {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0;
  font-family: var(--font-mono);
  font-size: var(--text-mono);
  font-weight: 400;
  color: var(--taupe);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  line-height: 1.4;
}

.footer-nav__link {
  color: var(--taupe);
  text-decoration: none;
  /* Touch target: padding suficiente */
  padding: 0.4em 0;
  transition: color 0.2s ease;
  position: relative;
}

.footer-nav__link::after {
  content: '';
  position: absolute;
  bottom: 0.2em;
  left: 0;
  width: 100%;
  height: 1px;
  background-color: var(--rojo);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.footer-nav__link:hover {
  color: var(--crema);
}

.footer-nav__link:hover::after {
  transform: scaleX(1);
}

.footer-nav__link:focus-visible {
  outline: 1px solid var(--crema);
  outline-offset: 3px;
}

.footer-nav__sep {
  color: var(--taupe);
  opacity: 0.4;
  padding: 0 0.6em;
  line-height: 1.4;
}

/* ─── SELECTOR DE IDIOMA ──────────────────────────────────── */
/*
 * Mismo sistema que Nav.astro — reutiliza la lógica visual exacta.
 * En footer: posición izquierda (mobile) / derecha (tablet+).
 */
.footer-lang {
  display: flex;
  align-items: center;
  gap: 0.3em;
  font-family: var(--font-mono);
  font-size: var(--text-mono);
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  line-height: 1.4;
  /* Discreta en mobile */
  opacity: 0.65;
  transition: opacity 0.2s ease;
}

.footer-lang:hover,
.footer-lang:focus-within {
  opacity: 1;
}

.footer-lang__active {
  color: var(--crema);
  cursor: default;
}

.footer-lang__sep {
  color: var(--taupe);
  opacity: 0.4;
}

.footer-lang__other {
  color: var(--taupe);
  text-decoration: none;
  transition: color 0.2s ease;
  position: relative;
  padding-bottom: 2px;
}

.footer-lang__other::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 1px;
  background-color: var(--rojo);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.footer-lang__other:hover {
  color: var(--crema);
}

.footer-lang__other:hover::after {
  transform: scaleX(1);
}

.footer-lang__other:focus-visible {
  outline: 1px solid var(--crema);
  outline-offset: 3px;
}

/* ─── FIRMA — N1 ─────────────────────────────────────────── */
/*
 * El protagonista del footer. Archivo 900, crema.
 * clamp calibrado:
 *   - mínimo 4rem: a 375px (con --margin ~20px) = 335px útiles.
 *     "SCUART+" = 7 chars Archivo 900 wdth 105. A 64px ~315px → entra.
 *   - máximo: viewport width menos márgenes, limitado para que no desborde.
 *     preferred 18vw da ~230px en 1280px → no es lo que queremos.
 *     En desktop queremos SCUART+ cubriendo ~70-80% del ancho.
 *     A 1280px con márgenes ~120px → 1040px disponibles. 80% = 832px.
 *     7 chars Archivo 900 wdth 110 a ~119px/char = 833px → clamp(4rem, 13vw, 8.5rem)
 *     da 8.5rem = 136px → 7 chars = ~952px. Demasiado con margen en 1280px.
 *     Usar unidad basada en el contenedor — font-size: clamp(4rem, 13vw, 8rem).
 *     A 1280px: 13vw = 166px. 8rem = 128px (max). 7 chars × 128px → ~896px.
 *     Con margins 120px c/u = 240px → 1280-240 = 1040px disponibles. OK.
 *
 *     Táctica: usar font-size grande + letter-spacing negativo.
 *     desktop: font-size clamp(4rem, 13vw, 8rem) con wdth 110.
 *
 * line-height 0.9: característica del sistema display del sitio.
 * letter-spacing -0.03em: tracking del sistema de headings.
 * margin: 0 para que los créditos queden pegados debajo (gap se maneja en flex).
 */
.footer-brand {
  margin-bottom: var(--space-m);
}

.footer-wordmark {
  font-family: var(--font-display);
  font-weight: var(--display-weight-heavy);
  /*
   * clamp seguro:
   * min 4rem (~64px): 7 chars × ~45px = ~315px < 335px (375px - márgenes). OK.
   * preferred: en 375px el preferred 13vw = ~49px. El min de 4rem=64px aplica → 64px.
   * max 8rem: desktop 1280px. 13vw = 166px → el max 8rem=128px aplica.
   *   7 chars × ~91px (128px × wdth110 factor ~0.71) = ~637px < 1040px disponibles. OK.
   *   Resultado: el SCUART+ no llena TODO el ancho en desktop — es statement largo
   *   pero no display full-bleed. Para coverage full-bleed usaría clamp diferente.
   *   DECISIÓN: mantener 8rem. El SCUART+ es una firma grande, no un background text.
   *   Si William quiere full-bleed, se ajusta el max.
   */
  font-size: clamp(4rem, 13vw, 8rem);
  line-height: 0.92;
  letter-spacing: -0.03em;
  font-variation-settings: 'wdth' 105;
  color: var(--crema);
  text-transform: uppercase;
  margin: 0;
  /* Evitar corte en cualquier viewport */
  hyphens: none;
  -webkit-hyphens: none;
  word-break: keep-all;
  overflow-wrap: normal;
}

/* El "+" — instancia 1 del presupuesto rojo del footer */
.footer-wordmark__plus {
  color: var(--rojo);
}

/* ─── CRÉDITOS — N3 ──────────────────────────────────────── */
/*
 * Mono taupe. Una fila con separadores "·".
 * flex-wrap para mobile si la línea es larga.
 * Textura de ficha de estudio — no protagonista.
 */
.footer-credits {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.4em;
  font-family: var(--font-mono);
  font-size: var(--text-mono);
  font-weight: 400;
  color: var(--taupe);
  letter-spacing: 0.03em;
  line-height: 1.4;
  opacity: 0.7;
}

.footer-credits__item {
  /* Texto plano — no interactivo */
}

.footer-credits__dot {
  opacity: 0.4;
}

.footer-credits__link {
  color: var(--taupe);
  text-decoration: none;
  /* Touch target: mínimo 44px via padding vertical */
  padding: 0.25em 0;
  transition: color 0.2s ease;
}

.footer-credits__link:hover {
  color: var(--crema);
  opacity: 1;
}

.footer-credits__link:focus-visible {
  outline: 1px solid var(--crema);
  outline-offset: 2px;
  opacity: 1;
}

/* ═══════════════════════════════════════════════════════════
   TABLET (768px+)
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 768px) {
  .site-footer {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);
  }

  /* Banda meta: fila asimétrica — nav izquierda (flex:1) | lang derecha */
  .footer-meta {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    margin-bottom: var(--space-3xl);
  }

  .footer-lang {
    /* Tablet+: opacidad plena, hay espacio */
    opacity: 1;
  }

  /* Firma más grande en tablet */
  .footer-wordmark {
    font-variation-settings: 'wdth' 108;
  }

  /* Créditos: sin wrap en tablet — caben en una línea */
  .footer-credits {
    flex-wrap: nowrap;
  }
}

/* ═══════════════════════════════════════════════════════════
   DESKTOP (1280px+)
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 1280px) {
  .site-footer {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);
  }

  /* La firma en desktop recupera wdth 110 — más ancho, más impacto */
  .footer-wordmark {
    font-variation-settings: 'wdth' 110;
    /* En desktop la firma puede ser más grande — preferred 13vw en 1280px = 166px,
       max 8rem = 128px aplica. Relajamos el max para desktop. */
    font-size: clamp(6rem, 13vw, 11rem);
  }

  .footer-meta {
    margin-bottom: var(--space-3xl);
  }
}

/* ═══════════════════════════════════════════════════════════
   REDUCED-MOTION — sin transiciones, sin reveal
   ═══════════════════════════════════════════════════════════ */
@media (prefers-reduced-motion: reduce) {
  .site-footer {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .footer-nav__link,
  .footer-lang__other,
  .footer-credits__link {
    transition: none;
  }

  .footer-nav__link::after,
  .footer-lang__other::after {
    transition: none;
  }
}
</style>

<script>
  /**
   * Footer reveal — IntersectionObserver sobrio.
   *
   * Cuando el footer entra al viewport (threshold 0.15 = 15% visible),
   * agrega .is-visible que dispara la transición CSS de opacity + translateY.
   *
   * Una sola vez: disconnect() después del primer trigger.
   * Progressive enhancement: si JS falla, el footer queda opaco gracias
   * al fallback en prefers-reduced-motion (o se puede agregar un noscript fallback).
   *
   * NO usa GSAP — reveal simple no justifica una dep adicional.
   */

  const footer = document.querySelector<HTMLElement>('.site-footer');

  if (footer) {
    /* Si el usuario prefiere reduced-motion, hacemos visible inmediatamente */
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReduced) {
      footer.classList.add('is-visible');
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              footer.classList.add('is-visible');
              /* Una sola vez — disconnect para no retriggerear */
              observer.disconnect();
            }
          });
        },
        { threshold: 0.08 }
      );

      observer.observe(footer);
    }
  }
</script>
