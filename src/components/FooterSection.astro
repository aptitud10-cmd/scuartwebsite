---
/**
 * FooterSection.astro — Cierre del sitio — Rediseño 2026-07-17
 *
 * Patrón Locomotive confirmado (research 2026): footer COMPACTO de 3 capas,
 * SIN wordmark gigante (es la excepción, no la norma; en un estudio de 1
 * persona se siente vacío/pretencioso).
 *
 *   Capa 1 — Descriptor del estudio (los HECHOS: independiente, NY+LATAM,
 *            bilingüe — la logística vive acá, no en el hero) + nav + idioma.
 *   Capa 2 — Contacto directo: email + mercados.
 *   Capa 3 — Cierre de marca: tagline "No decoramos. Decidimos." + © + legales.
 *
 * MOTION (restraint — el footer usa MENOS motion que el resto, como el
 * fade-out de una canción): un solo reveal escalonado de las 3 capas al
 * entrar + underline hover en links (CSS, cubic-bezier expo).
 *
 * Progressive enhancement: estado oculto solo via JS.
 */

import type { Translations } from '../i18n/en';
import type { Lang } from '../i18n/index';

interface Props {
  t: Translations;
  lang: Lang;
}

const { t, lang } = Astro.props;
const f = t.footer;

const EMAIL = 'info@scuart.com';
---

<footer class="foot" aria-label={f.ariaLabel}>

  <!-- ── Capa 1: descriptor + nav + idioma ── -->
  <div class="foot__row foot__row--top" data-foot-row>
    <p class="foot__descriptor">{f.descriptor}</p>

    <nav class="foot__nav" aria-label={f.navLabel}>
      <a href={`/${lang}#portfolio`} class="foot__link">{t.nav.portfolio}</a>
      <a href={`/${lang}#studio`} class="foot__link">{t.nav.method}</a>
      <a href={`/${lang}#contact`} class="foot__link">{t.nav.contact}</a>
      <a
        href={t.nav.langHref}
        class="foot__link foot__link--lang"
        hreflang={t.nav.langLabel.toLowerCase()}
        aria-label={`${f.langSwitchLabel}: ${t.nav.langLabel}`}
      >{t.nav.langLabel}</a>
    </nav>
  </div>

  <!-- ── Capa 2: contacto directo.
       Orden invertido vs Contacto (mercados izq / email der) para NO
       duplicar la estructura de la sección de arriba (fix visual-critic). ── -->
  <div class="foot__row foot__row--contact" data-foot-row>
    <p class="foot__markets">{f.markets}</p>
    <a href={`mailto:${EMAIL}`} class="foot__email">{EMAIL}</a>
  </div>

  <!-- ── Capa 3: cierre de marca ── -->
  <div class="foot__row foot__row--legal" data-foot-row>
    <p class="foot__tagline">{f.tagline}</p>
    <div class="foot__legal">
      <span class="foot__copy">{f.builtBy}</span>
      <a href={f.legal.privacyHref} class="foot__link foot__link--small">{f.legal.privacyLabel}</a>
      <a href={f.legal.termsHref} class="foot__link foot__link--small">{f.legal.termsLabel}</a>
    </div>
  </div>

</footer>

<style>
/* ═══════════════════════════════════════════════════════════
   FOOTER — compacto, 3 capas, sistema del portafolio.
   Los hechos (NY/LATAM/bilingüe) viven acá — no en el hero.
   ═══════════════════════════════════════════════════════════ */

.foot {
  background-color: var(--bg);
  padding: var(--space-xl) var(--margin) var(--space-l);
  border-top: 1px solid var(--ink);
}

.foot__row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: var(--space-l);
  flex-wrap: wrap;
  padding-block: clamp(1.25rem, 3vh, 2rem);
}

.foot__row + .foot__row {
  border-top: 1px solid var(--hairline);
}

/* ── Capa 1 ── */
.foot__descriptor {
  font-family: var(--font-body);
  font-size: var(--text-body);
  color: var(--ink-62);
  line-height: 1.55;
  max-width: 38ch;
  margin: 0;
}

.foot__nav {
  display: flex;
  gap: clamp(1rem, 2.5vw, 2rem);
  align-items: baseline;
}

/* ── Links: underline que entra por la izquierda y sale por la derecha ── */
.foot__link {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--ink-62);
  text-decoration: none;
  padding-bottom: 2px;
  background-image: linear-gradient(currentColor, currentColor);
  background-repeat: no-repeat;
  background-position: 100% 100%;
  background-size: 0% 1px;
  transition:
    color 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94),
    background-size 0.5s cubic-bezier(0.19, 1, 0.22, 1),
    background-position 0s 0.5s;
}

.foot__link:hover,
.foot__link:focus-visible {
  color: var(--ink);
  background-position: 0% 100%;
  background-size: 100% 1px;
  transition:
    color 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94),
    background-size 0.5s cubic-bezier(0.19, 1, 0.22, 1);
}

.foot__link:focus-visible {
  outline: 2px solid var(--brand);
  outline-offset: 3px;
}

.foot__link--lang {
  color: var(--ink-42);
}

/* ── Capa 2: email + mercados ── */
/* Nivel secundario a propósito: el CTA-email gigante ya vive en Contacto,
   justo arriba — repetirlo en la misma escala diluye ambos (visual-critic). */
.foot__email {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(1.25rem, 1.8vw, 1.75rem);
  letter-spacing: -0.02em;
  color: var(--ink);
  text-decoration: none;
  padding-bottom: 0.08em;
  background-image: linear-gradient(var(--ink), var(--ink));
  background-repeat: no-repeat;
  background-position: 100% 100%;
  background-size: 0% 1.5px;
  transition: background-size 0.5s cubic-bezier(0.19, 1, 0.22, 1), background-position 0s 0.5s;
}

.foot__email:hover,
.foot__email:focus-visible {
  background-position: 0% 100%;
  background-size: 100% 1.5px;
  transition: background-size 0.5s cubic-bezier(0.19, 1, 0.22, 1);
}

.foot__email:focus-visible {
  outline: 2px solid var(--brand);
  outline-offset: 4px;
}

.foot__markets {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--ink-42);
  margin: 0;
}

/* ── Capa 3: tagline + legales ── */
.foot__tagline {
  font-family: var(--font-display);
  font-style: italic;
  font-weight: 400;
  font-size: var(--text-body);
  color: var(--ink);
  margin: 0;
}

.foot__legal {
  display: flex;
  gap: clamp(0.75rem, 2vw, 1.5rem);
  align-items: baseline;
}

.foot__copy {
  font-family: var(--font-body);
  font-size: var(--text-mono);
  letter-spacing: 0.08em;
  color: var(--ink-42);
}

.foot__link--small {
  font-weight: 400;
  color: var(--ink-42);
}

@media (max-width: 640px) {
  .foot__row {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-s);
  }
}

/* ── reduced-motion ── */
@media (prefers-reduced-motion: reduce) {
  [data-foot-row] {
    opacity: 1 !important;
    transform: none !important;
  }
  .foot__link,
  .foot__email {
    transition: none;
  }
}
</style>

<script>
  /**
   * Footer — motion mínimo (restraint): las 3 capas entran escalonadas
   * una sola vez. Nada más — el footer es el fade-out del sitio.
   */

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion) {
    try {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(ScrollTrigger);

      const rows = document.querySelectorAll<HTMLElement>('[data-foot-row]');
      if (rows.length) {
        /* gsap.from DENTRO de onEnter — sin estado oculto persistente */
        ScrollTrigger.create({
          trigger: '.foot',
          start: 'top 88%',
          once: true,
          onEnter: () => {
            gsap.from(rows, {
              opacity: 0,
              y: 16,
              duration: 0.7,
              ease: 'power3.out',
              stagger: 0.1,
            });
          },
        });
      }
    } catch (err) {
      console.error('[FooterSection] motion init failed:', err);
      document.querySelectorAll<HTMLElement>('[data-foot-row]').forEach((r) => {
        r.style.opacity = '1';
        r.style.transform = 'none';
      });
    }
  }
</script>
