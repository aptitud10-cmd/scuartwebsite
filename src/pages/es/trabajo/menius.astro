---
import CaseStudyLayout from '../../../components/CaseStudyLayout.astro';
import { getTranslations, getAlternatesFor } from '../../../i18n/index';
import type { CaseStudyData } from '../../../components/CaseStudyLayout.astro';

const lang = 'es';
const t = getTranslations(lang);
const alternates = getAlternatesFor('work/menius', 'trabajo/menius');

const data: CaseStudyData = {
  name: 'Menius',
  tagline: 'SaaS de menús digitales y pedidos para restaurantes. Producto propio de SCUART, de cero a producción.',
  categories: ['SAAS', 'PRODUCTO PROPIO'],
  year: '2025',
  client: 'SCUART (producto propio)',
  siteUrl: 'https://menius.app',
  // vista del sitio recortada (sin navbar del cliente) → browser-mockup dark
  heroImage: '/images/casos/menius-hero-crop.webp',
  // recorte al contenido para mobile: la captura completa (ratio 2.19) dejaba
  // el contenido diminuto en 346px de ancho (William 2026-08-04)
  heroImageMobile: '/images/casos/menius-hero-crop-tight.webp',
  heroImageAlt: 'Menius — landing del producto: pedidos online sin comisión',
  // canvas arena cálida: el screenshot oscuro contrasta, se lee, y la pieza
  // flota sobre --bg. Antes #0e0e0e (negro sobre negro, ilegible — William 2026-07-28).
  heroBg: 'var(--canvas-arena)',
  heroFrame: true,
  heroTheme: 'dark',
  blocks: [
    {
      label: 'El problema',
      body: 'Los restaurantes pierden hasta el 30% de cada pedido en comisiones de apps de delivery. Necesitaban un canal propio — menú digital, pedidos online y pagos directos a su cuenta — sin depender de plataformas de terceros ni pagar por cada transacción.',
      image: '/images/casos/menius-precios-crop.webp',
      // mobile: solo la columna "Pro". La tabla de 3 columnas es ilegible a
      // 346px; la columna destacada comunica lo mismo y se lee.
      imageMobile: '/images/casos/menius-precios-crop-pro.webp',
      imageAlt: 'Menius — planes y precios sin comisiones',
      ratio: 'wide',
      bg: 'var(--canvas-arena)',
      frame: true,
      theme: 'dark',
    },
    {
      label: 'El producto',
      body: 'Diseñamos y desarrollamos Menius desde cero: arquitectura multi-tenant, menú público optimizado para mobile con QR, pedidos en tiempo real, pagos con Stripe (0% de comisión), y un asistente de IA que arma el menú desde una foto. Cada restaurante recibe su propio subdominio y panel de administración.',
      // mockup de celular (device oscuro) → canvas arena para que flote nítido
      image: '/images/casos/menius-mockup.webp',
      imageAlt: 'Menius — la app de menú digital funcionando en un celular',
      ratio: 'tall',
      bg: 'var(--canvas-arena)',
    },
    {
      label: 'El resultado',
      body: 'Menius valida el modelo del estudio: no solo construimos sitios, construimos sistemas digitales que generan valor a largo plazo. Es la prueba técnica de SCUART — un SaaS completo, en producción, con pagos reales y clientes activos.',
      // screenshot mobile (oscuro) → canvas arena para que flote nítido
      image: '/images/casos/menius-mobile.webp',
      imageAlt: 'Menius — versión mobile del landing',
      ratio: 'tall',
      bg: 'var(--canvas-arena)',
    },
  ],
  credits: [
    { role: 'Dirección de producto', name: 'William Mora' },
    { role: 'Diseño UX/UI', name: 'William Mora' },
    { role: 'Arquitectura & desarrollo', name: 'William Mora' },
  ],
  next: {
    name: 'Etnia Braids',
    href: '/es/trabajo/etnia-braids',
  },
};
---

<CaseStudyLayout
  t={t}
  lang={lang}
  data={data}
  title="Menius — SaaS de pedidos para restaurantes | SCUART"
  description="SaaS de menús digitales para restaurantes. Diseñado y desarrollado por SCUART, de cero a producción."
  canonicalURL="https://scuart.com/es/trabajo/menius"
  alternates={alternates}
/>
