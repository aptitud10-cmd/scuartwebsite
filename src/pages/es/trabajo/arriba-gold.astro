---
import CaseStudyLayout from '../../../components/CaseStudyLayout.astro';
import { getTranslations } from '../../../i18n/index';
import type { CaseStudyData } from '../../../components/CaseStudyLayout.astro';

const lang = 'es';
const t = getTranslations(lang);

const data: CaseStudyData = {
  name: 'Arriba Gold',
  tagline: 'E-commerce para marca de joyería artesanal colombiana.',
  categories: ['E-Commerce', 'Joyería'],
  year: '2021',
  client: 'Arriba Gold',
  heroImage: '/images/portfolio-arriba-gold-real.webp',
  heroImageAlt: 'Arriba Gold — e-commerce diseñado por SCUART',
  sections: [
    {
      label: 'Contexto',
      body: 'Arriba Gold es una marca de joyería artesanal colombiana que buscaba expandir su alcance más allá de las ventas presenciales y las redes sociales. El mercado de joyería online requiere transmitir confianza y calidad a través de la pantalla — un reto de diseño considerable.',
    },
    {
      label: 'Desafío',
      body: 'Crear una experiencia de e-commerce que justificara el precio premium de la joyería artesanal. Las fotos de producto necesitaban protagonismo absoluto, el proceso de compra tenía que ser impecable en mobile, y la marca debía diferenciarse del ruido visual del mercado masivo.',
    },
    {
      label: 'Solución',
      body: 'Diseñamos una tienda online con imágenes de producto a gran escala, tipografía elegante, y un proceso de checkout simplificado. La arquitectura priorizó la experiencia mobile (donde ocurre la mayoría de las compras) y la velocidad de carga para no perder conversiones.',
    },
    {
      label: 'Resultado',
      body: 'El e-commerce le dio a Arriba Gold su primer canal de ventas directo al consumidor, independiente de plataformas de terceros. La marca pasó de depender de intermediarios a controlar su propia tienda, su catálogo y la relación con el cliente.',
    },
  ],
  images: [
    {
      src: '/images/portfolio-arriba-gold-real-trim.webp',
      alt: 'Arriba Gold — vista de la tienda online',
      wide: true,
    },
    {
      src: '/images/portfolio-arriba-gold-real.webp',
      alt: 'Arriba Gold — detalle del diseño de producto',
    },
  ],
  credits: [
    { role: 'Dirección Creativa', name: 'William Cuartas' },
    { role: 'Diseño UX/UI', name: 'William Cuartas' },
    { role: 'Desarrollo E-Commerce', name: 'William Cuartas' },
  ],
  next: {
    name: 'Jamón Casero',
    href: '/es/trabajo/jamon-casero',
  },
};
---

<CaseStudyLayout
  t={t}
  lang={lang}
  data={data}
  title="Arriba Gold — SCUART"
  description="E-commerce para marca de joyería artesanal colombiana. Diseño y desarrollo por SCUART."
  canonicalURL="https://scuart.com/es/trabajo/arriba-gold"
/>
