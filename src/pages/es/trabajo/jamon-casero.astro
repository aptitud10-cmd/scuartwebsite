---
import CaseStudyLayout from '../../../components/CaseStudyLayout.astro';
import { getTranslations, getAlternatesFor } from '../../../i18n/index';
import type { CaseStudyData } from '../../../components/CaseStudyLayout.astro';

const lang = 'es';
const t = getTranslations(lang);
const alternates = getAlternatesFor('work/jamon-casero', 'trabajo/jamon-casero');

const data: CaseStudyData = {
  name: 'Jamón Casero',
  tagline: 'Identidad digital para una marca de charcutería artesanal con más de 55 años de historia en Bogotá.',
  categories: ['WEB', 'MARCA GASTRO'],
  // marca fundada en 1970, sitio remodelado por SCUART en 2025
  year: '2025',
  client: 'Jamón Casero',
  siteUrl: 'https://jamoncasero.com.co',
  // vista del sitio recortada (sin navbar del cliente) → browser-mockup dark
  heroImage: '/images/casos/jamon-hero-crop.webp',
  heroImageAlt: 'Jamón Casero — landing del sitio: el pernil sobre madera',
  // canvas arena cálida en todos los bloques (William 2026-07-28)
  heroBg: 'var(--canvas-arena)',
  heroFrame: true,
  heroTheme: 'dark',
  blocks: [
    {
      // narrativa 2026-07-28: labels que cada imagen ILUSTRA (no 'El reto' con el
      // sitio ya terminado). El sitio → El oficio → En tu bolsillo.
      label: 'El sitio',
      body: 'Una marca con más de 55 años de tradición, pero sin presencia digital. Diseñamos su identidad online: fotografía de producto en primer plano, tipografía con carácter y una paleta cálida que evoca el proceso artesanal. El sitio le habla al consumidor final y al distribuidor a la vez, con pedidos por WhatsApp integrados.',
      // vista del sitio (bloque de producto con precio) → browser-mockup dark sobre arena
      image: '/images/casos/jamon-producto.webp',
      imageAlt: 'Jamón Casero — bloque de producto del sitio con precio',
      ratio: 'wide',
      bg: 'var(--canvas-arena)',
      frame: true,
      theme: 'dark',
    },
    {
      label: 'El oficio',
      body: 'La marca se sostiene en una receta de familia transmitida por generaciones. El sitio prioriza esa historia por encima del catálogo: primero se construye la confianza en el oficio, después se pide el pedido. La identidad editorial hace del proceso artesanal el argumento de venta.',
      // detalle editorial (el libro de recetas) — sin chrome → canvas arena
      image: '/images/casos/jamon-detalle.webp',
      imageAlt: 'Jamón Casero — el libro de recetas familiar',
      ratio: 'wide',
      bg: 'var(--canvas-arena)',
    },
    {
      label: 'En tu bolsillo',
      body: 'La experiencia se diseñó mobile-first: la mayoría de los pedidos entran desde el teléfono. El sitio se convirtió en el principal punto de contacto para distribuidores nuevos, y la identidad digital sirvió de base para el material de punto de venta y el empaque de la marca.',
      // vista mobile del sitio (oscura) → canvas arena para que flote nítida
      image: '/images/casos/jamon-mobile.webp',
      imageAlt: 'Jamón Casero — versión mobile del sitio',
      ratio: 'tall',
      bg: 'var(--canvas-arena)',
    },
  ],
  credits: [
    { role: 'Dirección creativa', name: 'William Cuartas' },
    { role: 'Diseño web', name: 'William Cuartas' },
    { role: 'Desarrollo', name: 'William Cuartas' },
  ],
  next: {
    name: 'Menius',
    href: '/es/trabajo/menius',
  },
};
---

<CaseStudyLayout
  t={t}
  lang={lang}
  data={data}
  title="Jamón Casero — Sitio web para marca gastro | SCUART"
  description="Identidad digital y sitio web para Jamón Casero, marca colombiana de charcutería artesanal."
  canonicalURL="https://scuart.com/es/trabajo/jamon-casero"
  alternates={alternates}
/>
