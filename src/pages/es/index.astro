---
/**
 * pages/es/index.astro — Pagina principal ES
 * URL canonical: https://scuart.com/es
 * Audiencia: LATAM + restaurantes latinos en USA + negocios bilingues.
 */

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import HeroSection from '../../components/HeroSection.astro';
import ManifestoSection from '../../components/ManifestoSection.astro';
import PortfolioSection from '../../components/PortfolioSection.astro';
import StatementSection from '../../components/StatementSection.astro';
import ServicesSection from '../../components/ServicesSection.astro';
// import StudioSection from '../../components/StudioSection.astro'; // retirada 2026-07-26 (ver abajo)
import ContactSection from '../../components/ContactSection.astro';
import FooterSection from '../../components/FooterSection.astro';
import { getTranslations, getAlternates } from '../../i18n/index';

const lang = 'es';
const t = getTranslations(lang);
const alternates = getAlternates();
const canonicalURL = alternates.es;
---

<Layout
  title={t.meta.title}
  description={t.meta.description}
  ogTitle={t.meta.ogTitle}
  ogDescription={t.meta.ogDescription}
  lang={lang}
  canonicalURL={canonicalURL}
  alternates={alternates}
>
  <Nav lang={lang} t={t} />
  <HeroSection t={t} />
  <ManifestoSection t={t} />
  <PortfolioSection t={t} />
  <StatementSection t={t} />
  <ServicesSection t={t} />
  {/* StudioSection ("Cómo trabajamos") retirada 2026-07-26: las agencias top
      (Uncommon, Basement, Active Theory) no incluyen sección de proceso — se da
      por sentado. El componente sigue en el repo por si se recupera. */}
  {/* <StudioSection t={t} /> */}
  <ContactSection t={t} />
  <FooterSection t={t} lang={lang} />
</Layout>
