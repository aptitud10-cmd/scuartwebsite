---
import GeoServiceLayout from '../../../components/GeoServiceLayout.astro';
import type { GeoServiceData } from '../../../components/GeoServiceLayout.astro';
import { getTranslations, getAlternatesFor, SITE_URL } from '../../../i18n/index';

const lang = 'es';
const t = getTranslations(lang);
const alternates = getAlternatesFor('services/ai-visibility', 'servicios/ai-visibility');

/* Copy neutro LATAM, sin voseo (convención es.ts).
   Precios base en USD (decisión William 2026-08-04: COP limitaba al resto de
   LATAM + España); el hint de moneda local lo pone el layout client-side.
   Stats con fuente real (research 2026-08-04): AI search 30% de interacciones
   (desde <10% en 2023); adopción >70% Gen Z/Millennials. */
const data: GeoServiceData = {
  kicker: 'SERVICIO N°02 — AI VISIBILITY · GEO',
  heading: 'Aparece en las respuestas de ChatGPT, no solo en Google.',
  tagline:
    'Tus clientes ya no buscan — preguntan. Si la IA no te menciona, ese cliente nunca llega a tu puerta.',
  cta: 'Chequear mi sitio gratis',
  shift: {
    label: 'El comportamiento ya cambió',
    /* CORREGIDO 2026-08-14 (auditoría de transparencia). Los tres stats tenían
       problemas y eran los únicos datos del sitio que dependen de terceros:
       · Pew: la cifra es correcta pero es de OCTUBRE 2025, no 2026. Y el 65%
         incluye "algunas veces"; solo 45% los ve seguido.
       · Deloitte: mide uso de IA EN EL TRABAJO ("day-to-day work"). Decir "en su
         día a día" y enlazarlo a decisiones de compra cambiaba el sentido.
       · Gartner: era un pronóstico de FEBRERO 2024 sobre 2026, presentado en
         presente ("proyecta") estando ya en 2026 — y no se cumplió: Google
         mantiene 90%+ de share vía AI Overviews. Citar una predicción fallida
         como prueba de que "el comportamiento ya cambió" era el punto más
         reclamable del sitio, y encima contradecía al propio body, que abre con
         "No es una predicción: es medible".
       El reemplazo dice la verdad y es MÁS fuerte: el problema no es que la
       gente dejara Google, es que Google dejó de mandar clics. */
    body: 'No es una predicción: es medible. Dos de cada tres personas ya se cruzan con respuestas generadas por IA cuando buscan, y entre quienes hoy deciden dónde gastar, tres de cada cuatro ya trabajan con IA todos los días. El que espera "a ver si esto crece" está regalando esos clientes.',
    stats: [
      { num: '65%', note: 'de los adultos en EE.UU. se cruza con resúmenes de IA al buscar — 45% los ve seguido (Pew Research, oct. 2025)' },
      { num: '74%', note: 'de Gen Z y Millennials ya usa IA en su trabajo diario, contra ~56% el año anterior (Deloitte, 2026)' },
      { num: '2024', note: 'Gartner predijo una caída del 25% en búsqueda tradicional para 2026. No se cumplió a esa escala: Google respondió con AI Overviews. El cambio es real, pero es de formato — no dejaste de aparecer, dejaste de recibir el clic' },
    ],
    sourceNote: 'Fuentes primarias: Pew Research Center, octubre 2025 (encuentro con resúmenes de IA en búsqueda); Deloitte Gen Z & Millennial Survey 2026 (uso de IA en el trabajo); Gartner, febrero 2024 (predicción de volumen de búsqueda, citada acá justamente porque no se cumplió). Links completos a pedido.',
  },
  whatIs: {
    label: '¿Qué es GEO?',
    body: 'GEO (Generative Engine Optimization) es hacer que tu negocio aparezca en las respuestas de la inteligencia artificial. Cuando alguien pregunta "¿cuál es el mejor salón en Queens?" o "¿qué agencia me recomiendas en Bogotá?", ChatGPT, Perplexity y Gemini responden con nombres concretos. GEO es el trabajo de que uno de esos nombres sea el tuyo. Es al 2026 lo que el SEO fue al 2010: los que entraron temprano se quedaron con la categoría.',
  },
  whyNot: {
    label: '¿Por qué tu negocio no aparece?',
    items: [
      {
        title: 'La IA lee información vieja.',
        body: 'Horarios desactualizados, direcciones que ya no son, precios de hace dos años — la IA repite lo que encuentra en sus fuentes, aunque esté mal. Peor que no aparecer es aparecer con datos errados.',
      },
      {
        title: 'Tu sitio no responde preguntas.',
        body: 'Los motores generativos citan páginas que contestan directo lo que la gente pregunta: qué cuesta, dónde queda, qué incluye. Un sitio bonito pero que no responde nada no les sirve como fuente.',
      },
      {
        title: 'Nadie más te menciona.',
        body: 'Los modelos de IA confían en las menciones de terceros: directorios, prensa, reseñas, listas de "los mejores de". Sin ecos externos, para la IA tu negocio no existe — por bueno que sea.',
      },
    ],
  },
  engines: {
    label: 'Los motores que auditamos',
    body: 'Cada motor responde distinto y lee fuentes distintas. Por eso la auditoría no es "preguntarle a ChatGPT": es la misma batería de preguntas reales de cliente, corrida en paralelo en los cuatro motores principales, con sus fuentes rastreadas.',
    primary: ['ChatGPT', 'Perplexity', 'Gemini', 'Claude'],
    secondary: 'En el monitoreo mensual se suman Google AI Overviews y Copilot cuando aplican a tu mercado.',
  },
  how: {
    label: '¿Cómo funciona?',
    tiers: [
      {
        num: '01',
        name: 'Diagnóstico',
        priceUSD: 249,
        priceSuffix: 'pago único',
        body: 'La foto completa de tu presencia en IA: dónde apareces, quién se está llevando a tus clientes y qué información errada circula sobre tu negocio.',
        includesLabel: 'Incluye',
        includes: [
          '25+ preguntas reales de cliente corridas en ChatGPT, Perplexity, Gemini y Claude',
          'En tu idioma y el de tu mercado (español e inglés si aplica)',
          'Mapa de competidores: quiénes aparecen en tu categoría y por qué',
          'Fuentes que la IA cita para tu rubro — o sea, dónde hay que estar',
          'Información errada detectada (horarios, precios, ubicación)',
          'Plan de arreglo priorizado: qué mover primero y qué esperar de cada cambio',
          'Reporte diseñado, en cristiano, entregado en 7 días',
        ],
      },
      {
        num: '02',
        name: 'Arreglo',
        priceUSD: 1500,
        pricePrefix: 'Desde',
        priceSuffix: 'por proyecto',
        body: 'Ejecutamos el plan del diagnóstico: convertimos tu presencia digital en algo que la IA pueda leer, citar y recomendar.',
        includesLabel: 'Incluye',
        includes: [
          'Arquitectura answer-first: tus páginas responden las preguntas que tu cliente hace',
          'Reescritura de las páginas clave (servicios, precios, ubicación, FAQ)',
          'Corrección de tu información en las fuentes que la IA lee (Google Business, directorios, mapas)',
          'Datos estructurados donde aportan (negocio, servicios, FAQ)',
          'Plan de menciones de terceros: dónde y cómo conseguir los ecos que la IA escucha',
          'Si tu sitio necesita rediseño, se cotiza aparte — con el diagnóstico como base',
          'Aplicable a sitios que podamos editar directamente. Si tu sitio corre en una plataforma cerrada que no da acceso, te entregamos el diagnóstico y el plan exacto para que tu equipo lo ejecute — o te proponemos rehacerlo bien.',
        ],
      },
      {
        num: '03',
        name: 'Mantenimiento',
        priceUSD: 250,
        pricePrefix: 'Desde',
        priceSuffix: 'por mes',
        body: 'La visibilidad en IA no es un logro, es una posición — y se defiende trabajando, no mirando. Cada mes hacemos algo por tu presencia, y te mostramos el resultado.',
        includesLabel: 'Cada mes incluye',
        includes: [
          'Una página o FAQ nueva respondiendo lo que tus clientes preguntan ese mes',
          'Tu Google Business al día: horarios, fotos, servicios, novedades',
          'Sistema de reseñas listo para que las pidas + respuesta a las que llegan (las reseñas reales las dejan tus clientes — así las valora la IA)',
          'Una mención nueva de terceros perseguida (directorios, listas, prensa local)',
          'Re-auditoría completa en los 4 motores: qué ganaste, qué perdiste, quién se movió',
        ],
      },
    ],
  },
  checker: {
    label: '¿Cómo está tu sitio hoy?',
    body: 'Pega la dirección de tu sitio y lo analizamos al instante: si los motores de IA pueden leerte, si tienes schema, si tu contenido responde preguntas. Sin registro, sin email, sin espera.',
    placeholder: 'tusitio.com',
    inputLabel: 'Dirección de tu sitio web',
    button: 'Analizar mi sitio',
    note: 'El análisis es técnico y automático. Lo que la IA responde hoy sobre tu negocio lo revisamos juntos — escríbenos con el resultado.',
    waMessage: 'Hola SCUART, analicé mi sitio con el chequeo GEO:',
    loadingLabel: 'Analizando…',
    /* 2026-08-14: era "Lo que movería la aguja primero", que describía un top 3.
       Ahora el informe lista TODAS las fallas ordenadas por severidad, así que
       el encabezado dice lo que la lista realmente es. */
    prioLabel: 'Lo que hay que arreglar',
    waCta: 'Hablemos de cómo arreglarlo',
    errorLabel: 'Algo falló. Prueba de nuevo o escríbenos.',
  },
  forWhom: {
    label: '¿Es para tu negocio?',
    yesLabel: 'Funciona muy bien si',
    yes: [
      'Te buscan por categoría: "mejor dentista en...", "agencia de...", "salón de..."',
      'Vives de clientes nuevos, no solo de recompra',
      'Tu competencia ya aparece en las respuestas y tú no',
      'Vendes servicios con ticket que justifica la inversión',
    ],
    noLabel: 'No es prioridad si',
    no: [
      'Todo tu negocio llega por referidos y no necesitas ser encontrado',
      'Tu marca ya domina la categoría en todos los motores',
      'No tienes presencia digital ni planes de tenerla — primero hay que construir la base',
    ],
  },
  evidence: {
    label: 'La prueba',
    body: 'Estamos corriendo esta misma auditoría sobre SCUART. El antes y el después se publican aquí — con capturas reales, no promesas.',
  },
  faq: {
    label: 'Preguntas directas',
    items: [
      {
        q: '¿Cuánto cuesta el servicio GEO?',
        a: 'El diagnóstico cuesta $249 USD (pago único, y se abona al arreglo si continúas), el arreglo desde $1.500 USD según el tamaño de tu presencia digital, y el mantenimiento mensual desde $250 USD. Facturamos en dólares y aceptamos pagos internacionales; en Colombia también en pesos.',
      },
      {
        q: '¿Cuánto tarda en verse el resultado?',
        a: 'El diagnóstico toma una semana. Los cambios de visibilidad en IA suelen notarse entre 4 y 12 semanas después del arreglo, según el punto de partida y la competencia de tu categoría.',
      },
      {
        q: '¿Funciona para cualquier negocio?',
        a: 'Funciona mejor para negocios que la gente busca por categoría: servicios locales, profesionales, marcas con nicho claro. En el diagnóstico te decimos con honestidad si vale la pena para el tuyo.',
      },
      {
        q: '¿En qué países trabajan?',
        /* "el equipo es bilingüe" → "trabajamos en español e inglés"
           (auditoría de copy 2026-08-10): el original afirmaba una composición
           de equipo; el reemplazo dice la capacidad real, que es lo que le
           importa al cliente y es verificable. */
        a: 'En toda Latinoamérica, Estados Unidos y España. El trabajo es remoto y trabajamos en español e inglés — auditamos y optimizamos según el mercado de tu negocio.',
      },
      {
        q: '¿Qué necesitan de mí?',
        a: 'El nombre de tu negocio, tu zona, tus competidores conocidos y acceso a tus perfiles (Google Business, redes). Lo técnico lo hacemos todo nosotros. La única parte que depende de ti son las reseñas: nosotros armamos el sistema completo — el guion, el QR, el mensaje listo — y tú lo activas con tus clientes contentos, porque una reseña real solo la puede dejar quien te visitó (y así es como la IA las valora). Te dejamos todo servido; tú solo lo pones a andar con tu gente.',
      },
      {
        q: '¿Esto reemplaza el SEO?',
        a: 'No — lo complementa. Google sigue existiendo; GEO cubre el frente nuevo: las respuestas generadas por IA, donde los resultados clásicos no aparecen. Lo que haces bien para GEO suele mejorar también tu SEO.',
      },
      {
        q: '¿Cómo miden los resultados?',
        a: 'Con una batería fija de preguntas reales corrida cada mes en los mismos motores, en conversaciones nuevas y sin historial. Las respuestas de la IA varían por sesión, así que medimos tendencia sobre una muestra representativa — y te lo decimos así, sin prometer "posición #1".',
      },
      {
        q: '¿Sirve si mi negocio no tiene sitio web?',
        a: 'Se puede empezar por perfiles y directorios (Google Business, reseñas), pero el techo es bajo: la IA necesita una fuente propia que leer. Si no tienes sitio, lo honesto es construir esa base primero — y también lo hacemos.',
      },
      {
        q: '¿Esto viene incluido si me construyen el sitio?',
        a: 'Sí. Todo sitio que construimos sale con la base de GEO de fábrica — arquitectura answer-first, datos estructurados y contenido que la IA puede leer y citar, sin costo aparte. Los tres planes de arriba (diagnóstico, arreglo, mantenimiento) son para negocios que YA tienen un sitio hecho por otro y quieren ganar visibilidad en IA sin rehacerlo. Si tu sitio corre en una plataforma que no podemos editar, te damos el diagnóstico y el plan; el arreglo requiere un sitio al que tengamos acceso.',
      },
    ],
  },
  closing: {
    statement: '¿Qué dice la IA de tu negocio? Averigüémoslo.',
    emailLabel: 'Escribir a info@scuart.com',
    whatsappLabel: 'WhatsApp',
  },
};
---

<GeoServiceLayout
  t={t}
  lang={lang}
  data={data}
  title="AI Visibility (GEO) — Aparece en ChatGPT | SCUART"
  description="Servicio GEO en español para LATAM, USA y España: auditamos qué dicen ChatGPT, Perplexity y Gemini de tu negocio y hacemos que te recomienden. Diagnóstico $249 USD."
  canonicalURL={`${SITE_URL}/es/servicios/ai-visibility`}
  alternates={alternates}
/>
