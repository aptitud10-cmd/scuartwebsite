---
import CaseStudyLayout from '../../../components/CaseStudyLayout.astro';
import { getTranslations, getAlternatesFor } from '../../../i18n/index';
import type { CaseStudyData } from '../../../components/CaseStudyLayout.astro';

const lang = 'en';
const t = getTranslations(lang);
const alternates = getAlternatesFor('work/healthy-choice', 'trabajo/healthy-choice');

const data: CaseStudyData = {
  name: 'Healthy Choice NY',
  tagline: 'Digital presence for a healthy food restaurant in New York.',
  categories: ['Web', 'Restaurant'],
  year: '2019',
  client: 'Healthy Choice NY',
  heroImage: '/images/portfolio-healthy-choice-real.webp',
  heroImageAlt: 'Healthy Choice NY — website designed by SCUART',
  sections: [
    {
      label: 'Context',
      body: 'Healthy Choice NY is a healthy food restaurant in New York City with a local and Latino community clientele. They operated without significant digital presence in a market where Google Maps and the website are the first contact point with new customers.',
    },
    {
      label: 'Challenge',
      body: 'Design a website that worked as a real sales tool — not just a digital business card. The site needed to clearly communicate the menu, hours, location, and restaurant identity in both English and Spanish for their bilingual audience.',
    },
    {
      label: 'Solution',
      body: 'We built a mobile-first website with an updatable menu, Google Maps integration, and clear calls to action for orders and reservations. The design used real product photography and a fresh palette that communicated health without falling into green-generic clichés.',
    },
    {
      label: 'Result',
      body: 'The restaurant went from having no digital presence to showing up in searches and on Google Maps across their New York area — the first point of contact with new customers in that market.',
    },
  ],
  images: [
    {
      src: '/images/portfolio-healthy-choice-real-trim.webp',
      alt: 'Healthy Choice NY — website view',
      wide: true,
    },
    {
      src: '/images/portfolio-healthy-choice-real.webp',
      alt: 'Healthy Choice NY — design detail',
    },
  ],
  credits: [
    { role: 'Creative Direction', name: 'William Cuartas' },
    { role: 'Web Design', name: 'William Cuartas' },
    { role: 'Development', name: 'William Cuartas' },
  ],
  next: {
    name: 'Arriba Gold',
    href: '/en/work/arriba-gold',
  },
};
---

<CaseStudyLayout
  t={t}
  lang={lang}
  data={data}
  title="Healthy Choice NY — SCUART"
  description="Website for a healthy food restaurant in New York. Design and development by SCUART."
  canonicalURL="https://scuart.com/en/work/healthy-choice"

  alternates={alternates}
/>
