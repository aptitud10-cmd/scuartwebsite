---
import CaseStudyLayout from '../../../components/CaseStudyLayout.astro';
import { getTranslations, getAlternatesFor } from '../../../i18n/index';
import type { CaseStudyData } from '../../../components/CaseStudyLayout.astro';

const lang = 'en';
const t = getTranslations(lang);
const alternates = getAlternatesFor('work/menius', 'trabajo/menius');

const data: CaseStudyData = {
  name: 'Menius',
  tagline: 'Digital menu and ordering SaaS for restaurants. SCUART\'s own product, from zero to production.',
  categories: ['SAAS', 'OWN PRODUCT'],
  year: '2025',
  client: 'SCUART (own product)',
  siteUrl: 'https://menius.app',
  // site view cropped (no client navbar) → dark browser-mockup
  heroImage: '/images/casos/menius-hero-crop.webp',
  heroImageAlt: 'Menius — product landing: online orders with no commission',
  // warm arena canvas: the dark screenshot contrasts and stays legible.
  heroBg: 'var(--canvas-arena)',
  heroFrame: true,
  heroTheme: 'dark',
  blocks: [
    {
      label: 'The problem',
      body: 'Restaurants lose up to 30% of every order to delivery-app commissions. They needed their own channel — digital menu, online orders, and payments straight to their account — without depending on third-party platforms or paying per transaction.',
      image: '/images/casos/menius-precios-crop.webp',
      imageAlt: 'Menius — plans and pricing with no commission',
      ratio: 'wide',
      bg: 'var(--canvas-arena)',
      frame: true,
      theme: 'dark',
    },
    {
      label: 'The product',
      // phone mockup (dark device) → arena canvas so it floats crisply
      image: '/images/casos/menius-mockup.webp',
      body: 'We designed and built Menius from scratch: multi-tenant architecture, mobile-first public menu with QR, real-time orders, Stripe payments (0% commission), and an AI assistant that builds the menu from a photo. Each restaurant gets its own subdomain and admin panel.',
      imageAlt: 'Menius — the digital menu app running on a phone',
      ratio: 'tall',
      bg: 'var(--canvas-arena)',
    },
    {
      label: 'The result',
      body: 'Menius validates the studio\'s model: we don\'t just build websites, we build digital systems that create long-term value. It\'s SCUART\'s technical proof — a complete SaaS, in production, with real payments and active clients.',
      // mobile screenshot (dark) → arena canvas so it floats crisply
      image: '/images/casos/menius-mobile.webp',
      imageAlt: 'Menius — mobile version of the landing',
      ratio: 'tall',
      bg: 'var(--canvas-arena)',
    },
  ],
  credits: [
    { role: 'Product direction', name: 'William Cuartas' },
    { role: 'UX/UI design', name: 'William Cuartas' },
    { role: 'Architecture & development', name: 'William Cuartas' },
  ],
  next: {
    name: 'Etnia Braids',
    href: '/en/work/etnia-braids',
  },
};
---

<CaseStudyLayout
  t={t}
  lang={lang}
  data={data}
  title="Menius — Restaurant Ordering SaaS | SCUART"
  description="Digital menu SaaS for restaurants. Designed and built by SCUART, from zero to production."
  canonicalURL="https://scuart.com/en/work/menius"
  alternates={alternates}
/>
