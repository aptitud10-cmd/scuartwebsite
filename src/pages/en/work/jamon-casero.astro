---
import CaseStudyLayout from '../../../components/CaseStudyLayout.astro';
import { getTranslations, getAlternatesFor } from '../../../i18n/index';
import type { CaseStudyData } from '../../../components/CaseStudyLayout.astro';

const lang = 'en';
const t = getTranslations(lang);
const alternates = getAlternatesFor('work/jamon-casero', 'trabajo/jamon-casero');

const data: CaseStudyData = {
  name: 'Jamón Casero',
  tagline: 'Digital identity for an artisanal charcuterie brand with over 55 years of history in Bogotá.',
  categories: ['WEB', 'GASTRO BRAND'],
  // brand founded in 1970, site rebuilt by SCUART in 2025
  year: '2025',
  client: 'Jamón Casero',
  siteUrl: 'https://jamoncasero.com.co',
  // site view cropped (no client navbar) → dark browser-mockup
  heroImage: '/images/casos/jamon-hero-crop.webp',
  heroImageAlt: 'Jamón Casero — site landing: the roast on wood',
  // warm arena canvas across all blocks (William 2026-07-28)
  heroBg: 'var(--canvas-arena)',
  heroFrame: true,
  heroTheme: 'dark',
  blocks: [
    {
      // 2026-07-28 narrative: labels each image actually ILLUSTRATES.
      // The site → The craft → In your pocket.
      label: 'The site',
      body: 'A brand with over 55 years of tradition, but no digital presence. We designed its online identity: product photography front and center, characterful typography, and a warm palette that evokes the artisanal process. The site speaks to both the end customer and the distributor, with WhatsApp ordering built in.',
      // site view (product block with pricing) → dark browser-mockup on arena
      image: '/images/casos/jamon-producto.webp',
      imageAlt: 'Jamón Casero — product block from the site with pricing',
      ratio: 'wide',
      bg: 'var(--canvas-arena)',
      frame: true,
      theme: 'dark',
    },
    {
      label: 'The craft',
      body: 'The brand rests on a family recipe passed down through generations. The site puts that story ahead of the catalog: build trust in the craft first, then take the order. The editorial identity turns the artisanal process into the selling point.',
      // editorial detail (the recipe book) — no chrome → arena canvas
      image: '/images/casos/jamon-detalle.webp',
      imageAlt: 'Jamón Casero — the family recipe book',
      ratio: 'wide',
      bg: 'var(--canvas-arena)',
    },
    {
      label: 'In your pocket',
      body: 'The experience was designed mobile-first: most orders come in from the phone. The site became the main point of contact for new distributors, and the digital identity served as the base for the brand\'s point-of-sale and packaging materials.',
      // mobile view of the site (dark) → arena canvas so it floats crisply
      image: '/images/casos/jamon-mobile.webp',
      imageAlt: 'Jamón Casero — mobile version of the site',
      ratio: 'tall',
      bg: 'var(--canvas-arena)',
    },
  ],
  credits: [
    { role: 'Creative direction', name: 'William Cuartas' },
    { role: 'Web design', name: 'William Cuartas' },
    { role: 'Development', name: 'William Cuartas' },
  ],
  next: {
    name: 'Menius',
    href: '/en/work/menius',
  },
};
---

<CaseStudyLayout
  t={t}
  lang={lang}
  data={data}
  title="Jamón Casero — Food Brand Website | SCUART"
  description="Digital identity and website for Jamón Casero, a Colombian artisanal charcuterie brand."
  canonicalURL="https://scuart.com/en/work/jamon-casero"
  alternates={alternates}
/>
