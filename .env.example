# .env.example — Variables de entorno requeridas para scuart.com
# Copiar este archivo como .env y completar los valores.
# NUNCA commitear .env con valores reales — está en .gitignore.

# API key de Resend para envío de emails del formulario de contacto.
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=

# Email de destino donde llegan los briefs del formulario.
# Ejemplo: hello@scuart.com o william@tudominio.com
CONTACT_EMAIL=
